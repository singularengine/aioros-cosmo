<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aioros" />
    <ProjectReference Include="..\..\..\src\Aioros.Cosmo\Aioros.Cosmo.csproj" />
    <ProjectReference Include="..\..\..\src\Aioros.Cosmo.Charts\Aioros.Cosmo.Charts.csproj" />
    <ProjectReference Include="..\..\..\src\Aioros.Cosmo.Markdown\Aioros.Cosmo.Markdown.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\*.png" />
    <AvaloniaResource Include="Assets\*.json" />
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\tools\shadcn\out\summary.json" Link="Reference\summary.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\tools\shadcn\out\*.png" Link="Reference\png\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Remove="$(MSBuildThisFileDirectory)..\..\..\BannedSymbols.txt" />
    <AdditionalFiles Include="BannedSymbols.Gallery.txt" />
  </ItemGroup>
</Project>
