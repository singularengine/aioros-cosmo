<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo">
  <Style Selector="Window">
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="TextBlock.h1:not(.typography)">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.75" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="44" />
    <Setter Property="LineHeight" Value="48" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-1.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.h2:not(.typography)">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.h3:not(.typography)">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.lead:not(.typography)">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.p:not(.typography)">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.sm">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.xs">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.muted:not(.typography)">
    <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
  </Style>
  <Style Selector="TextBlock.stat">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.75" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
  </Style>

  <Style Selector="Border.preview">
    <Setter Property="BorderBrush" Value="{DynamicResource CosmoBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CosmoRadiusXl}" />
    <Setter Property="Padding" Value="24,32" />
    <Setter Property="MinHeight" Value="160" />
    <Setter Property="Background" Value="{DynamicResource CosmoBackgroundBrush}" />
  </Style>
  <Style Selector="Border.code">
    <Setter Property="Background" Value="{DynamicResource CosmoMutedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CosmoRadiusLg}" />
    <Setter Property="Padding" Value="16,14" />
  </Style>
  <Style Selector="Border.code TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
  </Style>
  <Style Selector="Border.rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource CosmoBorderBrush}" />
  </Style>
  <Style Selector="Border.kbd">
    <Setter Property="Background" Value="{DynamicResource CosmoMutedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CosmoRadiusSm}" />
    <Setter Property="Padding" Value="5,1" />
  </Style>

  <Style Selector="Border.nav">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource CosmoRadiusMd}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.nav TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoSidebarForegroundBrush}" />
  </Style>
  <Style Selector="Border.nav a|Icon">
    <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource CosmoSidebarAccentBrush}" />
  </Style>
  <Style Selector="Border.nav:current">
    <Setter Property="Background" Value="{DynamicResource CosmoSidebarAccentBrush}" />
  </Style>
  <Style Selector="Border.nav:current TextBlock">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoSidebarAccentForegroundBrush}" />
  </Style>
  <Style Selector="Border.nav:current a|Icon">
    <Setter Property="Foreground" Value="{DynamicResource CosmoSidebarAccentForegroundBrush}" />
  </Style>
  <Style Selector="Border.brand">
    <Setter Property="CornerRadius" Value="{DynamicResource CosmoRadiusMd}" />
  </Style>
  <Style Selector="Border.brand:pointerover">
    <Setter Property="Background" Value="{DynamicResource CosmoSidebarAccentBrush}" />
  </Style>
  <Style Selector="TextBlock.group">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="8,20,0,6" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
  </Style>
  <Style Selector="Border.soon TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
  </Style>
  <Style Selector="Border.soon">
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <Style Selector="Border.segment">
    <Setter Property="Background" Value="{DynamicResource CosmoMutedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CosmoRadiusLg}" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="Border.seg">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="{DynamicResource CosmoRadiusMd}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.seg TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoTabsTriggerBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.seg a|Icon">
    <Setter Property="Foreground" Value="{DynamicResource CosmoTabsTriggerBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.seg:pointerover TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
  </Style>
  <Style Selector="Border.seg.on">
    <Setter Property="Background" Value="{DynamicResource CosmoBackgroundBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource CosmoShadowSm}" />
  </Style>
  <Style Selector="Border.seg.on TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource CosmoRadiusMd}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource CosmoBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource CosmoBackgroundBrush}" />
  </Style>
  <Style Selector="Border.chip.on">
    <Setter Property="BorderBrush" Value="{DynamicResource CosmoForegroundBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="9,5" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.swatch">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.link TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Border.link:pointerover TextBlock">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="Border.feature">
    <Setter Property="BorderBrush" Value="{DynamicResource CosmoBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CosmoRadiusXl}" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="Background" Value="{DynamicResource CosmoCardBrush}" />
  </Style>
  <Style Selector="Border.feature:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource CosmoRingBrush}" />
  </Style>
  <Style Selector="Border.iconbox">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="{DynamicResource CosmoRadiusMd}" />
    <Setter Property="Background" Value="{DynamicResource CosmoMutedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.iconbox a|Icon">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="BorderBrush" Value="{DynamicResource CosmoBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,10" />
  </Style>
  <Style Selector="Border.avatar">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{DynamicResource CosmoMutedBrush}" />
  </Style>
  <Style Selector="Border.avatar TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
