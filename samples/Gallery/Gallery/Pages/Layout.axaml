            <TextBlock Classes="group" Text="Examples" />
            <Border Classes="nav" a:Web.Href="/examples/dashboard">
              <StackPanel Orientation="Horizontal" Spacing="10"><a:Icon Kind="dashboard" /><TextBlock Text="Dashboard" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/examples/forms">
              <StackPanel Orientation="Horizontal" Spacing="10"><a:Icon Kind="check" /><TextBlock Text="Forms" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/examples/workspace">
