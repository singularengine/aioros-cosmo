    </SplitView.Pane>

    <DockPanel>
      <Border DockPanel.Dock="Top" a:Web.Tag="header" a:Web.HideAbove="1024" IsVisible="{a:OnPlatform Default=False, Web=True}"
              Padding="12,8" BorderBrush="{DynamicResource CosmoBorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource CosmoBackgroundBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <Button Classes="ghost icon" AutomationProperties.Name="Menu" a:Web.Toggles="nav" VerticalAlignment="Center">
            <a:Icon Kind="menu" Size="18" />
          </Button>
          <TextBlock Grid.Column="1" Text="Aioros.Cosmo" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Border Grid.Column="2" Classes="seg" a:Web.Href="/theme/toggle" AutomationProperties.Name="Switch theme" VerticalAlignment="Center" Padding="8">
            <a:Icon Kind="{DynamicResource ThemeIcon}" Size="18" />
          </Border>
        </Grid>
      </Border>
      <ScrollViewer>
        <StackPanel>
          <Border Padding="24,32,24,16" a:Web.Tag="main">
            <a:Outlet />
          </Border>
          <Border Padding="24,8,24,32">
            <TextBlock Classes="xs muted" MaxWidth="760" HorizontalAlignment="Left"
                       Text="Cosmo is an independent port of shadcn/ui and is not affiliated with or endorsed by shadcn. shadcn/ui and Radix UI are MIT-licensed, Lucide is ISC-licensed and Inter is under the SIL Open Font License; see THIRD-PARTY-NOTICES." />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </SplitView>
  </Panel>
</UserControl>
