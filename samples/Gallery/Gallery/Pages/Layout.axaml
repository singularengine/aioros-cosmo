              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Skeleton" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/components/slider">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Slider" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/components/sonner">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Sonner" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/components/spinner">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Spinner" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/components/switch">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Switch" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/components/table">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Table" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/components/tabs">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Tabs" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/components/textarea">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Textarea" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/components/toggle">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Toggle" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/components/toggle-group">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Toggle Group" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/components/tooltip">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Tooltip" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/components/trace">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Trace" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/components/typography">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Typography" /></StackPanel>
            </Border>

            <TextBlock Classes="group" Text="Blocks" />
            <Border Classes="nav" a:Web.Href="/blocks/login-01">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Login-01" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/blocks/login-02">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Login-02" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/blocks/login-03">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Login-03" /></StackPanel>
