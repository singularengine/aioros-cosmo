            </Border>
            <Border Classes="nav" a:Web.Href="/blocks/login-05">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Login-05" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/blocks/signup-01">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Signup-01" /></StackPanel>
            </Border>
