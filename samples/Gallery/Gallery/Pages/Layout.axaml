            <Border Classes="nav" a:Web.Href="/components/carousel">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Carousel" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/components/chart">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Chart" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/components/checkbox">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Checkbox" /></StackPanel>
