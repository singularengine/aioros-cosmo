<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo"
             a:Page.Title="Aioros.Cosmo" a:Page.TitleTemplate="%s · Aioros.Cosmo">
  <UserControl.Styles>
    <Style Selector="Border.nav a|Icon">
      <Setter Property="Size" Value="16" />
    </Style>
  </UserControl.Styles>
  <Panel c:OverlayHost.IsHost="True">
  <SplitView DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="256" PaneBackground="{DynamicResource CosmoSidebarBrush}"
             a:Web.Id="nav" a:Web.CollapseBelow="1024">
    <SplitView.Pane>
      <Border Padding="12,16" BorderBrush="{DynamicResource CosmoSidebarBorderBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Spacing="1" a:Web.Tag="nav">
            <Border Classes="brand" a:Web.Href="/" AutomationProperties.Name="Aioros.Cosmo home" Padding="6" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Viewbox Width="28" Height="28">
                  <Canvas Width="64" Height="64">
                    <Rectangle Width="64" Height="64" RadiusX="14" RadiusY="14">
                      <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                          <GradientStop Offset="0" Color="#27272A" />
                          <GradientStop Offset="1" Color="#09090B" />
                        </LinearGradientBrush>
                      </Rectangle.Fill>
                    </Rectangle>
                    <Path Data="M52.78,20 A24,10 -30 1 1 11.22,44 A24,10 -30 1 1 52.78,20 Z" Stroke="#71717A" StrokeThickness="2" />
                    <Path Data="M32,14 C33.5,26 38,30.5 50,32 C38,33.5 33.5,38 32,50 C30.5,38 26,33.5 14,32 C26,30.5 30.5,26 32,14 Z" Fill="#FAFAFA" />
                    <Ellipse Canvas.Left="49.58" Canvas.Top="16.8" Width="6.4" Height="6.4" Fill="#FAFAFA" />
                  </Canvas>
                </Viewbox>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Aioros.Cosmo" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource CosmoSidebarForegroundBrush}" />
                  <TextBlock Text="Components for Aioros" FontSize="12" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="segment" HorizontalAlignment="Left" Margin="0,4,0,4" AutomationProperties.Name="Theme">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Border Classes="seg" Background="{DynamicResource GalleryLightSegment}" BoxShadow="{DynamicResource GalleryLightSegmentShadow}" a:Web.Href="/theme/light" AutomationProperties.Name="Light theme">
                  <StackPanel Orientation="Horizontal" Spacing="6"><a:Icon Kind="sun" Size="14" /><TextBlock Text="Light" /></StackPanel>
                </Border>
                <Border Classes="seg" Background="{DynamicResource GalleryDarkSegment}" BoxShadow="{DynamicResource GalleryDarkSegmentShadow}" a:Web.Href="/theme/dark" AutomationProperties.Name="Dark theme">
                  <StackPanel Orientation="Horizontal" Spacing="6"><a:Icon Kind="moon" Size="14" /><TextBlock Text="Dark" /></StackPanel>
                </Border>
                <Border Classes="seg" a:Web.Href="/theme/system" AutomationProperties.Name="System theme, following the device">
                  <StackPanel Orientation="Horizontal" Spacing="6"><a:Icon Kind="monitor" Size="14" /><TextBlock Text="System" /></StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <TextBlock Classes="group" Text="Getting started" />
            <Border Classes="nav" a:Web.Href="/" a:Web.Exact="True">
              <StackPanel Orientation="Horizontal" Spacing="10"><a:Icon Kind="sparkles" /><TextBlock Text="Introduction" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/installation">
              <StackPanel Orientation="Horizontal" Spacing="10"><a:Icon Kind="rocket" /><TextBlock Text="Installation" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/themes">
              <StackPanel Orientation="Horizontal" Spacing="10"><a:Icon Kind="layers" /><TextBlock Text="Themes" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/binding">
              <StackPanel Orientation="Horizontal" Spacing="10"><a:Icon Kind="code" /><TextBlock Text="Binding and MVVM" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/fidelity">
              <StackPanel Orientation="Horizontal" Spacing="10"><a:Icon Kind="target" /><TextBlock Text="Fidelity" /></StackPanel>
            </Border>

            <TextBlock Classes="group" Text="Components" />
            <Border Classes="nav" a:Web.Href="/components/accordion">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Accordion" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/components/alert">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Alert" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/components/alert-dialog">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Alert Dialog" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/components/aspect-ratio">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Aspect Ratio" /></StackPanel>
            </Border>
            <Border Classes="nav" a:Web.Href="/components/attachment">
