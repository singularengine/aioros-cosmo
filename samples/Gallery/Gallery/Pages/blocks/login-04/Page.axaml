<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo"
             a:Page.Title="login-04" a:Page.Description="Login page with form and image.">
  <StackPanel Spacing="24">
    <StackPanel Spacing="10">
      <TextBlock Classes="h1" Text="login-04" />
      <TextBlock Classes="lead" Text="Login page with form and image." />
    </StackPanel>
    <Border MinHeight="720" CornerRadius="{DynamicResource CosmoRadiusXl}" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}"
            Background="{DynamicResource CosmoMutedBrush}" ClipToBounds="True" Container.Name="block" Container.Sizing="Width">
      <Border.Styles>
        <Style Selector="Border.page"><Setter Property="Padding" Value="40" /></Style>
        <Style Selector="StackPanel.split"><Setter Property="MaxWidth" Value="896" /></Style>
        <Style Selector="c|FieldGroup.split"><Setter Property="Margin" Value="32" /></Style>
        <ContainerQuery Name="block" Query="max-width:767">
          <Style Selector="Border.page"><Setter Property="Padding" Value="24" /></Style>
          <Style Selector="StackPanel.split"><Setter Property="MaxWidth" Value="384" /></Style>
          <Style Selector="c|FieldGroup.split"><Setter Property="Margin" Value="24" /><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
          <Style Selector="Border.cover"><Setter Property="IsVisible" Value="False" /></Style>
        </ContainerQuery>
      </Border.Styles>
      <Border VerticalAlignment="Center">
        <Border Classes="page" Background="{DynamicResource CosmoMutedBrush}">
          <StackPanel Classes="split" Spacing="24">
            <c:Card Padding="0" ClipToBounds="True">
              <c:CardContent Padding="0">
                <Grid ColumnDefinitions="*,*">
                  <c:FieldGroup Classes="split">
                    <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                      <TextBlock Text="Welcome back" FontSize="24" LineHeight="32" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                      <TextBlock Text="Login to your Acme Inc account" FontSize="16" LineHeight="24" Foreground="{DynamicResource CosmoMutedForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <c:Field>
                      <c:FieldLabel Content="Email" Target="{Binding #email}" />
                      <TextBox Name="email" a:Web.Id="email" a:Web.InputType="email" PlaceholderText="m@example.com" />
                    </c:Field>
                    <c:Field>
                      <Grid ColumnDefinitions="Auto,*">
                        <c:FieldLabel Content="Password" Target="{Binding #password}" VerticalAlignment="Center" />
                        <HyperlinkButton Classes="link" NavigateUri="#" Padding="0" Height="NaN" MinHeight="0" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource CosmoForegroundBrush}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Forgot your password?" TextWrapping="Wrap" /></HyperlinkButton>
                      </Grid>
                      <TextBox Name="password" a:Web.Id="password" PasswordChar="•" />
                    </c:Field>
                    <c:Field>
                      <Button Content="Login" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </c:Field>
                    <c:FieldSeparator Classes="card" Content="Or continue with" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16"><Button Grid.Column="0" Classes="outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="Login with Apple"><Viewbox Width="16" Height="16"><Path Width="24" Height="24" Stretch="None" Fill="{DynamicResource CosmoForegroundBrush}" Data="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" /></Viewbox></Button><Button Grid.Column="1" Classes="outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="Login with Google"><Viewbox Width="16" Height="16"><Path Width="24" Height="24" Stretch="None" Fill="{DynamicResource CosmoForegroundBrush}" Data="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z" /></Viewbox></Button><Button Grid.Column="2" Classes="outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="Login with Meta"><Viewbox Width="16" Height="16"><Path Width="24" Height="24" Stretch="None" Fill="{DynamicResource CosmoForegroundBrush}" Data="M6.915 4.03c-1.968 0-3.683 1.28-4.871 3.113C.704 9.208 0 11.883 0 14.449c0 .706.07 1.369.21 1.973a6.624 6.624 0 0 0 .265.86 5.297 5.297 0 0 0 .371.761c.696 1.159 1.818 1.927 3.593 1.927 1.497 0 2.633-.671 3.965-2.444.76-1.012 1.144-1.626 2.663-4.32l.756-1.339.186-.325c.061.1.121.196.183.3l2.152 3.595c.724 1.21 1.665 2.556 2.47 3.314 1.046.987 1.992 1.22 3.06 1.22 1.075 0 1.876-.355 2.455-.843a3.743 3.743 0 0 0 .81-.973c.542-.939.861-2.127.861-3.745 0-2.72-.681-5.357-2.084-7.45-1.282-1.912-2.957-2.93-4.716-2.93-1.047 0-2.088.467-3.053 1.308-.652.57-1.257 1.29-1.82 2.05-.69-.875-1.335-1.547-1.958-2.056-1.182-.966-2.315-1.303-3.454-1.303zm10.16 2.053c1.147 0 2.188.758 2.992 1.999 1.132 1.748 1.647 4.195 1.647 6.4 0 1.548-.368 2.9-1.839 2.9-.58 0-1.027-.23-1.664-1.004-.496-.601-1.343-1.878-2.832-4.358l-.617-1.028a44.908 44.908 0 0 0-1.255-1.98c.07-.109.141-.224.211-.327 1.12-1.667 2.118-2.602 3.358-2.602zm-10.201.553c1.265 0 2.058.791 2.675 1.446.307.327.737.871 1.234 1.579l-1.02 1.566c-.757 1.163-1.882 3.017-2.837 4.338-1.191 1.649-1.81 1.817-2.486 1.817-.524 0-1.038-.237-1.383-.794-.263-.426-.464-1.13-.464-2.046 0-2.221.63-4.535 1.66-6.088.454-.687.964-1.226 1.533-1.533a2.264 2.264 0 0 1 1.088-.285z" /></Viewbox></Button></Grid>
                    <c:FieldDescription TextAlignment="Center"><Run Text="Don't have an account? " /><Run Text="Sign up" a:Web.Href="#" TextDecorations="Underline" /></c:FieldDescription>
                  </c:FieldGroup>
                  <Border Classes="cover" Grid.Column="1"><Border Background="#EAEAEA" CornerRadius="0,13,13,0" ClipToBounds="True"><Border.Resources>
              <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                  <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="PlaceholderShade" Color="Transparent" /></ResourceDictionary>
                  <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="PlaceholderShade" Color="#CC000000" /></ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
              </ResourceDictionary>
            </Border.Resources><Panel><Image Source="/Assets/placeholder.png" Stretch="UniformToFill" AutomationProperties.Name="Image" /><Border Background="{DynamicResource PlaceholderShade}" /></Panel></Border></Border>
                </Grid>
              </c:CardContent>
            </c:Card>
            <c:FieldDescription TextAlignment="Center" Margin="24,0"><Run Text="By clicking continue, you agree to our " /><Run Text="Terms of Service" a:Web.Href="#" TextDecorations="Underline" /><Run Text=" and " /><Run Text="Privacy Policy" a:Web.Href="#" TextDecorations="Underline" /><Run Text="." /></c:FieldDescription>
          </StackPanel>
        </Border>
      </Border>
    </Border>
  </StackPanel>
</UserControl>
