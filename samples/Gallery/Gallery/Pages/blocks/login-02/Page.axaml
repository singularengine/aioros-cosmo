<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo"
             a:Page.Title="login-02" a:Page.Description="A two column login page with a cover image.">
  <StackPanel Spacing="24">
    <StackPanel Spacing="10">
      <TextBlock Classes="h1" Text="login-02" />
      <TextBlock Classes="lead" Text="A two column login page with a cover image." />
    </StackPanel>
    <Border MinHeight="720" CornerRadius="{DynamicResource CosmoRadiusXl}" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}"
            Background="{DynamicResource CosmoBackgroundBrush}" ClipToBounds="True" Container.Name="block" Container.Sizing="Width">
      <Border.Styles>
        <Style Selector="Border.page"><Setter Property="Padding" Value="40" /></Style>
        <Style Selector="StackPanel.split"><Setter Property="MaxWidth" Value="896" /></Style>
        <Style Selector="c|FieldGroup.split"><Setter Property="Margin" Value="32" /></Style>
        <ContainerQuery Name="block" Query="max-width:767">
          <Style Selector="Border.page"><Setter Property="Padding" Value="24" /></Style>
          <Style Selector="StackPanel.split"><Setter Property="MaxWidth" Value="384" /></Style>
          <Style Selector="c|FieldGroup.split"><Setter Property="Margin" Value="24" /><Setter Property="Grid.ColumnSpan" Value="2" /></Style>
          <Style Selector="Border.cover"><Setter Property="IsVisible" Value="False" /></Style>
        </ContainerQuery>
      </Border.Styles>
      <Border VerticalAlignment="Center">
        <Border Classes="page">
          <StackPanel Spacing="16">
            <Border a:Web.Href="#" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><Border Width="24" Height="24" CornerRadius="{DynamicResource CosmoRadiusMd}" Background="{DynamicResource CosmoPrimaryBrush}"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPrimaryForegroundBrush}" Data="M7 2h10 M5 6h14 M5,10 L19,10 A2,2 0 0 1 21,12 L21,20 A2,2 0 0 1 19,22 L5,22 A2,2 0 0 1 3,20 L3,12 A2,2 0 0 1 5,10 Z" /></Viewbox></Border><TextBlock Text="Acme Inc." FontSize="16" LineHeight="24" FontWeight="Medium" VerticalAlignment="Center" /></StackPanel></Border>
            <StackPanel MaxWidth="320">
              <c:FieldGroup>
                <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                  <TextBlock Text="Login to your account" FontSize="24" LineHeight="32" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                  <TextBlock Text="Enter your email below to login to your account" FontSize="14" LineHeight="20" Foreground="{DynamicResource CosmoMutedForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <c:Field>
                  <c:FieldLabel Content="Email" Target="{Binding #email}" />
                  <TextBox Name="email" a:Web.Id="email" a:Web.InputType="email" PlaceholderText="m@example.com" />
                </c:Field>
                <c:Field>
                  <Grid ColumnDefinitions="Auto,*">
                    <c:FieldLabel Content="Password" Target="{Binding #password}" VerticalAlignment="Center" />
                    <HyperlinkButton Classes="link" NavigateUri="#" Padding="0" Height="NaN" MinHeight="0" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource CosmoForegroundBrush}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Forgot your password?" TextWrapping="Wrap" /></HyperlinkButton>
                  </Grid>
                  <TextBox Name="password" a:Web.Id="password" PasswordChar="•" />
                </c:Field>
                <c:Field>
                  <Button Content="Login" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </c:Field>
                <c:FieldSeparator Content="Or continue with" />
                <c:Field>
                  <Button Classes="outline has-icon" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"><StackPanel><Viewbox Width="16" Height="16"><Path Width="24" Height="24" Stretch="None" Fill="{DynamicResource CosmoForegroundBrush}" Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></Viewbox><TextBlock Text="Login with GitHub" /></StackPanel></Button>
                  <c:FieldDescription TextAlignment="Center"><Run Text="Don't have an account? " /><Run Text="Sign up" a:Web.Href="#" TextDecorations="Underline" /></c:FieldDescription>
                </c:Field>
              </c:FieldGroup>
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Border>
  </StackPanel>
</UserControl>
