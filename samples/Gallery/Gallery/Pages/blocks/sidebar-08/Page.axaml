<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models"
             a:Page.Title="sidebar-08" a:Page.Description="An inset sidebar with secondary navigation.">
  <StackPanel Spacing="24">
    <StackPanel Spacing="10">
      <TextBlock Classes="h1" Text="sidebar-08" />
      <TextBlock Classes="lead" Text="An inset sidebar with secondary navigation." />
    </StackPanel>
    <Border Height="800" CornerRadius="{DynamicResource CosmoRadiusXl}" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" ClipToBounds="True">
      <c:SidebarProvider MobileBreakpoint="0">
        <c:Sidebar Variant="Inset">
          <c:SidebarHeader>
            <c:SidebarMenu>
              <c:SidebarMenuItem>
                <c:SidebarMenuButton Classes="lg" Tooltip="Acme Inc">
                  <DockPanel>
                    <Border Width="32" Height="32" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoSidebarPrimaryBrush}"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarPrimaryForegroundBrush}" Data="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3" /></Viewbox></Border>
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="Acme Inc" FontWeight="Medium" LineHeight="17.5" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="Enterprise" FontSize="12" LineHeight="15" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DockPanel>
                </c:SidebarMenuButton>
              </c:SidebarMenuItem>
            </c:SidebarMenu>
          </c:SidebarHeader>
          <c:SidebarContent>
            <c:SidebarContent.ItemsPanel><ItemsPanelTemplate><DockPanel LastChildFill="False" VerticalSpacing="8" /></ItemsPanelTemplate></c:SidebarContent.ItemsPanel>
            <c:SidebarGroup DockPanel.Dock="Top">
              <c:SidebarGroupLabel Content="Platform" />
              <c:SidebarMenu>
                <c:SidebarMenuItem IsCollapsible="True" IsExpanded="True">
                  <c:SidebarMenuButton Tooltip="Playground"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M7 11 l2-2-2-2 M11 13h4 M5,3 L19,3 A2,2 0 0 1 21,5 L21,19 A2,2 0 0 1 19,21 L5,21 A2,2 0 0 1 3,19 L3,5 A2,2 0 0 1 5,3 Z" /></Viewbox><TextBlock Text="Playground" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                  <c:SidebarMenuAction Toggles="True" AutomationProperties.Name="Toggle"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M9 18 l6-6-6-6" /></Viewbox></c:SidebarMenuAction>
                  <c:SidebarMenuSub>
                    <c:SidebarMenuSubButton Content="History" />
                    <c:SidebarMenuSubButton Content="Starred" />
                    <c:SidebarMenuSubButton Content="Settings" />
                  </c:SidebarMenuSub>
                </c:SidebarMenuItem>
                <c:SidebarMenuItem IsCollapsible="True">
                  <c:SidebarMenuButton Tooltip="Models"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M12 8V4H8 M6,8 L18,8 A2,2 0 0 1 20,10 L20,18 A2,2 0 0 1 18,20 L6,20 A2,2 0 0 1 4,18 L4,10 A2,2 0 0 1 6,8 Z M2 14h2 M20 14h2 M15 13v2 M9 13v2" /></Viewbox><TextBlock Text="Models" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                  <c:SidebarMenuAction Toggles="True" AutomationProperties.Name="Toggle"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M9 18 l6-6-6-6" /></Viewbox></c:SidebarMenuAction>
                  <c:SidebarMenuSub>
                    <c:SidebarMenuSubButton Content="Genesis" />
                    <c:SidebarMenuSubButton Content="Explorer" />
                    <c:SidebarMenuSubButton Content="Quantum" />
                  </c:SidebarMenuSub>
                </c:SidebarMenuItem>
                <c:SidebarMenuItem IsCollapsible="True">
                  <c:SidebarMenuButton Tooltip="Documentation"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M12 7v14 M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z" /></Viewbox><TextBlock Text="Documentation" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                  <c:SidebarMenuAction Toggles="True" AutomationProperties.Name="Toggle"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M9 18 l6-6-6-6" /></Viewbox></c:SidebarMenuAction>
                  <c:SidebarMenuSub>
                    <c:SidebarMenuSubButton Content="Introduction" />
                    <c:SidebarMenuSubButton Content="Get Started" />
                    <c:SidebarMenuSubButton Content="Tutorials" />
                    <c:SidebarMenuSubButton Content="Changelog" />
                  </c:SidebarMenuSub>
                </c:SidebarMenuItem>
                <c:SidebarMenuItem IsCollapsible="True">
                  <c:SidebarMenuButton Tooltip="Settings"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M20 7h-9 M14 17H5 M14,17 A3,3 0 1 1 20,17 A3,3 0 1 1 14,17 Z M4,7 A3,3 0 1 1 10,7 A3,3 0 1 1 4,7 Z" /></Viewbox><TextBlock Text="Settings" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                  <c:SidebarMenuAction Toggles="True" AutomationProperties.Name="Toggle"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M9 18 l6-6-6-6" /></Viewbox></c:SidebarMenuAction>
                  <c:SidebarMenuSub>
                    <c:SidebarMenuSubButton Content="General" />
                    <c:SidebarMenuSubButton Content="Team" />
                    <c:SidebarMenuSubButton Content="Billing" />
                    <c:SidebarMenuSubButton Content="Limits" />
                  </c:SidebarMenuSub>
                </c:SidebarMenuItem>
              </c:SidebarMenu>
            </c:SidebarGroup>
            <c:SidebarGroup DockPanel.Dock="Top" Classes="icon-hidden">
              <c:SidebarGroupLabel Content="Projects" />
              <c:SidebarMenu>
                <c:SidebarMenuItem>
                  <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M22,6 L2,6 M22,18 L2,18 M6,2 L6,22 M18,2 L18,22" /></Viewbox><TextBlock Text="Design Engineering" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                  <c:SidebarMenuAction Classes="show-on-hover" AutomationProperties.Name="More">
                    <Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M11,12 A1,1 0 1 1 13,12 A1,1 0 1 1 11,12 Z M18,12 A1,1 0 1 1 20,12 A1,1 0 1 1 18,12 Z M4,12 A1,1 0 1 1 6,12 A1,1 0 1 1 4,12 Z" /></Viewbox>
                    <c:SidebarMenuAction.Flyout>
                      <MenuFlyout Placement="RightEdgeAlignedTop">
                        <MenuItem Header="View Project"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" /></Viewbox></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Share Project"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8 M16,6 L12,2 L8,6 M12,2 L12,15" /></Viewbox></MenuItem.Icon></MenuItem>
                        <Separator />
                        <MenuItem Header="Delete Project"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M3 6h18 M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6 M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2 M10,11 L10,17 M14,11 L14,17" /></Viewbox></MenuItem.Icon></MenuItem>
                      </MenuFlyout>
                    </c:SidebarMenuAction.Flyout>
                  </c:SidebarMenuAction>
                </c:SidebarMenuItem>
                <c:SidebarMenuItem>
                  <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M21 12c.552 0 1.005-.449.95-.998a10 10 0 0 0-8.953-8.951c-.55-.055-.998.398-.998.95v8a1 1 0 0 0 1 1z M21.21 15.89A10 10 0 1 1 8 2.83" /></Viewbox><TextBlock Text="Sales &amp; Marketing" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                  <c:SidebarMenuAction Classes="show-on-hover" AutomationProperties.Name="More">
                    <Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M11,12 A1,1 0 1 1 13,12 A1,1 0 1 1 11,12 Z M18,12 A1,1 0 1 1 20,12 A1,1 0 1 1 18,12 Z M4,12 A1,1 0 1 1 6,12 A1,1 0 1 1 4,12 Z" /></Viewbox>
                    <c:SidebarMenuAction.Flyout>
                      <MenuFlyout Placement="RightEdgeAlignedTop">
                        <MenuItem Header="View Project"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" /></Viewbox></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Share Project"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8 M16,6 L12,2 L8,6 M12,2 L12,15" /></Viewbox></MenuItem.Icon></MenuItem>
                        <Separator />
                        <MenuItem Header="Delete Project"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M3 6h18 M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6 M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2 M10,11 L10,17 M14,11 L14,17" /></Viewbox></MenuItem.Icon></MenuItem>
                      </MenuFlyout>
                    </c:SidebarMenuAction.Flyout>
                  </c:SidebarMenuAction>
                </c:SidebarMenuItem>
                <c:SidebarMenuItem>
                  <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z M15 5.764v15 M9 3.236v15" /></Viewbox><TextBlock Text="Travel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                  <c:SidebarMenuAction Classes="show-on-hover" AutomationProperties.Name="More">
                    <Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M11,12 A1,1 0 1 1 13,12 A1,1 0 1 1 11,12 Z M18,12 A1,1 0 1 1 20,12 A1,1 0 1 1 18,12 Z M4,12 A1,1 0 1 1 6,12 A1,1 0 1 1 4,12 Z" /></Viewbox>
                    <c:SidebarMenuAction.Flyout>
                      <MenuFlyout Placement="RightEdgeAlignedTop">
                        <MenuItem Header="View Project"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" /></Viewbox></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Share Project"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8 M16,6 L12,2 L8,6 M12,2 L12,15" /></Viewbox></MenuItem.Icon></MenuItem>
                        <Separator />
                        <MenuItem Header="Delete Project"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M3 6h18 M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6 M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2 M10,11 L10,17 M14,11 L14,17" /></Viewbox></MenuItem.Icon></MenuItem>
                      </MenuFlyout>
                    </c:SidebarMenuAction.Flyout>
                  </c:SidebarMenuAction>
                </c:SidebarMenuItem>
                <c:SidebarMenuItem><c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M11,12 A1,1 0 1 1 13,12 A1,1 0 1 1 11,12 Z M18,12 A1,1 0 1 1 20,12 A1,1 0 1 1 18,12 Z M4,12 A1,1 0 1 1 6,12 A1,1 0 1 1 4,12 Z" /></Viewbox><TextBlock Text="More" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
              </c:SidebarMenu>
            </c:SidebarGroup>
            <c:SidebarGroup DockPanel.Dock="Bottom">
              <c:SidebarMenu>
                <c:SidebarMenuItem>
                  <c:SidebarMenuButton Classes="sm"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M4.93 4.93 l4.24 4.24 M14.83 9.17 l4.24-4.24 M14.83 14.83 l4.24 4.24 M9.17 14.83 l-4.24 4.24 M8,12 A4,4 0 1 1 16,12 A4,4 0 1 1 8,12 Z" /></Viewbox><TextBlock Text="Support" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                </c:SidebarMenuItem>
                <c:SidebarMenuItem>
                  <c:SidebarMenuButton Classes="sm"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z M21.854 2.147 l-10.94 10.939" /></Viewbox><TextBlock Text="Feedback" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                </c:SidebarMenuItem>
              </c:SidebarMenu>
            </c:SidebarGroup>
          </c:SidebarContent>
          <c:SidebarFooter>
            <c:SidebarMenu>
              <c:SidebarMenuItem>
                <c:SidebarMenuButton Classes="lg" Tooltip="shadcn">
                  <DockPanel>
                    <Viewbox Width="16" Height="16" DockPanel.Dock="Right" Margin="8,0,0,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M7 15 l5 5 5-5 M7 9 l5-5 5 5" /></Viewbox>
                    <c:Avatar Width="32" Height="32" Content="CN" CornerRadius="{DynamicResource CosmoRadiusLg}" />
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="shadcn" FontWeight="Medium" LineHeight="17.5" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="m@example.com" FontSize="12" LineHeight="15" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DockPanel>
                  <c:SidebarMenuButton.Flyout>
                    <MenuFlyout Placement="RightEdgeAlignedBottom">
                      <MenuItem Classes="label">
                        <MenuItem.Header>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:Avatar Width="32" Height="32" Content="CN" CornerRadius="{DynamicResource CosmoRadiusLg}" />
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="shadcn" FontWeight="Medium" FontSize="14" LineHeight="17.5" />
                              <TextBlock Text="m@example.com" FontWeight="Normal" FontSize="12" LineHeight="15" />
                            </StackPanel>
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      <Separator />
                      <MenuItem Header="Upgrade to Pro"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z M20 3v4 M22 5h-4 M4 17v2 M5 18H3" /></Viewbox></MenuItem.Icon></MenuItem>
                      <Separator />
                      <MenuItem Header="Account"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z M9 12 l2 2 4-4" /></Viewbox></MenuItem.Icon></MenuItem>
                      <MenuItem Header="Billing"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M4,5 L20,5 A2,2 0 0 1 22,7 L22,17 A2,2 0 0 1 20,19 L4,19 A2,2 0 0 1 2,17 L2,7 A2,2 0 0 1 4,5 Z M2,10 L22,10" /></Viewbox></MenuItem.Icon></MenuItem>
                      <MenuItem Header="Notifications"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M10.268 21a2 2 0 0 0 3.464 0 M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326" /></Viewbox></MenuItem.Icon></MenuItem>
                      <Separator />
                      <MenuItem Header="Log out"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16,17 L21,12 L16,7 M21,12 L9,12" /></Viewbox></MenuItem.Icon></MenuItem>
                    </MenuFlyout>
                  </c:SidebarMenuButton.Flyout>
                </c:SidebarMenuButton>
              </c:SidebarMenuItem>
            </c:SidebarMenu>
          </c:SidebarFooter>
        </c:Sidebar>
        <c:SidebarInset>
          <DockPanel>
            <Border DockPanel.Dock="Top" Height="64" Padding="16,0">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <c:SidebarTrigger Margin="-4,0,0,0" VerticalAlignment="Center" />
                <Separator Classes="vertical" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                <c:Breadcrumb VerticalAlignment="Center">
                  <HyperlinkButton Content="Build Your Application" NavigateUri="#" />
                  <c:BreadcrumbPage Text="Data Fetching" />
                </c:Breadcrumb>
              </StackPanel>
            </Border>
            <DockPanel Margin="16,0,16,16">
              <UniformGrid DockPanel.Dock="Top" Columns="3" ColumnSpacing="16" Margin="0,0,0,16">
                <c:AspectRatio Ratio="1.7778"><Border CornerRadius="{DynamicResource CosmoRadiusXl}" Background="{DynamicResource CosmoMutedHalfBrush}" /></c:AspectRatio>
                <c:AspectRatio Ratio="1.7778"><Border CornerRadius="{DynamicResource CosmoRadiusXl}" Background="{DynamicResource CosmoMutedHalfBrush}" /></c:AspectRatio>
                <c:AspectRatio Ratio="1.7778"><Border CornerRadius="{DynamicResource CosmoRadiusXl}" Background="{DynamicResource CosmoMutedHalfBrush}" /></c:AspectRatio>
              </UniformGrid>
              <Border CornerRadius="{DynamicResource CosmoRadiusXl}" Background="{DynamicResource CosmoMutedHalfBrush}" />
            </DockPanel>
          </DockPanel>
        </c:SidebarInset>
      </c:SidebarProvider>
    </Border>
  </StackPanel>
</UserControl>
