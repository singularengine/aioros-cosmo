<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" x:DataType="m:ShellExample"
             a:Page.Title="sidebar-10" a:Page.Description="A sidebar in a popover.">
  <StackPanel Spacing="24">
    <StackPanel Spacing="10">
      <TextBlock Classes="h1" Text="sidebar-10" />
      <TextBlock Classes="lead" Text="A sidebar in a popover." />
    </StackPanel>
    <Border Height="800" CornerRadius="{DynamicResource CosmoRadiusXl}" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" ClipToBounds="True">
      <c:SidebarProvider MobileBreakpoint="0" x:DataType="m:ShellExample">
        <c:SidebarProvider.Styles>
          <Style Selector="c|SidebarMenuAction.start">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="8,6,0,0" />
            <Setter Property="Background" Value="{DynamicResource CosmoSidebarAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource CosmoSidebarAccentForegroundBrush}" />
          </Style>
          <Style Selector="FlyoutPresenter.actions">
            <Setter Property="Width" Value="224" />
            <Setter Property="Padding" Value="0" />
          </Style>
        </c:SidebarProvider.Styles>
        <c:Sidebar Classes="borderless">
          <c:SidebarHeader>
            <c:SidebarMenu>
              <c:SidebarMenuItem>
                <c:SidebarMenuButton Padding="6,6" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="20" Height="20" CornerRadius="{DynamicResource CosmoRadiusMd}" Background="{DynamicResource CosmoSidebarPrimaryBrush}"><Panel><Viewbox Width="12" Height="12" IsVisible="{Binding ShowsGallery}"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarPrimaryForegroundBrush}" Data="M7 2h10 M5 6h14 M5,10 L19,10 A2,2 0 0 1 21,12 L21,20 A2,2 0 0 1 19,22 L5,22 A2,2 0 0 1 3,20 L3,12 A2,2 0 0 1 5,10 Z" /></Viewbox><Viewbox Width="12" Height="12" IsVisible="{Binding ShowsWaveform}"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarPrimaryForegroundBrush}" Data="M2 13a2 2 0 0 0 2-2V7a2 2 0 0 1 4 0v13a2 2 0 0 0 4 0V4a2 2 0 0 1 4 0v13a2 2 0 0 0 4 0v-4a2 2 0 0 1 2-2" /></Viewbox><Viewbox Width="12" Height="12" IsVisible="{Binding ShowsCommand}"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarPrimaryForegroundBrush}" Data="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3" /></Viewbox></Panel></Border>
                    <TextBlock Text="{Binding ActiveTeam.Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Viewbox Width="16" Height="16" Opacity="0.5" VerticalAlignment="Center"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M6 9 l6 6 6-6" /></Viewbox>
                  </StackPanel>
                  <c:SidebarMenuButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                      <MenuItem Classes="label" Header="Teams" />
                      <MenuItem Header="Acme Inc" InputGesture="Ctrl+D1" Command="{Binding SelectTeam}" CommandParameter="Acme Inc" />
                      <MenuItem Header="Acme Corp." InputGesture="Ctrl+D2" Command="{Binding SelectTeam}" CommandParameter="Acme Corp." />
                      <MenuItem Header="Evil Corp." InputGesture="Ctrl+D3" Command="{Binding SelectTeam}" CommandParameter="Evil Corp." />
                      <Separator />
                      <MenuItem Header="Add team"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M5 12h14 M12 5v14" /></Viewbox></MenuItem.Icon></MenuItem>
                    </MenuFlyout>
                  </c:SidebarMenuButton.Flyout>
                </c:SidebarMenuButton>
              </c:SidebarMenuItem>
            </c:SidebarMenu>
            <c:SidebarMenu>
              <c:SidebarMenuItem><c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M3,11 A8,8 0 1 1 19,11 A8,8 0 1 1 3,11 Z M21 21 l-4.3-4.3" /></Viewbox><TextBlock Text="Search" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
              <c:SidebarMenuItem><c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z M20 3v4 M22 5h-4 M4 17v2 M5 18H3" /></Viewbox><TextBlock Text="Ask AI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
              <c:SidebarMenuItem><c:SidebarMenuButton IsActive="True"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8 M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /></Viewbox><TextBlock Text="Home" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
              <c:SidebarMenuItem><c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M22,12 L16,12 L14,15 L10,15 L8,12 L2,12 M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" /></Viewbox><TextBlock Text="Inbox" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
            </c:SidebarMenu>
          </c:SidebarHeader>
          <c:SidebarContent>
            <c:SidebarContent.ItemsPanel><ItemsPanelTemplate><DockPanel LastChildFill="False" VerticalSpacing="8" /></ItemsPanelTemplate></c:SidebarContent.ItemsPanel>
            <c:SidebarGroup DockPanel.Dock="Top" Classes="icon-hidden">
              <c:SidebarGroupLabel Content="Favorites" />
              <c:SidebarMenu>
                <c:SidebarMenuItem>
                  <c:SidebarMenuButton ToolTip.Tip="Project Management &amp; Task Tracking"><DockPanel><TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" Text="📊" /><TextBlock Text="Project Management &amp; Task Tracking" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                  <c:SidebarMenuAction Classes="show-on-hover" AutomationProperties.Name="More">
                    <Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M11,12 A1,1 0 1 1 13,12 A1,1 0 1 1 11,12 Z M18,12 A1,1 0 1 1 20,12 A1,1 0 1 1 18,12 Z M4,12 A1,1 0 1 1 6,12 A1,1 0 1 1 4,12 Z" /></Viewbox>
                    <c:SidebarMenuAction.Flyout>
                      <MenuFlyout Placement="RightEdgeAlignedTop">
                        <MenuItem Header="Remove from Favorites"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M8.34 8.34 2 9.27l5 4.87L5.82 21 12 17.77 18.18 21l-.59-3.43 M18.42 12.76 22 9.27l-6.91-1L12 2l-1.44 2.91 M2,2 L22,22" /></Viewbox></MenuItem.Icon></MenuItem>
                        <Separator />
                        <MenuItem Header="Copy Link"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></Viewbox></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Open in New Tab"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M7 7h10v10 M7 17 17 7" /></Viewbox></MenuItem.Icon></MenuItem>
                        <Separator />
                        <MenuItem Header="Delete"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M3 6h18 M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6 M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2 M10,11 L10,17 M14,11 L14,17" /></Viewbox></MenuItem.Icon></MenuItem>
                      </MenuFlyout>
                    </c:SidebarMenuAction.Flyout>
                  </c:SidebarMenuAction>
                </c:SidebarMenuItem>
                <c:SidebarMenuItem>
                  <c:SidebarMenuButton ToolTip.Tip="Family Recipe Collection &amp; Meal Planning"><DockPanel><TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" Text="🍳" /><TextBlock Text="Family Recipe Collection &amp; Meal Planning" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                  <c:SidebarMenuAction Classes="show-on-hover" AutomationProperties.Name="More">
                    <Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M11,12 A1,1 0 1 1 13,12 A1,1 0 1 1 11,12 Z M18,12 A1,1 0 1 1 20,12 A1,1 0 1 1 18,12 Z M4,12 A1,1 0 1 1 6,12 A1,1 0 1 1 4,12 Z" /></Viewbox>
                    <c:SidebarMenuAction.Flyout>
                      <MenuFlyout Placement="RightEdgeAlignedTop">
                        <MenuItem Header="Remove from Favorites"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M8.34 8.34 2 9.27l5 4.87L5.82 21 12 17.77 18.18 21l-.59-3.43 M18.42 12.76 22 9.27l-6.91-1L12 2l-1.44 2.91 M2,2 L22,22" /></Viewbox></MenuItem.Icon></MenuItem>
                        <Separator />
                        <MenuItem Header="Copy Link"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></Viewbox></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Open in New Tab"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M7 7h10v10 M7 17 17 7" /></Viewbox></MenuItem.Icon></MenuItem>
                        <Separator />
                        <MenuItem Header="Delete"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M3 6h18 M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6 M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2 M10,11 L10,17 M14,11 L14,17" /></Viewbox></MenuItem.Icon></MenuItem>
                      </MenuFlyout>
                    </c:SidebarMenuAction.Flyout>
                  </c:SidebarMenuAction>
                </c:SidebarMenuItem>
                <c:SidebarMenuItem>
                  <c:SidebarMenuButton ToolTip.Tip="Fitness Tracker &amp; Workout Routines"><DockPanel><TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" Text="💪" /><TextBlock Text="Fitness Tracker &amp; Workout Routines" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                  <c:SidebarMenuAction Classes="show-on-hover" AutomationProperties.Name="More">
                    <Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M11,12 A1,1 0 1 1 13,12 A1,1 0 1 1 11,12 Z M18,12 A1,1 0 1 1 20,12 A1,1 0 1 1 18,12 Z M4,12 A1,1 0 1 1 6,12 A1,1 0 1 1 4,12 Z" /></Viewbox>
                    <c:SidebarMenuAction.Flyout>
