<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" xmlns:p="https://aioros.dev/pictor" x:DataType="m:DashboardBlock"
             a:Page.Title="dashboard-01" a:Page.Description="A dashboard with sidebar, charts and data table.">
  <StackPanel Spacing="24">
    <StackPanel Spacing="10">
      <TextBlock Classes="h1" Text="dashboard-01" />
      <TextBlock Classes="lead" Text="A dashboard with sidebar, charts and data table." />
    </StackPanel>
    <Border Height="800" CornerRadius="{DynamicResource CosmoRadiusXl}" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" ClipToBounds="True">
      <Panel x:DataType="m:DashboardBlock" c:OverlayHost.IsHost="True">
        <Panel.Resources>
          <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
              <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="DashboardDoneBrush" Color="#00C950" /></ResourceDictionary>
              <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="DashboardDoneBrush" Color="#05DF72" /></ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <c:ChartConfig x:Key="VisitorsConfig"><c:ChartConfigItem Key="Visitors" Label="Visitors" /><c:ChartConfigItem Key="Desktop" Label="Desktop" Color="PictorPrimary" /><c:ChartConfigItem Key="Mobile" Label="Mobile" Color="PictorPrimary" /></c:ChartConfig>
          </ResourceDictionary>
        </Panel.Resources>
        <Panel.Styles>
          <Style Selector="c|SidebarMenuButton.quick">
            <Setter Property="Background" Value="{DynamicResource CosmoPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource CosmoPrimaryForegroundBrush}" />
            <Setter Property="MinWidth" Value="32" />
          </Style>
          <Style Selector="c|SidebarMenuButton.quick:pointerover, c|SidebarMenuButton.quick:pressed">
            <Setter Property="Background" Value="{DynamicResource CosmoButtonPrimaryHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource CosmoPrimaryForegroundBrush}" />
          </Style>
          <Style Selector="c|Card.section">
            <Setter Property="Background">
              <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                <GradientStop Offset="0" Color="{DynamicResource CosmoSectionCardBottomColor}" />
                <GradientStop Offset="1" Color="{DynamicResource CosmoSectionCardTopColor}" />
              </LinearGradientBrush>
            </Setter>
          </Style>
          <Style Selector="ListBox.toggle-group.range > ListBoxItem">
            <Setter Property="Padding" Value="16,0" />
          </Style>
          <Style Selector="TextBox.cell">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Width" Value="64" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
          </Style>
          <Style Selector="TextBox.cell /template/ Border#PART_BorderElement">
            <Setter Property="BoxShadow" Value="none" />
          </Style>
          <Style Selector="TextBox.cell:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource CosmoInputHoverBackgroundBrush}" />
          </Style>
          <Style Selector="c|Badge.cell">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
          </Style>
          <Style Selector="c|Badge.count">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="CornerRadius" Value="9999" />
            <Setter Property="Background" Value="{DynamicResource CosmoMutedForegroundThirdBrush}" />
          </Style>
        </Panel.Styles>
        <c:SidebarProvider MobileBreakpoint="0">
          <c:Sidebar Variant="Inset" ExpandedWidth="288">
            <c:SidebarHeader>
              <c:SidebarMenu>
                <c:SidebarMenuItem>
                  <c:SidebarMenuButton Padding="6"><DockPanel><Viewbox Width="20" Height="20" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M5.636 5.636a9 9 0 1 0 12.728 12.728a9 9 0 0 0 -12.728 -12.728 M16.243 7.757a6 6 0 0 0 -8.486 0" /></Viewbox><TextBlock Text="Acme Inc." FontSize="16" LineHeight="24" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel></c:SidebarMenuButton>
                </c:SidebarMenuItem>
              </c:SidebarMenu>
            </c:SidebarHeader>
            <c:SidebarContent>
              <c:SidebarContent.ItemsPanel><ItemsPanelTemplate><DockPanel LastChildFill="False" VerticalSpacing="8" /></ItemsPanelTemplate></c:SidebarContent.ItemsPanel>
              <c:SidebarGroup DockPanel.Dock="Top">
                <StackPanel Spacing="8">
                  <c:SidebarMenu>
                    <c:SidebarMenuItem>
                      <DockPanel>
                        <Button Classes="outline icon" Width="32" Height="32" Margin="8,0,0,0" DockPanel.Dock="Right" AutomationProperties.Name="Inbox"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10 M3 7l9 6l9 -6" /></Viewbox></Button>
                        <c:SidebarMenuButton Classes="quick" Tooltip="Quick Create"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Fill="{DynamicResource CosmoPrimaryForegroundBrush}" StrokeThickness="0" Data="M4.929 4.929a10 10 0 1 1 14.141 14.141a10 10 0 0 1 -14.14 -14.14m8.071 4.071a1 1 0 1 0 -2 0v2h-2a1 1 0 1 0 0 2h2v2a1 1 0 1 0 2 0v-2h2a1 1 0 1 0 0 -2h-2v-2z" /></Viewbox><TextBlock Text="Quick Create" VerticalAlignment="Center" /></DockPanel></c:SidebarMenuButton>
                      </DockPanel>
                    </c:SidebarMenuItem>
                  </c:SidebarMenu>
                  <c:SidebarMenu>
                    <c:SidebarMenuItem><c:SidebarMenuButton Tooltip="Dashboard"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M10 13a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M13.45 11.55l2.05 -2.05 M6.4 20a9 9 0 1 1 11.2 0l-11.2 0" /></Viewbox><TextBlock Text="Dashboard" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
                    <c:SidebarMenuItem><c:SidebarMenuButton Tooltip="Lifecycle"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M13 5h8 M13 9h5 M13 15h8 M13 19h5 M3 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4 M3 15a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4" /></Viewbox><TextBlock Text="Lifecycle" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
                    <c:SidebarMenuItem><c:SidebarMenuButton Tooltip="Analytics"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M3 13a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v6a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -6 M15 9a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -10 M9 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -14 M4 20h14" /></Viewbox><TextBlock Text="Analytics" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
                    <c:SidebarMenuItem><c:SidebarMenuButton Tooltip="Projects"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2" /></Viewbox><TextBlock Text="Projects" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
                    <c:SidebarMenuItem><c:SidebarMenuButton Tooltip="Team"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M5 7a4 4 0 1 0 8 0a4 4 0 1 0 -8 0 M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2 M16 3.13a4 4 0 0 1 0 7.75 M21 21v-2a4 4 0 0 0 -3 -3.85" /></Viewbox><TextBlock Text="Team" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
                  </c:SidebarMenu>
                </StackPanel>
              </c:SidebarGroup>
              <c:SidebarGroup DockPanel.Dock="Top" Classes="icon-hidden">
                <c:SidebarGroupLabel Content="Documents" />
                <c:SidebarMenu>
                  <c:SidebarMenuItem>
                    <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M4 6a8 3 0 1 0 16 0a8 3 0 1 0 -16 0 M4 6v6a8 3 0 0 0 16 0v-6 M4 12v6a8 3 0 0 0 16 0v-6" /></Viewbox><TextBlock Text="Data Library" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                    <c:SidebarMenuAction Classes="show-on-hover" AutomationProperties.Name="More">
                      <Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M4 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M18 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /></Viewbox>
                      <c:SidebarMenuAction.Flyout>
                        <MenuFlyout Placement="RightEdgeAlignedTop">
                          <MenuItem Header="Open"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2" /></Viewbox></MenuItem.Icon></MenuItem>
                          <MenuItem Header="Share"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M13 4v4c-6.575 1.028 -9.02 6.788 -10 12c-.037 .206 5.384 -5.962 10 -6v4l8 -7l-8 -7" /></Viewbox></MenuItem.Icon></MenuItem>
                          <Separator />
                          <MenuItem Header="Delete" Classes="destructive"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoDestructiveBrush}" Data="M4 7l16 0 M10 11l0 6 M14 11l0 6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" /></Viewbox></MenuItem.Icon></MenuItem>
                        </MenuFlyout>
                      </c:SidebarMenuAction.Flyout>
                    </c:SidebarMenuAction>
                  </c:SidebarMenuItem>
                  <c:SidebarMenuItem>
                    <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M8 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h5.697 M18 14v4h4 M18 11v-4a2 2 0 0 0 -2 -2h-2 M8 5a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2 M14 18a4 4 0 1 0 8 0a4 4 0 1 0 -8 0 M8 11h4 M8 15h3" /></Viewbox><TextBlock Text="Reports" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                    <c:SidebarMenuAction Classes="show-on-hover" AutomationProperties.Name="More">
                      <Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M4 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M18 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /></Viewbox>
                      <c:SidebarMenuAction.Flyout>
                        <MenuFlyout Placement="RightEdgeAlignedTop">
                          <MenuItem Header="Open"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2" /></Viewbox></MenuItem.Icon></MenuItem>
                          <MenuItem Header="Share"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M13 4v4c-6.575 1.028 -9.02 6.788 -10 12c-.037 .206 5.384 -5.962 10 -6v4l8 -7l-8 -7" /></Viewbox></MenuItem.Icon></MenuItem>
                          <Separator />
                          <MenuItem Header="Delete" Classes="destructive"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoDestructiveBrush}" Data="M4 7l16 0 M10 11l0 6 M14 11l0 6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" /></Viewbox></MenuItem.Icon></MenuItem>
                        </MenuFlyout>
                      </c:SidebarMenuAction.Flyout>
                    </c:SidebarMenuAction>
                  </c:SidebarMenuItem>
                  <c:SidebarMenuItem>
                    <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M14 3v4a1 1 0 0 0 1 1h4 M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2 M9 12l1.333 5l1.667 -4l1.667 4l1.333 -5" /></Viewbox><TextBlock Text="Word Assistant" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                    <c:SidebarMenuAction Classes="show-on-hover" AutomationProperties.Name="More">
                      <Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M4 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M18 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /></Viewbox>
                      <c:SidebarMenuAction.Flyout>
                        <MenuFlyout Placement="RightEdgeAlignedTop">
                          <MenuItem Header="Open"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2" /></Viewbox></MenuItem.Icon></MenuItem>
                          <MenuItem Header="Share"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M13 4v4c-6.575 1.028 -9.02 6.788 -10 12c-.037 .206 5.384 -5.962 10 -6v4l8 -7l-8 -7" /></Viewbox></MenuItem.Icon></MenuItem>
                          <Separator />
                          <MenuItem Header="Delete" Classes="destructive"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoDestructiveBrush}" Data="M4 7l16 0 M10 11l0 6 M14 11l0 6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" /></Viewbox></MenuItem.Icon></MenuItem>
                        </MenuFlyout>
                      </c:SidebarMenuAction.Flyout>
                    </c:SidebarMenuAction>
                  </c:SidebarMenuItem>
                  <c:SidebarMenuItem><c:SidebarMenuButton Opacity="0.7"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M4 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M18 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /></Viewbox><TextBlock Text="More" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
                </c:SidebarMenu>
              </c:SidebarGroup>
              <c:SidebarGroup DockPanel.Dock="Bottom">
                <c:SidebarMenu>
                  <c:SidebarMenuItem>
                    <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065 M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" /></Viewbox><TextBlock Text="Settings" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                  </c:SidebarMenuItem>
                  <c:SidebarMenuItem>
                    <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M12 17l0 .01 M12 13.5a1.5 1.5 0 0 1 1 -1.5a2.6 2.6 0 1 0 -3 -4" /></Viewbox><TextBlock Text="Get Help" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                  </c:SidebarMenuItem>
                  <c:SidebarMenuItem>
                    <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0 M21 21l-6 -6" /></Viewbox><TextBlock Text="Search" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                  </c:SidebarMenuItem>
                </c:SidebarMenu>
              </c:SidebarGroup>
            </c:SidebarContent>
            <c:SidebarFooter>
              <c:SidebarMenu>
                <c:SidebarMenuItem>
                  <c:SidebarMenuButton Classes="lg" Tooltip="shadcn">
                    <DockPanel>
                      <Viewbox Width="16" Height="16" DockPanel.Dock="Right" Margin="8,0,0,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M11 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M11 5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /></Viewbox>
                      <c:Avatar Width="32" Height="32" Content="CN" CornerRadius="{DynamicResource CosmoRadiusLg}" />
                      <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="shadcn" FontWeight="Medium" LineHeight="17.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="m@example.com" FontSize="12" LineHeight="15" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                    <c:SidebarMenuButton.Flyout>
                      <MenuFlyout Placement="RightEdgeAlignedBottom">
                        <MenuItem Classes="label">
                          <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <c:Avatar Width="32" Height="32" Content="CN" CornerRadius="{DynamicResource CosmoRadiusLg}" />
                              <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="shadcn" FontWeight="Medium" FontSize="14" LineHeight="17.5" />
                                <TextBlock Text="m@example.com" FontWeight="Normal" FontSize="12" LineHeight="15" />
                              </StackPanel>
                            </StackPanel>
                          </MenuItem.Header>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Account"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M9 10a3 3 0 1 0 6 0a3 3 0 1 0 -6 0 M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855" /></Viewbox></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Billing"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M3 8a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3l0 -8 M3 10l18 0 M7 15l.01 0 M11 15l2 0" /></Viewbox></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Notifications"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M10 6h-3a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-3 M14 7a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" /></Viewbox></MenuItem.Icon></MenuItem>
                        <Separator />
                        <MenuItem Header="Log out"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M14 8v-2a2 2 0 0 0 -2 -2h-7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2 -2v-2 M9 12h12l-3 -3 M18 15l3 -3" /></Viewbox></MenuItem.Icon></MenuItem>
                      </MenuFlyout>
                    </c:SidebarMenuButton.Flyout>
                  </c:SidebarMenuButton>
                </c:SidebarMenuItem>
              </c:SidebarMenu>
            </c:SidebarFooter>
          </c:Sidebar>
          <c:SidebarInset>
            <DockPanel>
              <Border DockPanel.Dock="Top" Height="48" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CosmoBorderBrush}">
                <DockPanel Margin="24,0">
                  <HyperlinkButton DockPanel.Dock="Right" Classes="ghost sm" Content="GitHub" NavigateUri="https://github.com/shadcn-ui/ui/tree/main/apps/v4/app/(examples)/dashboard" VerticalAlignment="Center" />
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <c:SidebarTrigger Margin="-4,0,0,0" VerticalAlignment="Center" />
                    <Separator Classes="vertical" Height="16" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Documents" FontSize="16" LineHeight="24" FontWeight="Medium" VerticalAlignment="Center" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <ScrollViewer Theme="{DynamicResource CosmoScrollArea}" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="24" Margin="0,24">
                  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16" Margin="24,0">
                    <c:Card Classes="section" Grid.Row="0" Grid.Column="0">
                      <c:CardHeader>
                        <c:CardHeader.Title>
                          <StackPanel Spacing="8">
                            <TextBlock Text="Total Revenue" FontSize="14" LineHeight="20" FontWeight="Normal" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                            <TextBlock Text="$1,250.00" FontSize="30" LineHeight="36" FontWeight="SemiBold" FontFeatures="+tnum" />
                          </StackPanel>
                        </c:CardHeader.Title>
                        <c:CardHeader.Action><c:Badge Classes="outline"><StackPanel><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 17l6 -6l4 4l8 -8 M14 7l7 0l0 7" /></Viewbox><TextBlock Text="+12.5%" /></StackPanel></c:Badge></c:CardHeader.Action>
                      </c:CardHeader>
                      <c:CardFooter>
                        <StackPanel Spacing="6">
                          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Trending up this month" FontSize="14" LineHeight="20" FontWeight="Medium" /><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 17l6 -6l4 4l8 -8 M14 7l7 0l0 7" /></Viewbox></StackPanel>
                          <TextBlock Text="Visitors for the last 6 months" FontSize="14" LineHeight="20" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                        </StackPanel>
                      </c:CardFooter>
                    </c:Card>
                    <c:Card Classes="section" Grid.Row="0" Grid.Column="1">
                      <c:CardHeader>
                        <c:CardHeader.Title>
                          <StackPanel Spacing="8">
                            <TextBlock Text="New Customers" FontSize="14" LineHeight="20" FontWeight="Normal" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                            <TextBlock Text="1,234" FontSize="30" LineHeight="36" FontWeight="SemiBold" FontFeatures="+tnum" />
                          </StackPanel>
                        </c:CardHeader.Title>
                        <c:CardHeader.Action><c:Badge Classes="outline"><StackPanel><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 7l6 6l4 -4l8 8 M21 10l0 7l-7 0" /></Viewbox><TextBlock Text="-20%" /></StackPanel></c:Badge></c:CardHeader.Action>
                      </c:CardHeader>
                      <c:CardFooter>
                        <StackPanel Spacing="6">
                          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Down 20% this period" FontSize="14" LineHeight="20" FontWeight="Medium" /><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 7l6 6l4 -4l8 8 M21 10l0 7l-7 0" /></Viewbox></StackPanel>
                          <TextBlock Text="Acquisition needs attention" FontSize="14" LineHeight="20" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                        </StackPanel>
                      </c:CardFooter>
                    </c:Card>
                    <c:Card Classes="section" Grid.Row="1" Grid.Column="0">
                      <c:CardHeader>
                        <c:CardHeader.Title>
                          <StackPanel Spacing="8">
                            <TextBlock Text="Active Accounts" FontSize="14" LineHeight="20" FontWeight="Normal" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                            <TextBlock Text="45,678" FontSize="30" LineHeight="36" FontWeight="SemiBold" FontFeatures="+tnum" />
                          </StackPanel>
                        </c:CardHeader.Title>
                        <c:CardHeader.Action><c:Badge Classes="outline"><StackPanel><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 17l6 -6l4 4l8 -8 M14 7l7 0l0 7" /></Viewbox><TextBlock Text="+12.5%" /></StackPanel></c:Badge></c:CardHeader.Action>
                      </c:CardHeader>
                      <c:CardFooter>
                        <StackPanel Spacing="6">
                          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Strong user retention" FontSize="14" LineHeight="20" FontWeight="Medium" /><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 17l6 -6l4 4l8 -8 M14 7l7 0l0 7" /></Viewbox></StackPanel>
                          <TextBlock Text="Engagement exceed targets" FontSize="14" LineHeight="20" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                        </StackPanel>
                      </c:CardFooter>
                    </c:Card>
                    <c:Card Classes="section" Grid.Row="1" Grid.Column="1">
                      <c:CardHeader>
                        <c:CardHeader.Title>
                          <StackPanel Spacing="8">
                            <TextBlock Text="Growth Rate" FontSize="14" LineHeight="20" FontWeight="Normal" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                            <TextBlock Text="4.5%" FontSize="30" LineHeight="36" FontWeight="SemiBold" FontFeatures="+tnum" />
                          </StackPanel>
                        </c:CardHeader.Title>
                        <c:CardHeader.Action><c:Badge Classes="outline"><StackPanel><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 17l6 -6l4 4l8 -8 M14 7l7 0l0 7" /></Viewbox><TextBlock Text="+4.5%" /></StackPanel></c:Badge></c:CardHeader.Action>
                      </c:CardHeader>
                      <c:CardFooter>
                        <StackPanel Spacing="6">
                          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Steady performance increase" FontSize="14" LineHeight="20" FontWeight="Medium" /><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 17l6 -6l4 4l8 -8 M14 7l7 0l0 7" /></Viewbox></StackPanel>
                          <TextBlock Text="Meets growth projections" FontSize="14" LineHeight="20" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                        </StackPanel>
                      </c:CardFooter>
                    </c:Card>
                  </Grid>
                  <c:Card Margin="24,0">
                    <c:CardHeader Title="Total Visitors" Description="Total for the last 3 months">
                      <c:CardHeader.Action>
                        <ListBox Classes="toggle-group outline range" SelectionMode="Single,AlwaysSelected" SelectedIndex="{Binding Visitors.TimeRange}" AutomationProperties.Name="Time range">
                          <ListBoxItem Content="Last 3 months" />
                          <ListBoxItem Content="Last 30 days" />
                          <ListBoxItem Content="Last 7 days" />
                        </ListBox>
                      </c:CardHeader.Action>
                    </c:CardHeader>
                    <c:CardContent Padding="24,24,24,0">
                      <p:AreaChart c:ChartConfig.Config="{StaticResource VisitorsConfig}" Data="{Binding Visitors.Range}" Height="250" Margin="0,0,0,0">
                        <p:CartesianGrid Vertical="False" />
                        <p:XAxis DataKey="Date" TickLine="False" AxisLine="False" TickMargin="8" MinTickGap="32" TickFormat="{}{0:MMM d}" />
                        <p:Tooltip Cursor="False" LabelFormat="{}{0:MMM d}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent Indicator="Dot" /></p:Tooltip.ContentTemplate></p:Tooltip>
                        <p:Area DataKey="Mobile" Type="Natural" StackId="a" IsAnimationActive="False">
                          <p:Area.Fill>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                              <GradientStop Offset="0.05" Color="{DynamicResource CosmoPrimaryTopColor}" />
                              <GradientStop Offset="0.95" Color="{DynamicResource CosmoPrimaryBottomColor}" />
                            </LinearGradientBrush>
                          </p:Area.Fill>
                        </p:Area>
                        <p:Area DataKey="Desktop" Type="Natural" StackId="a" IsAnimationActive="False">
                          <p:Area.Fill>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                              <GradientStop Offset="0.05" Color="{DynamicResource CosmoPrimaryColor}" />
                              <GradientStop Offset="0.95" Color="{DynamicResource CosmoPrimaryBottomColor}" />
                            </LinearGradientBrush>
                          </p:Area.Fill>
                        </p:Area>
                      </p:AreaChart>
                    </c:CardContent>
                  </c:Card>
                  <Panel Margin="24,0">
                    <TabControl SelectedIndex="{Binding Tab}">
                      <TabItem><TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Outline" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                        <StackPanel Spacing="16">
                          <Border BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" CornerRadius="{DynamicResource CosmoRadiusLg}" ClipToBounds="True" a:Drag.Target="sections" a:Drag.Command="{Binding Move}">
                            <TableView Classes="muted-header" ItemsSource="{Binding Sections.Rows}" c:DataTable.SelectsRows="True" c:DataTable.State="{Binding Sections.State}">
                              <TableView.Columns>
                                <TableViewColumn Width="44">
                                  <TableViewColumn.Header></TableViewColumn.Header>
                                  <TableViewColumn.CellTemplate>
                                    <DataTemplate x:DataType="m:DashboardSection"><Border Classes="grip" Width="28" Height="28" CornerRadius="{DynamicResource CosmoRadiusMd}" Background="Transparent" HorizontalAlignment="Left" a:Drag.Item="{Binding Id}" AutomationProperties.Name="Drag to reorder"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M8 5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M8 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M8 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M14 5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M14 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M14 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /></Viewbox></Border></DataTemplate>
                                  </TableViewColumn.CellTemplate>
                                </TableViewColumn>
                                <TableViewColumn Width="24">
                                  <TableViewColumn.Header><CheckBox IsChecked="{Binding Sections.AllPageRowsSelected}" HorizontalAlignment="Center" AutomationProperties.Name="Select all" /></TableViewColumn.Header>
                                  <TableViewColumn.CellTemplate>
                                    <DataTemplate x:DataType="m:DashboardSection"><CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" AutomationProperties.Name="Select row" /></DataTemplate>
                                  </TableViewColumn.CellTemplate>
                                </TableViewColumn>
                                <TableViewColumn Width="306.27">
                                  <TableViewColumn.Header>Header</TableViewColumn.Header>
                                  <TableViewColumn.CellTemplate>
                                    <DataTemplate x:DataType="m:DashboardSection"><Button Classes="link" Padding="0" Content="{Binding Header}" Foreground="{DynamicResource CosmoForegroundBrush}" Command="{Binding View}" /></DataTemplate>
                                  </TableViewColumn.CellTemplate>
                                </TableViewColumn>
                                <TableViewColumn Width="144" IsVisible="{Binding Sections.Columns[3].IsVisible}">
                                  <TableViewColumn.Header>Section Type</TableViewColumn.Header>
                                  <TableViewColumn.CellTemplate>
                                    <DataTemplate x:DataType="m:DashboardSection"><Border Width="128" HorizontalAlignment="Left"><c:Badge Classes="outline cell" Content="{Binding Type}" HorizontalAlignment="Left" /></Border></DataTemplate>
                                  </TableViewColumn.CellTemplate>
                                </TableViewColumn>
                                <TableViewColumn Width="105.06" IsVisible="{Binding Sections.Columns[4].IsVisible}">
                                  <TableViewColumn.Header>Status</TableViewColumn.Header>
                                  <TableViewColumn.CellTemplate>
                                    <DataTemplate x:DataType="m:DashboardSection"><c:Badge Classes="outline cell"><StackPanel><Panel><Viewbox Width="16" Height="16" IsVisible="{Binding IsDone}"><Path Theme="{DynamicResource CosmoIcon}" Fill="{DynamicResource DashboardDoneBrush}" StrokeThickness="0" Data="M17 3.34a10 10 0 1 1 -14.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 14.995 -8.336zm-1.293 5.953a1 1 0 0 0 -1.32 -.083l-.094 .083l-3.293 3.292l-1.293 -1.292l-.094 -.083a1 1 0 0 0 -1.403 1.403l.083 .094l2 2l.094 .083a1 1 0 0 0 1.226 0l.094 -.083l4 -4l.083 -.094a1 1 0 0 0 -.083 -1.32z" /></Viewbox><Viewbox Width="16" Height="16" IsVisible="{Binding !IsDone}"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M12 6l0 -3 M16.25 7.75l2.15 -2.15 M18 12l3 0 M16.25 16.25l2.15 2.15 M12 18l0 3 M7.75 16.25l-2.15 2.15 M6 12l-3 0 M7.75 7.75l-2.15 -2.15" /></Viewbox></Panel><TextBlock Text="{Binding Status}" /></StackPanel></c:Badge></DataTemplate>
                                  </TableViewColumn.CellTemplate>
                                </TableViewColumn>
                                <TableViewColumn Width="80" IsVisible="{Binding Sections.Columns[5].IsVisible}" HorizontalContentAlignment="Stretch">
                                  <TableViewColumn.Header><TextBlock Text="Target" HorizontalAlignment="Right" /></TableViewColumn.Header>
                                  <TableViewColumn.CellTemplate>
                                    <DataTemplate x:DataType="m:DashboardSection"><TextBox Classes="cell" Text="{Binding Target}" AutomationProperties.Name="Target" /></DataTemplate>
                                  </TableViewColumn.CellTemplate>
                                </TableViewColumn>
                                <TableViewColumn Width="80" IsVisible="{Binding Sections.Columns[6].IsVisible}" HorizontalContentAlignment="Stretch">
                                  <TableViewColumn.Header><TextBlock Text="Limit" HorizontalAlignment="Right" /></TableViewColumn.Header>
                                  <TableViewColumn.CellTemplate>
                                    <DataTemplate x:DataType="m:DashboardSection"><TextBox Classes="cell" Text="{Binding Limit}" AutomationProperties.Name="Limit" /></DataTemplate>
                                  </TableViewColumn.CellTemplate>
                                </TableViewColumn>
                                <TableViewColumn Width="168" IsVisible="{Binding Sections.Columns[7].IsVisible}">
                                  <TableViewColumn.Header>Reviewer</TableViewColumn.Header>
                                  <TableViewColumn.CellTemplate>
                                    <DataTemplate x:DataType="m:DashboardSection"><Panel>
                                  <TextBlock Text="{Binding Reviewer}" IsVisible="{Binding IsAssigned}" VerticalAlignment="Center" />
                                  <ComboBox Classes="sm" Width="152" PlaceholderText="Assign reviewer" SelectedItem="{Binding Assignee}" IsVisible="{Binding !IsAssigned}" AutomationProperties.Name="Reviewer">
                                    <x:String>Eddie Lake</x:String>
                                    <x:String>Jamik Tashpulatov</x:String>
                                  </ComboBox>
                                </Panel></DataTemplate>
                                  </TableViewColumn.CellTemplate>
                                </TableViewColumn>
                                <TableViewColumn Width="48">
                                  <TableViewColumn.Header></TableViewColumn.Header>
                                  <TableViewColumn.CellTemplate>
                                    <DataTemplate x:DataType="m:DashboardSection"><Button Classes="ghost icon" Width="32" Height="32" HorizontalAlignment="Left" AutomationProperties.Name="Open menu"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M11 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M11 5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /></Viewbox>
                                <Button.Flyout>
                                  <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="w-32">
                                    <MenuItem Header="Edit" />
                                    <MenuItem Header="Make a copy" />
                                    <MenuItem Header="Favorite" />
                                    <Separator />
                                    <MenuItem Header="Delete" Classes="destructive" />
                                  </MenuFlyout>
                                </Button.Flyout></Button></DataTemplate>
                                  </TableViewColumn.CellTemplate>
                                </TableViewColumn>
                              </TableView.Columns>
                            </TableView>
                          </Border>
                          <DockPanel Margin="16,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="32">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <Label Content="Rows per page" Target="{Binding #rows}" VerticalAlignment="Center" />
                                <ComboBox Name="rows" Classes="sm" Width="80" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding Sections.PageSize}" />
                              </StackPanel>
                              <TextBlock FontSize="14" LineHeight="20" FontWeight="Medium" VerticalAlignment="Center">
                                <TextBlock.Text><MultiBinding StringFormat="Page {0} of {1}"><Binding Path="Sections.PageNumber" /><Binding Path="Sections.PageCount" /></MultiBinding></TextBlock.Text>
                              </TextBlock>
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="outline icon" Width="32" Height="32" Command="{Binding Sections.FirstPageCommand}" AutomationProperties.Name="Go to first page"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M11 7l-5 5l5 5 M17 7l-5 5l5 5" /></Viewbox></Button>
                                <Button Classes="outline icon" Width="32" Height="32" Command="{Binding Sections.PreviousPageCommand}" AutomationProperties.Name="Go to previous page"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M15 6l-6 6l6 6" /></Viewbox></Button>
                                <Button Classes="outline icon" Width="32" Height="32" Command="{Binding Sections.NextPageCommand}" AutomationProperties.Name="Go to next page"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M9 6l6 6l-6 6" /></Viewbox></Button>
                                <Button Classes="outline icon" Width="32" Height="32" Command="{Binding Sections.LastPageCommand}" AutomationProperties.Name="Go to last page"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M7 7l5 5l-5 5 M13 7l5 5l-5 5" /></Viewbox></Button>
                              </StackPanel>
                            </StackPanel>
                            <TextBlock FontSize="14" LineHeight="20" VerticalAlignment="Center" Foreground="{DynamicResource CosmoMutedForegroundBrush}">
                              <TextBlock.Text><MultiBinding StringFormat="{}{0} of {1} row(s) selected."><Binding Path="Sections.SelectedCount" /><Binding Path="Sections.FilteredCount" /></MultiBinding></TextBlock.Text>
                            </TextBlock>
                          </DockPanel>
                        </StackPanel>
                      </TabItem>
                      <TabItem><TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Past Performance" VerticalAlignment="Center" /><c:Badge Classes="secondary count" Content="3" /></StackPanel></TabItem.Header><c:AspectRatio Ratio="1.7778"><Rectangle Stroke="{DynamicResource CosmoBorderBrush}" StrokeThickness="1" StrokeDashArray="3,3" RadiusX="8" RadiusY="8" /></c:AspectRatio></TabItem>
                      <TabItem><TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Key Personnel" VerticalAlignment="Center" /><c:Badge Classes="secondary count" Content="2" /></StackPanel></TabItem.Header><c:AspectRatio Ratio="1.7778"><Rectangle Stroke="{DynamicResource CosmoBorderBrush}" StrokeThickness="1" StrokeDashArray="3,3" RadiusX="8" RadiusY="8" /></c:AspectRatio></TabItem>
                      <TabItem><TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Focus Documents" VerticalAlignment="Center" /></StackPanel></TabItem.Header><c:AspectRatio Ratio="1.7778"><Rectangle Stroke="{DynamicResource CosmoBorderBrush}" StrokeThickness="1" StrokeDashArray="3,3" RadiusX="8" RadiusY="8" /></c:AspectRatio></TabItem>
                    </TabControl>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                      <Button Classes="outline sm has-icon">
                        <StackPanel><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M4 6a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2l0 -12 M12 4l0 16" /></Viewbox><TextBlock Text="Customize Columns" /><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M6 9l6 6l6 -6" /></Viewbox></StackPanel>
                        <Button.Flyout>
                          <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="w-56">
                      <MenuItem Header="Type" ToggleType="CheckBox" IsChecked="{Binding Sections.Columns[3].IsVisible, Mode=TwoWay}" />
                      <MenuItem Header="Status" ToggleType="CheckBox" IsChecked="{Binding Sections.Columns[4].IsVisible, Mode=TwoWay}" />
                      <MenuItem Header="Target" ToggleType="CheckBox" IsChecked="{Binding Sections.Columns[5].IsVisible, Mode=TwoWay}" />
                      <MenuItem Header="Limit" ToggleType="CheckBox" IsChecked="{Binding Sections.Columns[6].IsVisible, Mode=TwoWay}" />
                      <MenuItem Header="Reviewer" ToggleType="CheckBox" IsChecked="{Binding Sections.Columns[7].IsVisible, Mode=TwoWay}" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                      <Button Classes="outline sm has-icon"><StackPanel><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M12 5l0 14 M5 12l14 0" /></Viewbox><TextBlock Text="Add Section" /></StackPanel></Button>
                    </StackPanel>
                  </Panel>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </c:SidebarInset>
        </c:SidebarProvider>
        <c:Drawer Side="Right" IsOpen="{Binding ViewerOpen}">
          <DockPanel DataContext="{Binding Viewing}" x:DataType="m:DashboardSection">
            <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="16">
              <Button Content="Submit" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" c:Dialog.Closes="True" />
              <Button Classes="outline" Content="Done" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" c:Dialog.Closes="True" />
            </StackPanel>
            <c:DialogHeader DockPanel.Dock="Top" Padding="16" Title="{Binding Header}" Description="Showing total visitors for the last 6 months" />
            <ScrollViewer Theme="{DynamicResource CosmoScrollArea}" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="16" Margin="16,0">
                <p:AreaChart c:ChartConfig.Config="{StaticResource VisitorsConfig}" Data="{Binding Months}" Height="200" Padding="0,0,10,0">
                  <p:CartesianGrid Vertical="False" />
                  <p:XAxis DataKey="Month" Hide="True" />
                  <p:Tooltip Cursor="False"><p:Tooltip.ContentTemplate><c:ChartTooltipContent Indicator="Dot" /></p:Tooltip.ContentTemplate></p:Tooltip>
                  <p:Area DataKey="Mobile" Type="Natural" StackId="a" Fill="{DynamicResource PictorPrimary}" FillOpacity="0.6" Stroke="{DynamicResource PictorPrimary}" IsAnimationActive="False" />
                  <p:Area DataKey="Desktop" Type="Natural" StackId="a" Fill="{DynamicResource PictorPrimary}" FillOpacity="0.4" Stroke="{DynamicResource PictorPrimary}" IsAnimationActive="False" />
                </p:AreaChart>
                <Separator />
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Trending up by 5.2% this month" FontWeight="Medium" LineHeight="14" /><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 17l6 -6l4 4l8 -8 M14 7l7 0l0 7" /></Viewbox></StackPanel>
                  <TextBlock Text="Showing total visitors for the last 6 months. This is just some random text to test the layout. It spans multiple lines and should wrap around." TextWrapping="Wrap" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                </StackPanel>
                <Separator />
                <StackPanel Spacing="16">
                  <StackPanel Spacing="12">
                    <Label Content="Header" />
                    <TextBox Text="{Binding Header, Mode=OneWay}" AutomationProperties.Name="Header" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <StackPanel Spacing="12">
                      <Label Content="Type" />
                      <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Select a type" SelectedItem="{Binding Type, Mode=OneWay}" AutomationProperties.Name="Type"><x:String>Table of Contents</x:String><x:String>Executive Summary</x:String><x:String>Technical Approach</x:String><x:String>Design</x:String><x:String>Capabilities</x:String><x:String>Focus Documents</x:String><x:String>Narrative</x:String><x:String>Cover Page</x:String></ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="12">
                      <Label Content="Status" />
                      <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Select a status" SelectedItem="{Binding Status, Mode=OneWay}" AutomationProperties.Name="Status"><x:String>Done</x:String><x:String>In Progress</x:String><x:String>Not Started</x:String></ComboBox>
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <StackPanel Spacing="12">
                      <Label Content="Target" />
                      <TextBox Text="{Binding Target}" AutomationProperties.Name="Target" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="12">
                      <Label Content="Limit" />
                      <TextBox Text="{Binding Limit}" AutomationProperties.Name="Limit" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="12">
                    <Label Content="Reviewer" />
                    <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Select a reviewer" SelectedItem="{Binding Reviewer, Mode=OneWay}" AutomationProperties.Name="Reviewer"><x:String>Eddie Lake</x:String><x:String>Jamik Tashpulatov</x:String><x:String>Emily Whalen</x:String></ComboBox>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </c:Drawer>
      </Panel>
    </Border>
  </StackPanel>
</UserControl>
