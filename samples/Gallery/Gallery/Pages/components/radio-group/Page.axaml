<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" x:DataType="m:ChoiceExamples"
             a:Page.Title="Radio Group" a:Page.Description="A set of checkable buttons—known as radio buttons—where no more than one of the buttons can be checked at a time.">
  <UserControl.Resources>
    <m:Is x:Key="Is" />
  </UserControl.Resources>
  <StackPanel Spacing="32" MaxWidth="880" HorizontalAlignment="Left">
    <StackPanel Spacing="10">
      <TextBlock Classes="h1" Text="Radio Group" />
      <TextBlock Classes="lead" Text="A set of checkable buttons—known as radio buttons—where no more than one of the buttons can be checked at a time." />
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <c:Badge Classes="secondary" Content="shadcn/ui: radio-group" />
        <c:Badge Classes="secondary" Content="Avalonia: RadioButton" />
        <c:Badge Classes="secondary" Content="Web: &lt;input type=radio&gt;" />
      </WrapPanel>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Usage" />
      <TextBlock Classes="sm muted" Text="Radio buttons in one panel form a group (or share a GroupName); 12 px apart as shadcn&#x27;s gap-3." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="12">
            <RadioButton Content="Default" />
            <RadioButton Content="Comfortable" IsChecked="True" />
            <RadioButton Content="Compact" />
          </StackPanel>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;StackPanel Spacing=&quot;12&quot;&gt;&#10;  &lt;RadioButton Content=&quot;Default&quot; /&gt;&#10;  &lt;RadioButton Content=&quot;Comfortable&quot; IsChecked=&quot;True&quot; /&gt;&#10;  &lt;RadioButton Content=&quot;Compact&quot; /&gt;&#10;&lt;/StackPanel&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Disabled" />
      <Border Classes="preview">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="12">
            <RadioButton Content="Enabled" IsChecked="True" />
            <RadioButton Content="Disabled" IsEnabled="False" />
          </StackPanel>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;StackPanel Spacing=&quot;12&quot;&gt;&#10;  &lt;RadioButton Content=&quot;Enabled&quot; IsChecked=&quot;True&quot; /&gt;&#10;  &lt;RadioButton Content=&quot;Disabled&quot; IsEnabled=&quot;False&quot; /&gt;&#10;&lt;/StackPanel&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Binding" />
      <TextBlock Classes="sm muted" Text="Each IsChecked is bound two way through a converter comparing the model&#x27;s enum with the radio&#x27;s value." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="12">
            <RadioButton Content="Default" IsChecked="{Binding Density, Converter={StaticResource Is}, ConverterParameter=Default}" />
            <RadioButton Content="Comfortable" IsChecked="{Binding Density, Converter={StaticResource Is}, ConverterParameter=Comfortable}" />
            <RadioButton Content="Compact" IsChecked="{Binding Density, Converter={StaticResource Is}, ConverterParameter=Compact}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Classes="outline" Command="{Binding ApplyCommand}" Content="Apply" />
              <TextBlock Classes="sm muted" VerticalAlignment="Center" Text="{Binding Status}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;StackPanel Spacing=&quot;12&quot;&gt;&#10;  &lt;RadioButton Content=&quot;Default&quot; IsChecked=&quot;{Binding Density, Converter={StaticResource Is}, ConverterParameter=Default}&quot; /&gt;&#10;  &lt;RadioButton Content=&quot;Comfortable&quot; IsChecked=&quot;{Binding Density, Converter={StaticResource Is}, ConverterParameter=Comfortable}&quot; /&gt;&#10;  &lt;RadioButton Content=&quot;Compact&quot; IsChecked=&quot;{Binding Density, Converter={StaticResource Is}, ConverterParameter=Compact}&quot; /&gt;&#10;  &lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;12&quot;&gt;&#10;    &lt;Button Classes=&quot;outline&quot; Command=&quot;{Binding ApplyCommand}&quot; Content=&quot;Apply&quot; /&gt;&#10;    &lt;TextBlock Classes=&quot;sm muted&quot; VerticalAlignment=&quot;Center&quot; Text=&quot;{Binding Status}&quot; /&gt;&#10;  &lt;/StackPanel&gt;&#10;&lt;/StackPanel&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="API" />
      <StackPanel>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="IsChecked" /><TextBlock Grid.Column="1" Classes="sm muted" Text="Two-way bindable; one radio of a group is checked." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="Content" /><TextBlock Grid.Column="1" Classes="sm muted" Text="The label beside the circle (14 px medium)." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="GroupName" /><TextBlock Grid.Column="1" Classes="sm muted" Text="Groups radios across panels." /></Grid></Border>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
