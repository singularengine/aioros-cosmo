      <Border Classes="code"><TextBlock Text="&lt;Expander Classes=&quot;trace&quot; MaxWidth=&quot;384&quot; IsExpanded=&quot;True&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;Worked for 2m 4s, 1 command failed&quot; Status=&quot;Error&quot; /&gt;&lt;/Expander.Header&gt;&#10;  &lt;StackPanel Spacing=&quot;8&quot;&gt;&#10;&lt;c:Trace&gt;&#10;  &lt;Expander Classes=&quot;trace&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;Thought&quot; Description=&quot;12s&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4 M17.599 6.5a3 3 0 0 0 .399-1.375 M6.003 5.125A3 3 0 0 0 6.401 6.5 M3.477 10.896a4 4 0 0 1 .585-.396 M19.938 10.5a4 4 0 0 1 .585.396 M6 18a4 4 0 0 1-1.967-.516 M19.967 17.484A4 4 0 0 1 18 18&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&lt;/Expander.Header&gt;&#10;  &lt;TextBlock Text=&quot;I should check which package managers are installed before I scaffold anything.&quot; TextWrapping=&quot;Wrap&quot; /&gt;&#10;&lt;/Expander&gt;&#10;  &lt;Expander Classes=&quot;trace&quot; IsExpanded=&quot;True&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;Ran 2 commands, 1 failed&quot; Status=&quot;Error&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M4,17 L10,11 L4,5 M12,19 L20,19&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&lt;/Expander.Header&gt;&#10;  &lt;c:Trace&gt;&#10;  &lt;c:TraceLine Content=&quot;Ran node --version&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M4,17 L10,11 L4,5 M12,19 L20,19&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;  &lt;Expander Classes=&quot;trace&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;Failed to run pnpm --version&quot; Status=&quot;Error&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M4,17 L10,11 L4,5 M12,19 L20,19&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&lt;/Expander.Header&gt;&#10;  &lt;c:CodeBlock Classes=&quot;sm destructive&quot;&gt;&#10;&#10;  &lt;c:CodeBlockContent Wrap=&quot;True&quot;&gt;&#10;    &lt;StackPanel&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;command not found: pnpm&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/c:CodeBlockContent&gt;&#10;&lt;/c:CodeBlock&gt;&#10;&lt;/Expander&gt;&#10;&lt;/c:Trace&gt;&#10;&lt;/Expander&gt;&#10;&lt;/c:Trace&gt;&#10;&lt;TextBlock Text=&quot;Node is installed and pnpm is not. Reading the docs config.&quot; TextWrapping=&quot;Wrap&quot; /&gt;&#10;&lt;c:Trace&gt;&#10;  &lt;HyperlinkButton Classes=&quot;trace&quot; NavigateUri=&quot;#turn&quot;&gt;&lt;c:TraceLine Content=&quot;Read apps/v4/lib/docs.ts&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4 M10 9H8 M16 13H8 M16 17H8&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;c:TraceLine.Trailing&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M9 18 l6-6-6-6&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Trailing&gt;&lt;/c:TraceLine&gt;&lt;/HyperlinkButton&gt;&#10;&lt;/c:Trace&gt;&#10;&lt;/StackPanel&gt;&#10;&lt;/Expander&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Thinking" />
      <TextBlock Classes="sm muted" Text="Send message streams the reasoning, open while it runs, then the answer; Reset clears it." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <DockPanel DataContext="{Binding Thinking}" MaxWidth="384" MinHeight="240" Margin="0,24">
            <Button DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,16,0,0" Classes="outline sm" Height="28" Padding="12,0" CornerRadius="16" HorizontalAlignment="Left" Content="{Binding Chat.Action}" IsVisible="{Binding Chat.Idle}" Command="{Binding ActCommand}" />
            <StackPanel Spacing="16" VerticalAlignment="Top"><c:Message IsVisible="{Binding Chat.Asked}" Classes="end"><c:MessageContent><c:Bubble Classes="muted" Content="Why is the checkout deploy so slow?" /></c:MessageContent></c:Message><c:Message IsVisible="{Binding Chat.Answering}"><c:MessageContent Spacing="16"><c:Trace>
            <c:TraceLine IsVisible="{Binding Chat.ReasoningEmpty}" Content="{Binding Chat.ThinkingTitle}" Status="{Binding Chat.ReasoningStatus}"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4 M17.599 6.5a3 3 0 0 0 .399-1.375 M6.003 5.125A3 3 0 0 0 6.401 6.5 M3.477 10.896a4 4 0 0 1 .585-.396 M19.938 10.5a4 4 0 0 1 .585.396 M6 18a4 4 0 0 1-1.967-.516 M19.967 17.484A4 4 0 0 1 18 18" /></Viewbox></c:TraceLine.Icon></c:TraceLine>
          <Expander Classes="trace" IsVisible="{Binding Chat.ReasoningShown}" IsExpanded="{Binding Chat.ReasoningOpen, Mode=TwoWay}">
            <Expander.Header><c:TraceLine Content="{Binding Chat.ThinkingTitle}" Status="{Binding Chat.ReasoningStatus}"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4 M17.599 6.5a3 3 0 0 0 .399-1.375 M6.003 5.125A3 3 0 0 0 6.401 6.5 M3.477 10.896a4 4 0 0 1 .585-.396 M19.938 10.5a4 4 0 0 1 .585.396 M6 18a4 4 0 0 1-1.967-.516 M19.967 17.484A4 4 0 0 1 18 18" /></Viewbox></c:TraceLine.Icon></c:TraceLine></Expander.Header>
            <TextBlock Text="{Binding Chat.Reasoning}" TextWrapping="Wrap" />
          </Expander>
          </c:Trace><TextBlock IsVisible="{Binding Chat.HasAnswer}" Text="{Binding Chat.Answer}" TextWrapping="Wrap" Foreground="{DynamicResource CosmoForegroundBrush}" /></c:MessageContent></c:Message></StackPanel>
          </DockPanel>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;DockPanel DataContext=&quot;{Binding Thinking}&quot; MaxWidth=&quot;384&quot; MinHeight=&quot;240&quot; Margin=&quot;0,24&quot;&gt;&#10;  &lt;Button DockPanel.Dock=&quot;Bottom&quot; VerticalAlignment=&quot;Bottom&quot; Margin=&quot;0,16,0,0&quot; Classes=&quot;outline sm&quot; Height=&quot;28&quot; Padding=&quot;12,0&quot; CornerRadius=&quot;16&quot; HorizontalAlignment=&quot;Left&quot; Content=&quot;{Binding Chat.Action}&quot; IsVisible=&quot;{Binding Chat.Idle}&quot; Command=&quot;{Binding ActCommand}&quot; /&gt;&#10;  &lt;StackPanel Spacing=&quot;16&quot; VerticalAlignment=&quot;Top&quot;&gt;&lt;c:Message IsVisible=&quot;{Binding Chat.Asked}&quot; Classes=&quot;end&quot;&gt;&lt;c:MessageContent&gt;&lt;c:Bubble Classes=&quot;muted&quot; Content=&quot;Why is the checkout deploy so slow?&quot; /&gt;&lt;/c:MessageContent&gt;&lt;/c:Message&gt;&lt;c:Message IsVisible=&quot;{Binding Chat.Answering}&quot;&gt;&lt;c:MessageContent Spacing=&quot;16&quot;&gt;&lt;c:Trace&gt;&#10;  &lt;c:TraceLine IsVisible=&quot;{Binding Chat.ReasoningEmpty}&quot; Content=&quot;{Binding Chat.ThinkingTitle}&quot; Status=&quot;{Binding Chat.ReasoningStatus}&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4 M17.599 6.5a3 3 0 0 0 .399-1.375 M6.003 5.125A3 3 0 0 0 6.401 6.5 M3.477 10.896a4 4 0 0 1 .585-.396 M19.938 10.5a4 4 0 0 1 .585.396 M6 18a4 4 0 0 1-1.967-.516 M19.967 17.484A4 4 0 0 1 18 18&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;&lt;Expander Classes=&quot;trace&quot; IsVisible=&quot;{Binding Chat.ReasoningShown}&quot; IsExpanded=&quot;{Binding Chat.ReasoningOpen, Mode=TwoWay}&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;{Binding Chat.ThinkingTitle}&quot; Status=&quot;{Binding Chat.ReasoningStatus}&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4 M17.599 6.5a3 3 0 0 0 .399-1.375 M6.003 5.125A3 3 0 0 0 6.401 6.5 M3.477 10.896a4 4 0 0 1 .585-.396 M19.938 10.5a4 4 0 0 1 .585.396 M6 18a4 4 0 0 1-1.967-.516 M19.967 17.484A4 4 0 0 1 18 18&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&lt;/Expander.Header&gt;&#10;  &lt;TextBlock Text=&quot;{Binding Chat.Reasoning}&quot; TextWrapping=&quot;Wrap&quot; /&gt;&#10;&lt;/Expander&gt;&#10;&lt;/c:Trace&gt;&lt;TextBlock IsVisible=&quot;{Binding Chat.HasAnswer}&quot; Text=&quot;{Binding Chat.Answer}&quot; TextWrapping=&quot;Wrap&quot; Foreground=&quot;{DynamicResource CosmoForegroundBrush}&quot; /&gt;&lt;/c:MessageContent&gt;&lt;/c:Message&gt;&lt;/StackPanel&gt;&#10;&lt;/DockPanel&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Tool calls" />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <DockPanel DataContext="{Binding ToolCalls}" MaxWidth="384" MinHeight="240" Margin="0,24">
            <Button DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,16,0,0" Classes="outline sm" Height="28" Padding="12,0" CornerRadius="16" HorizontalAlignment="Left" Content="{Binding Chat.Action}" IsVisible="{Binding Chat.Idle}" Command="{Binding ActCommand}" />
            <StackPanel Spacing="16" VerticalAlignment="Top"><c:Message IsVisible="{Binding Chat.Asked}" Classes="end"><c:MessageContent><c:Bubble Classes="muted" Content="Which package managers are installed?" /></c:MessageContent></c:Message><c:Message IsVisible="{Binding Chat.Answering}"><c:MessageContent Spacing="16"><c:Trace>
            <c:TraceLine IsVisible="{Binding Chat.ToolsRunning[0]}" Content="Running node --version" Status="Running"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox></c:TraceLine.Icon></c:TraceLine>
          <Expander IsVisible="{Binding Chat.ToolsShown[0]}" Classes="trace">
            <Expander.Header><c:TraceLine Content="Ran node --version"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox></c:TraceLine.Icon></c:TraceLine></Expander.Header>
            <c:CodeBlock Classes="sm">

            <c:CodeBlockContent Wrap="True">
              <StackPanel>
                <c:CodeBlockLine><TextBlock Text="v24.18.0" /></c:CodeBlockLine>
              </StackPanel>
            </c:CodeBlockContent>
          </c:CodeBlock>
          </Expander>
            <c:TraceLine IsVisible="{Binding Chat.ToolsRunning[1]}" Content="Running npm --version" Status="Running"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox></c:TraceLine.Icon></c:TraceLine>
          <Expander IsVisible="{Binding Chat.ToolsShown[1]}" Classes="trace">
            <Expander.Header><c:TraceLine Content="Ran npm --version"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox></c:TraceLine.Icon></c:TraceLine></Expander.Header>
            <c:CodeBlock Classes="sm">

            <c:CodeBlockContent Wrap="True">
              <StackPanel>
                <c:CodeBlockLine><TextBlock Text="11.6.2" /></c:CodeBlockLine>
              </StackPanel>
            </c:CodeBlockContent>
          </c:CodeBlock>
          </Expander>
            <c:TraceLine IsVisible="{Binding Chat.ToolsRunning[2]}" Content="Running pnpm --version" Status="Running"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox></c:TraceLine.Icon></c:TraceLine>
          <Expander IsVisible="{Binding Chat.ToolsShown[2]}" Classes="trace">
            <Expander.Header><c:TraceLine Content="Failed to run pnpm --version" Status="Error"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox></c:TraceLine.Icon></c:TraceLine></Expander.Header>
            <c:CodeBlock Classes="sm">

            <c:CodeBlockContent Wrap="True">
              <StackPanel>
                <c:CodeBlockLine><TextBlock Text="command not found: pnpm" /></c:CodeBlockLine>
              </StackPanel>
            </c:CodeBlockContent>
          </c:CodeBlock>
          </Expander>
          </c:Trace><TextBlock IsVisible="{Binding Chat.HasAnswer}" Text="{Binding Chat.Answer}" TextWrapping="Wrap" Foreground="{DynamicResource CosmoForegroundBrush}" /></c:MessageContent></c:Message></StackPanel>
          </DockPanel>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;DockPanel DataContext=&quot;{Binding ToolCalls}&quot; MaxWidth=&quot;384&quot; MinHeight=&quot;240&quot; Margin=&quot;0,24&quot;&gt;&#10;  &lt;Button DockPanel.Dock=&quot;Bottom&quot; VerticalAlignment=&quot;Bottom&quot; Margin=&quot;0,16,0,0&quot; Classes=&quot;outline sm&quot; Height=&quot;28&quot; Padding=&quot;12,0&quot; CornerRadius=&quot;16&quot; HorizontalAlignment=&quot;Left&quot; Content=&quot;{Binding Chat.Action}&quot; IsVisible=&quot;{Binding Chat.Idle}&quot; Command=&quot;{Binding ActCommand}&quot; /&gt;&#10;  &lt;StackPanel Spacing=&quot;16&quot; VerticalAlignment=&quot;Top&quot;&gt;&lt;c:Message IsVisible=&quot;{Binding Chat.Asked}&quot; Classes=&quot;end&quot;&gt;&lt;c:MessageContent&gt;&lt;c:Bubble Classes=&quot;muted&quot; Content=&quot;Which package managers are installed?&quot; /&gt;&lt;/c:MessageContent&gt;&lt;/c:Message&gt;&lt;c:Message IsVisible=&quot;{Binding Chat.Answering}&quot;&gt;&lt;c:MessageContent Spacing=&quot;16&quot;&gt;&lt;c:Trace&gt;&#10;  &lt;c:TraceLine IsVisible=&quot;{Binding Chat.ToolsRunning[0]}&quot; Content=&quot;Running node --version&quot; Status=&quot;Running&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M4,17 L10,11 L4,5 M12,19 L20,19&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;&lt;Expander IsVisible=&quot;{Binding Chat.ToolsShown[0]}&quot; Classes=&quot;trace&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;Ran node --version&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M4,17 L10,11 L4,5 M12,19 L20,19&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&lt;/Expander.Header&gt;&#10;  &lt;c:CodeBlock Classes=&quot;sm&quot;&gt;&#10;&#10;  &lt;c:CodeBlockContent Wrap=&quot;True&quot;&gt;&#10;    &lt;StackPanel&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;v24.18.0&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/c:CodeBlockContent&gt;&#10;&lt;/c:CodeBlock&gt;&#10;&lt;/Expander&gt;&#10;  &lt;c:TraceLine IsVisible=&quot;{Binding Chat.ToolsRunning[1]}&quot; Content=&quot;Running npm --version&quot; Status=&quot;Running&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M4,17 L10,11 L4,5 M12,19 L20,19&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;&lt;Expander IsVisible=&quot;{Binding Chat.ToolsShown[1]}&quot; Classes=&quot;trace&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;Ran npm --version&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M4,17 L10,11 L4,5 M12,19 L20,19&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&lt;/Expander.Header&gt;&#10;  &lt;c:CodeBlock Classes=&quot;sm&quot;&gt;&#10;&#10;  &lt;c:CodeBlockContent Wrap=&quot;True&quot;&gt;&#10;    &lt;StackPanel&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;11.6.2&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/c:CodeBlockContent&gt;&#10;&lt;/c:CodeBlock&gt;&#10;&lt;/Expander&gt;&#10;  &lt;c:TraceLine IsVisible=&quot;{Binding Chat.ToolsRunning[2]}&quot; Content=&quot;Running pnpm --version&quot; Status=&quot;Running&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M4,17 L10,11 L4,5 M12,19 L20,19&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;&lt;Expander IsVisible=&quot;{Binding Chat.ToolsShown[2]}&quot; Classes=&quot;trace&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;Failed to run pnpm --version&quot; Status=&quot;Error&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M4,17 L10,11 L4,5 M12,19 L20,19&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&lt;/Expander.Header&gt;&#10;  &lt;c:CodeBlock Classes=&quot;sm&quot;&gt;&#10;&#10;  &lt;c:CodeBlockContent Wrap=&quot;True&quot;&gt;&#10;    &lt;StackPanel&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;command not found: pnpm&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/c:CodeBlockContent&gt;&#10;&lt;/c:CodeBlock&gt;&#10;&lt;/Expander&gt;&#10;&lt;/c:Trace&gt;&lt;TextBlock IsVisible=&quot;{Binding Chat.HasAnswer}&quot; Text=&quot;{Binding Chat.Answer}&quot; TextWrapping=&quot;Wrap&quot; Foreground=&quot;{DynamicResource CosmoForegroundBrush}&quot; /&gt;&lt;/c:MessageContent&gt;&lt;/c:Message&gt;&lt;/StackPanel&gt;&#10;&lt;/DockPanel&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Demo" />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <StackPanel DataContext="{Binding Demo}" MaxWidth="384" Spacing="16" Margin="0,24">
            <c:Message IsVisible="{Binding Chat.Asked}" Classes="end"><c:MessageContent><c:Bubble Classes="muted" Content="Why does pnpm install fail in CI?" /></c:MessageContent></c:Message>
            <c:Message IsVisible="{Binding Chat.Answering}"><c:MessageContent Spacing="16"><c:Trace>
            <c:TraceLine IsVisible="{Binding Chat.ReasoningEmpty}" Content="{Binding Chat.ThinkingTitle}" Status="{Binding Chat.ReasoningStatus}"><c:TraceLine.Icon><Panel><c:Spinner IsVisible="{Binding Chat.ReasoningRunning}" Width="16" Height="16" /><Viewbox IsVisible="{Binding Chat.ReasoningDone}" Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M9 12 l2 2 4-4" /></Viewbox></Panel></c:TraceLine.Icon></c:TraceLine>
          <Expander Classes="trace" IsVisible="{Binding Chat.ReasoningShown}" IsExpanded="{Binding Chat.ReasoningOpen, Mode=TwoWay}">
            <Expander.Header><c:TraceLine Content="{Binding Chat.ThinkingTitle}" Status="{Binding Chat.ReasoningStatus}"><c:TraceLine.Icon><Panel><c:Spinner IsVisible="{Binding Chat.ReasoningRunning}" Width="16" Height="16" /><Viewbox IsVisible="{Binding Chat.ReasoningDone}" Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M9 12 l2 2 4-4" /></Viewbox></Panel></c:TraceLine.Icon></c:TraceLine></Expander.Header>
            <TextBlock Text="{Binding Chat.Reasoning}" TextWrapping="Wrap" />
          </Expander>
            <c:TraceLine IsVisible="{Binding Chat.ToolsRunning[0]}" Content="Running pnpm --version" Status="Running"><c:TraceLine.Icon><c:Spinner Width="16" Height="16" /></c:TraceLine.Icon></c:TraceLine>
          <Expander IsVisible="{Binding Chat.ToolsShown[0]}" Classes="trace">
            <Expander.Header><c:TraceLine Content="Ran pnpm --version"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M9 12 l2 2 4-4" /></Viewbox></c:TraceLine.Icon></c:TraceLine></Expander.Header>
            <c:CodeBlock Classes="sm">

            <c:CodeBlockContent Wrap="True">
              <StackPanel>
                <c:CodeBlockLine><TextBlock Text="10.18.0" /></c:CodeBlockLine>
              </StackPanel>
            </c:CodeBlockContent>
          </c:CodeBlock>
          </Expander>
            <c:TraceLine IsVisible="{Binding Chat.ToolsRunning[1]}" Content="Running git diff --stat HEAD~1 -- package.json pnpm-lock.yaml" Status="Running"><c:TraceLine.Icon><c:Spinner Width="16" Height="16" /></c:TraceLine.Icon></c:TraceLine>
          <Expander IsVisible="{Binding Chat.ToolsShown[1]}" Classes="trace" IsExpanded="True">
            <Expander.Header><c:TraceLine Content="Ran git diff --stat HEAD~1 -- package.json pnpm-lock.yaml"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M9 12 l2 2 4-4" /></Viewbox></c:TraceLine.Icon></c:TraceLine></Expander.Header>
            <c:CodeBlock Classes="sm">

            <c:CodeBlockContent Wrap="True">
              <StackPanel>
                <c:CodeBlockLine><TextBlock Text=" package.json | 2 +-" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text=" 1 file changed, 1 insertion(+), 1 deletion(-)" /></c:CodeBlockLine>
              </StackPanel>
            </c:CodeBlockContent>
          </c:CodeBlock>
          </Expander>
            <c:TraceLine IsVisible="{Binding Chat.ToolsRunning[2]}" Content="Running pnpm install --frozen-lockfile" Status="Running"><c:TraceLine.Icon><c:Spinner Width="16" Height="16" /></c:TraceLine.Icon></c:TraceLine>
          <Expander IsVisible="{Binding Chat.ToolsShown[2]}" Classes="trace">
            <Expander.Header><c:TraceLine Content="Failed to run pnpm install --frozen-lockfile" Status="Error"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12,8 L12,12 M12,16 L12.01,16" /></Viewbox></c:TraceLine.Icon></c:TraceLine></Expander.Header>
            <c:CodeBlock Classes="sm destructive">

            <c:CodeBlockContent Wrap="True">
              <StackPanel>
                <c:CodeBlockLine><TextBlock Text="ERR_PNPM_OUTDATED_LOCKFILE  Cannot install with &amp;quot;frozen-lockfile&amp;quot; because pnpm-lock.yaml is not up to date with package.json" /></c:CodeBlockLine>
              </StackPanel>
            </c:CodeBlockContent>
          </c:CodeBlock>
          </Expander>
            <Expander IsVisible="{Binding Chat.SourcesShown}" Classes="trace">
            <Expander.Header><c:TraceLine Content="{Binding Chat.SourcesTitle}" Status="{Binding Chat.SourcesStatus}"><c:TraceLine.Icon><Panel><c:Spinner IsVisible="{Binding Chat.SourcesRunning}" Width="16" Height="16" /><Viewbox IsVisible="{Binding Chat.SourcesDone}" Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20 M2 12h20" /></Viewbox></Panel></c:TraceLine.Icon></c:TraceLine></Expander.Header>
            <c:Trace>
            <HyperlinkButton Classes="trace" NavigateUri="https://pnpm.io/cli/install#--frozen-lockfile" AutomationProperties.Name="pnpm install | pnpm.io (opens in a new tab)"><c:TraceLine Content="pnpm install | pnpm.io"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20 M2 12h20" /></Viewbox></c:TraceLine.Icon><c:TraceLine.Trailing><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M7 7h10v10 M7 17 17 7" /></Viewbox></c:TraceLine.Trailing></c:TraceLine></HyperlinkButton>
            <HyperlinkButton Classes="trace" NavigateUri="https://pnpm.io/continuous-integration" AutomationProperties.Name="Continuous Integration | pnpm.io (opens in a new tab)"><c:TraceLine Content="Continuous Integration | pnpm.io"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20 M2 12h20" /></Viewbox></c:TraceLine.Icon><c:TraceLine.Trailing><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M7 7h10v10 M7 17 17 7" /></Viewbox></c:TraceLine.Trailing></c:TraceLine></HyperlinkButton>
          </c:Trace>
          </Expander>
          </c:Trace><TextBlock IsVisible="{Binding Chat.HasAnswer}" Text="{Binding Chat.Answer}" TextWrapping="Wrap" Foreground="{DynamicResource CosmoForegroundBrush}" /></c:MessageContent></c:Message>
            <Button Classes="outline sm" Height="28" Padding="12,0" CornerRadius="16" HorizontalAlignment="Left" Content="Replay" IsVisible="{Binding Chat.Idle}" Command="{Binding ReplayCommand}" />
          </StackPanel>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;StackPanel DataContext=&quot;{Binding Demo}&quot; MaxWidth=&quot;384&quot; Spacing=&quot;16&quot; Margin=&quot;0,24&quot;&gt;&#10;  &lt;c:Message IsVisible=&quot;{Binding Chat.Asked}&quot; Classes=&quot;end&quot;&gt;&lt;c:MessageContent&gt;&lt;c:Bubble Classes=&quot;muted&quot; Content=&quot;Why does pnpm install fail in CI?&quot; /&gt;&lt;/c:MessageContent&gt;&lt;/c:Message&gt;&#10;  &lt;c:Message IsVisible=&quot;{Binding Chat.Answering}&quot;&gt;&lt;c:MessageContent Spacing=&quot;16&quot;&gt;&lt;c:Trace&gt;&#10;  &lt;c:TraceLine IsVisible=&quot;{Binding Chat.ReasoningEmpty}&quot; Content=&quot;{Binding Chat.ThinkingTitle}&quot; Status=&quot;{Binding Chat.ReasoningStatus}&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Panel&gt;&lt;c:Spinner IsVisible=&quot;{Binding Chat.ReasoningRunning}&quot; Width=&quot;16&quot; Height=&quot;16&quot; /&gt;&lt;Viewbox IsVisible=&quot;{Binding Chat.ReasoningDone}&quot; Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M9 12 l2 2 4-4&quot; /&gt;&lt;/Viewbox&gt;&lt;/Panel&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;&lt;Expander Classes=&quot;trace&quot; IsVisible=&quot;{Binding Chat.ReasoningShown}&quot; IsExpanded=&quot;{Binding Chat.ReasoningOpen, Mode=TwoWay}&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;{Binding Chat.ThinkingTitle}&quot; Status=&quot;{Binding Chat.ReasoningStatus}&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Panel&gt;&lt;c:Spinner IsVisible=&quot;{Binding Chat.ReasoningRunning}&quot; Width=&quot;16&quot; Height=&quot;16&quot; /&gt;&lt;Viewbox IsVisible=&quot;{Binding Chat.ReasoningDone}&quot; Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M9 12 l2 2 4-4&quot; /&gt;&lt;/Viewbox&gt;&lt;/Panel&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&lt;/Expander.Header&gt;&#10;  &lt;TextBlock Text=&quot;{Binding Chat.Reasoning}&quot; TextWrapping=&quot;Wrap&quot; /&gt;&#10;&lt;/Expander&gt;&#10;  &lt;c:TraceLine IsVisible=&quot;{Binding Chat.ToolsRunning[0]}&quot; Content=&quot;Running pnpm --version&quot; Status=&quot;Running&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;c:Spinner Width=&quot;16&quot; Height=&quot;16&quot; /&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;&lt;Expander IsVisible=&quot;{Binding Chat.ToolsShown[0]}&quot; Classes=&quot;trace&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;Ran pnpm --version&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M9 12 l2 2 4-4&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&lt;/Expander.Header&gt;&#10;  &lt;c:CodeBlock Classes=&quot;sm&quot;&gt;&#10;&#10;  &lt;c:CodeBlockContent Wrap=&quot;True&quot;&gt;&#10;    &lt;StackPanel&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;10.18.0&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/c:CodeBlockContent&gt;&#10;&lt;/c:CodeBlock&gt;&#10;&lt;/Expander&gt;&#10;  &lt;c:TraceLine IsVisible=&quot;{Binding Chat.ToolsRunning[1]}&quot; Content=&quot;Running git diff --stat HEAD~1 -- package.json pnpm-lock.yaml&quot; Status=&quot;Running&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;c:Spinner Width=&quot;16&quot; Height=&quot;16&quot; /&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;&lt;Expander IsVisible=&quot;{Binding Chat.ToolsShown[1]}&quot; Classes=&quot;trace&quot; IsExpanded=&quot;True&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;Ran git diff --stat HEAD~1 -- package.json pnpm-lock.yaml&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M9 12 l2 2 4-4&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&lt;/Expander.Header&gt;&#10;  &lt;c:CodeBlock Classes=&quot;sm&quot;&gt;&#10;&#10;  &lt;c:CodeBlockContent Wrap=&quot;True&quot;&gt;&#10;    &lt;StackPanel&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot; package.json | 2 +-&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot; 1 file changed, 1 insertion(+), 1 deletion(-)&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/c:CodeBlockContent&gt;&#10;&lt;/c:CodeBlock&gt;&#10;&lt;/Expander&gt;&#10;  &lt;c:TraceLine IsVisible=&quot;{Binding Chat.ToolsRunning[2]}&quot; Content=&quot;Running pnpm install --frozen-lockfile&quot; Status=&quot;Running&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;c:Spinner Width=&quot;16&quot; Height=&quot;16&quot; /&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;&lt;Expander IsVisible=&quot;{Binding Chat.ToolsShown[2]}&quot; Classes=&quot;trace&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;Failed to run pnpm install --frozen-lockfile&quot; Status=&quot;Error&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12,8 L12,12 M12,16 L12.01,16&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&lt;/Expander.Header&gt;&#10;  &lt;c:CodeBlock Classes=&quot;sm destructive&quot;&gt;&#10;&#10;  &lt;c:CodeBlockContent Wrap=&quot;True&quot;&gt;&#10;    &lt;StackPanel&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;ERR_PNPM_OUTDATED_LOCKFILE  Cannot install with &amp;amp;quot;frozen-lockfile&amp;amp;quot; because pnpm-lock.yaml is not up to date with package.json&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/c:CodeBlockContent&gt;&#10;&lt;/c:CodeBlock&gt;&#10;&lt;/Expander&gt;&#10;  &lt;Expander IsVisible=&quot;{Binding Chat.SourcesShown}&quot; Classes=&quot;trace&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;{Binding Chat.SourcesTitle}&quot; Status=&quot;{Binding Chat.SourcesStatus}&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Panel&gt;&lt;c:Spinner IsVisible=&quot;{Binding Chat.SourcesRunning}&quot; Width=&quot;16&quot; Height=&quot;16&quot; /&gt;&lt;Viewbox IsVisible=&quot;{Binding Chat.SourcesDone}&quot; Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20 M2 12h20&quot; /&gt;&lt;/Viewbox&gt;&lt;/Panel&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&lt;/Expander.Header&gt;&#10;  &lt;c:Trace&gt;&#10;  &lt;HyperlinkButton Classes=&quot;trace&quot; NavigateUri=&quot;https://pnpm.io/cli/install#--frozen-lockfile&quot; AutomationProperties.Name=&quot;pnpm install | pnpm.io (opens in a new tab)&quot;&gt;&lt;c:TraceLine Content=&quot;pnpm install | pnpm.io&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20 M2 12h20&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;c:TraceLine.Trailing&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M7 7h10v10 M7 17 17 7&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Trailing&gt;&lt;/c:TraceLine&gt;&lt;/HyperlinkButton&gt;&#10;  &lt;HyperlinkButton Classes=&quot;trace&quot; NavigateUri=&quot;https://pnpm.io/continuous-integration&quot; AutomationProperties.Name=&quot;Continuous Integration | pnpm.io (opens in a new tab)&quot;&gt;&lt;c:TraceLine Content=&quot;Continuous Integration | pnpm.io&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20 M2 12h20&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;c:TraceLine.Trailing&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M7 7h10v10 M7 17 17 7&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Trailing&gt;&lt;/c:TraceLine&gt;&lt;/HyperlinkButton&gt;&#10;&lt;/c:Trace&gt;&#10;&lt;/Expander&gt;&#10;&lt;/c:Trace&gt;&lt;TextBlock IsVisible=&quot;{Binding Chat.HasAnswer}&quot; Text=&quot;{Binding Chat.Answer}&quot; TextWrapping=&quot;Wrap&quot; Foreground=&quot;{DynamicResource CosmoForegroundBrush}&quot; /&gt;&lt;/c:MessageContent&gt;&lt;/c:Message&gt;&#10;  &lt;Button Classes=&quot;outline sm&quot; Height=&quot;28&quot; Padding=&quot;12,0&quot; CornerRadius=&quot;16&quot; HorizontalAlignment=&quot;Left&quot; Content=&quot;Replay&quot; IsVisible=&quot;{Binding Chat.Idle}&quot; Command=&quot;{Binding ReplayCommand}&quot; /&gt;&#10;&lt;/StackPanel&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="API" />
      <StackPanel>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="c:TraceLine: Icon, Description, Trailing" /><TextBlock Grid.Column="1" Classes="sm muted" Text="The 16 px icon, the detail after the title and an icon at the end; the content is the title." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="Status" /><TextBlock Grid.Column="1" Classes="sm muted" Text="Done, Running, Error or Pending." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="Expander.trace" /><TextBlock Grid.Column="1" Classes="sm muted" Text="A collapsible step: the header is its trigger, the content opens behind a left line." /></Grid></Border>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
