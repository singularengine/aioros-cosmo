<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Web.Live="True" x:DataType="m:TracePlayback"
             a:Page.Title="Trace" a:Page.Description="Displays an agent&#x27;s steps as compact lines, with status, details and collapsible steps.">
  <StackPanel Spacing="32" MaxWidth="880" HorizontalAlignment="Left">
    <StackPanel Spacing="10">
      <TextBlock Classes="h1" Text="Trace" />
      <TextBlock Classes="lead" Text="Displays an agent&#x27;s steps as compact lines, with status, details and collapsible steps." />
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <c:Badge Classes="secondary" Content="shadcn/ui: trace (radix-rhea)" />
        <c:Badge Classes="secondary" Content="Avalonia: ContentControl, Expander" />
        <c:Badge Classes="secondary" Content="Web: &lt;div&gt;, &lt;details&gt;" />
      </WrapPanel>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Static" />
      <TextBlock Classes="sm muted" Text="c:Trace stacks c:TraceLines 8 px apart; a line&#x27;s Icon, title and Description." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <c:Trace MaxWidth="384">
            <c:TraceLine Content="Created branch fix/frozen-lockfile"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M6,3 L6,15 M15,6 A3,3 0 1 1 21,6 A3,3 0 1 1 15,6 Z M3,18 A3,3 0 1 1 9,18 A3,3 0 1 1 3,18 Z M18 9a9 9 0 0 1-9 9" /></Viewbox></c:TraceLine.Icon></c:TraceLine>
          </c:Trace>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;c:Trace MaxWidth=&quot;384&quot;&gt;&#10;  &lt;c:TraceLine Content=&quot;Created branch fix/frozen-lockfile&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M6,3 L6,15 M15,6 A3,3 0 1 1 21,6 A3,3 0 1 1 15,6 Z M3,18 A3,3 0 1 1 9,18 A3,3 0 1 1 3,18 Z M18 9a9 9 0 0 1-9 9&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;&lt;/c:Trace&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Status" />
      <TextBlock Classes="sm muted" Text="Status: Done, Running, Error and Pending, each a pseudo-class." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <c:Trace MaxWidth="384">
            <c:TraceLine Content="Ran pnpm install"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M9 12 l2 2 4-4" /></Viewbox></c:TraceLine.Icon></c:TraceLine>
            <c:TraceLine Content="Failed to run pnpm lint" Status="Error"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12,8 L12,12 M12,16 L12.01,16" /></Viewbox></c:TraceLine.Icon></c:TraceLine>
            <c:TraceLine Content="Running pnpm build" Status="Running"><c:TraceLine.Icon><c:Spinner Width="16" Height="16" /></c:TraceLine.Icon></c:TraceLine>
            <c:TraceLine Content="Run pnpm test" Status="Pending"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z" /></Viewbox></c:TraceLine.Icon></c:TraceLine>
          </c:Trace>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;c:Trace MaxWidth=&quot;384&quot;&gt;&#10;  &lt;c:TraceLine Content=&quot;Ran pnpm install&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M9 12 l2 2 4-4&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;  &lt;c:TraceLine Content=&quot;Failed to run pnpm lint&quot; Status=&quot;Error&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12,8 L12,12 M12,16 L12.01,16&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;  &lt;c:TraceLine Content=&quot;Running pnpm build&quot; Status=&quot;Running&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;c:Spinner Width=&quot;16&quot; Height=&quot;16&quot; /&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;  &lt;c:TraceLine Content=&quot;Run pnpm test&quot; Status=&quot;Pending&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;&lt;/c:Trace&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Description" />
      <TextBlock Classes="sm muted" Text="A long title is cut short with an ellipsis; the description keeps its width." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <c:Trace MaxWidth="384">
            <c:TraceLine Content="Edited components/settings/notification-preferences-form.tsx"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M12.5 22H18a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v9.5 M14 2v4a2 2 0 0 0 2 2h4 M13.378 15.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z" /></Viewbox></c:TraceLine.Icon><c:TraceLine.Description><TextBlock Text="+48 −12" FontFamily="{DynamicResource CosmoFontMono}" /></c:TraceLine.Description></c:TraceLine>
            <c:TraceLine Content="Ran pnpm test" Description="14s"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox></c:TraceLine.Icon></c:TraceLine>
            <c:TraceLine Content="Searched for useChat" Description="8 results"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M3,11 A8,8 0 1 1 19,11 A8,8 0 1 1 3,11 Z M21 21 l-4.3-4.3" /></Viewbox></c:TraceLine.Icon></c:TraceLine>
          </c:Trace>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;c:Trace MaxWidth=&quot;384&quot;&gt;&#10;  &lt;c:TraceLine Content=&quot;Edited components/settings/notification-preferences-form.tsx&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M12.5 22H18a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v9.5 M14 2v4a2 2 0 0 0 2 2h4 M13.378 15.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;c:TraceLine.Description&gt;&lt;TextBlock Text=&quot;+48 −12&quot; FontFamily=&quot;{DynamicResource CosmoFontMono}&quot; /&gt;&lt;/c:TraceLine.Description&gt;&lt;/c:TraceLine&gt;&#10;  &lt;c:TraceLine Content=&quot;Ran pnpm test&quot; Description=&quot;14s&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M4,17 L10,11 L4,5 M12,19 L20,19&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;  &lt;c:TraceLine Content=&quot;Searched for useChat&quot; Description=&quot;8 results&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M3,11 A8,8 0 1 1 19,11 A8,8 0 1 1 3,11 Z M21 21 l-4.3-4.3&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;&lt;/c:Trace&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Group" />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <c:Trace MaxWidth="384">
            <c:TraceLine Content="Searched for minimumReleaseAge"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M3,11 A8,8 0 1 1 19,11 A8,8 0 1 1 3,11 Z M21 21 l-4.3-4.3" /></Viewbox></c:TraceLine.Icon></c:TraceLine>
            <c:TraceLine Content="Read pnpm-workspace.yaml"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4 M10 9H8 M16 13H8 M16 17H8" /></Viewbox></c:TraceLine.Icon></c:TraceLine>
            <c:TraceLine Content="Ran pnpm install"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox></c:TraceLine.Icon></c:TraceLine>
          </c:Trace>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;c:Trace MaxWidth=&quot;384&quot;&gt;&#10;  &lt;c:TraceLine Content=&quot;Searched for minimumReleaseAge&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M3,11 A8,8 0 1 1 19,11 A8,8 0 1 1 3,11 Z M21 21 l-4.3-4.3&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;  &lt;c:TraceLine Content=&quot;Read pnpm-workspace.yaml&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4 M10 9H8 M16 13H8 M16 17H8&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;  &lt;c:TraceLine Content=&quot;Ran pnpm install&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M4,17 L10,11 L4,5 M12,19 L20,19&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&#10;&lt;/c:Trace&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Collapsible" />
      <TextBlock Classes="sm muted" Text="An Expander with the trace class opens a step below its trigger." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Expander Classes="trace" MaxWidth="384">
            <Expander.Header><c:TraceLine Content="Ran node --version"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox></c:TraceLine.Icon></c:TraceLine></Expander.Header>
            <c:CodeBlock Classes="sm">

            <c:CodeBlockContent Wrap="True">
              <StackPanel>
                <c:CodeBlockLine><TextBlock Text="$ node --version" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="v24.18.0" /></c:CodeBlockLine>
              </StackPanel>
            </c:CodeBlockContent>
          </c:CodeBlock>
          </Expander>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Expander Classes=&quot;trace&quot; MaxWidth=&quot;384&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;Ran node --version&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M4,17 L10,11 L4,5 M12,19 L20,19&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&lt;/Expander.Header&gt;&#10;  &lt;c:CodeBlock Classes=&quot;sm&quot;&gt;&#10;&#10;  &lt;c:CodeBlockContent Wrap=&quot;True&quot;&gt;&#10;    &lt;StackPanel&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;$ node --version&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;v24.18.0&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/c:CodeBlockContent&gt;&#10;&lt;/c:CodeBlock&gt;&#10;&lt;/Expander&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Steps" />
      <TextBlock Classes="sm muted" Text="Steps inside a step; Trailing puts an icon at a line&#x27;s end." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Expander Classes="trace" MaxWidth="384" IsExpanded="True">
            <Expander.Header><c:TraceLine Content="Looking into the slow deploy" Status="Running" /></Expander.Header>
            <c:Trace>
            <Expander Classes="trace">
            <Expander.Header><c:TraceLine Content="Searched for the checkout build log"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M3,11 A8,8 0 1 1 19,11 A8,8 0 1 1 3,11 Z M21 21 l-4.3-4.3" /></Viewbox></c:TraceLine.Icon></c:TraceLine></Expander.Header>
            <WrapPanel ItemSpacing="6" LineSpacing="6"><c:Badge Classes="secondary" Content="vercel.com" /><c:Badge Classes="secondary" Content="github.com" /></WrapPanel>
          </Expander>
            <Border a:Web.Href="#steps" HorizontalAlignment="Left"><c:TraceLine Content="Read the last twelve deploys"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4 M10 9H8 M16 13H8 M16 17H8" /></Viewbox></c:TraceLine.Icon><c:TraceLine.Trailing><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M9 18 l6-6-6-6" /></Viewbox></c:TraceLine.Trailing></c:TraceLine></Border>
            <Expander Classes="trace">
            <Expander.Header><c:TraceLine Content="Searching for the cache key" Status="Running"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M3,11 A8,8 0 1 1 19,11 A8,8 0 1 1 3,11 Z M21 21 l-4.3-4.3" /></Viewbox></c:TraceLine.Icon></c:TraceLine></Expander.Header>
            <c:CodeBlock Classes="sm">

            <c:CodeBlockContent Wrap="True">
              <StackPanel>
                <c:CodeBlockLine><TextBlock Text="cache key image optimization" /></c:CodeBlockLine>
              </StackPanel>
            </c:CodeBlockContent>
          </c:CodeBlock>
          </Expander>
          </c:Trace>
          </Expander>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Expander Classes=&quot;trace&quot; MaxWidth=&quot;384&quot; IsExpanded=&quot;True&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;Looking into the slow deploy&quot; Status=&quot;Running&quot; /&gt;&lt;/Expander.Header&gt;&#10;  &lt;c:Trace&gt;&#10;  &lt;Expander Classes=&quot;trace&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;Searched for the checkout build log&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M3,11 A8,8 0 1 1 19,11 A8,8 0 1 1 3,11 Z M21 21 l-4.3-4.3&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&lt;/Expander.Header&gt;&#10;  &lt;WrapPanel ItemSpacing=&quot;6&quot; LineSpacing=&quot;6&quot;&gt;&lt;c:Badge Classes=&quot;secondary&quot; Content=&quot;vercel.com&quot; /&gt;&lt;c:Badge Classes=&quot;secondary&quot; Content=&quot;github.com&quot; /&gt;&lt;/WrapPanel&gt;&#10;&lt;/Expander&gt;&#10;  &lt;Border a:Web.Href=&quot;#steps&quot; HorizontalAlignment=&quot;Left&quot;&gt;&lt;c:TraceLine Content=&quot;Read the last twelve deploys&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4 M10 9H8 M16 13H8 M16 17H8&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;c:TraceLine.Trailing&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M9 18 l6-6-6-6&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Trailing&gt;&lt;/c:TraceLine&gt;&lt;/Border&gt;&#10;  &lt;Expander Classes=&quot;trace&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;Searching for the cache key&quot; Status=&quot;Running&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M3,11 A8,8 0 1 1 19,11 A8,8 0 1 1 3,11 Z M21 21 l-4.3-4.3&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&lt;/Expander.Header&gt;&#10;  &lt;c:CodeBlock Classes=&quot;sm&quot;&gt;&#10;&#10;  &lt;c:CodeBlockContent Wrap=&quot;True&quot;&gt;&#10;    &lt;StackPanel&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;cache key image optimization&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/c:CodeBlockContent&gt;&#10;&lt;/c:CodeBlock&gt;&#10;&lt;/Expander&gt;&#10;&lt;/c:Trace&gt;&#10;&lt;/Expander&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Link" />
      <TextBlock Classes="sm muted" Text="A line&#x27;s title can be a link." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <c:Trace MaxWidth="384">
            <HyperlinkButton Classes="trace" NavigateUri="#link"><c:TraceLine Content="Read apps/v4/lib/docs.ts"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4 M10 9H8 M16 13H8 M16 17H8" /></Viewbox></c:TraceLine.Icon><c:TraceLine.Trailing><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M9 18 l6-6-6-6" /></Viewbox></c:TraceLine.Trailing></c:TraceLine></HyperlinkButton>
            <HyperlinkButton Classes="trace" NavigateUri="https://docs.astro.build/en/install-and-setup/" AutomationProperties.Name="Install Astro | docs.astro.build (opens in a new tab)"><c:TraceLine Content="Install Astro | docs.astro.build"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20 M2 12h20" /></Viewbox></c:TraceLine.Icon><c:TraceLine.Trailing><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M7 7h10v10 M7 17 17 7" /></Viewbox></c:TraceLine.Trailing></c:TraceLine></HyperlinkButton>
          </c:Trace>
