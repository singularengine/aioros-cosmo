<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" x:DataType="m:CompositeExamples"
             a:Page.Title="Carousel" a:Page.Description="A carousel with motion and swipe built using Embla.">
  <StackPanel Spacing="32" MaxWidth="880" HorizontalAlignment="Left">
    <StackPanel Spacing="10">
      <TextBlock Classes="h1" Text="Carousel" />
      <TextBlock Classes="lead" Text="A carousel with motion and swipe built using Embla." />
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <c:Badge Classes="secondary" Content="shadcn/ui: carousel" />
        <c:Badge Classes="secondary" Content="Avalonia: Carousel" />
        <c:Badge Classes="secondary" Content="Web: scroll-snap" />
      </WrapPanel>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Usage" />
      <TextBlock Classes="sm muted" Text="Avalonia&#x27;s Carousel in Cosmo&#x27;s theme: the previous and next buttons, Left and Right, swipe and the mouse&#x27;s drag (Embla&#x27;s)." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Carousel MaxWidth="320" Margin="48,0">
            <Border Padding="4"><c:Card><c:AspectRatio Ratio="1"><c:CardContent Padding="24"><TextBlock Text="1" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:AspectRatio></c:Card></Border>
            <Border Padding="4"><c:Card><c:AspectRatio Ratio="1"><c:CardContent Padding="24"><TextBlock Text="2" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:AspectRatio></c:Card></Border>
            <Border Padding="4"><c:Card><c:AspectRatio Ratio="1"><c:CardContent Padding="24"><TextBlock Text="3" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:AspectRatio></c:Card></Border>
            <Border Padding="4"><c:Card><c:AspectRatio Ratio="1"><c:CardContent Padding="24"><TextBlock Text="4" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:AspectRatio></c:Card></Border>
            <Border Padding="4"><c:Card><c:AspectRatio Ratio="1"><c:CardContent Padding="24"><TextBlock Text="5" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:AspectRatio></c:Card></Border>
          </Carousel>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Carousel MaxWidth=&quot;320&quot; Margin=&quot;48,0&quot;&gt;&#10;  &lt;Border Padding=&quot;4&quot;&gt;&lt;c:Card&gt;&lt;c:AspectRatio Ratio=&quot;1&quot;&gt;&lt;c:CardContent Padding=&quot;24&quot;&gt;&lt;TextBlock Text=&quot;1&quot; FontSize=&quot;36&quot; FontWeight=&quot;SemiBold&quot; HorizontalAlignment=&quot;Center&quot; VerticalAlignment=&quot;Center&quot; /&gt;&lt;/c:CardContent&gt;&lt;/c:AspectRatio&gt;&lt;/c:Card&gt;&lt;/Border&gt;&#10;  &lt;Border Padding=&quot;4&quot;&gt;&lt;c:Card&gt;&lt;c:AspectRatio Ratio=&quot;1&quot;&gt;&lt;c:CardContent Padding=&quot;24&quot;&gt;&lt;TextBlock Text=&quot;2&quot; FontSize=&quot;36&quot; FontWeight=&quot;SemiBold&quot; HorizontalAlignment=&quot;Center&quot; VerticalAlignment=&quot;Center&quot; /&gt;&lt;/c:CardContent&gt;&lt;/c:AspectRatio&gt;&lt;/c:Card&gt;&lt;/Border&gt;&#10;  &lt;Border Padding=&quot;4&quot;&gt;&lt;c:Card&gt;&lt;c:AspectRatio Ratio=&quot;1&quot;&gt;&lt;c:CardContent Padding=&quot;24&quot;&gt;&lt;TextBlock Text=&quot;3&quot; FontSize=&quot;36&quot; FontWeight=&quot;SemiBold&quot; HorizontalAlignment=&quot;Center&quot; VerticalAlignment=&quot;Center&quot; /&gt;&lt;/c:CardContent&gt;&lt;/c:AspectRatio&gt;&lt;/c:Card&gt;&lt;/Border&gt;&#10;  &lt;Border Padding=&quot;4&quot;&gt;&lt;c:Card&gt;&lt;c:AspectRatio Ratio=&quot;1&quot;&gt;&lt;c:CardContent Padding=&quot;24&quot;&gt;&lt;TextBlock Text=&quot;4&quot; FontSize=&quot;36&quot; FontWeight=&quot;SemiBold&quot; HorizontalAlignment=&quot;Center&quot; VerticalAlignment=&quot;Center&quot; /&gt;&lt;/c:CardContent&gt;&lt;/c:AspectRatio&gt;&lt;/c:Card&gt;&lt;/Border&gt;&#10;  &lt;Border Padding=&quot;4&quot;&gt;&lt;c:Card&gt;&lt;c:AspectRatio Ratio=&quot;1&quot;&gt;&lt;c:CardContent Padding=&quot;24&quot;&gt;&lt;TextBlock Text=&quot;5&quot; FontSize=&quot;36&quot; FontWeight=&quot;SemiBold&quot; HorizontalAlignment=&quot;Center&quot; VerticalAlignment=&quot;Center&quot; /&gt;&lt;/c:CardContent&gt;&lt;/c:AspectRatio&gt;&lt;/c:Card&gt;&lt;/Border&gt;&#10;&lt;/Carousel&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Orientation" />
      <TextBlock Classes="sm muted" Text="The vertical class slides up and down and turns the buttons." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Carousel Classes="vertical" MaxWidth="320" Height="200" Margin="0,48">
            <Border Padding="4"><c:Card><c:CardContent Padding="24"><TextBlock Text="1" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" /></c:CardContent></c:Card></Border>
            <Border Padding="4"><c:Card><c:CardContent Padding="24"><TextBlock Text="2" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" /></c:CardContent></c:Card></Border>
            <Border Padding="4"><c:Card><c:CardContent Padding="24"><TextBlock Text="3" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" /></c:CardContent></c:Card></Border>
          </Carousel>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Carousel Classes=&quot;vertical&quot; MaxWidth=&quot;320&quot; Height=&quot;200&quot; Margin=&quot;0,48&quot;&gt;&#10;  &lt;Border Padding=&quot;4&quot;&gt;&lt;c:Card&gt;&lt;c:CardContent Padding=&quot;24&quot;&gt;&lt;TextBlock Text=&quot;1&quot; FontSize=&quot;30&quot; FontWeight=&quot;SemiBold&quot; HorizontalAlignment=&quot;Center&quot; /&gt;&lt;/c:CardContent&gt;&lt;/c:Card&gt;&lt;/Border&gt;&#10;  &lt;Border Padding=&quot;4&quot;&gt;&lt;c:Card&gt;&lt;c:CardContent Padding=&quot;24&quot;&gt;&lt;TextBlock Text=&quot;2&quot; FontSize=&quot;30&quot; FontWeight=&quot;SemiBold&quot; HorizontalAlignment=&quot;Center&quot; /&gt;&lt;/c:CardContent&gt;&lt;/c:Card&gt;&lt;/Border&gt;&#10;  &lt;Border Padding=&quot;4&quot;&gt;&lt;c:Card&gt;&lt;c:CardContent Padding=&quot;24&quot;&gt;&lt;TextBlock Text=&quot;3&quot; FontSize=&quot;30&quot; FontWeight=&quot;SemiBold&quot; HorizontalAlignment=&quot;Center&quot; /&gt;&lt;/c:CardContent&gt;&lt;/c:Card&gt;&lt;/Border&gt;&#10;&lt;/Carousel&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Binding" />
      <TextBlock Classes="sm muted" Text="Slides from the model with an item template, SelectedIndex two way, WrapSelection as Embla&#x27;s loop and the indicators class for dots." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <StackPanel MaxWidth="320" Margin="48,0" Spacing="8">
            <Carousel Classes="indicators" ItemsSource="{Binding Slides}" SelectedIndex="{Binding SlideIndex}" WrapSelection="True">
              <Carousel.ItemTemplate>
                <DataTemplate x:DataType="x:Int32">
                  <c:Card><c:AspectRatio Ratio="1"><c:CardContent Padding="24"><TextBlock Text="{Binding}" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:AspectRatio></c:Card>
                </DataTemplate>
              </Carousel.ItemTemplate>
            </Carousel>
            <TextBlock Classes="sm muted" Text="{Binding SlideText}" HorizontalAlignment="Center" />
            <Button Classes="outline sm" Content="Add a slide" Command="{Binding AddSlideCommand}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;StackPanel MaxWidth=&quot;320&quot; Margin=&quot;48,0&quot; Spacing=&quot;8&quot;&gt;&#10;  &lt;Carousel Classes=&quot;indicators&quot; ItemsSource=&quot;{Binding Slides}&quot; SelectedIndex=&quot;{Binding SlideIndex}&quot; WrapSelection=&quot;True&quot;&gt;&#10;    &lt;Carousel.ItemTemplate&gt;&#10;      &lt;DataTemplate x:DataType=&quot;x:Int32&quot;&gt;&#10;        &lt;c:Card&gt;&lt;c:AspectRatio Ratio=&quot;1&quot;&gt;&lt;c:CardContent Padding=&quot;24&quot;&gt;&lt;TextBlock Text=&quot;{Binding}&quot; FontSize=&quot;36&quot; FontWeight=&quot;SemiBold&quot; HorizontalAlignment=&quot;Center&quot; VerticalAlignment=&quot;Center&quot; /&gt;&lt;/c:CardContent&gt;&lt;/c:AspectRatio&gt;&lt;/c:Card&gt;&#10;      &lt;/DataTemplate&gt;&#10;    &lt;/Carousel.ItemTemplate&gt;&#10;  &lt;/Carousel&gt;&#10;  &lt;TextBlock Classes=&quot;sm muted&quot; Text=&quot;{Binding SlideText}&quot; HorizontalAlignment=&quot;Center&quot; /&gt;&#10;  &lt;Button Classes=&quot;outline sm&quot; Content=&quot;Add a slide&quot; Command=&quot;{Binding AddSlideCommand}&quot; HorizontalAlignment=&quot;Center&quot; /&gt;&#10;&lt;/StackPanel&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="API" />
      <StackPanel>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="Carousel" /><TextBlock Grid.Column="1" Classes="sm muted" Text="ItemsSource, ItemTemplate, SelectedIndex (two way), WrapSelection (loop), ViewportFraction, IsSwipeEnabled, PageTransition." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="Classes" /><TextBlock Grid.Column="1" Classes="sm muted" Text="vertical, indicators, align-start (slides narrower than the viewport start at its edge)." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="c:CarouselIndicators" /><TextBlock Grid.Column="1" Classes="sm muted" Text="The dots: Count, SelectedIndex (two way)." /></Grid></Border>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
