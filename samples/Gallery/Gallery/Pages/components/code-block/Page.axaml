      <Border Classes="code"><TextBlock Text="&lt;c:Collapsible MaxWidth=&quot;448&quot;&gt;&#10;&lt;c:CodeBlock MaxWidth=&quot;448&quot; Title=&quot;components/chat.tsx&quot;&gt;&#10;  &lt;c:CodeBlock.Actions&gt;&lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;4&quot;&gt;&lt;c:CodeBlockCopyButton Value=&quot;&amp;quot;use client&amp;quot;&amp;#10;&amp;#10;import * as React from &amp;quot;react&amp;quot;&amp;#10;import { useChat } from &amp;quot;@ai-sdk/react&amp;quot;&amp;#10;&amp;#10;import { Button } from &amp;quot;@/components/ui/button&amp;quot;&amp;#10;import { Input } from &amp;quot;@/components/ui/input&amp;quot;&amp;#10;&amp;#10;export function Chat() {&amp;#10;  const [input, setInput] = React.useState(&amp;quot;&amp;quot;)&amp;#10;  const { messages, sendMessage, status } = useChat()&amp;#10;&amp;#10;  return (&amp;#10;    &amp;lt;div className=&amp;quot;flex flex-col gap-4&amp;quot;&amp;gt;&amp;#10;      {messages.map((message) =&amp;gt; (&amp;#10;        &amp;lt;div key={message.id}&amp;gt;&amp;#10;          {message.parts.map((part, index) =&amp;gt;&amp;#10;            part.type === &amp;quot;text&amp;quot; ? &amp;lt;p key={index}&amp;gt;{part.text}&amp;lt;/p&amp;gt; : null&amp;#10;          )}&amp;#10;        &amp;lt;/div&amp;gt;&amp;#10;      ))}&amp;#10;      &amp;lt;form&amp;#10;        onSubmit={(event) =&amp;gt; {&amp;#10;          event.preventDefault()&amp;#10;          sendMessage({ text: input })&amp;#10;          setInput(&amp;quot;&amp;quot;)&amp;#10;        }}&amp;#10;      &amp;gt;&amp;#10;        &amp;lt;Input value={input} onChange={(event) =&amp;gt; setInput(event.target.value)} /&amp;gt;&amp;#10;        &amp;lt;Button disabled={status !== &amp;quot;ready&amp;quot;}&amp;gt;Send&amp;lt;/Button&amp;gt;&amp;#10;      &amp;lt;/form&amp;gt;&amp;#10;    &amp;lt;/div&amp;gt;&amp;#10;  )&amp;#10;}&quot; /&gt;&lt;/StackPanel&gt;&lt;/c:CodeBlock.Actions&gt;&#10;  &lt;c:CodeBlockContent Classes=&quot;show-more scroll&quot; LineNumbers=&quot;True&quot;&gt;&#10;    &lt;StackPanel&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;&amp;quot;use client&amp;quot;&quot; Foreground=&quot;{DynamicResource CosmoCodeStringBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot; &quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;import&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;*&quot; Foreground=&quot;{DynamicResource CosmoCodeConstantBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;as&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; React &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;from&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;&amp;quot;react&amp;quot;&quot; Foreground=&quot;{DynamicResource CosmoCodeStringBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;import&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; { useChat } &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;from&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;&amp;quot;@ai-sdk/react&amp;quot;&quot; Foreground=&quot;{DynamicResource CosmoCodeStringBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock T