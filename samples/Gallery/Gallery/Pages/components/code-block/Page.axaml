sh}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine IsVisible=&quot;{Binding Lines[28]}&quot;&gt;&lt;TextBlock Text=&quot; &quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine IsVisible=&quot;{Binding Lines[29]}&quot;&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;{Binding Tokens[169]}&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;{Binding Tokens[170]}&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot;{Binding Tokens[171]}&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;{Binding Tokens[172]}&quot; Foreground=&quot;{DynamicResource CosmoCodeFunctionBrush}&quot; /&gt;&lt;Run Text=&quot;{Binding Tokens[173]}&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine IsVisible=&quot;{Binding Lines[30]}&quot;&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;{Binding Tokens[174]}&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/c:CodeBlockContent&gt;&#10;&lt;/c:CodeBlock&gt;&#10;&lt;c:CodeBlock IsVisible=&quot;{Binding Blocks[4]}&quot; Title=&quot;.env.local&quot;&gt;&#10;  &lt;c:CodeBlock.Actions&gt;&lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;4&quot;&gt;&lt;c:CodeBlockCopyButton Value=&quot;AI_GATEWAY_API_KEY=your-api-key&quot; IsEnabled=&quot;{Binding Copies[4]}&quot; /&gt;&lt;/StackPanel&gt;&lt;/c:CodeBlock.Actions&gt;&#10;  &lt;c:CodeBlockContent&gt;&#10;    &lt;StackPanel&gt;&#10;      &lt;c:CodeBlockLine IsVisible=&quot;{Binding Lines[31]}&quot;&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;{Binding Tokens[175]}&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;{Binding Tokens[176]}&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot;{Binding Tokens[177]}&quot; Foreground=&quot;{DynamicResource CosmoCodeStringBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/c:CodeBlockContent&gt;&#10;&lt;/c:CodeBlock&gt;&#10;&lt;Button Classes=&quot;outline sm&quot; Height=&quot;28&quot; Padding=&quot;12,0&quot; CornerRadius=&quot;16&quot; HorizontalAlignment=&quot;Left&quot; IsEnabled=&quot;{Binding Idle}&quot; Command=&quot;{Binding ReplayCommand}&quot;&gt;&lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;4&quot;&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[Button].Foreground}&quot; Data=&quot;M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8 M3 3v5h5&quot; /&gt;&lt;/Viewbox&gt;&lt;TextBlock Text=&quot;Replay&quot; /&gt;&lt;/StackPanel&gt;&lt;/Button&gt;&#10;&lt;/StackPanel&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="In a trace" />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <c:Trace MaxWidth="448">
            <Expander Classes="trace" IsExpanded="True">
            <Expander.Header><c:TraceLine Content="Ran node --version"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox></c:TraceLine.Icon></c:TraceLine></Expander.Header>
            <c:CodeBlock Classes="sm">

            <c:CodeBlockContent Wrap="True">
              <StackPanel>
                <c:CodeBlockLine><TextBlock Text="$ node --version" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="v24.18.0" /></c:CodeBlockLine>
              </StackPanel>
            </c:CodeBlockContent>
          </c:CodeBlock>
          </Expander>
            <Expander Classes="trace" IsExpanded="True">
            <Expander.Header><c:TraceLine Content="Failed to run pnpm dev" Status="Error"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox></c:TraceLine.Icon></c:TraceLine></Expander.Header>
            <c:CodeBlock Classes="sm destructive">

            <c:CodeBlockContent Wrap="True">
              <StackPanel>
                <c:CodeBlockLine><TextBlock Text="$ pnpm dev" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="Error: listen EADDRINUSE: address already in use :::3000" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="    at Server.setupListenHandle [as _listen2] (node:net:1908:16)" /></c:CodeBlockLine>
              </StackPanel>
            </c:CodeBlockContent>
          </c:CodeBlock>
          </Expander>
          </c:Trace>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;c:Trace MaxWidth=&quot;448&quot;&gt;&#10;  &lt;Expander Classes=&quot;trace&quot; IsExpanded=&quot;True&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;Ran node --version&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M4,17 L10,11 L4,5 M12,19 L20,19&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&lt;/Expander.Header&gt;&#10;  &lt;c:CodeBlock Classes=&quot;sm&quot;&gt;&#10;&#10;  &lt;c:CodeBlockContent Wrap=&quot;True&quot;&gt;&#10;    &lt;StackPanel&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;$ node --version&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;v24.18.0&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/c:CodeBlockContent&gt;&#10;&lt;/c:CodeBlock&gt;&#10;&lt;/Expander&gt;&#10;  &lt;Expander Classes=&quot;trace&quot; IsExpanded=&quot;True&quot;&gt;&#10;  &lt;Expander.Header&gt;&lt;c:TraceLine Content=&quot;Failed to run pnpm dev&quot; Status=&quot;Error&quot;&gt;&lt;c:TraceLine.Icon&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[c:TraceLine].Foreground}&quot; Data=&quot;M4,17 L10,11 L4,5 M12,19 L20,19&quot; /&gt;&lt;/Viewbox&gt;&lt;/c:TraceLine.Icon&gt;&lt;/c:TraceLine&gt;&lt;/Expander.Header&gt;&#10;  &lt;c:CodeBlock Classes=&quot;sm destructive&quot;&gt;&#10;&#10;  &lt;c:CodeBlockContent Wrap=&quot;True&quot;&gt;&#10;    &lt;StackPanel&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;$ pnpm dev&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;Error: listen EADDRINUSE: address already in use :::3000&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;    at Server.setupListenHandle [as _listen2] (node:net:1908:16)&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/c:CodeBlockContent&gt;&#10;&lt;/c:CodeBlock&gt;&#10;&lt;/Expander&gt;&#10;&lt;/c:Trace&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="API" />
      <StackPanel>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="Title, Actions, Footer" /><TextBlock Grid.Column="1" Classes="sm muted" Text="The header&#x27;s title and buttons (the code-block class) and the row below the code." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="destructive, sm" /><TextBlock Grid.Column="1" Classes="sm muted" Text="The destructive tint and the smaller size." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="c:CodeBlockContent: LineNumbers, StartLine, Wrap" /><TextBlock Grid.Column="1" Classes="sm muted" Text="Numbered lines from StartLine; long lines wrapped instead of scrolling." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="c:CodeBlockLine: highlighted, added, removed" /><TextBlock Grid.Column="1" Classes="sm muted" Text="A tinted line, an added line (+) and a removed line (−)." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="floating" /><TextBlock Grid.Column="1" Classes="sm muted" Text="The actions over the code, shown under the pointer or the focus." /></Grid></Border>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
