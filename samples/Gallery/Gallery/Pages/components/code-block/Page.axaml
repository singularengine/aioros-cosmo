<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Web.Live="True" x:DataType="m:CodeBlockPlayback"
             a:Page.Title="Code Block" a:Page.Description="Displays code with a header, actions, line numbers, highlighted lines and diffs, highlighted when the XAML is written.">
  <StackPanel Spacing="32" MaxWidth="880" HorizontalAlignment="Left">
    <StackPanel Spacing="10">
      <TextBlock Classes="h1" Text="Code Block" />
      <TextBlock Classes="lead" Text="Displays code with a header, actions, line numbers, highlighted lines and diffs, highlighted when the XAML is written." />
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <c:Badge Classes="secondary" Content="shadcn/ui: code-block (radix-rhea)" />
        <c:Badge Classes="secondary" Content="Avalonia: ContentControl" />
        <c:Badge Classes="secondary" Content="Web: &lt;div&gt;" />
      </WrapPanel>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Usage" />
      <TextBlock Classes="sm muted" Text="c:CodeBlock with a Title, Actions and a c:CodeBlockContent of c:CodeBlockLines; the tokens are Runs on Cosmo&#x27;s code brushes (github-light and github-dark), written by shiki with the page." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <c:CodeBlock MaxWidth="512">
            <c:CodeBlock.Title><StackPanel Orientation="Horizontal" Spacing="6"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M10 12.5 8 15l2 2.5 M14 12.5 l2 2.5-2 2.5 M14 2v4a2 2 0 0 0 2 2h4 M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z" /></Viewbox><TextBlock Text="app/api/chat/route.ts" VerticalAlignment="Center" /></StackPanel></c:CodeBlock.Title><c:CodeBlock.Actions><StackPanel Orientation="Horizontal" Spacing="4"><Button Classes="code-block" AutomationProperties.Name="Wrap lines"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[Button].Foreground}" Data="M3,6 L21,6 M3 12h15a3 3 0 1 1 0 6h-4 M16,16 L14,18 L16,20 M3,18 L10,18" /></Viewbox></Button><Button Classes="code-block" AutomationProperties.Name="Download"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[Button].Foreground}" Data="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7,10 L12,15 L17,10 M12,15 L12,3" /></Viewbox></Button><c:CodeBlockCopyButton Value="import { streamText } from &quot;ai&quot;&#10;&#10;export async function POST(request: Request) {&#10;  const { messages } = await request.json()&#10;&#10;  const result = streamText({&#10;    model: &quot;anthropic/claude-sonnet-4.5&quot;,&#10;    system: &quot;You are a helpful assistant. Answer in one short paragraph.&quot;,&#10;    messages,&#10;  })&#10;&#10;  return result.toUIMessageStreamResponse()&#10;}" /></StackPanel></c:CodeBlock.Actions>
            <c:CodeBlockContent LineNumbers="True">
              <StackPanel>
                <c:CodeBlockLine><TextBlock><Run Text="import" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" { streamText } " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="from" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;ai&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /></TextBlock></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock><Run Text="export" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="async" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="function" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="POST" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="(" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="request" Foreground="{DynamicResource CosmoCodeVariableBrush}" /><Run Text=":" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="Request" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text=") {" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="const" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" { " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="messages" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=" } " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="await" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" request." Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="json" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="()" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
                <c:CodeBlockLine Classes="highlighted"><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="const" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="result" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="streamText" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="({" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
                <c:CodeBlockLine Classes="highlighted"><TextBlock><Run Text="    model: " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;anthropic/claude-sonnet-4.5&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /><Run Text="," Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
                <c:CodeBlockLine Classes="highlighted"><TextBlock><Run Text="    system: " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;You are a helpful assistant. Answer in one short paragraph.&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /><Run Text="," Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
                <c:CodeBlockLine Classes="highlighted"><TextBlock><Run Text="    messages," Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
                <c:CodeBlockLine Classes="highlighted"><TextBlock><Run Text="  })" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="return" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" result." Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="toUIMessageStreamResponse" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="()" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock><Run Text="}" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
              </StackPanel>
            </c:CodeBlockContent>
          </c:CodeBlock>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;c:CodeBlock MaxWidth=&quot;512&quot;&gt;&#10;  &lt;c:CodeBlock.Title&gt;&lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;6&quot;&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{DynamicResource CosmoForegroundBrush}&quot; Data=&quot;M10 12.5 8 15l2 2.5 M14 12.5 l2 2.5-2 2.5 M14 2v4a2 2 0 0 0 2 2h4 M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z&quot; /&gt;&lt;/Viewbox&gt;&lt;TextBlock Text=&quot;app/api/chat/route.ts&quot; VerticalAlignment=&quot;Center&quot; /&gt;&lt;/StackPanel&gt;&lt;/c:CodeBlock.Title&gt;&lt;c:CodeBlock.Actions&gt;&lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;4&quot;&gt;&lt;Button Classes=&quot;code-block&quot; AutomationProperties.Name=&quot;Wrap lines&quot;&gt;&lt;Viewbox Width=&quot;12&quot; Height=&quot;12&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[Button].Foreground}&quot; Data=&quot;M3,6 L21,6 M3 12h15a3 3 0 1 1 0 6h-4 M16,16 L14,18 L16,20 M3,18 L10,18&quot; /&gt;&lt;/Viewbox&gt;&lt;/Button&gt;&lt;Button Classes=&quot;code-block&quot; AutomationProperties.Name=&quot;Download&quot;&gt;&lt;Viewbox Width=&quot;12&quot; Height=&quot;12&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{Binding $parent[Button].Foreground}&quot; Data=&quot;M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7,10 L12,15 L17,10 M12,15 L12,3&quot; /&gt;&lt;/Viewbox&gt;&lt;/Button&gt;&lt;c:CodeBlockCopyButton Value=&quot;import { streamText } from &amp;quot;ai&amp;quot;&amp;#10;&amp;#10;export async function POST(request: Request) {&amp;#10;  const { messages } = await request.json()&amp;#10;&amp;#10;  const result = streamText({&amp;#10;    model: &amp;quot;anthropic/claude-sonnet-4.5&amp;quot;,&amp;#10;    system: &amp;quot;You are a helpful assistant. Answer in one short paragraph.&amp;quot;,&amp;#10;    messages,&amp;#10;  })&amp;#10;&amp;#10;  return result.toUIMessageStreamResponse()&amp;#10;}&quot; /&gt;&lt;/StackPanel&gt;&lt;/c:CodeBlock.Actions&gt;&#10;  &lt;c:CodeBlockContent LineNumbers=&quot;True&quot;&gt;&#10;    &lt;StackPanel&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;import&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; { streamText } &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;from&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;&amp;quot;ai&amp;quot;&quot; Foreground=&quot;{DynamicResource CosmoCodeStringBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot; &quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;export&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;async&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;function&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;POST&quot; Foreground=&quot;{DynamicResource CosmoCodeFunctionBrush}&quot; /&gt;&lt;Run Text=&quot;(&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;request&quot; Foreground=&quot;{DynamicResource CosmoCodeVariableBrush}&quot; /&gt;&lt;Run Text=&quot;:&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;Request&quot; Foreground=&quot;{DynamicResource CosmoCodeFunctionBrush}&quot; /&gt;&lt;Run Text=&quot;) {&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;  &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;const&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; { &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;messages&quot; Foreground=&quot;{DynamicResource CosmoCodeConstantBrush}&quot; /&gt;&lt;Run Text=&quot; } &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;=&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;await&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; request.&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;json&quot; Foreground=&quot;{DynamicResource CosmoCodeFunctionBrush}&quot; /&gt;&lt;Run Text=&quot;()&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot; &quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine Classes=&quot;highlighted&quot;&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;  &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;const&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;result&quot; Foreground=&quot;{DynamicResource CosmoCodeConstantBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;=&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;streamText&quot; Foreground=&quot;{DynamicResource CosmoCodeFunctionBrush}&quot; /&gt;&lt;Run Text=&quot;({&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine Classes=&quot;highlighted&quot;&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;    model: &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;&amp;quot;anthropic/claude-sonnet-4.5&amp;quot;&quot; Foreground=&quot;{DynamicResource CosmoCodeStringBrush}&quot; /&gt;&lt;Run Text=&quot;,&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine Classes=&quot;highlighted&quot;&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;    system: &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;&amp;quot;You are a helpful assistant. Answer in one short paragraph.&amp;quot;&quot; Foreground=&quot;{DynamicResource CosmoCodeStringBrush}&quot; /&gt;&lt;Run Text=&quot;,&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine Classes=&quot;highlighted&quot;&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;    messages,&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine Classes=&quot;highlighted&quot;&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;  })&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot; &quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;  &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;return&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; result.&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;toUIMessageStreamResponse&quot; Foreground=&quot;{DynamicResource CosmoCodeFunctionBrush}&quot; /&gt;&lt;Run Text=&quot;()&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;}&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/c:CodeBlockContent&gt;&#10;&lt;/c:CodeBlock&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Basic" />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <c:CodeBlock MaxWidth="448">

            <c:CodeBlockContent>
              <StackPanel>
                <c:CodeBlockLine><TextBlock Text="$ pnpm build" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="&gt; next build" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text=" ✓ Compiled successfully in 4.2s" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text=" ✓ Generating static pages (12/12)" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="Route (app)                Size  First Load JS" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="┌ ○ /                    1.9 kB         112 kB" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="├ ○ /_not-found           993 B         103 kB" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="└ ƒ /api/chat             141 B         102 kB" /></c:CodeBlockLine>
              </StackPanel>
            </c:CodeBlockContent>
          </c:CodeBlock>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;c:CodeBlock MaxWidth=&quot;448&quot;&gt;&#10;&#10;  &lt;c:CodeBlockContent&gt;&#10;    &lt;StackPanel&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;$ pnpm build&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;&amp;gt; next build&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot; &quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot; ✓ Compiled successfully in 4.2s&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot; ✓ Generating static pages (12/12)&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot; &quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;Route (app)                Size  First Load JS&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;┌ ○ /                    1.9 kB         112 kB&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;├ ○ /_not-found           993 B         103 kB&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;└ ƒ /api/chat             141 B         102 kB&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/c:CodeBlockContent&gt;&#10;&lt;/c:CodeBlock&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Header" />
      <TextBlock Classes="sm muted" Text="c:CodeBlockCopyButton copies its Value and shows a check for two seconds." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <c:CodeBlock MaxWidth="448">
            <c:CodeBlock.Title><StackPanel Orientation="Horizontal" Spacing="6"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox><TextBlock Text="Terminal" VerticalAlignment="Center" /></StackPanel></c:CodeBlock.Title><c:CodeBlock.Actions><StackPanel Orientation="Horizontal" Spacing="4"><c:CodeBlockCopyButton Value="pnpm add ai @ai-sdk/react zod" /></StackPanel></c:CodeBlock.Actions>
            <c:CodeBlockContent>
              <StackPanel>
                <c:CodeBlockLine><TextBlock Text="$ pnpm add ai @ai-sdk/react zod" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="Packages: +14" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="Progress: resolved 412, reused 398, downloaded 14, added 14, done" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="Done in 2.8s using pnpm v10.18.0" /></c:CodeBlockLine>
              </StackPanel>
            </c:CodeBlockContent>
          </c:CodeBlock>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;c:CodeBlock MaxWidth=&quot;448&quot;&gt;&#10;  &lt;c:CodeBlock.Title&gt;&lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;6&quot;&gt;&lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{DynamicResource CosmoForegroundBrush}&quot; Data=&quot;M4,17 L10,11 L4,5 M12,19 L20,19&quot; /&gt;&lt;/Viewbox&gt;&lt;TextBlock Text=&quot;Terminal&quot; VerticalAlignment=&quot;Center&quot; /&gt;&lt;/StackPanel&gt;&lt;/c:CodeBlock.Title&gt;&lt;c:CodeBlock.Actions&gt;&lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;4&quot;&gt;&lt;c:CodeBlockCopyButton Value=&quot;pnpm add ai @ai-sdk/react zod&quot; /&gt;&lt;/StackPanel&gt;&lt;/c:CodeBlock.Actions&gt;&#10;  &lt;c:CodeBlockContent&gt;&#10;    &lt;StackPanel&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;$ pnpm add ai @ai-sdk/react zod&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;Packages: +14&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;Progress: resolved 412, reused 398, downloaded 14, added 14, done&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot;Done in 2.8s using pnpm v10.18.0&quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/c:CodeBlockContent&gt;&#10;&lt;/c:CodeBlock&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Line numbers" />
      <TextBlock Classes="sm muted" Text="LineNumbers numbers the lines from StartLine." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <c:CodeBlock MaxWidth="448">

            <c:CodeBlockContent LineNumbers="True">
              <StackPanel>
                <c:CodeBlockLine><TextBlock Text="{}{" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="  &quot;name&quot;: &quot;chat&quot;," /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="  &quot;private&quot;: true," /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="  &quot;scripts&quot;: {" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="    &quot;dev&quot;: &quot;next dev&quot;," /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="    &quot;build&quot;: &quot;next build&quot;" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="  }" /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text="}" /></c:CodeBlockLine>
              </StackPanel>
            </c:CodeBlockContent>
          </c:CodeBlock>
