;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;import&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; { streamText } &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;from&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;&amp;quot;ai&amp;quot;&quot; Foreground=&quot;{DynamicResource CosmoCodeStringBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot; &quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;export&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;async&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;function&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;POST&quot; Foreground=&quot;{DynamicResource CosmoCodeFunctionBrush}&quot; /&gt;&lt;Run Text=&quot;(&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;request&quot; Foreground=&quot;{DynamicResource CosmoCodeVariableBrush}&quot; /&gt;&lt;Run Text=&quot;:&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;Request&quot; Foreground=&quot;{DynamicResource CosmoCodeFunctionBrush}&quot; /&gt;&lt;Run Text=&quot;) {&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;  &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;const&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; { &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;messages&quot; Foreground=&quot;{DynamicResource CosmoCodeConstantBrush}&quot; /&gt;&lt;Run Text=&quot; } &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;=&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;await&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; request.&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;json&quot; Foreground=&quot;{DynamicResource CosmoCodeFunctionBrush}&quot; /&gt;&lt;Run Text=&quot;()&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;  &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;const&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;result&quot; Foreground=&quot;{DynamicResource CosmoCodeConstantBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;=&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;streamText&quot; Foreground=&quot;{DynamicResource CosmoCodeFunctionBrush}&quot; /&gt;&lt;Run Text=&quot;({ model: &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;&amp;quot;anthropic/claude-sonnet-4.5&amp;quot;&quot; Foreground=&quot;{DynamicResource CosmoCodeStringBrush}&quot; /&gt;&lt;Run Text=&quot;, messages })&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot; &quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;  &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;return&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; result.&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;toUIMessageStreamResponse&quot; Foreground=&quot;{DynamicResource CosmoCodeFunctionBrush}&quot; /&gt;&lt;Run Text=&quot;()&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;}&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/c:CodeBlockContent&gt;&#10;&lt;/c:CodeBlock&gt;&#10;  &lt;TextBlock Classes=&quot;typeset&quot; TextWrapping=&quot;Wrap&quot; FontSize=&quot;16&quot; LineHeight=&quot;28&quot; Margin=&quot;0,20,0,0&quot;&gt;&lt;Run Text=&quot;The &quot; /&gt;&lt;InlineUIContainer&gt;&lt;Border Classes=&quot;typeset-code&quot;&gt;&lt;TextBlock Text=&quot;useChat&quot; /&gt;&lt;/Border&gt;&lt;/InlineUIContainer&gt;&lt;Run Text=&quot; hook reads the stream on the client and renders the answer while it is written.&quot; /&gt;&lt;/TextBlock&gt;&#10;&lt;/StackPanel&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Markdown" />
      <TextBlock Classes="sm muted" Text="c:Markdown writes fenced blocks as code blocks; Replay streams the answer in, its fence highlighted as far as it has come." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <StackPanel DataContext="{Binding Markdown}" MaxWidth="448" Spacing="16" Margin="0,24">
            <c:Message IsVisible="{Binding Chat.Asked}" Classes="end"><c:MessageContent><c:Bubble Classes="muted" Content="How do I debounce a search input in React?" /></c:MessageContent></c:Message>
            <c:Message IsVisible="{Binding Chat.Answering}"><c:MessageContent><c:Markdown Text="{Binding Chat.Answer}" LineNumbers="False" /></c:MessageContent></c:Message>
            <Button Classes="outline sm" Height="28" Padding="12,0" CornerRadius="16" HorizontalAlignment="Left" Content="Replay" IsVisible="{Binding Chat.Idle}" Command="{Binding ReplayCommand}" />
          </StackPanel>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;StackPanel DataContext=&quot;{Binding Markdown}&quot; MaxWidth=&quot;448&quot; Spacing=&quot;16&quot; Margin=&quot;0,24&quot;&gt;&#10;  &lt;c:Message IsVisible=&quot;{Binding Chat.Asked}&quot; Classes=&quot;end&quot;&gt;&lt;c:MessageContent&gt;&lt;c:Bubble Classes=&quot;muted&quot; Content=&quot;How do I debounce a search input in React?&quot; /&gt;&lt;/c:MessageContent&gt;&lt;/c:Message&gt;&#10;  &lt;c:Message IsVisible=&quot;{Binding Chat.Answering}&quot;&gt;&lt;c:MessageContent&gt;&lt;c:Markdown Text=&quot;{Binding Chat.Answer}&quot; LineNumbers=&quot;False&quot; /&gt;&lt;/c:MessageContent&gt;&lt;/c:Message&gt;&#10;  &lt;Button Classes=&quot;outline sm&quot; Height=&quot;28&quot; Padding=&quot;12,0&quot; CornerRadius=&quot;16&quot; HorizontalAlignment=&quot;Left&quot; Content=&quot;Replay&quot; IsVisible=&quot;{Binding Chat.Idle}&quot; Command=&quot;{Binding ReplayCommand}&quot; /&gt;&#10;&lt;/StackPanel&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Chat" />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <StackPanel MaxWidth="448" Spacing="16">
            <c:Message Classes="end"><c:MessageContent><c:Bubble Classes="muted" Content="How do I stream a response?" /></c:MessageContent></c:Message>
            <c:Message><c:MessageContent Spacing="12"><TextBlock Text="Create a route handler that returns the stream:" TextWrapping="Wrap" /><c:CodeBlock Title="app/api/chat/route.ts">
            <c:CodeBlock.Actions><StackPanel Orientation="Horizontal" Spacing="4"><c:CodeBlockCopyButton Value="import { streamText } from &quot;ai&quot;&#10;&#10;export async function POST(request: Request) {&#10;  const { messages } = await request.json()&#10;&#10;  const result = streamText({&#10;    model: &quot;anthropic/claude-sonnet-4.5&quot;,&#10;    messages,&#10;  })&#10;&#10;  return result.toUIMessageStreamResponse()&#10;}" /></StackPanel></c:CodeBlock.Actions>
            <c:CodeBlockContent>
              <StackPanel>
                <c:CodeBlockLine><TextBlock><Run Text="import" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" { streamText } " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="from" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;ai&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /></TextBlock></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock><Run Text="export" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="async" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="function" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="POST" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="(" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="request" Foreground="{DynamicResource CosmoCodeVariableBrush}" /><Run Text=":" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="Request" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text=") {" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="const" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" { " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="messages" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=" } " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="await" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" request." Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="json" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="()" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="const" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="result" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="streamText" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="({" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock><Run Text="    model: " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;anthropic/claude-sonnet-4.5&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /><Run Text="," Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock><Run Text="    messages," Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock><Run Text="  })" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="return" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" result." Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="toUIMessageStreamResponse" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="()" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
                <c:CodeBlockLine><TextBlock><Run Text="}" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
              </StackPanel>
            </c:CodeBlockContent>
          </c:CodeBlock><TextBlock Text="The client reads it with useChat." TextWrapping="Wrap" /></c:MessageContent></c:Message>
          </StackPanel>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;StackPanel MaxWidth=&quot;448&quot; Spacing=&quot;16&quot;&gt;&#10;  &lt;c:Message Classes=&quot;end&quot;&gt;&lt;c:MessageContent&gt;&lt;c:Bubble Classes=&quot;muted&quot; Content=&quot;How do I stream a response?&quot; /&gt;&lt;/c:MessageContent&gt;&lt;/c:Message&gt;&#10;  &lt;c:Message&gt;&lt;c:MessageContent Spacing=&quot;12&quot;&gt;&lt;TextBlock Text=&quot;Create a route handler that returns the stream:&quot; TextWrapping=&quot;Wrap&quot; /&gt;&lt;c:CodeBlock Title=&quot;app/api/chat/route.ts&quot;&gt;&#10;  &lt;c:CodeBlock.Actions&gt;&lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;4&quot;&gt;&lt;c:CodeBlockCopyButton Value=&quot;import { streamText } from &amp;quot;ai&amp;quot;&amp;#10;&amp;#10;export async function POST(request: Request) {&amp;#10;  const { messages } = await request.json()&amp;#10;&amp;#10;  const result = streamText({&amp;#10;    model: &amp;quot;anthropic/claude-sonnet-4.5&amp;quot;,&amp;#10;    messages,&amp;#10;  })&amp;#10;&amp;#10;  return result.toUIMessageStreamResponse()&amp;#10;}&quot; /&gt;&lt;/StackPanel&gt;&lt;/c:CodeBlock.Actions&gt;&#10;  &lt;c:CodeBlockContent&gt;&#10;    &lt;StackPanel&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;import&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; { streamText } &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;from&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;&amp;quot;ai&amp;quot;&quot; Foreground=&quot;{DynamicResource CosmoCodeStringBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot; &quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;export&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;async&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;function&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;POST&quot; Foreground=&quot;{DynamicResource CosmoCodeFunctionBrush}&quot; /&gt;&lt;Run Text=&quot;(&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;request&quot; Foreground=&quot;{DynamicResource CosmoCodeVariableBrush}&quot; /&gt;&lt;Run Text=&quot;:&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;Request&quot; Foreground=&quot;{DynamicResource CosmoCodeFunctionBrush}&quot; /&gt;&lt;Run Text=&quot;) {&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;  &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;const&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; { &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;messages&quot; Foreground=&quot;{DynamicResource CosmoCodeConstantBrush}&quot; /&gt;&lt;Run Text=&quot; } &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;=&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;await&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; request.&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;json&quot; Foreground=&quot;{DynamicResource CosmoCodeFunctionBrush}&quot; /&gt;&lt;Run Text=&quot;()&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot; &quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;  &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;const&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;result&quot; Foreground=&quot;{DynamicResource CosmoCodeConstantBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;=&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;streamText&quot; Foreground=&quot;{DynamicResource CosmoCodeFunctionBrush}&quot; /&gt;&lt;Run Text=&quot;({&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;    model: &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;&amp;quot;anthropic/claude-sonnet-4.5&amp;quot;&quot; Foreground=&quot;{DynamicResource CosmoCodeStringBrush}&quot; /&gt;&lt;Run Text=&quot;,&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;    messages,&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;  })&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock Text=&quot; &quot; /&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;  &quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;return&quot; Foreground=&quot;{DynamicResource CosmoCodeKeywordBrush}&quot; /&gt;&lt;Run Text=&quot; result.&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;Run Text=&quot;toUIMessageStreamResponse&quot; Foreground=&quot;{DynamicResource CosmoCodeFunctionBrush}&quot; /&gt;&lt;Run Text=&quot;()&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;      &lt;c:CodeBlockLine&gt;&lt;TextBlock&gt;&lt;Run Text=&quot;}&quot; Foreground=&quot;{DynamicResource CosmoCodeTextBrush}&quot; /&gt;&lt;/TextBlock&gt;&lt;/c:CodeBlockLine&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/c:CodeBlockContent&gt;&#10;&lt;/c:CodeBlock&gt;&lt;TextBlock Text=&quot;The client reads it with useChat.&quot; TextWrapping=&quot;Wrap&quot; /&gt;&lt;/c:MessageContent&gt;&lt;/c:Message&gt;&#10;&lt;/StackPanel&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Streaming" />
      <TextBlock Classes="sm muted" Text="Replay streams the blocks in again from the page&#x27;s model, three characters every 16 ms; on the web the page streams each change." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <StackPanel DataContext="{Binding Streaming}" MaxWidth="448" Spacing="16">
          <c:CodeBlock IsVisible="{Binding Blocks[0]}" Title="hooks/use-debounce.ts">
            <c:CodeBlock.Actions><StackPanel Orientation="Horizontal" Spacing="4"><c:CodeBlockCopyButton Value="export function useDebounce&lt;T&gt;(value: T, delay = 300) {&#10;  const [debounced, setDebounced] = React.useState(value)&#10;&#10;  React.useEffect(() =&gt; {&#10;    const timeout = setTimeout(() =&gt; setDebounced(value), delay)&#10;    return () =&gt; clearTimeout(timeout)&#10;  }, [value, delay])&#10;&#10;  return debounced&#10;}" IsEnabled="{Binding Copies[0]}" /></StackPanel></c:CodeBlock.Actions>
            <c:CodeBlockContent LineNumbers="True">
              <StackPanel>
                <c:CodeBlockLine IsVisible="{Binding Lines[0]}"><TextBlock><Run Text="{Binding Tokens[0]}" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="{Binding Tokens[1]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[2]}" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="{Binding Tokens[3]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[4]}" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="{Binding Tokens[5]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[6]}" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="{Binding Tokens[7]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[8]}" Foreground="{DynamicResource CosmoCodeVariableBrush}" /><Run Text="{Binding Tokens[9]}" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="{Binding Tokens[10]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[11]}" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="{Binding Tokens[12]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[13]}" Foreground="{DynamicResource CosmoCodeVariableBrush}" /><Run Text="{Binding Tokens[14]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[15]}" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="{Binding Tokens[16]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[17]}" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text="{Binding Tokens[18]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
                <c:CodeBlockLine IsVisible="{Binding Lines[1]}"><TextBlock><Run Text="{Binding Tokens[19]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[20]}" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="{Binding Tokens[21]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[22]}" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text="{Binding Tokens[23]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[24]}" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text="{Binding Tokens[25]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[26]}" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="{Binding Tokens[27]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[28]}" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="{Binding Tokens[29]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
