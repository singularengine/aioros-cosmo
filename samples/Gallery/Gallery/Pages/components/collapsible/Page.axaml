<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" x:DataType="m:NavigationExamples"
             a:Page.Title="Collapsible" a:Page.Description="An interactive component which expands/collapses a panel.">
  <StackPanel Spacing="32" MaxWidth="880" HorizontalAlignment="Left">
    <StackPanel Spacing="10">
      <TextBlock Classes="h1" Text="Collapsible" />
      <TextBlock Classes="lead" Text="An interactive component which expands/collapses a panel." />
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <c:Badge Classes="secondary" Content="shadcn/ui: collapsible" />
        <c:Badge Classes="secondary" Content="Avalonia: Expander with collapsible" />
        <c:Badge Classes="secondary" Content="Web: &lt;details&gt;" />
      </WrapPanel>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Usage" />
      <TextBlock Classes="sm muted" Text="An Expander with the collapsible class: the header toggles it, the chevrons sit at its top right (inset by Padding); IsExpanded binds two way." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Expander Classes="collapsible" MaxWidth="350" Padding="0,0,16,0" IsExpanded="{Binding Starred}">
            <Expander.Header>
              <StackPanel Spacing="8">
                <Grid Height="32">
                  <TextBlock Text="@peduarte starred 3 repositories" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
                <Border CornerRadius="{DynamicResource CosmoRadiusMd}" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" Padding="16,8">
                  <TextBlock Text="@radix-ui/primitives" FontFamily="{DynamicResource CosmoFontMono}" FontSize="14" />
                </Border>
              </StackPanel>
            </Expander.Header>
            <StackPanel Spacing="8">
              <Border CornerRadius="{DynamicResource CosmoRadiusMd}" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" Padding="16,8">
                <TextBlock Text="@radix-ui/colors" FontFamily="{DynamicResource CosmoFontMono}" FontSize="14" />
              </Border>
              <Border CornerRadius="{DynamicResource CosmoRadiusMd}" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" Padding="16,8">
                <TextBlock Text="@stitches/react" FontFamily="{DynamicResource CosmoFontMono}" FontSize="14" />
              </Border>
            </StackPanel>
          </Expander>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Expander Classes=&quot;collapsible&quot; MaxWidth=&quot;350&quot; Padding=&quot;0,0,16,0&quot; IsExpanded=&quot;{Binding Starred}&quot;&gt;&#10;  &lt;Expander.Header&gt;&#10;    &lt;StackPanel Spacing=&quot;8&quot;&gt;&#10;      &lt;Grid Height=&quot;32&quot;&gt;&#10;        &lt;TextBlock Text=&quot;@peduarte starred 3 repositories&quot; FontSize=&quot;14&quot; FontWeight=&quot;SemiBold&quot; VerticalAlignment=&quot;Center&quot; Margin=&quot;16,0,0,0&quot; /&gt;&#10;      &lt;/Grid&gt;&#10;      &lt;Border CornerRadius=&quot;{DynamicResource CosmoRadiusMd}&quot; BorderThickness=&quot;1&quot; BorderBrush=&quot;{DynamicResource CosmoBorderBrush}&quot; Padding=&quot;16,8&quot;&gt;&#10;        &lt;TextBlock Text=&quot;@radix-ui/primitives&quot; FontFamily=&quot;{DynamicResource CosmoFontMono}&quot; FontSize=&quot;14&quot; /&gt;&#10;      &lt;/Border&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/Expander.Header&gt;&#10;  &lt;StackPanel Spacing=&quot;8&quot;&gt;&#10;    &lt;Border CornerRadius=&quot;{DynamicResource CosmoRadiusMd}&quot; BorderThickness=&quot;1&quot; BorderBrush=&quot;{DynamicResource CosmoBorderBrush}&quot; Padding=&quot;16,8&quot;&gt;&#10;      &lt;TextBlock Text=&quot;@radix-ui/colors&quot; FontFamily=&quot;{DynamicResource CosmoFontMono}&quot; FontSize=&quot;14&quot; /&gt;&#10;    &lt;/Border&gt;&#10;    &lt;Border CornerRadius=&quot;{DynamicResource CosmoRadiusMd}&quot; BorderThickness=&quot;1&quot; BorderBrush=&quot;{DynamicResource CosmoBorderBrush}&quot; Padding=&quot;16,8&quot;&gt;&#10;      &lt;TextBlock Text=&quot;@stitches/react&quot; FontFamily=&quot;{DynamicResource CosmoFontMono}&quot; FontSize=&quot;14&quot; /&gt;&#10;    &lt;/Border&gt;&#10;  &lt;/StackPanel&gt;&#10;&lt;/Expander&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="API" />
      <StackPanel>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="IsExpanded" /><TextBlock Grid.Column="1" Classes="sm muted" Text="Two way (Radix&#x27;s open and onOpenChange)." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="Header, Content" /><TextBlock Grid.Column="1" Classes="sm muted" Text="The trigger and the panel." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="Padding" /><TextBlock Grid.Column="1" Classes="sm muted" Text="Insets the toggle from the header&#x27;s top right." /></Grid></Border>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
