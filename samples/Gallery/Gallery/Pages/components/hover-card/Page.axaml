<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" x:DataType="m:OverlayExamples"
             a:Page.Title="Hover Card" a:Page.Description="For sighted users to preview content available behind a link.">
  <StackPanel Spacing="32" MaxWidth="880" HorizontalAlignment="Left">
    <StackPanel Spacing="10">
      <TextBlock Classes="h1" Text="Hover Card" />
      <TextBlock Classes="lead" Text="For sighted users to preview content available behind a link." />
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <c:Badge Classes="secondary" Content="shadcn/ui: hover-card" />
        <c:Badge Classes="secondary" Content="Cosmo: c:HoverCard" />
      </WrapPanel>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Usage" />
      <TextBlock Classes="sm muted" Text="The card opens after the pointer rests 700 ms on the link (or the link takes the focus with Tab), stays while the pointer is over the link or the card, and closes 300 ms after it left both." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center">
          <HyperlinkButton Classes="link" Content="@nextjs" NavigateUri="https://nextjs.org" c:HoverCard.Placement="Bottom">
            <c:HoverCard.Card>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                  <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource CosmoMutedBrush}" VerticalAlignment="Top">
                    <TextBlock Classes="sm muted" Text="VC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="sm" Text="{Binding User.Handle}" FontWeight="SemiBold" />
                    <TextBlock Classes="sm" Text="{Binding User.About}" TextWrapping="Wrap" />
                    <TextBlock Classes="xs muted" Text="{Binding User.Joined, StringFormat='Joined {0}'}" />
                  </StackPanel>
                </Grid>
            </c:HoverCard.Card>
          </HyperlinkButton>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;HyperlinkButton Classes=&quot;link&quot; Content=&quot;@nextjs&quot; NavigateUri=&quot;https://nextjs.org&quot; c:HoverCard.Placement=&quot;Bottom&quot;&gt;&#10;  &lt;c:HoverCard.Card&gt;&#10;      &lt;Grid ColumnDefinitions=&quot;Auto,*&quot; ColumnSpacing=&quot;16&quot;&gt;&#10;        &lt;Border Width=&quot;32&quot; Height=&quot;32&quot; CornerRadius=&quot;16&quot; Background=&quot;{DynamicResource CosmoMutedBrush}&quot; VerticalAlignment=&quot;Top&quot;&gt;&#10;          &lt;TextBlock Classes=&quot;sm muted&quot; Text=&quot;VC&quot; HorizontalAlignment=&quot;Center&quot; VerticalAlignment=&quot;Center&quot; /&gt;&#10;        &lt;/Border&gt;&#10;        &lt;StackPanel Grid.Column=&quot;1&quot; Spacing=&quot;4&quot;&gt;&#10;          &lt;TextBlock Classes=&quot;sm&quot; Text=&quot;{Binding User.Handle}&quot; FontWeight=&quot;SemiBold&quot; /&gt;&#10;          &lt;TextBlock Classes=&quot;sm&quot; Text=&quot;{Binding User.About}&quot; TextWrapping=&quot;Wrap&quot; /&gt;&#10;          &lt;TextBlock Classes=&quot;xs muted&quot; Text=&quot;{Binding User.Joined, StringFormat=&#x27;Joined {0}&#x27;}&quot; /&gt;&#10;        &lt;/StackPanel&gt;&#10;      &lt;/Grid&gt;&#10;  &lt;/c:HoverCard.Card&gt;&#10;&lt;/HyperlinkButton&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Delays" />
      <Border Classes="preview">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button Classes="outline" Content="Quick card" c:HoverCard.OpenDelay="0" c:HoverCard.CloseDelay="0">
            <c:HoverCard.Card>
              <TextBlock Classes="sm" Text="Opens at once, closes as the pointer leaves." TextWrapping="Wrap" />
            </c:HoverCard.Card>
          </Button>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Button Classes=&quot;outline&quot; Content=&quot;Quick card&quot; c:HoverCard.OpenDelay=&quot;0&quot; c:HoverCard.CloseDelay=&quot;0&quot;&gt;&#10;  &lt;c:HoverCard.Card&gt;&#10;    &lt;TextBlock Classes=&quot;sm&quot; Text=&quot;Opens at once, closes as the pointer leaves.&quot; TextWrapping=&quot;Wrap&quot; /&gt;&#10;  &lt;/c:HoverCard.Card&gt;&#10;&lt;/Button&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="API" />
      <StackPanel>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="c:HoverCard.Card" /><TextBlock Grid.Column="1" Classes="sm muted" Text="The card&#x27;s content, in the page&#x27;s data context (compiled bindings)." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="c:HoverCard.OpenDelay, CloseDelay" /><TextBlock Grid.Column="1" Classes="sm muted" Text="Radix&#x27;s openDelay (700 ms) and closeDelay (300 ms)." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="c:HoverCard.Placement" /><TextBlock Grid.Column="1" Classes="sm muted" Text="Bottom (centered) by default." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="FlyoutPresenter.hover-card" /><TextBlock Grid.Column="1" Classes="sm muted" Text="The card&#x27;s surface (256 px, w-64), restylable by the app." /></Grid></Border>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
