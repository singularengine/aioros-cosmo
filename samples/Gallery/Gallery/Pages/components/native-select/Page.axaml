<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models"
             a:Page.Title="Native Select" a:Page.Description="A styled native HTML select element with consistent design system integration.">
  <StackPanel Spacing="32" MaxWidth="880" HorizontalAlignment="Left">
    <StackPanel Spacing="10">
      <TextBlock Classes="h1" Text="Native Select" />
      <TextBlock Classes="lead" Text="A styled native HTML select element with consistent design system integration." />
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <c:Badge Classes="secondary" Content="shadcn/ui: native-select" />
        <c:Badge Classes="secondary" Content="Avalonia: ComboBox" />
        <c:Badge Classes="secondary" Content="Web: &lt;select&gt;" />
      </WrapPanel>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Usage" />
      <TextBlock Classes="sm muted" Text="On the web Aioros writes every ComboBox as a native &lt;select&gt;, which is what shadcn&#x27;s NativeSelect is; on the desktop it opens Cosmo&#x27;s drop-down." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center">
          <ComboBox Classes="native" SelectedIndex="0">
            <ComboBoxItem Content="Select status" />
            <ComboBoxItem Content="Todo" />
            <ComboBoxItem Content="In Progress" />
            <ComboBoxItem Content="Done" />
            <ComboBoxItem Content="Cancelled" />
          </ComboBox>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;ComboBox Classes=&quot;native&quot; SelectedIndex=&quot;0&quot;&gt;&#10;  &lt;ComboBoxItem Content=&quot;Select status&quot; /&gt;&#10;  &lt;ComboBoxItem Content=&quot;Todo&quot; /&gt;&#10;  &lt;ComboBoxItem Content=&quot;In Progress&quot; /&gt;&#10;  &lt;ComboBoxItem Content=&quot;Done&quot; /&gt;&#10;  &lt;ComboBoxItem Content=&quot;Cancelled&quot; /&gt;&#10;&lt;/ComboBox&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Small" />
      <Border Classes="preview">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center">
          <ComboBox Classes="native sm" SelectedIndex="0">
            <ComboBoxItem Content="Todo" />
            <ComboBoxItem Content="Done" />
          </ComboBox>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;ComboBox Classes=&quot;native sm&quot; SelectedIndex=&quot;0&quot;&gt;&#10;  &lt;ComboBoxItem Content=&quot;Todo&quot; /&gt;&#10;  &lt;ComboBoxItem Content=&quot;Done&quot; /&gt;&#10;&lt;/ComboBox&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Disabled" />
      <Border Classes="preview">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center">
          <ComboBox Classes="native" SelectedIndex="0" IsEnabled="False">
            <ComboBoxItem Content="Todo" />
          </ComboBox>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;ComboBox Classes=&quot;native&quot; SelectedIndex=&quot;0&quot; IsEnabled=&quot;False&quot;&gt;&#10;  &lt;ComboBoxItem Content=&quot;Todo&quot; /&gt;&#10;&lt;/ComboBox&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="API" />
      <StackPanel>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="native" /><TextBlock Grid.Column="1" Classes="sm muted" Text="The chevron 14 px from the right edge, as NativeSelect places it." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="sm" /><TextBlock Grid.Column="1" Classes="sm muted" Text="32 px high." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="SelectedIndex, SelectedItem" /><TextBlock Grid.Column="1" Classes="sm muted" Text="Two-way bindable selection; a post selects the chosen option." /></Grid></Border>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
