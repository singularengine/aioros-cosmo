<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" x:DataType="m:DisplayExamples"
             a:Page.Title="Kbd" a:Page.Description="Used to display textual user input from keyboard.">
  <StackPanel Spacing="32" MaxWidth="880" HorizontalAlignment="Left">
    <StackPanel Spacing="10">
      <TextBlock Classes="h1" Text="Kbd" />
      <TextBlock Classes="lead" Text="Used to display textual user input from keyboard." />
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <c:Badge Classes="secondary" Content="shadcn/ui: kbd" />
        <c:Badge Classes="secondary" Content="Cosmo: c:Kbd, c:KbdGroup" />
        <c:Badge Classes="secondary" Content="Web: &lt;div&gt;" />
      </WrapPanel>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Usage" />
      <TextBlock Classes="sm muted" Text="A key is 20 px high on --muted; a group puts its keys 4 px apart." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="16">
            <c:KbdGroup>
              <c:Kbd Content="⌘" />
              <c:Kbd Content="⇧" />
              <c:Kbd Content="⌥" />
              <c:Kbd Content="⌃" />
            </c:KbdGroup>
            <c:KbdGroup>
              <c:Kbd Content="Ctrl" />
              <TextBlock Text="+" />
              <c:Kbd Content="B" />
            </c:KbdGroup>
          </StackPanel>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;StackPanel Spacing=&quot;16&quot;&gt;&#10;  &lt;c:KbdGroup&gt;&#10;    &lt;c:Kbd Content=&quot;⌘&quot; /&gt;&#10;    &lt;c:Kbd Content=&quot;⇧&quot; /&gt;&#10;    &lt;c:Kbd Content=&quot;⌥&quot; /&gt;&#10;    &lt;c:Kbd Content=&quot;⌃&quot; /&gt;&#10;  &lt;/c:KbdGroup&gt;&#10;  &lt;c:KbdGroup&gt;&#10;    &lt;c:Kbd Content=&quot;Ctrl&quot; /&gt;&#10;    &lt;TextBlock Text=&quot;+&quot; /&gt;&#10;    &lt;c:Kbd Content=&quot;B&quot; /&gt;&#10;  &lt;/c:KbdGroup&gt;&#10;&lt;/StackPanel&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Button" />
      <Border Classes="preview">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Button Classes="outline sm" Padding="12,0,8,0">
              <StackPanel><TextBlock Text="Accept" /><c:Kbd Content="⏎" /></StackPanel>
            </Button>
            <Button Classes="outline sm" Padding="12,0,8,0">
              <StackPanel><TextBlock Text="Cancel" /><c:Kbd Content="Esc" /></StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;16&quot;&gt;&#10;  &lt;Button Classes=&quot;outline sm&quot; Padding=&quot;12,0,8,0&quot;&gt;&#10;    &lt;StackPanel&gt;&lt;TextBlock Text=&quot;Accept&quot; /&gt;&lt;c:Kbd Content=&quot;⏎&quot; /&gt;&lt;/StackPanel&gt;&#10;  &lt;/Button&gt;&#10;  &lt;Button Classes=&quot;outline sm&quot; Padding=&quot;12,0,8,0&quot;&gt;&#10;    &lt;StackPanel&gt;&lt;TextBlock Text=&quot;Cancel&quot; /&gt;&lt;c:Kbd Content=&quot;Esc&quot; /&gt;&lt;/StackPanel&gt;&#10;  &lt;/Button&gt;&#10;&lt;/StackPanel&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Tooltip" />
      <Border Classes="preview">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button Classes="outline" Content="Save">
            <ToolTip.Tip>
              <StackPanel Orientation="Horizontal" Spacing="3">
                <TextBlock Text="Save Changes" VerticalAlignment="Center" />
                <c:Kbd Content="S" />
              </StackPanel>
            </ToolTip.Tip>
          </Button>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Button Classes=&quot;outline&quot; Content=&quot;Save&quot;&gt;&#10;  &lt;ToolTip.Tip&gt;&#10;    &lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;3&quot;&gt;&#10;      &lt;TextBlock Text=&quot;Save Changes&quot; VerticalAlignment=&quot;Center&quot; /&gt;&#10;      &lt;c:Kbd Content=&quot;S&quot; /&gt;&#10;    &lt;/StackPanel&gt;&#10;  &lt;/ToolTip.Tip&gt;&#10;&lt;/Button&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Binding" />
      <TextBlock Classes="sm muted" Text="The key&#x27;s Content binds through a converter; post the toggle to switch." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <CheckBox Content="Use Mac keys" IsChecked="{Binding UseMacKeys}" />
              <Button Classes="outline sm" Content="Apply" Command="{Binding ApplyKeysCommand}" />
            </StackPanel>
            <c:KbdGroup>
              <c:Kbd><TextBlock Text="{Binding UseMacKeys, Converter={x:Static m:DisplayExamples.MacKey}}" /></c:Kbd>
              <c:Kbd Content="K" />
            </c:KbdGroup>
            <TextBlock Classes="sm muted" Text="{Binding KeysStatus}" />
          </StackPanel>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;StackPanel Spacing=&quot;12&quot;&gt;&#10;  &lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;12&quot;&gt;&#10;    &lt;CheckBox Content=&quot;Use Mac keys&quot; IsChecked=&quot;{Binding UseMacKeys}&quot; /&gt;&#10;    &lt;Button Classes=&quot;outline sm&quot; Content=&quot;Apply&quot; Command=&quot;{Binding ApplyKeysCommand}&quot; /&gt;&#10;  &lt;/StackPanel&gt;&#10;  &lt;c:KbdGroup&gt;&#10;    &lt;c:Kbd&gt;&lt;TextBlock Text=&quot;{Binding UseMacKeys, Converter={x:Static m:DisplayExamples.MacKey}}&quot; /&gt;&lt;/c:Kbd&gt;&#10;    &lt;c:Kbd Content=&quot;K&quot; /&gt;&#10;  &lt;/c:KbdGroup&gt;&#10;  &lt;TextBlock Classes=&quot;sm muted&quot; Text=&quot;{Binding KeysStatus}&quot; /&gt;&#10;&lt;/StackPanel&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="API" />
      <StackPanel>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="c:Kbd Content" /><TextBlock Grid.Column="1" Classes="sm muted" Text="The key; text or any content." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="c:KbdGroup" /><TextBlock Grid.Column="1" Classes="sm muted" Text="A StackPanel of keys 4 px apart." /></Grid></Border>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
