      <Border Classes="code"><TextBlock Text="&lt;Border MaxWidth=&quot;592&quot; DataContext=&quot;{Binding Samples}&quot; x:DataType=&quot;m:ChartSamples&quot;&gt;&#10;  &lt;Border.Resources&gt;&lt;c:ChartConfig x:Key=&quot;ChartConfig&quot;&gt;&lt;c:ChartConfigItem Key=&quot;Visitors&quot; Label=&quot;Visitors&quot; /&gt;&lt;/c:ChartConfig&gt;&lt;/Border.Resources&gt;&#10;  &lt;c:Card&gt;&#10;    &lt;c:CardHeader Title=&quot;Pie Chart - Legend&quot; Description=&quot;January - June 2024&quot; /&gt;&#10;    &lt;c:CardContent&gt;&#10;      &lt;p:PieChart c:ChartConfig.Config=&quot;{StaticResource ChartConfig}&quot; Data=&quot;{Binding Browsers}&quot; Width=&quot;300&quot; Height=&quot;300&quot; HorizontalAlignment=&quot;Center&quot;&gt;&#10;        &lt;p:Pie Data=&quot;{Binding Browsers}&quot; DataKey=&quot;Visitors&quot; NameKey=&quot;Label&quot; IsAnimationActive=&quot;False&quot;&gt;&lt;p:Cell Fill=&quot;{DynamicResource PictorPalette1}&quot; /&gt;&lt;p:Cell Fill=&quot;{DynamicResource PictorPalette2}&quot; /&gt;&lt;p:Cell Fill=&quot;{DynamicResource PictorPalette3}&quot; /&gt;&lt;p:Cell Fill=&quot;{DynamicResource PictorPalette4}&quot; /&gt;&lt;p:Cell Fill=&quot;{DynamicResource PictorPalette5}&quot; /&gt;&lt;/p:Pie&gt;&#10;        &lt;p:Legend&gt;&lt;p:Legend.Template&gt;&lt;c:ChartLegendContent Spacing=&quot;8&quot; ItemBasis=&quot;0.25&quot; /&gt;&lt;/p:Legend.Template&gt;&lt;p:Legend.ContentTemplate&gt;&lt;c:ChartLegendItem /&gt;&lt;/p:Legend.ContentTemplate&gt;&lt;/p:Legend&gt;&#10;      &lt;/p:PieChart&gt;&#10;    &lt;/c:CardContent&gt;&#10;&#10;  &lt;/c:Card&gt;&#10;&lt;/Border&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Pie Chart - Default Legend" />
      <TextBlock Classes="sm muted" Text="A plain p:Legend under CosmoChartsTheme is ChartLegendContent; give it a Template, or set Template and ContentTemplate to {x:Null} for Pictor&#x27;s default." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Border MaxWidth="592" DataContext="{Binding Samples}" x:DataType="m:ChartSamples">
            <c:Card>
              <c:CardHeader Title="Pie Chart - Default Legend" Description="January - June 2024" />
              <c:CardContent>
                <p:PieChart Data="{Binding Browsers}" Width="300" Height="300" HorizontalAlignment="Center">
                  <p:Pie Data="{Binding Browsers}" DataKey="Visitors" NameKey="Label" IsAnimationActive="False"><p:Cell Fill="{DynamicResource PictorPalette1}" /><p:Cell Fill="{DynamicResource PictorPalette2}" /><p:Cell Fill="{DynamicResource PictorPalette3}" /><p:Cell Fill="{DynamicResource PictorPalette4}" /><p:Cell Fill="{DynamicResource PictorPalette5}" /></p:Pie>
                  <p:Legend />
                </p:PieChart>
              </c:CardContent>

            </c:Card>
          </Border>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Border MaxWidth=&quot;592&quot; DataContext=&quot;{Binding Samples}&quot; x:DataType=&quot;m:ChartSamples&quot;&gt;&#10;  &lt;c:Card&gt;&#10;    &lt;c:CardHeader Title=&quot;Pie Chart - Default Legend&quot; Description=&quot;January - June 2024&quot; /&gt;&#10;    &lt;c:CardContent&gt;&#10;      &lt;p:PieChart Data=&quot;{Binding Browsers}&quot; Width=&quot;300&quot; Height=&quot;300&quot; HorizontalAlignment=&quot;Center&quot;&gt;&#10;        &lt;p:Pie Data=&quot;{Binding Browsers}&quot; DataKey=&quot;Visitors&quot; NameKey=&quot;Label&quot; IsAnimationActive=&quot;False&quot;&gt;&lt;p:Cell Fill=&quot;{DynamicResource PictorPalette1}&quot; /&gt;&lt;p:Cell Fill=&quot;{DynamicResource PictorPalette2}&quot; /&gt;&lt;p:Cell Fill=&quot;{DynamicResource PictorPalette3}&quot; /&gt;&lt;p:Cell Fill=&quot;{DynamicResource PictorPalette4}&quot; /&gt;&lt;p:Cell Fill=&quot;{DynamicResource PictorPalette5}&quot; /&gt;&lt;/p:Pie&gt;&#10;        &lt;p:Legend /&gt;&#10;      &lt;/p:PieChart&gt;&#10;    &lt;/c:CardContent&gt;&#10;&#10;  &lt;/c:Card&gt;&#10;&lt;/Border&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Radar Chart" />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Border MaxWidth="592" DataContext="{Binding Samples}" x:DataType="m:ChartSamples">
            <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Desktop" Label="Desktop" Color="PictorPalette1" /></c:ChartConfig></Border.Resources>
            <c:Card>
