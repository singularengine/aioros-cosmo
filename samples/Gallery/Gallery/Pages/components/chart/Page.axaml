    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Radial Chart - Text" />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Border MaxWidth="592" DataContext="{Binding Samples}" x:DataType="m:ChartSamples">
            <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Visitors" Label="Visitors" /></c:ChartConfig></Border.Resources>
            <c:Card>
              <c:CardHeader Title="Radial Chart - Text" Description="January - June 2024" />
              <c:CardContent>
                <p:RadialBarChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Safari}" StartAngle="0" EndAngle="250" InnerRadius="80" OuterRadius="90" Width="250" Height="250" HorizontalAlignment="Center">
                  <p:PolarGrid GridType="circle" RadialLines="False" Stroke="none" PolarRadius="90, 80" />
                  <p:RadialBar DataKey="Visitors" Background="{DynamicResource PictorBarBackground}" CornerRadius="10" Fill="{DynamicResource PictorPalette2}" IsAnimationActive="False" />
                  <p:PolarRadiusAxis Tick="False" AxisLine="False">
                    <p:Label Position="Center"><p:Label.ContentTemplate><DataTemplate x:DataType="p:LabelContext"><Canvas><p:SvgText X="{Binding Converter={p:Calc 'Cx'}}" Y="{Binding Converter={p:Calc 'Cy + 0'}}" TextAnchor="Middle" Dy="12.6" FontSize="36" FontWeight="Bold" Fill="{DynamicResource CosmoForegroundBrush}" Content="200" /><p:SvgText X="{Binding Converter={p:Calc 'Cx'}}" Y="{Binding Converter={p:Calc 'Cy + 24'}}" TextAnchor="Middle" Dy="4.2" FontSize="12" FontWeight="Normal" Fill="{DynamicResource CosmoMutedForegroundBrush}" Content="Visitors" /></Canvas></DataTemplate></p:Label.ContentTemplate></p:Label>
                  </p:PolarRadiusAxis>
                </p:RadialBarChart>
              </c:CardContent>
              <c:CardFooter>
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="Trending up by 5.2% this month" FontSize="14" LineHeight="14" FontWeight="Medium" VerticalAlignment="Center" />
                    <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13" /></Viewbox>
                  </StackPanel>
                  <TextBlock Text="Showing total visitors for the last 6 months" FontSize="14" LineHeight="14" Foreground="{DynamicResource CosmoMutedForegroundBrush}" HorizontalAlignment="Center" />
                </StackPanel>
              </c:CardFooter>
            </c:Card>
          </Border>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Border MaxWidth=&quot;592&quot; DataContext=&quot;{Binding Samples}&quot; x:DataType=&quot;m:ChartSamples&quot;&gt;&#10;  &lt;Border.Resources&gt;&lt;c:ChartConfig x:Key=&quot;ChartConfig&quot;&gt;&lt;c:ChartConfigItem Key=&quot;Visitors&quot; Label=&quot;Visitors&quot; /&gt;&lt;/c:ChartConfig&gt;&lt;/Border.Resources&gt;&#10;  &lt;c:Card&gt;&#10;    &lt;c:CardHeader Title=&quot;Radial Chart - Text&quot; Description=&quot;January - June 2024&quot; /&gt;&#10;    &lt;c:CardContent&gt;&#10;      &lt;p:RadialBarChart c:ChartConfig.Config=&quot;{StaticResource ChartConfig}&quot; Data=&quot;{Binding Safari}&quot; StartAngle=&quot;0&quot; EndAngle=&quot;250&quot; InnerRadius=&quot;80&quot; OuterRadius=&quot;90&quot; Width=&quot;250&quot; Height=&quot;250&quot; HorizontalAlignment=&quot;Center&quot;&gt;&#10;        &lt;p:PolarGrid GridType=&quot;circle&quot; RadialLines=&quot;False&quot; Stroke=&quot;none&quot; PolarRadius=&quot;90, 80&quot; /&gt;&#10;        &lt;p:RadialBar DataKey=&quot;Visitors&quot; Background=&quot;{DynamicResource PictorBarBackground}&quot; CornerRadius=&quot;10&quot; Fill=&quot;{DynamicResource PictorPalette2}&quot; IsAnimationActive=&quot;False&quot; /&gt;&#10;        &lt;p:PolarRadiusAxis Tick=&quot;False&quot; AxisLine=&quot;False&quot;&gt;&#10;          &lt;p:Label Position=&quot;Center&quot;&gt;&lt;p:Label.ContentTemplate&gt;&lt;DataTemplate x:DataType=&quot;p:LabelContext&quot;&gt;&lt;Canvas&gt;&lt;p:SvgText X=&quot;{Binding Converter={p:Calc &#x27;Cx&#x27;}}&quot; Y=&quot;{Binding Converter={p:Calc &#x27;Cy + 0&#x27;}}&quot; TextAnchor=&quot;Middle&quot; Dy=&quot;12.6&quot; FontSize=&quot;36&quot; FontWeight=&quot;Bold&quot; Fill=&quot;{DynamicResource CosmoForegroundBrush}&quot; Content=&quot;200&quot; /&gt;&lt;p:SvgText X=&quot;{Binding Converter={p:Calc &#x27;Cx&#x27;}}&quot; Y=&quot;{Binding Converter={p:Calc &#x27;Cy + 24&#x27;}}&quot; TextAnchor=&quot;Middle&quot; Dy=&quot;4.2&quot; FontSize=&quot;12&quot; FontWeight=&quot;Normal&quot; Fill=&quot;{DynamicResource CosmoMutedForegroundBrush}&quot; Content=&quot;Visitors&quot; /&gt;&lt;/Canvas&gt;&lt;/DataTemplate&gt;&lt;/p:Label.ContentTemplate&gt;&lt;/p:Label&gt;&#10;        &lt;/p:PolarRadiusAxis&gt;&#10;      &lt;/p:RadialBarChart&gt;&#10;    &lt;/c:CardContent&gt;&#10;    &lt;c:CardFooter&gt;&#10;      &lt;StackPanel Spacing=&quot;8&quot; HorizontalAlignment=&quot;Center&quot;&gt;&#10;        &lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;8&quot; HorizontalAlignment=&quot;Center&quot;&gt;&#10;          &lt;TextBlock Text=&quot;Trending up by 5.2% this month&quot; FontSize=&quot;14&quot; LineHeight=&quot;14&quot; FontWeight=&quot;Medium&quot; VerticalAlignment=&quot;Center&quot; /&gt;&#10;          &lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot; VerticalAlignment=&quot;Center&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{DynamicResource CosmoForegroundBrush}&quot; Data=&quot;M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13&quot; /&gt;&lt;/Viewbox&gt;&#10;        &lt;/StackPanel&gt;&#10;        &lt;TextBlock Text=&quot;Showing total visitors for the last 6 months&quot; FontSize=&quot;14&quot; LineHeight=&quot;14&quot; Foreground=&quot;{DynamicResource CosmoMutedForegroundBrush}&quot; HorizontalAlignment=&quot;Center&quot; /&gt;&#10;      &lt;/StackPanel&gt;&#10;    &lt;/c:CardFooter&gt;&#10;  &lt;/c:Card&gt;&#10;&lt;/Border&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Radial Chart - Stacked" />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Border MaxWidth="592" DataContext="{Binding Samples}" x:DataType="m:ChartSamples">
            <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Desktop" Label="Desktop" Color="PictorPalette1" /><c:ChartConfigItem Key="Mobile" Label="Mobile" Color="PictorPalette2" /></c:ChartConfig></Border.Resources>
            <c:Card>
              <c:CardHeader Title="Radial Chart - Stacked" Description="January - June 2024" />
              <c:CardContent>
                <p:RadialBarChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Stacked}" EndAngle="180" InnerRadius="80" OuterRadius="110" Width="250" Height="250" HorizontalAlignment="Center">
                  <p:Tooltip Cursor="False"><p:Tooltip.ContentTemplate><c:ChartTooltipContent HideLabel="True" /></p:Tooltip.ContentTemplate></p:Tooltip>
                  <p:RadialBar DataKey="Mobile" StackId="a" CornerRadius="5" IsAnimationActive="False" />
                  <p:RadialBar DataKey="Desktop" StackId="a" CornerRadius="5" IsAnimationActive="False" />
                  <p:PolarRadiusAxis Tick="False" AxisLine="False">
                    <p:Label Position="Center"><p:Label.ContentTemplate><DataTemplate x:DataType="p:LabelContext"><Canvas><p:SvgText X="{Binding Converter={p:Calc 'Cx'}}" Y="{Binding Converter={p:Calc 'Cy + -16'}}" TextAnchor="Middle" Dy="0" FontSize="24" FontWeight="Bold" Fill="{DynamicResource CosmoForegroundBrush}" Content="1,830" /><p:SvgText X="{Binding Converter={p:Calc 'Cx'}}" Y="{Binding Converter={p:Calc 'Cy + 4'}}" TextAnchor="Middle" Dy="0" FontSize="12" FontWeight="Normal" Fill="{DynamicResource CosmoMutedForegroundBrush}" Content="Visitors" /></Canvas></DataTemplate></p:Label.ContentTemplate></p:Label>
                  </p:PolarRadiusAxis>
                </p:RadialBarChart>
              </c:CardContent>
              <c:CardFooter>
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="Trending up by 5.2% this month" FontSize="14" LineHeight="14" FontWeight="Medium" VerticalAlignment="Center" />
                    <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13" /></Viewbox>
                  </StackPanel>
                  <TextBlock Text="Showing total visitors for the last 6 months" FontSize="14" LineHeight="14" Foreground="{DynamicResource CosmoMutedForegroundBrush}" HorizontalAlignment="Center" />
                </StackPanel>
              </c:CardFooter>
            </c:Card>
          </Border>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Border MaxWidth=&quot;592&quot; DataContext=&quot;{Binding Samples}&quot; x:DataType=&quot;m:ChartSamples&quot;&gt;&#10;  &lt;Border.Resources&gt;&lt;c:ChartConfig x:Key=&quot;ChartConfig&quot;&gt;&lt;c:ChartConfigItem Key=&quot;Desktop&quot; Label=&quot;Desktop&quot; Color=&quot;PictorPalette1&quot; /&gt;&lt;c:ChartConfigItem Key=&quot;Mobile&quot; Label=&quot;Mobile&quot; Color=&quot;PictorPalette2&quot; /&gt;&lt;/c:ChartConfig&gt;&lt;/Border.Resources&gt;&#10;  &lt;c:Card&gt;&#10;    &lt;c:CardHeader Title=&quot;Radial Chart - Stacked&quot; Description=&quot;January - June 2024&quot; /&gt;&#10;    &lt;c:CardContent&gt;&#10;      &lt;p:RadialBarChart c:ChartConfig.Config=&quot;{StaticResource ChartConfig}&quot; Data=&quot;{Binding Stacked}&quot; EndAngle=&quot;180&quot; InnerRadius=&quot;80&quot; OuterRadius=&quot;110&quot; Width=&quot;250&quot; Height=&quot;250&quot; HorizontalAlignment=&quot;Center&quot;&gt;&#10;        &lt;p:Tooltip Cursor=&quot;False&quot;&gt;&lt;p:Tooltip.ContentTemplate&gt;&lt;c:ChartTooltipContent HideLabel=&quot;True&quot; /&gt;&lt;/p:Tooltip.ContentTemplate&gt;&lt;/p:Tooltip&gt;&#10;        &lt;p:RadialBar DataKey=&quot;Mobile&quot; StackId=&quot;a&quot; CornerRadius=&quot;5&quot; IsAnimationActive=&quot;False&quot; /&gt;&#10;        &lt;p:RadialBar DataKey=&quot;Desktop&quot; StackId=&quot;a&quot; CornerRadius=&quot;5&quot; IsAnimationActive=&quot;False&quot; /&gt;&#10;        &lt;p:PolarRadiusAxis Tick=&quot;False&quot; AxisLine=&quot;False&quot;&gt;&#10;          &lt;p:Label Position=&quot;Center&quot;&gt;&lt;p:Label.ContentTemplate&gt;&lt;DataTemplate x:DataType=&quot;p:LabelContext&quot;&gt;&lt;Canvas&gt;&lt;p:SvgText X=&quot;{Binding Converter={p:Calc &#x27;Cx&#x27;}}&quot; Y=&quot;{Binding Converter={p:Calc &#x27;Cy + -16&#x27;}}&quot; TextAnchor=&quot;Middle&quot; Dy=&quot;0&quot; FontSize=&quot;24&quot; FontWeight=&quot;Bold&quot; Fill=&quot;{DynamicResource CosmoForegroundBrush}&quot; Content=&quot;1,830&quot; /&gt;&lt;p:SvgText X=&quot;{Binding Converter={p:Calc &#x27;Cx&#x27;}}&quot; Y=&quot;{Binding Converter={p:Calc &#x27;Cy + 4&#x27;}}&quot; TextAnchor=&quot;Middle&quot; Dy=&quot;0&quot; FontSize=&quot;12&quot; FontWeight=&quot;Normal&quot; Fill=&quot;{DynamicResource CosmoMutedForegroundBrush}&quot; Content=&quot;Visitors&quot; /&gt;&lt;/Canvas&gt;&lt;/DataTemplate&gt;&lt;/p:Label.ContentTemplate&gt;&lt;/p:Label&gt;&#10;        &lt;/p:PolarRadiusAxis&gt;&#10;      &lt;/p:RadialBarChart&gt;&#10;    &lt;/c:CardContent&gt;&#10;    &lt;c:CardFooter&gt;&#10;      &lt;StackPanel Spacing=&quot;8&quot; HorizontalAlignment=&quot;Center&quot;&gt;&#10;        &lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;8&quot; HorizontalAlignment=&quot;Center&quot;&gt;&#10;          &lt;TextBlock Text=&quot;Trending up by 5.2% this month&quot; FontSize=&quot;14&quot; LineHeight=&quot;14&quot; FontWeight=&quot;Medium&quot; VerticalAlignment=&quot;Center&quot; /&gt;&#10;          &lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot; VerticalAlignment=&quot;Center&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{DynamicResource CosmoForegroundBrush}&quot; Data=&quot;M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13&quot; /&gt;&lt;/Viewbox&gt;&#10;        &lt;/StackPanel&gt;&#10;        &lt;TextBlock Text=&quot;Showing total visitors for the last 6 months&quot; FontSize=&quot;14&quot; LineHeight=&quot;14&quot; Foreground=&quot;{DynamicResource CosmoMutedForegroundBrush}&quot; HorizontalAlignment=&quot;Center&quot; /&gt;&#10;      &lt;/StackPanel&gt;&#10;    &lt;/c:CardFooter&gt;&#10;  &lt;/c:Card&gt;&#10;&lt;/Border&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Tooltip - Default" />
      <TextBlock Classes="sm muted" Text="ChartTooltipContent: the label, then a line per series with its dot, name and value." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Border MaxWidth="592" DataContext="{Binding Samples}" x:DataType="m:ChartSamples">
            <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Running" Label="Running" Color="PictorPalette1" /><c:ChartConfigItem Key="Swimming" Label="Swimming" Color="PictorPalette2" /></c:ChartConfig></Border.Resources>
            <c:Card>
              <c:CardHeader Title="Tooltip - Default" Description="Default tooltip with ChartTooltipContent." />
              <c:CardContent>
                <p:BarChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Activities}" Aspect="1.7777777777777777" ResponsiveWidths="542">
                  <p:XAxis DataKey="Date" TickLine="False" TickMargin="10" AxisLine="False" TickFormat="{}{0:ddd}" />
                  <p:Bar DataKey="Running" StackId="a" Radius="0, 0, 4, 4" IsAnimationActive="False" />
                  <p:Bar DataKey="Swimming" StackId="a" Radius="4, 4, 0, 0" IsAnimationActive="False" />
                  <p:Tooltip Cursor="False" DefaultIndex="1" LabelFormat="{}{0:yyyy-MM-dd}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent /></p:Tooltip.ContentTemplate></p:Tooltip>
                </p:BarChart>
              </c:CardContent>

            </c:Card>
          </Border>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Border MaxWidth=&quot;592&quot; DataContext=&quot;{Binding Samples}&quot; x:DataType=&quot;m:ChartSamples&quot;&gt;&#10;  &lt;Border.Resources&gt;&lt;c:ChartConfig x:Key=&quot;ChartConfig&quot;&gt;&lt;c:ChartConfigItem Key=&quot;Running&quot; Label=&quot;Running&quot; Color=&quot;PictorPalette1&quot; /&gt;&lt;c:ChartConfigItem Key=&quot;Swimming&quot; Label=&quot;Swimming&quot; Color=&quot;PictorPalette2&quot; /&gt;&lt;/c:ChartConfig&gt;&lt;/Border.Resources&gt;&#10;  &lt;c:Card&gt;&#10;    &lt;c:CardHeader Title=&quot;Tooltip - Default&quot; Description=&quot;Default tooltip with ChartTooltipContent.&quot; /&gt;&#10;    &lt;c:CardContent&gt;&#10;      &lt;p:BarChart c:ChartConfig.Config=&quot;{StaticResource ChartConfig}&quot; Data=&quot;{Binding Activities}&quot; Aspect=&quot;1.7777777777777777&quot; ResponsiveWidths=&quot;542&quot;&gt;&#10;        &lt;p:XAxis DataKey=&quot;Date&quot; TickLine=&quot;False&quot; TickMargin=&quot;10&quot; AxisLine=&quot;False&quot; TickFormat=&quot;{}{0:ddd}&quot; /&gt;&#10;        &lt;p:Bar DataKey=&quot;Running&quot; StackId=&quot;a&quot; Radius=&quot;0, 0, 4, 4&quot; IsAnimationActive=&quot;False&quot; /&gt;&#10;        &lt;p:Bar DataKey=&quot;Swimming&quot; StackId=&quot;a&quot; Radius=&quot;4, 4, 0, 0&quot; IsAnimationActive=&quot;False&quot; /&gt;&#10;        &lt;p:Tooltip Cursor=&quot;False&quot; DefaultIndex=&quot;1&quot; LabelFormat=&quot;{}{0:yyyy-MM-dd}&quot;&gt;&lt;p:Tooltip.ContentTemplate&gt;&lt;c:ChartTooltipContent /&gt;&lt;/p:Tooltip.ContentTemplate&gt;&lt;/p:Tooltip&gt;&#10;      &lt;/p:BarChart&gt;&#10;    &lt;/c:CardContent&gt;&#10;&#10;  &lt;/c:Card&gt;&#10;&lt;/Border&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Tooltip - Line Indicator" />
      <TextBlock Classes="sm muted" Text="Indicator=Line." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Border MaxWidth="592" DataContext="{Binding Samples}" x:DataType="m:ChartSamples">
            <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Running" Label="Running" Color="PictorPalette1" /><c:ChartConfigItem Key="Swimming" Label="Swimming" Color="PictorPalette2" /></c:ChartConfig></Border.Resources>
            <c:Card>
              <c:CardHeader Title="Tooltip - Line Indicator" Description="Tooltip with line indicator." />
              <c:CardContent>
                <p:BarChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Activities}" Aspect="1.7777777777777777" ResponsiveWidths="542">
                  <p:XAxis DataKey="Date" TickLine="False" TickMargin="10" AxisLine="False" TickFormat="{}{0:ddd}" />
                  <p:Bar DataKey="Running" StackId="a" Radius="0, 0, 4, 4" IsAnimationActive="False" />
                  <p:Bar DataKey="Swimming" StackId="a" Radius="4, 4, 0, 0" IsAnimationActive="False" />
                  <p:Tooltip Cursor="False" DefaultIndex="1" LabelFormat="{}{0:yyyy-MM-dd}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent Indicator="Line" /></p:Tooltip.ContentTemplate></p:Tooltip>
                </p:BarChart>
              </c:CardContent>

            </c:Card>
          </Border>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Border MaxWidth=&quot;592&quot; DataContext=&quot;{Binding Samples}&quot; x:DataType=&quot;m:ChartSamples&quot;&gt;&#10;  &lt;Border.Resources&gt;&lt;c:ChartConfig x:Key=&quot;ChartConfig&quot;&gt;&lt;c:ChartConfigItem Key=&quot;Running&quot; Label=&quot;Running&quot; Color=&quot;PictorPalette1&quot; /&gt;&lt;c:ChartConfigItem Key=&quot;Swimming&quot; Label=&quot;Swimming&quot; Color=&quot;PictorPalette2&quot; /&gt;&lt;/c:ChartConfig&gt;&lt;/Border.Resources&gt;&#10;  &lt;c:Card&gt;&#10;    &lt;c:CardHeader Title=&quot;Tooltip - Line Indicator&quot; Description=&quot;Tooltip with line indicator.&quot; /&gt;&#10;    &lt;c:CardContent&gt;&#10;      &lt;p:BarChart c:ChartConfig.Config=&quot;{StaticResource ChartConfig}&quot; Data=&quot;{Binding Activities}&quot; Aspect=&quot;1.7777777777777777&quot; ResponsiveWidths=&quot;542&quot;&gt;&#10;        &lt;p:XAxis DataKey=&quot;Date&quot; TickLine=&quot;False&quot; TickMargin=&quot;10&quot; AxisLine=&quot;False&quot; TickFormat=&quot;{}{0:ddd}&quot; /&gt;&#10;        &lt;p:Bar DataKey=&quot;Running&quot; StackId=&quot;a&quot; Radius=&quot;0, 0, 4, 4&quot; IsAnimationActive=&quot;False&quot; /&gt;&#10;        &lt;p:Bar DataKey=&quot;Swimming&quot; StackId=&quot;a&quot; Radius=&quot;4, 4, 0, 0&quot; IsAnimationActive=&quot;False&quot; /&gt;&#10;        &lt;p:Tooltip Cursor=&quot;False&quot; DefaultIndex=&quot;1&quot; LabelFormat=&quot;{}{0:yyyy-MM-dd}&quot;&gt;&lt;p:Tooltip.ContentTemplate&gt;&lt;c:ChartTooltipContent Indicator=&quot;Line&quot; /&gt;&lt;/p:Tooltip.ContentTemplate&gt;&lt;/p:Tooltip&gt;&#10;      &lt;/p:BarChart&gt;&#10;    &lt;/c:CardContent&gt;&#10;&#10;  &lt;/c:Card&gt;&#10;&lt;/Border&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Tooltip - No Indicator" />
      <TextBlock Classes="sm muted" Text="HideIndicator=True." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Border MaxWidth="592" DataContext="{Binding Samples}" x:DataType="m:ChartSamples">
            <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Running" Label="Running" Color="PictorPalette1" /><c:ChartConfigItem Key="Swimming" Label="Swimming" Color="PictorPalette2" /></c:ChartConfig></Border.Resources>
            <c:Card>
              <c:CardHeader Title="Tooltip - No Indicator" Description="Tooltip with no indicator." />
              <c:CardContent>
                <p:BarChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Activities}" Aspect="1.7777777777777777" ResponsiveWidths="542">
                  <p:XAxis DataKey="Date" TickLine="False" TickMargin="10" AxisLine="False" TickFormat="{}{0:ddd}" />
                  <p:Bar DataKey="Running" StackId="a" Radius="0, 0, 4, 4" IsAnimationActive="False" />
                  <p:Bar DataKey="Swimming" StackId="a" Radius="4, 4, 0, 0" IsAnimationActive="False" />
                  <p:Tooltip Cursor="False" DefaultIndex="1" LabelFormat="{}{0:yyyy-MM-dd}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent HideIndicator="True" /></p:Tooltip.ContentTemplate></p:Tooltip>
                </p:BarChart>
              </c:CardContent>

            </c:Card>
          </Border>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Border MaxWidth=&quot;592&quot; DataContext=&quot;{Binding Samples}&quot; x:DataType=&quot;m:ChartSamples&quot;&gt;&#10;  &lt;Border.Resources&gt;&lt;c:ChartConfig x:Key=&quot;ChartConfig&quot;&gt;&lt;c:ChartConfigItem Key=&quot;Running&quot; Label=&quot;Running&quot; Color=&quot;PictorPalette1&quot; /&gt;&lt;c:ChartConfigItem Key=&quot;Swimming&quot; Label=&quot;Swimming&quot; Color=&quot;PictorPalette2&quot; /&gt;&lt;/c:ChartConfig&gt;&lt;/Border.Resources&gt;&#10;  &lt;c:Card&gt;&#10;    &lt;c:CardHeader Title=&quot;Tooltip - No Indicator&quot; Description=&quot;Tooltip with no indicator.&quot; /&gt;&#10;    &lt;c:CardContent&gt;&#10;      &lt;p:BarChart c:ChartConfig.Config=&quot;{StaticResource ChartConfig}&quot; Data=&quot;{Binding Activities}&quot; Aspect=&quot;1.7777777777777777&quot; ResponsiveWidths=&quot;542&quot;&gt;&#10;        &lt;p:XAxis DataKey=&quot;Date&quot; TickLine=&quot;False&quot; TickMargin=&quot;10&quot; AxisLine=&quot;False&quot; TickFormat=&quot;{}{0:ddd}&quot; /&gt;&#10;        &lt;p:Bar DataKey=&quot;Running&quot; StackId=&quot;a&quot; Radius=&quot;0, 0, 4, 4&quot; IsAnimationActive=&quot;False&quot; /&gt;&#10;        &lt;p:Bar DataKey=&quot;Swimming&quot; StackId=&quot;a&quot; Radius=&quot;4, 4, 0, 0&quot; IsAnimationActive=&quot;False&quot; /&gt;&#10;        &lt;p:Tooltip Cursor=&quot;False&quot; DefaultIndex=&quot;1&quot; LabelFormat=&quot;{}{0:yyyy-MM-dd}&quot;&gt;&lt;p:Tooltip.ContentTemplate&gt;&lt;c:ChartTooltipContent HideIndicator=&quot;True&quot; /&gt;&lt;/p:Tooltip.ContentTemplate&gt;&lt;/p:Tooltip&gt;&#10;      &lt;/p:BarChart&gt;&#10;    &lt;/c:CardContent&gt;&#10;&#10;  &lt;/c:Card&gt;&#10;&lt;/Border&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Tooltip - Formatters" />
      <TextBlock Classes="sm muted" Text="A line per series however many there are; ChartConfig names and colors the series by data key; converters write the ticks (TickFormatter), the values (Formatter, the series&#x27; name as the parameter) and the label (LabelFormatter)." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Border MaxWidth="592" DataContext="{Binding Samples}" x:DataType="m:ChartSamples">
            <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Chrome" Label="Chrome" Color="PictorPalette1" /><c:ChartConfigItem Key="Safari" Label="Safari" Color="PictorPalette2" /><c:ChartConfigItem Key="Firefox" Label="Firefox" Color="PictorPalette3" /><c:ChartConfigItem Key="Edge" Label="Edge" Color="PictorPalette4" /><c:ChartConfigItem Key="Other" Label="Other" Color="PictorPalette5" /></c:ChartConfig><m:MonthName x:Key="Month" /><m:Visitors x:Key="Visitors" /><m:MonthTitle x:Key="Title" /></Border.Resources>
            <c:Card>
              <c:CardHeader Title="Tooltip - Formatters" Description="Five browsers, a line each; the ticks, values and label written by converters." />
              <c:CardContent>
                <p:BarChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding BrowserMonths}" Aspect="1.7777777777777777" ResponsiveWidths="542">
                  <p:CartesianGrid Vertical="False" />
                  <p:XAxis DataKey="Month" TickLine="False" AxisLine="False" TickMargin="10" TickFormatter="{StaticResource Month}" />
                  <p:Tooltip Cursor="False" Formatter="{StaticResource Visitors}" LabelFormatter="{StaticResource Title}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent Indicator="Dashed" /></p:Tooltip.ContentTemplate></p:Tooltip>
                  <p:Bar DataKey="Chrome" StackId="a" IsAnimationActive="False" /><p:Bar DataKey="Safari" StackId="a" IsAnimationActive="False" /><p:Bar DataKey="Firefox" StackId="a" IsAnimationActive="False" /><p:Bar DataKey="Edge" StackId="a" IsAnimationActive="False" /><p:Bar DataKey="Other" StackId="a" IsAnimationActive="False" />
                </p:BarChart>
              </c:CardContent>
            </c:Card>
          </Border>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Border MaxWidth=&quot;592&quot; DataContext=&quot;{Binding Samples}&quot; x:DataType=&quot;m:ChartSamples&quot;&gt;&#10;  &lt;Border.Resources&gt;&lt;c:ChartConfig x:Key=&quot;ChartConfig&quot;&gt;&lt;c:ChartConfigItem Key=&quot;Chrome&quot; Label=&quot;Chrome&quot; Color=&quot;PictorPalette1&quot; /&gt;&lt;c:ChartConfigItem Key=&quot;Safari&quot; Label=&quot;Safari&quot; Color=&quot;PictorPalette2&quot; /&gt;&lt;c:ChartConfigItem Key=&quot;Firefox&quot; Label=&quot;Firefox&quot; Color=&quot;PictorPalette3&quot; /&gt;&lt;c:ChartConfigItem Key=&quot;Edge&quot; Label=&quot;Edge&quot; Color=&quot;PictorPalette4&quot; /&gt;&lt;c:ChartConfigItem Key=&quot;Other&quot; Label=&quot;Other&quot; Color=&quot;PictorPalette5&quot; /&gt;&lt;/c:ChartConfig&gt;&lt;m:MonthName x:Key=&quot;Month&quot; /&gt;&lt;m:Visitors x:Key=&quot;Visitors&quot; /&gt;&lt;m:MonthTitle x:Key=&quot;Title&quot; /&gt;&lt;/Border.Resources&gt;&#10;  &lt;c:Card&gt;&#10;    &lt;c:CardHeader Title=&quot;Tooltip - Formatters&quot; Description=&quot;Five browsers, a line each; the ticks, values and label written by converters.&quot; /&gt;&#10;    &lt;c:CardContent&gt;&#10;      &lt;p:BarChart c:ChartConfig.Config=&quot;{StaticResource ChartConfig}&quot; Data=&quot;{Binding BrowserMonths}&quot; Aspect=&quot;1.7777777777777777&quot; ResponsiveWidths=&quot;542&quot;&gt;&#10;        &lt;p:CartesianGrid Vertical=&quot;False&quot; /&gt;&#10;        &lt;p:XAxis DataKey=&quot;Month&quot; TickLine=&quot;False&quot; AxisLine=&quot;False&quot; TickMargin=&quot;10&quot; TickFormatter=&quot;{StaticResource Month}&quot; /&gt;&#10;        &lt;p:Tooltip Cursor=&quot;False&quot; Formatter=&quot;{StaticResource Visitors}&quot; LabelFormatter=&quot;{StaticResource Title}&quot;&gt;&lt;p:Tooltip.ContentTemplate&gt;&lt;c:ChartTooltipContent Indicator=&quot;Dashed&quot; /&gt;&lt;/p:Tooltip.ContentTemplate&gt;&lt;/p:Tooltip&gt;&#10;        &lt;p:Bar DataKey=&quot;Chrome&quot; StackId=&quot;a&quot; IsAnimationActive=&quot;False&quot; /&gt;&lt;p:Bar DataKey=&quot;Safari&quot; StackId=&quot;a&quot; IsAnimationActive=&quot;False&quot; /&gt;&lt;p:Bar DataKey=&quot;Firefox&quot; StackId=&quot;a&quot; IsAnimationActive=&quot;False&quot; /&gt;&lt;p:Bar DataKey=&quot;Edge&quot; StackId=&quot;a&quot; IsAnimationActive=&quot;False&quot; /&gt;&lt;p:Bar DataKey=&quot;Other&quot; StackId=&quot;a&quot; IsAnimationActive=&quot;False&quot; /&gt;&#10;      &lt;/p:BarChart&gt;&#10;    &lt;/c:CardContent&gt;&#10;  &lt;/c:Card&gt;&#10;&lt;/Border&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="API" />
      <StackPanel>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="c:CosmoChartsTheme" /><TextBlock Grid.Column="1" Classes="sm muted" Text="Add after CosmoTheme in the application&#x27;s styles: chart text in Cosmo&#x27;s font and the chart-toggles list box." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="c:ChartTooltipContent" /><TextBlock Grid.Column="1" Classes="sm muted" Text="A tooltip&#x27;s ContentTemplate: Indicator (Dot, Line, Dashed), HideLabel, HideIndicator; the label and a line per series, bringing its lines&#x27; template." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="c:ChartConfig" /><TextBlock Grid.Column="1" Classes="sm muted" Text="shadcn&#x27;s ChartConfig as a resource of c:ChartConfigItem (Key, Label, Color: a theme key such as PictorPalette1, or a CSS color), given to a chart with c:ChartConfig.Config: each series of that data key takes the label as its Name and the color as its fill or stroke." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="TickFormatter, Formatter, LabelFormatter" /><TextBlock Grid.Column="1" Classes="sm muted" Text="Pictor&#x27;s formatter functions: value converters on an axis and a tooltip (a function from code through FuncValueConverter); composite formats (TickFormat, Format, LabelFormat) stay for what a format says. A converter class with no settings keeps the page&#x27;s plan on the web." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="c:ChartLegendContent" /><TextBlock Grid.Column="1" Classes="sm muted" Text="A legend&#x27;s Template: the entries in a centered row; Spacing (16) and ItemBasis." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="c:ChartLegendItem" /><TextBlock Grid.Column="1" Classes="sm muted" Text="A legend&#x27;s ContentTemplate: an 8 px square of the series&#x27; color and its name." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="PictorPalette1 to PictorPalette5" /><TextBlock Grid.Column="1" Classes="sm muted" Text="The chart tokens --chart-1 to --chart-5 as Pictor&#x27;s palette, in every color theme, light and dark." /></Grid></Border>
        <Border Classes="row"><Grid ColumnDefinitions="200,*" ColumnSpacing="16"><TextBlock Classes="sm" FontWeight="Medium" Text="CosmoChart1TopColor, CosmoChart1BottomColor" /><TextBlock Grid.Column="1" Classes="sm muted" Text="A chart token at 0.8 and 0.1, the stops of the area gradients (1 to 5)." /></Grid></Border>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
