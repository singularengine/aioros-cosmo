                  <p:XAxis DataKey="Month" TickLine="False" AxisLine="False" TickMargin="10" TickFormat="{}{0:MMM}" />
                  <p:Tooltip Cursor="False" LabelFormat="{}{0:MMMM}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent HideLabel="True" /></p:Tooltip.ContentTemplate></p:Tooltip>
                  <p:Bar DataKey="Desktop" Radius="8" IsAnimationActive="False"><p:LabelList Position="Top" Offset="12" Fill="{DynamicResource CosmoChartForeground}" FontSize="12" /></p:Bar>
                </p:BarChart>
              </c:CardContent>
              <c:CardFooter>
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Trending up by 5.2% this month" FontSize="14" LineHeight="14" FontWeight="Medium" VerticalAlignment="Top" />
                    <Viewbox Width="16" Height="16" VerticalAlignment="Top"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13" /></Viewbox>
                  </StackPanel>
                  <TextBlock Text="Showing total visitors for the last 6 months" FontSize="14" LineHeight="14" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                </StackPanel>
              </c:CardFooter>
            </c:Card>
          </Border>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Border MaxWidth=&quot;592&quot; DataContext=&quot;{Binding Samples}&quot; x:DataType=&quot;m:ChartSamples&quot;&gt;&#10;  &lt;Border.Resources&gt;&lt;c:ChartConfig x:Key=&quot;ChartConfig&quot;&gt;&lt;c:ChartConfigItem Key=&quot;Desktop&quot; Label=&quot;Desktop&quot; Color=&quot;PictorPalette1&quot; /&gt;&lt;/c:ChartConfig&gt;&lt;/Border.Resources&gt;&#10;  &lt;c:Card&gt;&#10;    &lt;c:CardHeader Title=&quot;Bar Chart - Label&quot; Description=&quot;January - June 2024&quot; /&gt;&#10;    &lt;c:CardContent&gt;&#10;      &lt;p:BarChart c:ChartConfig.Config=&quot;{StaticResource ChartConfig}&quot; Data=&quot;{Binding Months}&quot; Aspect=&quot;1.7777777777777777&quot; ResponsiveWidths=&quot;542&quot; Padding=&quot;0,20,0,0&quot;&gt;&#10;        &lt;p:CartesianGrid Vertical=&quot;False&quot; /&gt;&#10;        &lt;p:XAxis DataKey=&quot;Month&quot; TickLine=&quot;False&quot; AxisLine=&quot;False&quot; TickMargin=&quot;10&quot; TickFormat=&quot;{}{0:MMM}&quot; /&gt;&#10;        &lt;p:Tooltip Cursor=&quot;False&quot; LabelFormat=&quot;{}{0:MMMM}&quot;&gt;&lt;p:Tooltip.ContentTemplate&gt;&lt;c:ChartTooltipContent HideLabel=&quot;True&quot; /&gt;&lt;/p:Tooltip.ContentTemplate&gt;&lt;/p:Tooltip&gt;&#10;        &lt;p:Bar DataKey=&quot;Desktop&quot; Radius=&quot;8&quot; IsAnimationActive=&quot;False&quot;&gt;&lt;p:LabelList Position=&quot;Top&quot; Offset=&quot;12&quot; Fill=&quot;{DynamicResource CosmoChartForeground}&quot; FontSize=&quot;12&quot; /&gt;&lt;/p:Bar&gt;&#10;      &lt;/p:BarChart&gt;&#10;    &lt;/c:CardContent&gt;&#10;    &lt;c:CardFooter&gt;&#10;      &lt;StackPanel Spacing=&quot;8&quot;&gt;&#10;        &lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;8&quot;&gt;&#10;          &lt;TextBlock Text=&quot;Trending up by 5.2% this month&quot; FontSize=&quot;14&quot; LineHeight=&quot;14&quot; FontWeight=&quot;Medium&quot; VerticalAlignment=&quot;Top&quot; /&gt;&#10;          &lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot; VerticalAlignment=&quot;Top&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{DynamicResource CosmoForegroundBrush}&quot; Data=&quot;M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13&quot; /&gt;&lt;/Viewbox&gt;&#10;        &lt;/StackPanel&gt;&#10;        &lt;TextBlock Text=&quot;Showing total visitors for the last 6 months&quot; FontSize=&quot;14&quot; LineHeight=&quot;14&quot; Foreground=&quot;{DynamicResource CosmoMutedForegroundBrush}&quot; /&gt;&#10;      &lt;/StackPanel&gt;&#10;    &lt;/c:CardFooter&gt;&#10;  &lt;/c:Card&gt;&#10;&lt;/Border&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Bar Chart - Interactive" />
      <TextBlock Classes="sm muted" Text="The header&#x27;s toggles are a ListBox with the chart-toggles class; each choice shows its series&#x27; chart." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Border MaxWidth="592" DataContext="{Binding Interactive}" x:DataType="m:ChartInteractive">
            <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Desktop" Label="Desktop" Color="PictorPalette2" /><c:ChartConfigItem Key="Mobile" Label="Mobile" Color="PictorPalette1" /></c:ChartConfig></Border.Resources>
            <c:Card Padding="0">
              <Border BorderBrush="{DynamicResource CosmoBorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                  <c:CardHeader Title="Bar Chart - Interactive" Description="Showing total visitors for the last 3 months" VerticalAlignment="Center" />
                  <ListBox Grid.Column="1" Classes="chart-toggles" SelectedIndex="{Binding ActiveChart}">
                    <ListBoxItem>
                      <StackPanel Spacing="4">
                        <TextBlock Text="Desktop" FontSize="12" LineHeight="16" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                        <TextBlock Text="{Binding DesktopTotal}" FontSize="30" LineHeight="30" FontWeight="Bold" />
                      </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                      <StackPanel Spacing="4">
                        <TextBlock Text="Mobile" FontSize="12" LineHeight="16" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                        <TextBlock Text="{Binding MobileTotal}" FontSize="30" LineHeight="30" FontWeight="Bold" />
                      </StackPanel>
                    </ListBoxItem>
                  </ListBox>
                </Grid>
              </Border>
              <c:CardContent Padding="24">
                <Panel>
                <p:BarChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Daily}" Height="250" ResponsiveWidths="360 542 720" Padding="12,0,12,0" IsVisible="{Binding DesktopShown}">
                  <p:CartesianGrid Vertical="False" />
                  <p:XAxis DataKey="Date" TickLine="False" AxisLine="False" TickMargin="8" MinTickGap="32" TickFormat="{}{0:MMM d}" />
                  <p:Tooltip Cursor="False" LabelFormat="{}{0:MMM d, yyyy}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent /></p:Tooltip.ContentTemplate></p:Tooltip>
                  <p:Bar DataKey="Desktop" Name="Page Views" IsAnimationActive="False" />
                </p:BarChart>
                <p:BarChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Daily}" Height="250" ResponsiveWidths="360 542 720" Padding="12,0,12,0" IsVisible="{Binding MobileShown}">
                  <p:CartesianGrid Vertical="False" />
                  <p:XAxis DataKey="Date" TickLine="False" AxisLine="False" TickMargin="8" MinTickGap="32" TickFormat="{}{0:MMM d}" />
                  <p:Tooltip Cursor="False" LabelFormat="{}{0:MMM d, yyyy}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent /></p:Tooltip.ContentTemplate></p:Tooltip>
                  <p:Bar DataKey="Mobile" Name="Page Views" IsAnimationActive="False" />
                </p:BarChart>
                </Panel>
              </c:CardContent>
            </c:Card>
          </Border>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Border MaxWidth=&quot;592&quot; DataContext=&quot;{Binding Interactive}&quot; x:DataType=&quot;m:ChartInteractive&quot;&gt;&#10;  &lt;Border.Resources&gt;&lt;c:ChartConfig x:Key=&quot;ChartConfig&quot;&gt;&lt;c:ChartConfigItem Key=&quot;Desktop&quot; Label=&quot;Desktop&quot; Color=&quot;PictorPalette2&quot; /&gt;&lt;c:ChartConfigItem Key=&quot;Mobile&quot; Label=&quot;Mobile&quot; Color=&quot;PictorPalette1&quot; /&gt;&lt;/c:ChartConfig&gt;&lt;/Border.Resources&gt;&#10;  &lt;c:Card Padding=&quot;0&quot;&gt;&#10;    &lt;Border BorderBrush=&quot;{DynamicResource CosmoBorderBrush}&quot; BorderThickness=&quot;0,0,0,1&quot;&gt;&#10;      &lt;Grid ColumnDefinitions=&quot;*,Auto&quot;&gt;&#10;        &lt;c:CardHeader Title=&quot;Bar Chart - Interactive&quot; Description=&quot;Showing total visitors for the last 3 months&quot; VerticalAlignment=&quot;Center&quot; /&gt;&#10;        &lt;ListBox Grid.Column=&quot;1&quot; Classes=&quot;chart-toggles&quot; SelectedIndex=&quot;{Binding ActiveChart}&quot;&gt;&#10;          &lt;ListBoxItem&gt;&#10;            &lt;StackPanel Spacing=&quot;4&quot;&gt;&#10;              &lt;TextBlock Text=&quot;Desktop&quot; FontSize=&quot;12&quot; LineHeight=&quot;16&quot; Foreground=&quot;{DynamicResource CosmoMutedForegroundBrush}&quot; /&gt;&#10;              &lt;TextBlock Text=&quot;{Binding DesktopTotal}&quot; FontSize=&quot;30&quot; LineHeight=&quot;30&quot; FontWeight=&quot;Bold&quot; /&gt;&#10;            &lt;/StackPanel&gt;&#10;          &lt;/ListBoxItem&gt;&#10;          &lt;ListBoxItem&gt;&#10;            &lt;StackPanel Spacing=&quot;4&quot;&gt;&#10;              &lt;TextBlock Text=&quot;Mobile&quot; FontSize=&quot;12&quot; LineHeight=&quot;16&quot; Foreground=&quot;{DynamicResource CosmoMutedForegroundBrush}&quot; /&gt;&#10;              &lt;TextBlock Text=&quot;{Binding MobileTotal}&quot; FontSize=&quot;30&quot; LineHeight=&quot;30&quot; FontWeight=&quot;Bold&quot; /&gt;&#10;            &lt;/StackPanel&gt;&#10;          &lt;/ListBoxItem&gt;&#10;        &lt;/ListBox&gt;&#10;      &lt;/Grid&gt;&#10;    &lt;/Border&gt;&#10;    &lt;c:CardContent Padding=&quot;24&quot;&gt;&#10;      &lt;Panel&gt;&#10;      &lt;p:BarChart c:ChartConfig.Config=&quot;{StaticResource ChartConfig}&quot; Data=&quot;{Binding Daily}&quot; Height=&quot;250&quot; ResponsiveWidths=&quot;360 542 720&quot; Padding=&quot;12,0,12,0&quot; IsVisible=&quot;{Binding DesktopShown}&quot;&gt;&#10;        &lt;p:CartesianGrid Vertical=&quot;False&quot; /&gt;&#10;        &lt;p:XAxis DataKey=&quot;Date&quot; TickLine=&quot;False&quot; AxisLine=&quot;False&quot; TickMargin=&quot;8&quot; MinTickGap=&quot;32&quot; TickFormat=&quot;{}{0:MMM d}&quot; /&gt;&#10;        &lt;p:Tooltip Cursor=&quot;False&quot; LabelFormat=&quot;{}{0:MMM d, yyyy}&quot;&gt;&lt;p:Tooltip.ContentTemplate&gt;&lt;c:ChartTooltipContent /&gt;&lt;/p:Tooltip.ContentTemplate&gt;&lt;/p:Tooltip&gt;&#10;        &lt;p:Bar DataKey=&quot;Desktop&quot; Name=&quot;Page Views&quot; IsAnimationActive=&quot;False&quot; /&gt;&#10;      &lt;/p:BarChart&gt;&#10;      &lt;p:BarChart c:ChartConfig.Config=&quot;{StaticResource ChartConfig}&quot; Data=&quot;{Binding Daily}&quot; Height=&quot;250&quot; ResponsiveWidths=&quot;360 542 720&quot; Padding=&quot;12,0,12,0&quot; IsVisible=&quot;{Binding MobileShown}&quot;&gt;&#10;        &lt;p:CartesianGrid Vertical=&quot;False&quot; /&gt;&#10;        &lt;p:XAxis DataKey=&quot;Date&quot; TickLine=&quot;False&quot; AxisLine=&quot;False&quot; TickMargin=&quot;8&quot; MinTickGap=&quot;32&quot; TickFormat=&quot;{}{0:MMM d}&quot; /&gt;&#10;        &lt;p:Tooltip Cursor=&quot;False&quot; LabelFormat=&quot;{}{0:MMM d, yyyy}&quot;&gt;&lt;p:Tooltip.ContentTemplate&gt;&lt;c:ChartTooltipContent /&gt;&lt;/p:Tooltip.ContentTemplate&gt;&lt;/p:Tooltip&gt;&#10;        &lt;p:Bar DataKey=&quot;Mobile&quot; Name=&quot;Page Views&quot; IsAnimationActive=&quot;False&quot; /&gt;&#10;      &lt;/p:BarChart&gt;&#10;      &lt;/Panel&gt;&#10;    &lt;/c:CardContent&gt;&#10;  &lt;/c:Card&gt;&#10;&lt;/Border&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Line Chart" />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Border MaxWidth="592" DataContext="{Binding Samples}" x:DataType="m:ChartSamples">
            <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Desktop" Label="Desktop" Color="PictorPalette1" /></c:ChartConfig></Border.Resources>
            <c:Card>
              <c:CardHeader Title="Line Chart" Description="January - June 2024" />
              <c:CardContent>
                <p:LineChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Months}" Aspect="1.7777777777777777" ResponsiveWidths="542" Padding="12,0,12,0">
                  <p:CartesianGrid Vertical="False" />
                  <p:XAxis DataKey="Month" TickLine="False" AxisLine="False" TickMargin="8" TickFormat="{}{0:MMM}" />
                  <p:Tooltip Cursor="False" LabelFormat="{}{0:MMMM}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent HideLabel="True" /></p:Tooltip.ContentTemplate></p:Tooltip>
                  <p:Line DataKey="Desktop" Type="Natural" StrokeWidth="2" Dot="False" IsAnimationActive="False" />
                </p:LineChart>
              </c:CardContent>
              <c:CardFooter>
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Trending up by 5.2% this month" FontSize="14" LineHeight="14" FontWeight="Medium" VerticalAlignment="Top" />
                    <Viewbox Width="16" Height="16" VerticalAlignment="Top"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13" /></Viewbox>
                  </StackPanel>
                  <TextBlock Text="Showing total visitors for the last 6 months" FontSize="14" LineHeight="14" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                </StackPanel>
              </c:CardFooter>
            </c:Card>
          </Border>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Border MaxWidth=&quot;592&quot; DataContext=&quot;{Binding Samples}&quot; x:DataType=&quot;m:ChartSamples&quot;&gt;&#10;  &lt;Border.Resources&gt;&lt;c:ChartConfig x:Key=&quot;ChartConfig&quot;&gt;&lt;c:ChartConfigItem Key=&quot;Desktop&quot; Label=&quot;Desktop&quot; Color=&quot;PictorPalette1&quot; /&gt;&lt;/c:ChartConfig&gt;&lt;/Border.Resources&gt;&#10;  &lt;c:Card&gt;&#10;    &lt;c:CardHeader Title=&quot;Line Chart&quot; Description=&quot;January - June 2024&quot; /&gt;&#10;    &lt;c:CardContent&gt;&#10;      &lt;p:LineChart c:ChartConfig.Config=&quot;{StaticResource ChartConfig}&quot; Data=&quot;{Binding Months}&quot; Aspect=&quot;1.7777777777777777&quot; ResponsiveWidths=&quot;542&quot; Padding=&quot;12,0,12,0&quot;&gt;&#10;        &lt;p:CartesianGrid Vertical=&quot;False&quot; /&gt;&#10;        &lt;p:XAxis DataKey=&quot;Month&quot; TickLine=&quot;False&quot; AxisLine=&quot;False&quot; TickMargin=&quot;8&quot; TickFormat=&quot;{}{0:MMM}&quot; /&gt;&#10;        &lt;p:Tooltip Cursor=&quot;False&quot; LabelFormat=&quot;{}{0:MMMM}&quot;&gt;&lt;p:Tooltip.ContentTemplate&gt;&lt;c:ChartTooltipContent HideLabel=&quot;True&quot; /&gt;&lt;/p:Tooltip.ContentTemplate&gt;&lt;/p:Tooltip&gt;&#10;        &lt;p:Line DataKey=&quot;Desktop&quot; Type=&quot;Natural&quot; StrokeWidth=&quot;2&quot; Dot=&quot;False&quot; IsAnimationActive=&quot;False&quot; /&gt;&#10;      &lt;/p:LineChart&gt;&#10;    &lt;/c:CardContent&gt;&#10;    &lt;c:CardFooter&gt;&#10;      &lt;StackPanel Spacing=&quot;8&quot;&gt;&#10;        &lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;8&quot;&gt;&#10;          &lt;TextBlock Text=&quot;Trending up by 5.2% this month&quot; FontSize=&quot;14&quot; LineHeight=&quot;14&quot; FontWeight=&quot;Medium&quot; VerticalAlignment=&quot;Top&quot; /&gt;&#10;          &lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot; VerticalAlignment=&quot;Top&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&