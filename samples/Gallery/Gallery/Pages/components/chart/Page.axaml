<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" xmlns:p="https://aioros.dev/pictor" x:DataType="m:ChartExamples"
             a:Page.Title="Chart" a:Page.Description="Beautiful charts. Built using Aioros.Pictor. Copy and paste into your apps.">
  <StackPanel Spacing="32" MaxWidth="880" HorizontalAlignment="Left">
    <StackPanel Spacing="10">
      <TextBlock Classes="h1" Text="Chart" />
      <TextBlock Classes="lead" Text="Beautiful charts. Built using Aioros.Pictor. Copy and paste into your apps." />
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <c:Badge Classes="secondary" Content="shadcn/ui: chart" />
        <c:Badge Classes="secondary" Content="Aioros.Pictor: Recharts&#x27; charts in XAML" />
        <c:Badge Classes="secondary" Content="Web: &lt;svg&gt;" />
      </WrapPanel>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Area Chart" />
      <TextBlock Classes="sm muted" Text="An area of one series with the line indicator in its tooltip." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Border MaxWidth="592" DataContext="{Binding Samples}" x:DataType="m:ChartSamples">
            <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Desktop" Label="Desktop" Color="PictorPalette1" /></c:ChartConfig></Border.Resources>
            <c:Card>
              <c:CardHeader Title="Area Chart" Description="Showing total visitors for the last 6 months" />
              <c:CardContent>
                <p:AreaChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Months}" Aspect="1.7777777777777777" ResponsiveWidths="542" Padding="12,0,12,0">
                  <p:CartesianGrid Vertical="False" />
                  <p:XAxis DataKey="Month" TickLine="False" AxisLine="False" TickMargin="8" TickFormat="{}{0:MMM}" />
                  <p:Tooltip Cursor="False" LabelFormat="{}{0:MMMM}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent Indicator="Line" /></p:Tooltip.ContentTemplate></p:Tooltip>
                  <p:Area DataKey="Desktop" Type="Natural" FillOpacity="0.4" IsAnimationActive="False" />
                </p:AreaChart>
              </c:CardContent>
              <c:CardFooter>
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Trending up by 5.2% this month" FontSize="14" LineHeight="14" FontWeight="Medium" VerticalAlignment="Center" />
                    <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13" /></Viewbox>
                  </StackPanel>
                  <TextBlock Text="January - June 2024" FontSize="14" LineHeight="14" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                </StackPanel>
              </c:CardFooter>
            </c:Card>
          </Border>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Border MaxWidth=&quot;592&quot; DataContext=&quot;{Binding Samples}&quot; x:DataType=&quot;m:ChartSamples&quot;&gt;&#10;  &lt;Border.Resources&gt;&lt;c:ChartConfig x:Key=&quot;ChartConfig&quot;&gt;&lt;c:ChartConfigItem Key=&quot;Desktop&quot; Label=&quot;Desktop&quot; Color=&quot;PictorPalette1&quot; /&gt;&lt;/c:ChartConfig&gt;&lt;/Border.Resources&gt;&#10;  &lt;c:Card&gt;&#10;    &lt;c:CardHeader Title=&quot;Area Chart&quot; Description=&quot;Showing total visitors for the last 6 months&quot; /&gt;&#10;    &lt;c:CardContent&gt;&#10;      &lt;p:AreaChart c:ChartConfig.Config=&quot;{StaticResource ChartConfig}&quot; Data=&quot;{Binding Months}&quot; Aspect=&quot;1.7777777777777777&quot; ResponsiveWidths=&quot;542&quot; Padding=&quot;12,0,12,0&quot;&gt;&#10;        &lt;p:CartesianGrid Vertical=&quot;False&quot; /&gt;&#10;        &lt;p:XAxis DataKey=&quot;Month&quot; TickLine=&quot;False&quot; AxisLine=&quot;False&quot; TickMargin=&quot;8&quot; TickFormat=&quot;{}{0:MMM}&quot; /&gt;&#10;        &lt;p:Tooltip Cursor=&quot;False&quot; LabelFormat=&quot;{}{0:MMMM}&quot;&gt;&lt;p:Tooltip.ContentTemplate&gt;&lt;c:ChartTooltipContent Indicator=&quot;Line&quot; /&gt;&lt;/p:Tooltip.ContentTemplate&gt;&lt;/p:Tooltip&gt;&#10;        &lt;p:Area DataKey=&quot;Desktop&quot; Type=&quot;Natural&quot; FillOpacity=&quot;0.4&quot; IsAnimationActive=&quot;False&quot; /&gt;&#10;      &lt;/p:AreaChart&gt;&#10;    &lt;/c:CardContent&gt;&#10;    &lt;c:CardFooter&gt;&#10;      &lt;StackPanel Spacing=&quot;8&quot;&gt;&#10;        &lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;8&quot;&gt;&#10;          &lt;TextBlock Text=&quot;Trending up by 5.2% this month&quot; FontSize=&quot;14&quot; LineHeight=&quot;14&quot; FontWeight=&quot;Medium&quot; VerticalAlignment=&quot;Center&quot; /&gt;&#10;          &lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot; VerticalAlignment=&quot;Center&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{DynamicResource CosmoForegroundBrush}&quot; Data=&quot;M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13&quot; /&gt;&lt;/Viewbox&gt;&#10;        &lt;/StackPanel&gt;&#10;        &lt;TextBlock Text=&quot;January - June 2024&quot; FontSize=&quot;14&quot; LineHeight=&quot;14&quot; Foreground=&quot;{DynamicResource CosmoMutedForegroundBrush}&quot; /&gt;&#10;      &lt;/StackPanel&gt;&#10;    &lt;/c:CardFooter&gt;&#10;  &lt;/c:Card&gt;&#10;&lt;/Border&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Area Chart - Gradient" />
      <TextBlock Classes="sm muted" Text="Stacked areas filled with gradients from the chart tokens (CosmoChart1TopColor to CosmoChart1BottomColor)." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Border MaxWidth="592" DataContext="{Binding Samples}" x:DataType="m:ChartSamples">
            <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Desktop" Label="Desktop" Color="PictorPalette1" /><c:ChartConfigItem Key="Mobile" Label="Mobile" Color="PictorPalette2" /></c:ChartConfig></Border.Resources>
            <c:Card>
              <c:CardHeader Title="Area Chart - Gradient" Description="Showing total visitors for the last 6 months" />
              <c:CardContent>
                <p:AreaChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding MonthsByDevice}" Aspect="1.7777777777777777" ResponsiveWidths="542" Padding="12,0,12,0">
                  <p:CartesianGrid Vertical="False" />
                  <p:XAxis DataKey="Month" TickLine="False" AxisLine="False" TickMargin="8" TickFormat="{}{0:MMM}" />
                  <p:Tooltip Cursor="False" LabelFormat="{}{0:MMMM}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent /></p:Tooltip.ContentTemplate></p:Tooltip>
                  <p:Area DataKey="Mobile" Type="Natural" FillOpacity="0.4" StackId="a" IsAnimationActive="False">
                    <p:Area.Fill>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0.05" Color="{DynamicResource CosmoChart2TopColor}" />
                        <GradientStop Offset="0.95" Color="{DynamicResource CosmoChart2BottomColor}" />
                      </LinearGradientBrush>
                    </p:Area.Fill>
                  </p:Area>
                  <p:Area DataKey="Desktop" Type="Natural" FillOpacity="0.4" StackId="a" IsAnimationActive="False">
                    <p:Area.Fill>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0.05" Color="{DynamicResource CosmoChart1TopColor}" />
                        <GradientStop Offset="0.95" Color="{DynamicResource CosmoChart1BottomColor}" />
                      </LinearGradientBrush>
                    </p:Area.Fill>
                  </p:Area>
                </p:AreaChart>
              </c:CardContent>
              <c:CardFooter>
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Trending up by 5.2% this month" FontSize="14" LineHeight="14" FontWeight="Medium" VerticalAlignment="Center" />
                    <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13" /></Viewbox>
                  </StackPanel>
                  <TextBlock Text="January - June 2024" FontSize="14" LineHeight="14" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                </StackPanel>
              </c:CardFooter>
            </c:Card>
          </Border>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Border MaxWidth=&quot;592&quot; DataContext=&quot;{Binding Samples}&quot; x:DataType=&quot;m:ChartSamples&quot;&gt;&#10;  &lt;Border.Resources&gt;&lt;c:ChartConfig x:Key=&quot;ChartConfig&quot;&gt;&lt;c:ChartConfigItem Key=&quot;Desktop&quot; Label=&quot;Desktop&quot; Color=&quot;PictorPalette1&quot; /&gt;&lt;c:ChartConfigItem Key=&quot;Mobile&quot; Label=&quot;Mobile&quot; Color=&quot;PictorPalette2&quot; /&gt;&lt;/c:ChartConfig&gt;&lt;/Border.Resources&gt;&#10;  &lt;c:Card&gt;&#10;    &lt;c:CardHeader Title=&quot;Area Chart - Gradient&quot; Description=&quot;Showing total visitors for the last 6 months&quot; /&gt;&#10;    &lt;c:CardContent&gt;&#10;      &lt;p:AreaChart c:ChartConfig.Config=&quot;{StaticResource ChartConfig}&quot; Data=&quot;{Binding MonthsByDevice}&quot; Aspect=&quot;1.7777777777777777&quot; ResponsiveWidths=&quot;542&quot; Padding=&quot;12,0,12,0&quot;&gt;&#10;        &lt;p:CartesianGrid Vertical=&quot;False&quot; /&gt;&#10;        &lt;p:XAxis DataKey=&quot;Month&quot; TickLine=&quot;False&quot; AxisLine=&quot;False&quot; TickMargin=&quot;8&quot; TickFormat=&quot;{}{0:MMM}&quot; /&gt;&#10;        &lt;p:Tooltip Cursor=&quot;False&quot; LabelFormat=&quot;{}{0:MMMM}&quot;&gt;&lt;p:Tooltip.ContentTemplate&gt;&lt;c:ChartTooltipContent /&gt;&lt;/p:Tooltip.ContentTemplate&gt;&lt;/p:Tooltip&gt;&#10;        &lt;p:Area DataKey=&quot;Mobile&quot; Type=&quot;Natural&quot; FillOpacity=&quot;0.4&quot; StackId=&quot;a&quot; IsAnimationActive=&quot;False&quot;&gt;&#10;          &lt;p:Area.Fill&gt;&#10;            &lt;LinearGradientBrush StartPoint=&quot;0%,0%&quot; EndPoint=&quot;0%,100%&quot;&gt;&#10;              &lt;GradientStop Offset=&quot;0.05&quot; Color=&quot;{DynamicResource CosmoChart2TopColor}&quot; /&gt;&#10;              &lt;GradientStop Offset=&quot;0.95&quot; Color=&quot;{DynamicResource CosmoChart2BottomColor}&quot; /&gt;&#10;            &lt;/LinearGradientBrush&gt;&#10;          &lt;/p:Area.Fill&gt;&#10;        &lt;/p:Area&gt;&#10;        &lt;p:Area DataKey=&quot;Desktop&quot; Type=&quot;Natural&quot; FillOpacity=&quot;0.4&quot; StackId=&quot;a&quot; IsAnimationActive=&quot;False&quot;&gt;&#10;          &lt;p:Area.Fill&gt;&#10;            &lt;LinearGradientBrush StartPoint=&quot;0%,0%&quot; EndPoint=&quot;0%,100%&quot;&gt;&#10;              &lt;GradientStop Offset=&quot;0.05&quot; Color=&quot;{DynamicResource CosmoChart1TopColor}&quot; /&gt;&#10;              &lt;GradientStop Offset=&quot;0.95&quot; Color=&quot;{DynamicResource CosmoChart1BottomColor}&quot; /&gt;&#10;            &lt;/LinearGradientBrush&gt;&#10;          &lt;/p:Area.Fill&gt;&#10;        &lt;/p:Area&gt;&#10;      &lt;/p:AreaChart&gt;&#10;    &lt;/c:CardContent&gt;&#10;    &lt;c:CardFooter&gt;&#10;      &lt;StackPanel Spacing=&quot;8&quot;&gt;&#10;        &lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;8&quot;&gt;&#10;          &lt;TextBlock Text=&quot;Trending up by 5.2% this month&quot; FontSize=&quot;14&quot; LineHeight=&quot;14&quot; FontWeight=&quot;Medium&quot; VerticalAlignment=&quot;Center&quot; /&gt;&#10;          &lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot; VerticalAlignment=&quot;Center&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{DynamicResource CosmoForegroundBrush}&quot; Data=&quot;M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13&quot; /&gt;&lt;/Viewbox&gt;&#10;        &lt;/StackPanel&gt;&#10;        &lt;TextBlock Text=&quot;January - June 2024&quot; FontSize=&quot;14&quot; LineHeight=&quot;14&quot; Foreground=&quot;{DynamicResource CosmoMutedForegroundBrush}&quot; /&gt;&#10;      &lt;/StackPanel&gt;&#10;    &lt;/c:CardFooter&gt;&#10;  &lt;/c:Card&gt;&#10;&lt;/Border&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Area Chart - Stacked" />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Border MaxWidth="592" DataContext="{Binding Samples}" x:DataType="m:ChartSamples">
            <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Desktop" Label="Desktop" Color="PictorPalette1" /><c:ChartConfigItem Key="Mobile" Label="Mobile" Color="PictorPalette2" /></c:ChartConfig></Border.Resources>
            <c:Card>
              <c:CardHeader Title="Area Chart - Stacked" Description="Showing total visitors for the last 6 months" />
              <c:CardContent>
                <p:AreaChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding MonthsByDevice}" Aspect="1.7777777777777777" ResponsiveWidths="542" Padding="12,0,12,0">
                  <p:CartesianGrid Vertical="False" />
                  <p:XAxis DataKey="Month" TickLine="False" AxisLine="False" TickMargin="8" TickFormat="{}{0:MMM}" />
                  <p:Tooltip Cursor="False" LabelFormat="{}{0:MMMM}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent Indicator="Dot" /></p:Tooltip.ContentTemplate></p:Tooltip>
                  <p:Area DataKey="Mobile" Type="Natural" FillOpacity="0.4" StackId="a" IsAnimationActive="False" />
                  <p:Area DataKey="Desktop" Type="Natural" FillOpacity="0.4" StackId="a" IsAnimationActive="False" />
                </p:AreaChart>
              </c:CardContent>
              <c:CardFooter>
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Trending up by 5.2% this month" FontSize="14" LineHeight="14" FontWeight="Medium" VerticalAlignment="Center" />
                    <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13" /></Viewbox>
                  </StackPanel>
                  <TextBlock Text="January - June 2024" FontSize="14" LineHeight="14" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                </StackPanel>
              </c:CardFooter>
            </c:Card>
          </Border>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Border MaxWidth=&quot;592&quot; DataContext=&quot;{Binding Samples}&quot; x:DataType=&quot;m:ChartSamples&quot;&gt;&#10;  &lt;Border.Resources&gt;&lt;c:ChartConfig x:Key=&quot;ChartConfig&quot;&gt;&lt;c:ChartConfigItem Key=&quot;Desktop&quot; Label=&quot;Desktop&quot; Color=&quot;PictorPalette1&quot; /&gt;&lt;c:ChartConfigItem Key=&quot;Mobile&quot; Label=&quot;Mobile&quot; Color=&quot;PictorPalette2&quot; /&gt;&lt;/c:ChartConfig&gt;&lt;/Border.Resources&gt;&#10;  &lt;c:Card&gt;&#10;    &lt;c:CardHeader Title=&quot;Area Chart - Stacked&quot; Description=&quot;Showing total visitors for the last 6 months&quot; /&gt;&#10;    &lt;c:CardContent&gt;&#10;      &lt;p:AreaChart c:ChartConfig.Config=&quot;{StaticResource ChartConfig}&quot; Data=&quot;{Binding MonthsByDevice}&quot; Aspect=&quot;1.7777777777777777&quot; ResponsiveWidths=&quot;542&quot; Padding=&quot;12,0,12,0&quot;&gt;&#10;        &lt;p:CartesianGrid Vertical=&quot;False&quot; /&gt;&#10;        &lt;p:XAxis DataKey=&quot;Month&quot; TickLine=&quot;False&quot; AxisLine=&quot;False&quot; TickMargin=&quot;8&quot; TickFormat=&quot;{}{0:MMM}&quot; /&gt;&#10;        &lt;p:Tooltip Cursor=&quot;False&quot; LabelFormat=&quot;{}{0:MMMM}&quot;&gt;&lt;p:Tooltip.ContentTemplate&gt;&lt;c:ChartTooltipContent Indicator=&quot;Dot&quot; /&gt;&lt;/p:Tooltip.ContentTemplate&gt;&lt;/p:Tooltip&gt;&#10;        &lt;p:Area DataKey=&quot;Mobile&quot; Type=&quot;Natural&quot; FillOpacity=&quot;0.4&quot; StackId=&quot;a&quot; IsAnimationActive=&quot;False&quot; /&gt;&#10;        &lt;p:Area DataKey=&quot;Desktop&quot; Type=&quot;Natural&quot; FillOpacity=&quot;0.4&quot; StackId=&quot;a&quot; IsAnimationActive=&quot;False&quot; /&gt;&#10;      &lt;/p:AreaChart&gt;&#10;    &lt;/c:CardContent&gt;&#10;    &lt;c:CardFooter&gt;&#10;      &lt;StackPanel Spacing=&quot;8&quot;&gt;&#10;        &lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;8&quot;&gt;&#10;          &lt;TextBlock Text=&quot;Trending up by 5.2% this month&quot; FontSize=&quot;14&quot; LineHeight=&quot;14&quot; FontWeight=&quot;Medium&quot; VerticalAlignment=&quot;Center&quot; /&gt;&#10;          &lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot; VerticalAlignment=&quot;Center&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{DynamicResource CosmoForegroundBrush}&quot; Data=&quot;M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13&quot; /&gt;&lt;/Viewbox&gt;&#10;        &lt;/StackPanel&gt;&#10;        &lt;TextBlock Text=&quot;January - June 2024&quot; FontSize=&quot;14&quot; LineHeight=&quot;14&quot; Foreground=&quot;{DynamicResource CosmoMutedForegroundBrush}&quot; /&gt;&#10;      &lt;/StackPanel&gt;&#10;    &lt;/c:CardFooter&gt;&#10;  &lt;/c:Card&gt;&#10;&lt;/Border&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Area Chart - Interactive" />
      <TextBlock Classes="sm muted" Text="The select chooses the time range; the chart&#x27;s Data binds to the model&#x27;s filtered days, and the legend is ChartLegendContent." />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Border MaxWidth="592" DataContext="{Binding Interactive}" x:DataType="m:ChartInteractive">
            <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Visitors" Label="Visitors" /><c:ChartConfigItem Key="Desktop" Label="Desktop" Color="PictorPalette1" /><c:ChartConfigItem Key="Mobile" Label="Mobile" Color="PictorPalette2" /></c:ChartConfig></Border.Resources>
            <c:Card Padding="0,0,0,24">
              <Border BorderBrush="{DynamicResource CosmoBorderBrush}" BorderThickness="0,0,0,1">
                <c:CardHeader Padding="24,20" Title="Area Chart - Interactive" Description="Showing total visitors for the last 3 months">
                  <c:CardHeader.Action>
                    <ComboBox Width="160" SelectedIndex="{Binding TimeRange}"><ComboBoxItem Content="Last 3 months" /><ComboBoxItem Content="Last 30 days" /><ComboBoxItem Content="Last 7 days" /></ComboBox>
                  </c:CardHeader.Action>
                </c:CardHeader>
              </Border>
              <c:CardContent Padding="24,24,24,0">
                <p:AreaChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Range}" Height="250" ResponsiveWidths="240 360 542 720">
                  <p:CartesianGrid Vertical="False" />
                  <p:XAxis DataKey="Date" TickLine="False" AxisLine="False" TickMargin="8" MinTickGap="32" TickFormat="{}{0:MMM d}" />
                  <p:Tooltip Cursor="False" LabelFormat="{}{0:MMM d}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent Indicator="Dot" /></p:Tooltip.ContentTemplate></p:Tooltip>
                  <p:Area DataKey="Mobile" Type="Natural" StackId="a" IsAnimationActive="False">
                    <p:Area.Fill>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0.05" Color="{DynamicResource CosmoChart2TopColor}" />
                        <GradientStop Offset="0.95" Color="{DynamicResource CosmoChart2BottomColor}" />
                      </LinearGradientBrush>
                    </p:Area.Fill>
                  </p:Area>
                  <p:Area DataKey="Desktop" Type="Natural" StackId="a" IsAnimationActive="False">
                    <p:Area.Fill>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0.05" Color="{DynamicResource CosmoChart1TopColor}" />
                        <GradientStop Offset="0.95" Color="{DynamicResource CosmoChart1BottomColor}" />
                      </LinearGradientBrush>
                    </p:Area.Fill>
                  </p:Area>
                  <p:Legend><p:Legend.Template><c:ChartLegendContent /></p:Legend.Template><p:Legend.ContentTemplate><c:ChartLegendItem /></p:Legend.ContentTemplate></p:Legend>
                </p:AreaChart>
              </c:CardContent>
            </c:Card>
          </Border>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Border MaxWidth=&quot;592&quot; DataContext=&quot;{Binding Interactive}&quot; x:DataType=&quot;m:ChartInteractive&quot;&gt;&#10;  &lt;Border.Resources&gt;&lt;c:ChartConfig x:Key=&quot;ChartConfig&quot;&gt;&lt;c:ChartConfigItem Key=&quot;Visitors&quot; Label=&quot;Visitors&quot; /&gt;&lt;c:ChartConfigItem Key=&quot;Desktop&quot; Label=&quot;Desktop&quot; Color=&quot;PictorPalette1&quot; /&gt;&lt;c:ChartConfigItem Key=&quot;Mobile&quot; Label=&quot;Mobile&quot; Color=&quot;PictorPalette2&quot; /&gt;&lt;/c:ChartConfig&gt;&lt;/Border.Resources&gt;&#10;  &lt;c:Card Padding=&quot;0,0,0,24&quot;&gt;&#10;    &lt;Border BorderBrush=&quot;{DynamicResource CosmoBorderBrush}&quot; BorderThickness=&quot;0,0,0,1&quot;&gt;&#10;      &lt;c:CardHeader Padding=&quot;24,20&quot; Title=&quot;Area Chart - Interactive&quot; Description=&quot;Showing total visitors for the last 3 months&quot;&gt;&#10;        &lt;c:CardHeader.Action&gt;&#10;          &lt;ComboBox Width=&quot;160&quot; SelectedIndex=&quot;{Binding TimeRange}&quot;&gt;&lt;ComboBoxItem Content=&quot;Last 3 months&quot; /&gt;&lt;ComboBoxItem Content=&quot;Last 30 days&quot; /&gt;&lt;ComboBoxItem Content=&quot;Last 7 days&quot; /&gt;&lt;/ComboBox&gt;&#10;        &lt;/c:CardHeader.Action&gt;&#10;      &lt;/c:CardHeader&gt;&#10;    &lt;/Border&gt;&#10;    &lt;c:CardContent Padding=&quot;24,24,24,0&quot;&gt;&#10;      &lt;p:AreaChart c:ChartConfig.Config=&quot;{StaticResource ChartConfig}&quot; Data=&quot;{Binding Range}&quot; Height=&quot;250&quot; ResponsiveWidths=&quot;240 360 542 720&quot;&gt;&#10;        &lt;p:CartesianGrid Vertical=&quot;False&quot; /&gt;&#10;        &lt;p:XAxis DataKey=&quot;Date&quot; TickLine=&quot;False&quot; AxisLine=&quot;False&quot; TickMargin=&quot;8&quot; MinTickGap=&quot;32&quot; TickFormat=&quot;{}{0:MMM d}&quot; /&gt;&#10;        &lt;p:Tooltip Cursor=&quot;False&quot; LabelFormat=&quot;{}{0:MMM d}&quot;&gt;&lt;p:Tooltip.ContentTemplate&gt;&lt;c:ChartTooltipContent Indicator=&quot;Dot&quot; /&gt;&lt;/p:Tooltip.ContentTemplate&gt;&lt;/p:Tooltip&gt;&#10;        &lt;p:Area DataKey=&quot;Mobile&quot; Type=&quot;Natural&quot; StackId=&quot;a&quot; IsAnimationActive=&quot;False&quot;&gt;&#10;          &lt;p:Area.Fill&gt;&#10;            &lt;LinearGradientBrush StartPoint=&quot;0%,0%&quot; EndPoint=&quot;0%,100%&quot;&gt;&#10;              &lt;GradientStop Offset=&quot;0.05&quot; Color=&quot;{DynamicResource CosmoChart2TopColor}&quot; /&gt;&#10;              &lt;GradientStop Offset=&quot;0.95&quot; Color=&quot;{DynamicResource CosmoChart2BottomColor}&quot; /&gt;&#10;            &lt;/LinearGradientBrush&gt;&#10;          &lt;/p:Area.Fill&gt;&#10;        &lt;/p:Area&gt;&#10;        &lt;p:Area DataKey=&quot;Desktop&quot; Type=&quot;Natural&quot; StackId=&quot;a&quot; IsAnimationActive=&quot;False&quot;&gt;&#10;          &lt;p:Area.Fill&gt;&#10;            &lt;LinearGradientBrush StartPoint=&quot;0%,0%&quot; EndPoint=&quot;0%,100%&quot;&gt;&#10;              &lt;GradientStop Offset=&quot;0.05&quot; Color=&quot;{DynamicResource CosmoChart1TopColor}&quot; /&gt;&#10;              &lt;GradientStop Offset=&quot;0.95&quot; Color=&quot;{DynamicResource CosmoChart1BottomColor}&quot; /&gt;&#10;            &lt;/LinearGradientBrush&gt;&#10;          &lt;/p:Area.Fill&gt;&#10;        &lt;/p:Area&gt;&#10;        &lt;p:Legend&gt;&lt;p:Legend.Template&gt;&lt;c:ChartLegendContent /&gt;&lt;/p:Legend.Template&gt;&lt;p:Legend.ContentTemplate&gt;&lt;c:ChartLegendItem /&gt;&lt;/p:Legend.ContentTemplate&gt;&lt;/p:Legend&gt;&#10;      &lt;/p:AreaChart&gt;&#10;    &lt;/c:CardContent&gt;&#10;  &lt;/c:Card&gt;&#10;&lt;/Border&gt;" /></Border>
    </StackPanel>
    <StackPanel Spacing="12">
      <TextBlock Classes="h2" Text="Bar Chart" />
      <Border Classes="preview">
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Border MaxWidth="592" DataContext="{Binding Samples}" x:DataType="m:ChartSamples">
            <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Desktop" Label="Desktop" Color="PictorPalette1" /></c:ChartConfig></Border.Resources>
            <c:Card>
              <c:CardHeader Title="Bar Chart" Description="January - June 2024" />
              <c:CardContent>
                <p:BarChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Months}" Aspect="1.7777777777777777" ResponsiveWidths="542">
                  <p:CartesianGrid Vertical="False" />
                  <p:XAxis DataKey="Month" TickLine="False" AxisLine="False" TickMargin="10" TickFormat="{}{0:MMM}" />
                  <p:Tooltip Cursor="False" LabelFormat="{}{0:MMMM}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent HideLabel="True" /></p:Tooltip.ContentTemplate></p:Tooltip>
                  <p:Bar DataKey="Desktop" Radius="8" IsAnimationActive="False" />
                </p:BarChart>
              </c:CardContent>
              <c:CardFooter>
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Trending up by 5.2% this month" FontSize="14" LineHeight="14" FontWeight="Medium" VerticalAlignment="Top" />
                    <Viewbox Width="16" Height="16" VerticalAlignment="Top"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13" /></Viewbox>
                  </StackPanel>
                  <TextBlock Text="Showing total visitors for the last 6 months" FontSize="14" LineHeight="14" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                </StackPanel>
              </c:CardFooter>
            </c:Card>
          </Border>
        </Border>
      </Border>
      <Border Classes="code"><TextBlock Text="&lt;Border MaxWidth=&quot;592&quot; DataContext=&quot;{Binding Samples}&quot; x:DataType=&quot;m:ChartSamples&quot;&gt;&#10;  &lt;Border.Resources&gt;&lt;c:ChartConfig x:Key=&quot;ChartConfig&quot;&gt;&lt;c:ChartConfigItem Key=&quot;Desktop&quot; Label=&quot;Desktop&quot; Color=&quot;PictorPalette1&quot; /&gt;&lt;/c:ChartConfig&gt;&lt;/Border.Resources&gt;&#10;  &lt;c:Card&gt;&#10;    &lt;c:CardHeader Title=&quot;Bar Chart&quot; Description=&quot;January - June 2024&quot; /&gt;&#10;    &lt;c:CardContent&gt;&#10;      &lt;p:BarChart c:ChartConfig.Config=&quot;{StaticResource ChartConfig}&quot; Data=&quot;{Binding Months}&quot; Aspect=&quot;1.7777777777777777&quot; ResponsiveWidths=&quot;542&quot;&gt;&#10;        &lt;p:CartesianGrid Vertical=&quot;False&quot; /&gt;&#10;        &lt;p:XAxis DataKey=&quot;Month&quot; TickLine=&quot;False&quot; AxisLine=&quot;False&quot; TickMargin=&quot;10&quot; TickFormat=&quot;{}{0:MMM}&quot; /&gt;&#10;        &lt;p:Tooltip Cursor=&quot;False&quot; LabelFormat=&quot;{}{0:MMMM}&quot;&gt;&lt;p:Tooltip.ContentTemplate&gt;&lt;c:ChartTooltipContent HideLabel=&quot;True&quot; /&gt;&lt;/p:Tooltip.ContentTemplate&gt;&lt;/p:Tooltip&gt;&#10;        &lt;p:Bar DataKey=&quot;Desktop&quot; Radius=&quot;8&quot; IsAnimationActive=&quot;False&quot; /&gt;&#10;      &lt;/p:BarChart&gt;&#10;    &lt;/c:CardContent&gt;&#10;    &lt;c:CardFooter&gt;&#10;      &lt;StackPanel Spacing=&quot;8&quot;&gt;&#10;        &lt;StackPanel Orientation=&quot;Horizontal&quot; Spacing=&quot;8&quot;&gt;&#10;          &lt;TextBlock Text=&quot;Trending up by 5.2% this month&quot; FontSize=&quot;14&quot; LineHeight=&quot;14&quot; FontWeight=&quot;Medium&quot; VerticalAlignment=&quot;Top&quot; /&gt;&#10;          &lt;Viewbox Width=&quot;16&quot; Height=&quot;16&quot; VerticalAlignment=&quot;Top&quot;&gt;&lt;Path Theme=&quot;{DynamicResource CosmoIcon}&quot; Stroke=&quot;{DynamicResource CosmoForegroundBrush}&quot; Data=&quot;M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13&quot; /&gt;&lt;/Viewbox&gt;&#10;        &lt;/StackPanel&gt;&#10;        &lt;TextBlock Text=&quot;Showing total visitors for the last 6 months&quot; FontSize=&quot;14&quot; LineHeight=&quot;14&quot; Foreground=&quot;{DynamicResource CosmoMutedForegroundBrush}&quot; /&gt;&#10;      &lt;/StackPanel&gt;&#10;    &lt;/c:CardFooter&gt;&#10;  &lt;/c:Card&gt;&#10;&lt;/Border&gt;" /></Border>
    </StackPanel>
