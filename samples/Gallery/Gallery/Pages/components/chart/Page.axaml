osmoIcon}&quot; Stroke=&quot;{DynamicResource CosmoForegroundBrush}&quot; Data=&quot;M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13&quot; /&gt;&lt;/Viewbox&gt;&#10;        &lt;/StackPanel&gt;&#10;        &lt;TextBlock Text=&quot;January - June 2024&quot; FontSize=&quot;14&quot; LineHeight=&quot;14&quot; Foreground=&quot;{DynamicResource CosmoMutedForegroundBrush}&quot; HorizontalAlignment=&quot;Center&quot; /&gt;&#10;      &lt;/StackPanel&gt;&#10;    &lt;/c:CardFooter&gt;&#10;  &lt;/c:Card&gt;&#10;&lt;/Border&gt;" /></Border>
