<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" a:Page.Title="Fidelity: input-otp">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <StackPanel Spacing="24">
      <c:InputOtp Length="6" GroupSize="3" Text="123" AutomationProperties.Name="Code" />
      <c:InputOtp Length="4" IsEnabled="False" AutomationProperties.Name="Locked code" />
    </StackPanel>
  </Border>
</UserControl>
