<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Page.Title="Fidelity: attachment-image">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
          <StackPanel Width="384" HorizontalAlignment="Center" Margin="0,48" Spacing="0">
    <c:AttachmentGroup HorizontalAlignment="Center"><c:Attachment Title="workspace.png" Description="PNG · 820 KB" Classes="vertical image">
                <c:Attachment.Media><Image Source="/Assets/art-binni.png" Stretch="UniformToFill" /></c:Attachment.Media>
                <c:Attachment.Actions><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove workspace.png"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></c:Attachment.Actions>
                <c:Attachment.Trigger><HyperlinkButton Theme="{DynamicResource CosmoAttachmentTrigger}" NavigateUri="/Assets/art-binni.png" AutomationProperties.Name="Open workspace.png" /></c:Attachment.Trigger>
              </c:Attachment><c:Attachment Title="desk-reference.jpg" Description="JPG · 1.1 MB" Classes="vertical image">
                <c:Attachment.Media><Image Source="/Assets/art-byrom.png" Stretch="UniformToFill" /></c:Attachment.Media>
                <c:Attachment.Actions><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove desk-reference.jpg"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></c:Attachment.Actions>
                <c:Attachment.Trigger><HyperlinkButton Theme="{DynamicResource CosmoAttachmentTrigger}" NavigateUri="/Assets/art-byrom.png" AutomationProperties.Name="Open desk-reference.jpg" /></c:Attachment.Trigger>
              </c:Attachment><c:Attachment Title="office-reference.jpg" Description="JPG · 940 KB" Classes="vertical image">
                <c:Attachment.Media><Image Source="/Assets/art-malyavko.png" Stretch="UniformToFill" /></c:Attachment.Media>
                <c:Attachment.Actions><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove office-reference.jpg"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></c:Attachment.Actions>
                <c:Attachment.Trigger><HyperlinkButton Theme="{DynamicResource CosmoAttachmentTrigger}" NavigateUri="/Assets/art-malyavko.png" AutomationProperties.Name="Open office-reference.jpg" /></c:Attachment.Trigger>
              </c:Attachment></c:AttachmentGroup>
          </StackPanel>
  </Border>
</UserControl>
