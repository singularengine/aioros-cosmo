<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" a:Page.Title="Fidelity: toggle-states">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <ToggleButton AutomationProperties.Name="Like" VerticalAlignment="Center"><a:Icon Kind="heart" Size="16" /></ToggleButton>
      <ToggleButton AutomationProperties.Name="Star" IsChecked="True" VerticalAlignment="Center"><a:Icon Kind="star" Size="16" /></ToggleButton>
      <ToggleButton Classes="outline" AutomationProperties.Name="Bell" VerticalAlignment="Center"><a:Icon Kind="bell" Size="16" /></ToggleButton>
      <ToggleButton Classes="sm" AutomationProperties.Name="Like" VerticalAlignment="Center"><a:Icon Kind="heart" Size="16" /></ToggleButton>
      <ToggleButton Classes="lg" AutomationProperties.Name="Like" VerticalAlignment="Center"><a:Icon Kind="heart" Size="16" /></ToggleButton>
      <ToggleButton AutomationProperties.Name="Like" IsEnabled="False" VerticalAlignment="Center"><a:Icon Kind="heart" Size="16" /></ToggleButton>
      <ToggleButton Classes="outline" VerticalAlignment="Center">
        <StackPanel>
          <a:Icon Kind="star" Size="16" />
          <TextBlock Text="Favorite" VerticalAlignment="Center" />
        </StackPanel>
      </ToggleButton>
    </WrapPanel>
  </Border>
</UserControl>
