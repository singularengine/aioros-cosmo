<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Page.Title="Fidelity: attachment-group">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
          <StackPanel Width="384" HorizontalAlignment="Center" Margin="0,48" Spacing="0">
    <c:AttachmentGroup><c:Attachment Title="briefing-notes.pdf" Description="PDF · 1.4 MB" Width="256"><c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4 M10 9H8 M16 13H8 M16 17H8" /></Viewbox></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove briefing-notes.pdf"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment><c:Attachment Title="workspace.png" Description="PNG · 820 KB" Classes="image" Width="256"><c:Attachment.Media><Image Source="/Assets/art-binni.png" Stretch="UniformToFill" /></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove workspace.png"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment><c:Attachment Title="customers.csv" Description="CSV · 18 KB" Width="256"><c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M12 3v18 M5,3 L19,3 A2,2 0 0 1 21,5 L21,19 A2,2 0 0 1 19,21 L5,21 A2,2 0 0 1 3,19 L3,5 A2,2 0 0 1 5,3 Z M3 9h18 M3 15h18" /></Viewbox></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove customers.csv"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment><c:Attachment Title="renderer.tsx" Description="TSX · 12 KB" Width="256"><c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M10 12.5 8 15l2 2.5 M14 12.5 l2 2.5-2 2.5 M14 2v4a2 2 0 0 0 2 2h4 M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z" /></Viewbox></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove renderer.tsx"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment></c:AttachmentGroup>
          </StackPanel>
  </Border>
</UserControl>
