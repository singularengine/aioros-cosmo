<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Page.Title="Fidelity: trace-status">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <c:Trace Width="384" HorizontalAlignment="Left">
      <c:TraceLine Content="Ran pnpm install"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M9 12 l2 2 4-4" /></Viewbox></c:TraceLine.Icon></c:TraceLine>
      <c:TraceLine Content="Failed to run pnpm lint" Status="Error"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12,8 L12,12 M12,16 L12.01,16" /></Viewbox></c:TraceLine.Icon></c:TraceLine>
      <c:TraceLine Content="Running pnpm build" Status="Running"><c:TraceLine.Icon><c:Spinner Width="16" Height="16" /></c:TraceLine.Icon></c:TraceLine>
      <c:TraceLine Content="Run pnpm test" Status="Pending"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z" /></Viewbox></c:TraceLine.Icon></c:TraceLine>
    </c:Trace>
  </Border>
</UserControl>
