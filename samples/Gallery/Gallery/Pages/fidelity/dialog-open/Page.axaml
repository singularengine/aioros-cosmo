<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" x:DataType="m:OverlayExamples" a:Page.Title="Fidelity: dialog-open">
  <Panel a:Web.Id="fixture" Width="640" Height="480" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}" c:OverlayHost.IsHost="True">
    <Border Padding="24">
      <Panel>
        <Button Classes="outline" Content="Open Dialog" Command="{Binding EditCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <c:Dialog IsOpen="{Binding EditOpen}" MaxWidth="425">
          <StackPanel Spacing="16">
            <c:DialogHeader Title="Edit profile" Description="Make changes to your profile here. Click save when you're done." />
            <StackPanel Spacing="16">
              <StackPanel Spacing="12">
                <Label Content="Name" />
                <TextBox Text="{Binding Name}" AutomationProperties.Name="Name" />
              </StackPanel>
              <StackPanel Spacing="12">
                <Label Content="Username" />
                <TextBox Text="{Binding Username}" AutomationProperties.Name="Username" />
              </StackPanel>
            </StackPanel>
            <c:DialogFooter>
              <Button Classes="outline" Content="Cancel" Command="{Binding AnswerCommand}" CommandParameter="cancel" />
              <Button Content="Save changes" Command="{Binding AnswerCommand}" CommandParameter="save" />
            </c:DialogFooter>
          </StackPanel>
        </c:Dialog>
      </Panel>
    </Border>
  </Panel>
</UserControl>
