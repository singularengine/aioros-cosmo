<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" a:Page.Title="Fidelity: button-icons">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <Button Classes="has-icon">
        <StackPanel><a:Icon Kind="mail" /><TextBlock Text="Login with Email" /></StackPanel>
      </Button>
      <Button Classes="outline sm has-icon">
        <StackPanel><a:Icon Kind="plus" /><TextBlock Text="New" /></StackPanel>
      </Button>
      <Button Classes="secondary lg has-icon">
        <StackPanel><TextBlock Text="Continue" /><a:Icon Kind="chevron-right" /></StackPanel>
      </Button>
    </WrapPanel>
  </Border>
</UserControl>
