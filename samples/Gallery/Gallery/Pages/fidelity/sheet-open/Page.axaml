<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" x:DataType="m:OverlayExamples" a:Page.Title="Fidelity: sheet-open">
  <Panel a:Web.Id="fixture" Width="640" Height="600" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}" c:OverlayHost.IsHost="True">
    <Border Padding="24">
      <Panel>
        <Button Classes="outline" Content="Open" Command="{Binding SheetCommand}" CommandParameter="Right" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <c:Sheet IsOpen="{Binding SheetOpen}">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
            <c:DialogHeader Title="Edit profile" Description="Make changes to your profile here. Click save when you're done." />
            <StackPanel Grid.Row="1" Spacing="24" Margin="16,0">
              <StackPanel Spacing="12">
                <Label Content="Name" />
                <TextBox Text="{Binding Name}" AutomationProperties.Name="Name" />
              </StackPanel>
              <StackPanel Spacing="12">
                <Label Content="Username" />
                <TextBox Text="{Binding Username}" AutomationProperties.Name="Username" />
              </StackPanel>
            </StackPanel>
            <c:DialogFooter Grid.Row="2">
              <Button Content="Save changes" Command="{Binding AnswerCommand}" CommandParameter="save" />
              <Button Classes="outline" Content="Close" Command="{Binding AnswerCommand}" CommandParameter="close" />
            </c:DialogFooter>
          </Grid>
        </c:Sheet>
      </Panel>
    </Border>
  </Panel>
</UserControl>
