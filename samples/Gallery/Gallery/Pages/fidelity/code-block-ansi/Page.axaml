<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Page.Title="Fidelity: code-block-ansi">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <c:CodeBlock Width="448" HorizontalAlignment="Left">
      <c:CodeBlock.Title><StackPanel Orientation="Horizontal" Spacing="6"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox><TextBlock Text="Terminal" VerticalAlignment="Center" /></StackPanel></c:CodeBlock.Title><c:CodeBlock.Actions><StackPanel Orientation="Horizontal" Spacing="4"><c:CodeBlockCopyButton Value="$ pnpm test&#10;✓ src/format.test.ts (4 tests)&#10;✓ src/parse.test.ts (7 tests)&#10;✗ src/stream.test.ts (3 tests | 1 failed)&#10;&#10;AssertionError: expected 'hello' to be 'hello world'&#10;&#10;Tests  1 failed | 13 passed (14)" /></StackPanel></c:CodeBlock.Actions>
      <c:CodeBlockContent Wrap="True">
        <StackPanel>
          <c:CodeBlockLine><TextBlock><Run Text="$ pnpm test" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="✓" Foreground="{DynamicResource CosmoCodeAnsiGreenBrush}" /><Run Text=" src/format.test.ts " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="(4 tests)" Foreground="{DynamicResource CosmoCodeTextDimBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="✓" Foreground="{DynamicResource CosmoCodeAnsiGreenBrush}" /><Run Text=" src/parse.test.ts " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="(7 tests)" Foreground="{DynamicResource CosmoCodeTextDimBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="✗" Foreground="{DynamicResource CosmoCodeAnsiRedBrush}" /><Run Text=" src/stream.test.ts " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="(3 tests | 1 failed)" Foreground="{DynamicResource CosmoCodeTextDimBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="AssertionError: expected 'hello' to be 'hello world'" Foreground="{DynamicResource CosmoCodeAnsiRedBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="Tests  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="1 failed" Foreground="{DynamicResource CosmoCodeAnsiRedBrush}" /><Run Text=" | " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="13 passed" Foreground="{DynamicResource CosmoCodeAnsiGreenBrush}" /><Run Text=" (14)" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
        </StackPanel>
      </c:CodeBlockContent>
    </c:CodeBlock>
  </Border>
</UserControl>
