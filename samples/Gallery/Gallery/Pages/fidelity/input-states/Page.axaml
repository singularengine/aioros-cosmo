<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" a:Page.Title="Fidelity: input-states">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <StackPanel Spacing="16" Width="384" HorizontalAlignment="Left">
      <StackPanel Spacing="12">
        <Label Content="Email" Target="{Binding #email}" />
        <TextBox Name="email" a:Web.Id="email" a:Web.InputType="email" PlaceholderText="Email" />
      </StackPanel>
      <TextBox Text="shadcn@example.com" />
      <TextBox IsEnabled="False" PlaceholderText="Disabled" />
    </StackPanel>
  </Border>
</UserControl>
