<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" a:Page.Title="Fidelity: badge-variants">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <c:Badge Content="Badge" />
      <c:Badge Classes="secondary" Content="Badge" />
      <c:Badge Classes="destructive" Content="Badge" />
      <c:Badge Classes="outline" Content="Badge" />
      <c:Badge Classes="ghost" Content="Badge" />
      <c:Badge Classes="link" Content="Badge" />
    </WrapPanel>
  </Border>
</UserControl>
