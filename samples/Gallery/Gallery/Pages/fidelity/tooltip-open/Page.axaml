<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" a:Page.Title="Fidelity: tooltip-open">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <Panel Height="96">
      <Button Classes="outline" Content="Hover" ToolTip.Tip="Add to library" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
    </Panel>
  </Border>
</UserControl>
