<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Page.Title="Fidelity: bubble-variants">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="48">
    <c:Bubble Content="This is the default primary bubble." />
    <c:Bubble Classes="secondary end" Content="This is the secondary variant." />
    <c:Bubble Classes="muted" Content="This one is muted. It uses a lower emphasis color for the chat bubble."><c:Bubble.Reactions><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="👍" /></StackPanel></c:Bubble.Reactions></c:Bubble>
    <c:Bubble Classes="tinted end" Content="This one is tinted. The tint is a softer color derived from the primary color." />
    <c:Bubble Classes="outline" Content="We can also use an outlined variant." />
    <c:Bubble Classes="destructive end" Content="Or a destructive variant with a reaction."><c:Bubble.Reactions><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="🔥" /></StackPanel></c:Bubble.Reactions></c:Bubble>
    <c:Bubble Classes="ghost" Content="Ghost bubbles work for assistant text and other content that should not be framed. They are full width and can take the full width of the container." />
          </StackPanel>
  </Border>
</UserControl>
