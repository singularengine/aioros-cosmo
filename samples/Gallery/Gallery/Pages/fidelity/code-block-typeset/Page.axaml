<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Page.Title="Fidelity: code-block-typeset">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <StackPanel Width="448" HorizontalAlignment="Left">
      <TextBlock Classes="typeset" Text="Stream a response" FontSize="18" FontWeight="SemiBold" LineHeight="26.1" />
      <TextBlock Classes="typeset" TextWrapping="Wrap" FontSize="16" LineHeight="28" Margin="0,16,0,0"><Run Text="Create a route handler that calls " /><InlineUIContainer><Border Classes="typeset-code"><TextBlock Text="streamText" /></Border></InlineUIContainer><Run Text=" and returns the stream to the client." /></TextBlock>
      <c:CodeBlock Margin="0,17.5,0,0">
      <c:CodeBlock.Title><StackPanel Orientation="Horizontal" Spacing="6"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M10 12.5 8 15l2 2.5 M14 12.5 l2 2.5-2 2.5 M14 2v4a2 2 0 0 0 2 2h4 M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z" /></Viewbox><TextBlock Text="app/api/chat/route.ts" VerticalAlignment="Center" /></StackPanel></c:CodeBlock.Title><c:CodeBlock.Actions><StackPanel Orientation="Horizontal" Spacing="4"><c:CodeBlockCopyButton Value="import { streamText } from &quot;ai&quot;&#10;&#10;export async function POST(request: Request) {&#10;  const { messages } = await request.json()&#10;  const result = streamText({ model: &quot;anthropic/claude-sonnet-4.5&quot;, messages })&#10;&#10;  return result.toUIMessageStreamResponse()&#10;}" /></StackPanel></c:CodeBlock.Actions>
      <c:CodeBlockContent LineNumbers="True">
        <StackPanel>
          <c:CodeBlockLine><TextBlock><Run Text="import" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" { streamText } " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="from" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;ai&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="export" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="async" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="function" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="POST" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="(" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="request" Foreground="{DynamicResource CosmoCodeVariableBrush}" /><Run Text=":" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="Request" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text=") {" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="const" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" { " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="messages" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=" } " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="await" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" request." Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="json" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="()" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="const" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="result" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="streamText" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="({ model: " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;anthropic/claude-sonnet-4.5&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /><Run Text=", messages })" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="return" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" result." Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="toUIMessageStreamResponse" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="()" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="}" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
        </StackPanel>
      </c:CodeBlockContent>
    </c:CodeBlock>
      <TextBlock Classes="typeset" TextWrapping="Wrap" FontSize="16" LineHeight="28" Margin="0,20,0,0"><Run Text="The " /><InlineUIContainer><Border Classes="typeset-code"><TextBlock Text="useChat" /></Border></InlineUIContainer><Run Text=" hook reads the stream on the client and renders the answer while it is written." /></TextBlock>
    </StackPanel>
  </Border>
</UserControl>
