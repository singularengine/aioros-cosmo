<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Page.Title="Fidelity: trace-open">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <c:Collapsible Width="384" HorizontalAlignment="Left" Spacing="16">
    <Expander Classes="trace" IsExpanded="True">
      <Expander.Header><c:TraceLine Content="Ran node --version"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox></c:TraceLine.Icon></c:TraceLine></Expander.Header>
      <c:CodeBlock Classes="sm">

      <c:CodeBlockContent Wrap="True">
        <StackPanel>
          <c:CodeBlockLine><TextBlock Text="$ node --version" /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text="v24.18.0" /></c:CodeBlockLine>
        </StackPanel>
      </c:CodeBlockContent>
    </c:CodeBlock>
    </Expander>
    <Expander Classes="trace" IsExpanded="{Binding $parent[c:Collapsible].IsOpen, Mode=TwoWay}">
      <Expander.Header><c:TraceLine Content="Ran pnpm --version"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox></c:TraceLine.Icon></c:TraceLine></Expander.Header>
      <c:CodeBlock Classes="sm">

      <c:CodeBlockContent Wrap="True">
        <StackPanel>
          <c:CodeBlockLine><TextBlock Text="$ pnpm --version" /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text="10.33.4" /></c:CodeBlockLine>
        </StackPanel>
      </c:CodeBlockContent>
    </c:CodeBlock>
    </Expander>
    <c:CollapsibleTrigger Classes="outline sm" Height="28" Padding="12,0" CornerRadius="16" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock c:Collapsible.Shows="Closed" Text="Show the pnpm output" /><TextBlock c:Collapsible.Shows="Open" Text="Hide the pnpm output" /></StackPanel></c:CollapsibleTrigger>
    </c:Collapsible>
  </Border>
</UserControl>
