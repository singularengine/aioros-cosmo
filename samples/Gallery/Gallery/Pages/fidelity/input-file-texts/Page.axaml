<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" a:Page.Title="Fidelity: input-file-texts">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <StackPanel Spacing="12" Width="384" HorizontalAlignment="Left">
      <a:FilePicker a:Web.Id="translated" Content="Foto" c:FileInput.ChooseText="Elegir archivo" c:FileInput.EmptyText="Ningún archivo" />
      <a:FilePicker a:Web.Id="plain" Content="Picture" />
    </StackPanel>
  </Border>
</UserControl>
