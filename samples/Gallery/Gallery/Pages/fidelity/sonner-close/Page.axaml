<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" x:DataType="m:OverlayExamples" a:Page.Title="Fidelity: sonner-close">
  <Border a:Web.Id="fixture" Width="640" Height="260" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <Panel>
      <Button Classes="outline" Content="Show Toast" Command="{Binding ClosableCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" />
      <c:Toaster Toasts="{Binding Toasts}" CloseButton="True" />
    </Panel>
  </Border>
</UserControl>
