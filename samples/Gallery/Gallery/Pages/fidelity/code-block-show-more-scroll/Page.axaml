<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Page.Title="Fidelity: code-block-show-more-scroll">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <c:Collapsible Width="448" HorizontalAlignment="Left">
    <c:CodeBlock Width="448" HorizontalAlignment="Left" Title="components/chat.tsx">
      <c:CodeBlock.Actions><StackPanel Orientation="Horizontal" Spacing="4"><c:CodeBlockCopyButton Value="&quot;use client&quot;&#10;&#10;import * as React from &quot;react&quot;&#10;import { useChat } from &quot;@ai-sdk/react&quot;&#10;&#10;import { Button } from &quot;@/components/ui/button&quot;&#10;import { Input } from &quot;@/components/ui/input&quot;&#10;&#10;export function Chat() {&#10;  const [input, setInput] = React.useState(&quot;&quot;)&#10;  const { messages, sendMessage, status } = useChat()&#10;&#10;  return (&#10;    &lt;div className=&quot;flex flex-col gap-4&quot;&gt;&#10;      {messages.map((message) =&gt; (&#10;        &lt;div key={message.id}&gt;&#10;          {message.parts.map((part, index) =&gt;&#10;            part.type === &quot;text&quot; ? &lt;p key={index}&gt;{part.text}&lt;/p&gt; : null&#10;          )}&#10;        &lt;/div&gt;&#10;      ))}&#10;      &lt;form&#10;        onSubmit={(event) =&gt; {&#10;          event.preventDefault()&#10;          sendMessage({ text: input })&#10;          setInput(&quot;&quot;)&#10;        }}&#10;      &gt;&#10;        &lt;Input value={input} onChange={(event) =&gt; setInput(event.target.value)} /&gt;&#10;        &lt;Button disabled={status !== &quot;ready&quot;}&gt;Send&lt;/Button&gt;&#10;      &lt;/form&gt;&#10;    &lt;/div&gt;&#10;  )&#10;}" /></StackPanel></c:CodeBlock.Actions>
      <c:CodeBlockContent Classes="show-more scroll" LineNumbers="True">
        <StackPanel>
          <c:CodeBlockLine><TextBlock><Run Text="&quot;use client&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="import" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="*" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="as" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" React " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="from" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;react&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="import" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" { useChat } " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="from" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;@ai-sdk/react&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="import" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" { Button } " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="from" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;@/components/ui/button&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="import" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" { Input } " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="from" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;@/components/ui/input&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="export" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="function" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="Chat" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="() {" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="const" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" [" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="input" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=", " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="setInput" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text="] " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" React." Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="useState" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="(" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /><Run Text=")" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="const" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" { " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="messages" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=", " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="sendMessage" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=", " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="status" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=" } " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="useChat" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="()" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="return" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" (" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="    &lt;" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="div" Foreground="{DynamicResource CosmoCodeTagBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="className" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="&quot;flex flex-col gap-4&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /><Run Text="&gt;" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="      {messages." Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="map" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="((" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="message" Foreground="{DynamicResource CosmoCodeVariableBrush}" /><Run Text=") " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=&gt;" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" (" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="        &lt;" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="div" Foreground="{DynamicResource CosmoCodeTagBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="key" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="{}{message.id}&gt;" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="          {message.parts." Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="map" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="((" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="part" Foreground="{DynamicResource CosmoCodeVariableBrush}" /><Run Text=", " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="index" Foreground="{DynamicResource CosmoCodeVariableBrush}" /><Run Text=") " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=&gt;" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="            part.type " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="===" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;text&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="?" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" &lt;" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="p" Foreground="{DynamicResource CosmoCodeTagBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="key" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="{}{index}&gt;{part.text}&lt;/" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="p" Foreground="{DynamicResource CosmoCodeTagBrush}" /><Run Text="&gt; " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text=":" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="null" Foreground="{DynamicResource CosmoCodeConstantBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="          )}" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="        &lt;/" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="div" Foreground="{DynamicResource CosmoCodeTagBrush}" /><Run Text="&gt;" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="      ))}" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="      &lt;" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="form" Foreground="{DynamicResource CosmoCodeTagBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="        " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="onSubmit" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="{}{(" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="event" Foreground="{DynamicResource CosmoCodeVariableBrush}" /><Run Text=") " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=&gt;" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" {" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="          event." Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="preventDefault" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="()" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="          " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="sendMessage" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="({ text: input })" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="          " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="setInput" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="(" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /><Run Text=")" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="        }}" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="      &gt;" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="        &lt;" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="Input" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="value" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="{}{input} " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="onChange" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="{}{(" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="event" Foreground="{DynamicResource CosmoCodeVariableBrush}" /><Run Text=") " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=&gt;" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="setInput" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="(event.target.value)} /&gt;" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="        &lt;" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="Button" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="disabled" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="{}{status " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="!==" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;ready&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /><Run Text="}&gt;Send&lt;/" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="Button" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text="&gt;" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="      &lt;/" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="form" Foreground="{DynamicResource CosmoCodeTagBrush}" /><Run Text="&gt;" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="    &lt;/" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="div" Foreground="{DynamicResource CosmoCodeTagBrush}" /><Run Text="&gt;" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="  )" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="}" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
        </StackPanel>
      </c:CodeBlockContent>
      <c:CodeBlock.Footer><c:CollapsibleTrigger Classes="ghost xs" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="4"><Viewbox Width="16" Height="16" Classes="chevron"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[Button].Foreground}" Data="M6 9 l6 6 6-6" /></Viewbox><TextBlock c:Collapsible.Shows="Closed" Text="Show more" /><TextBlock c:Collapsible.Shows="Open" Text="Show less" /></StackPanel></c:CollapsibleTrigger></c:CodeBlock.Footer>
    </c:CodeBlock>
    </c:Collapsible>
  </Border>
</UserControl>
