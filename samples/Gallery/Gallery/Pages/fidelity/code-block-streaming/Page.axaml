<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" x:DataType="m:CodeBlockStreaming" a:Web.Live="True" a:Page.Title="Fidelity: code-block-streaming">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <StackPanel Width="448" HorizontalAlignment="Left" Spacing="16">
    <c:CodeBlock IsVisible="{Binding Blocks[0]}" Title="hooks/use-debounce.ts">
      <c:CodeBlock.Actions><StackPanel Orientation="Horizontal" Spacing="4"><c:CodeBlockCopyButton Value="export function useDebounce&lt;T&gt;(value: T, delay = 300) {&#10;  const [debounced, setDebounced] = React.useState(value)&#10;&#10;  React.useEffect(() =&gt; {&#10;    const timeout = setTimeout(() =&gt; setDebounced(value), delay)&#10;    return () =&gt; clearTimeout(timeout)&#10;  }, [value, delay])&#10;&#10;  return debounced&#10;}" IsEnabled="{Binding Copies[0]}" /></StackPanel></c:CodeBlock.Actions>
      <c:CodeBlockContent LineNumbers="True">
        <StackPanel>
          <c:CodeBlockLine IsVisible="{Binding Lines[0]}"><TextBlock><Run Text="{Binding Tokens[0]}" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="{Binding Tokens[1]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[2]}" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="{Binding Tokens[3]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[4]}" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="{Binding Tokens[5]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[6]}" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="{Binding Tokens[7]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[8]}" Foreground="{DynamicResource CosmoCodeVariableBrush}" /><Run Text="{Binding Tokens[9]}" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="{Binding Tokens[10]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[11]}" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="{Binding Tokens[12]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[13]}" Foreground="{DynamicResource CosmoCodeVariableBrush}" /><Run Text="{Binding Tokens[14]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[15]}" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="{Binding Tokens[16]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="{Binding Tokens[17]}" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text="{Binding Tokens[18]}" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
