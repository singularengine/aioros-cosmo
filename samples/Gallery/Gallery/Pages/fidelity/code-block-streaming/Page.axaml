    </c:CodeBlock>
    <c:CodeBlock IsVisible="{Binding Blocks[2]}" Title="components/search.tsx">
      <c:CodeBlock.Actions><StackPanel Orientation="Horizontal" Spacing="4"><c:CodeBlockCopyButton Value="export function Search() {&#10;  const [query, setQuery] = React.useState(&quot;&quot;)&#10;  const results = useSearch(query)&#10;  const debounced = useDebounce(query, 300)&#10;  const results = useSearch(debounced)&#10;&#10;  return &lt;SearchResults results={results} /&gt;&#10;}" IsEnabled="{Binding Copies[2]}" /></StackPanel></c:CodeBlock.Actions>
