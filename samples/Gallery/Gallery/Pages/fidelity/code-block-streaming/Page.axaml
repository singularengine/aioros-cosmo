    <c:CodeBlock IsVisible="{Binding Blocks[3]}" Title="app/api/chat/route.ts">
      <c:CodeBlock.Actions><StackPanel Orientation="Horizontal" Spacing="4"><c:CodeBlockCopyButton Value="import { streamText } from &quot;ai&quot;&#10;&#10;export async function POST(request: Request) {&#10;  const { messages } = await request.json()&#10;&#10;  const result = streamText({&#10;    model: &quot;anthropic/claude-sonnet-4.5&quot;,&#10;    messages,&#10;  })&#10;&#10;  return result.toUIMessageStreamResponse()&#10;}" IsEnabled="{Binding Copies[3]}" /></StackPanel></c:CodeBlock.Actions>
