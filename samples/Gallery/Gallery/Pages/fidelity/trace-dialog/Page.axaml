<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Page.Title="Fidelity: trace-dialog">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <c:Trace Width="384" HorizontalAlignment="Left">
      <Button Classes="trace" x:Name="webSearch"><c:TraceLine Content="Searched the web for cache keys"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20 M2 12h20" /></Viewbox></c:TraceLine.Icon><c:TraceLine.Trailing><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M9 18 l6-6-6-6" /></Viewbox></c:TraceLine.Trailing></c:TraceLine></Button><c:Dialog Trigger="{Binding #webSearch}" MaxWidth="512"><StackPanel Spacing="16">
          <c:DialogHeader Title="Searched the web for cache keys" Description="Three results were used in the response." /><c:Trace>
      <HyperlinkButton Classes="trace" NavigateUri="https://nextjs.org/docs/app/guides/caching" AutomationProperties.Name="Caching build outputs (opens in a new tab)"><c:TraceLine Content="Caching build outputs"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20 M2 12h20" /></Viewbox></c:TraceLine.Icon><c:TraceLine.Trailing><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M7 7h10v10 M7 17 17 7" /></Viewbox></c:TraceLine.Trailing></c:TraceLine></HyperlinkButton>
      <HyperlinkButton Classes="trace" NavigateUri="https://nextjs.org/docs/app/api-reference/components/image" AutomationProperties.Name="Image optimization reference (opens in a new tab)"><c:TraceLine Content="Image optimization reference"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20 M2 12h20" /></Viewbox></c:TraceLine.Icon><c:TraceLine.Trailing><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M7 7h10v10 M7 17 17 7" /></Viewbox></c:TraceLine.Trailing></c:TraceLine></HyperlinkButton>
      <HyperlinkButton Classes="trace" NavigateUri="https://vercel.com/docs/deploy-hooks" AutomationProperties.Name="Deploy hooks and cache keys (opens in a new tab)"><c:TraceLine Content="Deploy hooks and cache keys"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20 M2 12h20" /></Viewbox></c:TraceLine.Icon><c:TraceLine.Trailing><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M7 7h10v10 M7 17 17 7" /></Viewbox></c:TraceLine.Trailing></c:TraceLine></HyperlinkButton>
    </c:Trace></StackPanel></c:Dialog>
    </c:Trace>
  </Border>
</UserControl>
