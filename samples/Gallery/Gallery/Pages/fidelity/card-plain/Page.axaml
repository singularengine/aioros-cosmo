<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" a:Page.Title="Fidelity: card-plain">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <c:Card Width="384" HorizontalAlignment="Left">
      <c:CardHeader Title="Notifications" Description="You have 3 unread messages." />
      <c:CardContent>
        <TextBlock Text="Push notifications are sent to your phone." FontSize="14" LineHeight="20" TextWrapping="Wrap" />
      </c:CardContent>
    </c:Card>
  </Border>
</UserControl>
