<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Page.Title="Fidelity: attachment-trigger">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
          <StackPanel Width="384" HorizontalAlignment="Center" Margin="0,48" Spacing="0">
    <StackPanel>
            <c:Attachment Title="research-summary.pdf" Description="Open preview dialog" HorizontalAlignment="Stretch">
              <c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M14 2v4a2 2 0 0 0 2 2h4 M4.268 21a2 2 0 0 0 1.727 1H18a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v3 M9 18 l-1.5-1.5 M2,14 A3,3 0 1 1 8,14 A3,3 0 1 1 2,14 Z" /></Viewbox></c:Attachment.Media>
              <c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Copy link"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M10,8 L20,8 A2,2 0 0 1 22,10 L22,20 A2,2 0 0 1 20,22 L10,22 A2,2 0 0 1 8,20 L8,10 A2,2 0 0 1 10,8 Z M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></Viewbox></Button><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove research-summary.pdf"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions>
              <c:Attachment.Trigger><Button x:Name="previewTrigger" Theme="{DynamicResource CosmoAttachmentTrigger}" AutomationProperties.Name="Preview research-summary.pdf" /></c:Attachment.Trigger>
            </c:Attachment>
            <c:Dialog Trigger="{Binding #previewTrigger}" MaxWidth="448">
              <c:DialogHeader Title="research-summary.pdf" Description="The attachment trigger fills the card and opens the dialog, while the actions stay independently clickable above it." />
            </c:Dialog>
          </StackPanel>
          </StackPanel>
  </Border>
</UserControl>
