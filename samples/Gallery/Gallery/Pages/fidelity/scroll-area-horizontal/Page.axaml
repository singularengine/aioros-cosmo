<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Page.Title="Fidelity: scroll-area-horizontal">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <ScrollViewer Classes="scroll-area" Width="384" HorizontalAlignment="Left" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                  BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" CornerRadius="{DynamicResource CosmoRadiusMd}">
      <StackPanel Orientation="Horizontal" Spacing="16" Margin="16">
        <StackPanel>
          <Border CornerRadius="{DynamicResource CosmoRadiusMd}" ClipToBounds="True">
            <Image Source="/Assets/art-binni.png" Width="300" Height="400" Stretch="UniformToFill" AutomationProperties.Name="Photo by Ornella Binni" />
          </Border>
          <TextBlock FontSize="12" LineHeight="16" Margin="0,8,0,0" Foreground="{DynamicResource CosmoMutedForegroundBrush}">
            <Run Text="Photo by " /><Run Text="Ornella Binni" FontWeight="SemiBold" Foreground="{DynamicResource CosmoForegroundBrush}" />
          </TextBlock>
        </StackPanel>
        <StackPanel>
          <Border CornerRadius="{DynamicResource CosmoRadiusMd}" ClipToBounds="True">
            <Image Source="/Assets/art-byrom.png" Width="300" Height="400" Stretch="UniformToFill" AutomationProperties.Name="Photo by Tom Byrom" />
          </Border>
          <TextBlock FontSize="12" LineHeight="16" Margin="0,8,0,0" Foreground="{DynamicResource CosmoMutedForegroundBrush}">
            <Run Text="Photo by " /><Run Text="Tom Byrom" FontWeight="SemiBold" Foreground="{DynamicResource CosmoForegroundBrush}" />
          </TextBlock>
        </StackPanel>
        <StackPanel>
          <Border CornerRadius="{DynamicResource CosmoRadiusMd}" ClipToBounds="True">
            <Image Source="/Assets/art-malyavko.png" Width="300" Height="400" Stretch="UniformToFill" AutomationProperties.Name="Photo by Vladimir Malyavko" />
          </Border>
          <TextBlock FontSize="12" LineHeight="16" Margin="0,8,0,0" Foreground="{DynamicResource CosmoMutedForegroundBrush}">
            <Run Text="Photo by " /><Run Text="Vladimir Malyavko" FontWeight="SemiBold" Foreground="{DynamicResource CosmoForegroundBrush}" />
          </TextBlock>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
