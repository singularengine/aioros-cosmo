<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Page.Title="Fidelity: table-demo">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <StackPanel>
      <TableView>
        <TableView.Columns>
          <TableViewColumn Header="Invoice" Width="100" x:DataType="m:Invoice">
            <TableViewColumn.CellTemplate>
              <DataTemplate x:DataType="m:Invoice"><TextBlock Text="{Binding Number}" FontWeight="Medium" /></DataTemplate>
            </TableViewColumn.CellTemplate>
          </TableViewColumn>
          <TableViewColumn Header="Status" Binding="{Binding Status}" Width="128*" x:DataType="m:Invoice" />
          <TableViewColumn Header="Method" Binding="{Binding Method}" Width="202*" x:DataType="m:Invoice" />
          <TableViewColumn Header="Amount" Binding="{Binding Amount}" Width="162*" HorizontalContentAlignment="Right" x:DataType="m:Invoice" />
        </TableView.Columns>
        <TableView.Items>
          <m:Invoice Number="INV001" Status="Paid" Method="Credit Card" Amount="$250.00" />
          <m:Invoice Number="INV002" Status="Pending" Method="PayPal" Amount="$150.00" />
          <m:Invoice Number="INV003" Status="Unpaid" Method="Bank Transfer" Amount="$350.00" />
          <m:Invoice Number="INV004" Status="Paid" Method="Credit Card" Amount="$450.00" />
          <m:Invoice Number="INV005" Status="Paid" Method="PayPal" Amount="$550.00" />
          <m:Invoice Number="INV006" Status="Pending" Method="Bank Transfer" Amount="$200.00" />
          <m:Invoice Number="INV007" Status="Unpaid" Method="Credit Card" Amount="$300.00" />
        </TableView.Items>
      </TableView>
      <c:TableFooter>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="$2,500.00" />
          <TextBlock Text="Total" />
        </DockPanel>
      </c:TableFooter>
      <c:TableCaption Text="A list of your recent invoices." />
    </StackPanel>
  </Border>
</UserControl>
