<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Page.Title="Fidelity: kbd-demo">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <StackPanel Spacing="16">
      <c:KbdGroup>
        <c:Kbd Content="⌘" />
        <c:Kbd Content="⇧" />
        <c:Kbd Content="⌥" />
        <c:Kbd Content="⌃" />
      </c:KbdGroup>
      <c:KbdGroup>
        <c:Kbd Content="Ctrl" />
        <TextBlock Text="+" FontSize="16" LineHeight="24" />
        <c:Kbd Content="B" />
      </c:KbdGroup>
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Text="Use" FontSize="14" LineHeight="20" VerticalAlignment="Center" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
        <c:KbdGroup>
          <c:Kbd Content="Ctrl + B" />
          <c:Kbd Content="Ctrl + K" />
        </c:KbdGroup>
        <TextBlock Text="to open the command palette" FontSize="14" LineHeight="20" VerticalAlignment="Center" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <Button Classes="outline sm" Padding="12,0,8,0">
          <StackPanel><TextBlock Text="Accept" /><c:Kbd Content="⏎" /></StackPanel>
        </Button>
        <Button Classes="outline sm" Padding="12,0,8,0">
          <StackPanel><TextBlock Text="Cancel" /><c:Kbd Content="Esc" /></StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
