<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Page.Title="Fidelity: code-block-tabs">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <TabControl Width="448" HorizontalAlignment="Left" SelectedIndex="0"><TabItem Header="route.ts"><c:CodeBlock Title="app/api/chat/route.ts">
      <c:CodeBlock.Actions><StackPanel Orientation="Horizontal" Spacing="4"><c:CodeBlockCopyButton Value="import { streamText } from &quot;ai&quot;&#10;&#10;export async function POST(request: Request) {&#10;  const { messages } = await request.json()&#10;  const result = streamText({ model: &quot;anthropic/claude-sonnet-4.5&quot;, messages })&#10;&#10;  return result.toUIMessageStreamResponse()&#10;}" /></StackPanel></c:CodeBlock.Actions>
      <c:CodeBlockContent LineNumbers="True">
        <StackPanel>
          <c:CodeBlockLine><TextBlock><Run Text="import" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" { streamText } " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="from" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;ai&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="export" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="async" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="function" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="POST" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="(" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="request" Foreground="{DynamicResource CosmoCodeVariableBrush}" /><Run Text=":" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="Request" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text=") {" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="const" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" { " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="messages" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=" } " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="await" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" request." Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="json" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="()" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="const" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="result" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="streamText" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="({ model: " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;anthropic/claude-sonnet-4.5&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /><Run Text=", messages })" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="return" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" result." Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="toUIMessageStreamResponse" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="()" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="}" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
        </StackPanel>
      </c:CodeBlockContent>
    </c:CodeBlock></TabItem><TabItem Header="chat.tsx"><c:CodeBlock Title="components/chat.tsx">
      <c:CodeBlock.Actions><StackPanel Orientation="Horizontal" Spacing="4"><c:CodeBlockCopyButton Value="&quot;use client&quot;&#10;&#10;import { useChat } from &quot;@ai-sdk/react&quot;&#10;&#10;export function Chat() {&#10;  const { messages } = useChat()&#10;&#10;  return &lt;MessageList messages={messages} /&gt;&#10;}" /></StackPanel></c:CodeBlock.Actions>
      <c:CodeBlockContent LineNumbers="True">
        <StackPanel>
          <c:CodeBlockLine><TextBlock><Run Text="&quot;use client&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="import" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" { useChat } " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="from" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;@ai-sdk/react&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="export" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="function" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="Chat" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="() {" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="const" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" { " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="messages" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=" } " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="useChat" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="()" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="return" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" &lt;" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="MessageList" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="messages" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="{}{messages} /&gt;" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="}" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
        </StackPanel>
      </c:CodeBlockContent>
    </c:CodeBlock></TabItem><TabItem Header=".env.local"><c:CodeBlock Title=".env.local">
      <c:CodeBlock.Actions><StackPanel Orientation="Horizontal" Spacing="4"><c:CodeBlockCopyButton Value="AI_GATEWAY_API_KEY=your-api-key" /></StackPanel></c:CodeBlock.Actions>
      <c:CodeBlockContent LineNumbers="True">
        <StackPanel>
          <c:CodeBlockLine><TextBlock><Run Text="AI_GATEWAY_API_KEY" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text="your-api-key" Foreground="{DynamicResource CosmoCodeStringBrush}" /></TextBlock></c:CodeBlockLine>
        </StackPanel>
      </c:CodeBlockContent>
    </c:CodeBlock></TabItem></TabControl>
  </Border>
</UserControl>
