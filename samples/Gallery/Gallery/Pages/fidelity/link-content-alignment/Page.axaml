<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" a:Page.Title="Fidelity: link-content-alignment">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <StackPanel Spacing="12" Width="200" HorizontalAlignment="Left">
      <HyperlinkButton Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" NavigateUri="/a" Content="42" />
      <HyperlinkButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" NavigateUri="/b" Content="Cancel" />
      <HyperlinkButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" NavigateUri="/c" Content="Back" />
    </StackPanel>
  </Border>
</UserControl>
