<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" a:Page.Title="Fidelity: button-sizes">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <Button Classes="sm" Content="Small" />
      <Button Content="Default" />
      <Button Classes="lg" Content="Large" />
      <Button Classes="icon" AutomationProperties.Name="Next"><a:Icon Kind="chevron-right" /></Button>
      <Button Classes="outline sm" Content="Small" />
      <Button Classes="outline" Content="Default" />
      <Button Classes="outline lg" Content="Large" />
      <Button Classes="outline icon" AutomationProperties.Name="Next"><a:Icon Kind="chevron-right" /></Button>
    </WrapPanel>
  </Border>
</UserControl>
