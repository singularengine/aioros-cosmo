<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" xmlns:p="https://aioros.dev/pictor" x:DataType="m:ChartSamples" a:Page.Title="Fidelity: chart-radar-multiple">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <Border x:DataType="m:ChartSamples">
      <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Desktop" Label="Desktop" Color="PictorPalette1" /><c:ChartConfigItem Key="Mobile" Label="Mobile" Color="PictorPalette2" /></c:ChartConfig></Border.Resources>
      <c:Card>
        <c:CardHeader Title="Radar Chart - Multiple" Description="Showing total visitors for the last 6 months" Padding="24,0,24,16" />
        <c:CardContent>
          <p:RadarChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding MonthsByDevice}" Width="250" Height="250" HorizontalAlignment="Center">
            <p:Tooltip Cursor="False" LabelFormat="{}{0:MMMM}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent Indicator="Line" /></p:Tooltip.ContentTemplate></p:Tooltip>
            <p:PolarAngleAxis DataKey="Month" TickFormat="{}{0:MMMM}" />
            <p:PolarGrid />
            <p:Radar DataKey="Desktop" FillOpacity="0.6" IsAnimationActive="False" />
            <p:Radar DataKey="Mobile" IsAnimationActive="False" />
          </p:RadarChart>
        </c:CardContent>
        <c:CardFooter>
          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <TextBlock Text="Trending up by 5.2% this month" FontSize="14" LineHeight="14" FontWeight="Medium" VerticalAlignment="Center" />
              <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13" /></Viewbox>
            </StackPanel>
            <TextBlock Text="January - June 2024" FontSize="14" LineHeight="14" Foreground="{DynamicResource CosmoMutedForegroundBrush}" HorizontalAlignment="Center" />
          </StackPanel>
        </c:CardFooter>
      </c:Card>
    </Border>
  </Border>
</UserControl>
