<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Page.Title="Fidelity: attachment-demo">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
          <StackPanel Width="384" HorizontalAlignment="Center" Margin="0,48" Spacing="12">
    <c:AttachmentGroup><c:Attachment Title="workspace.png" Description="PNG · 820 KB" Classes="vertical image"><c:Attachment.Media><Image Source="/Assets/art-binni.png" Stretch="UniformToFill" /></c:Attachment.Media></c:Attachment><c:Attachment Title="desk-reference.jpg" Description="JPG · 1.1 MB" Classes="vertical image"><c:Attachment.Media><Image Source="/Assets/art-byrom.png" Stretch="UniformToFill" /></c:Attachment.Media></c:Attachment><c:Attachment Title="office-reference.jpg" Description="JPG · 940 KB" Classes="vertical image"><c:Attachment.Media><Image Source="/Assets/art-malyavko.png" Stretch="UniformToFill" /></c:Attachment.Media></c:Attachment></c:AttachmentGroup>
    <c:Attachment Title="sales-dashboard.pdf" Description="Uploading · 64%" State="Uploading" HorizontalAlignment="Stretch"><c:Attachment.Media><c:Spinner Width="16" Height="16" /></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Cancel upload"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment>
    <c:Attachment Title="message-renderer.tsx" Description="TypeScript · 12 KB" HorizontalAlignment="Stretch"><c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M10 12.5 8 15l2 2.5 M14 12.5 l2 2.5-2 2.5 M14 2v4a2 2 0 0 0 2 2h4 M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z" /></Viewbox></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove message-renderer.tsx"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment>
          </StackPanel>
  </Border>
</UserControl>
