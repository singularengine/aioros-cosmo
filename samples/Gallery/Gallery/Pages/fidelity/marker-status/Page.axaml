<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Page.Title="Fidelity: marker-status">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="32">
    <c:Marker Content="Compacting conversation"><c:Marker.Icon><c:Spinner Width="16" Height="16" /></c:Marker.Icon></c:Marker>
    <c:Marker Classes="separator" Content="Running tests"><c:Marker.Icon><c:Spinner Width="16" Height="16" /></c:Marker.Icon></c:Marker>
          </StackPanel>
  </Border>
</UserControl>
