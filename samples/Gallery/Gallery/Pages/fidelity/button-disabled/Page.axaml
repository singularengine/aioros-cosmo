<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" a:Page.Title="Fidelity: button-disabled">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <Button IsEnabled="False" Content="Button" />
      <Button IsEnabled="False" Classes="destructive" Content="Button" />
      <Button IsEnabled="False" Classes="outline" Content="Button" />
      <Button IsEnabled="False" Classes="secondary" Content="Button" />
      <Button IsEnabled="False" Classes="ghost" Content="Button" />
      <Button IsEnabled="False" Classes="link" Content="Button" />
    </WrapPanel>
  </Border>
</UserControl>
