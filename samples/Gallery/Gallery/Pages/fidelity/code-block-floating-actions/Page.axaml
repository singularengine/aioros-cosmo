<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Page.Title="Fidelity: code-block-floating-actions">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <c:CodeBlock Width="448" HorizontalAlignment="Left">
      <c:CodeBlock.Actions><StackPanel Orientation="Horizontal" Spacing="4"><c:CodeBlockCopyButton Value="$ pnpm add ai @ai-sdk/react zod&#10;Progress: resolved 412, reused 398, downloaded 14, added 14, done&#10;dependencies:&#10;+ @ai-sdk/react 3.0.12&#10;+ ai 6.0.12&#10;+ zod 4.1.12&#10;Done in 2.8s using pnpm v10.18.0" /></StackPanel></c:CodeBlock.Actions>
      <c:CodeBlockContent>
        <StackPanel>
          <c:CodeBlockLine><TextBlock Text="$ pnpm add ai @ai-sdk/react zod" /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text="Progress: resolved 412, reused 398, downloaded 14, added 14, done" /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text="dependencies:" /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text="+ @ai-sdk/react 3.0.12" /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text="+ ai 6.0.12" /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text="+ zod 4.1.12" /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text="Done in 2.8s using pnpm v10.18.0" /></c:CodeBlockLine>
        </StackPanel>
      </c:CodeBlockContent>
    </c:CodeBlock>
  </Border>
</UserControl>
