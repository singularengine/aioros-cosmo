<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" a:Page.Title="Fidelity: attachment-states">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
          <StackPanel Width="384" HorizontalAlignment="Center" Margin="0,48" Spacing="8">
    <c:Attachment Title="selected-file.pdf" Description="Ready to upload" State="Idle" HorizontalAlignment="Stretch"><c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12,6 L12,12 L16,14" /></Viewbox></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove selected-file.pdf"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment>
    <c:Attachment Title="design-system.zip" Description="Uploading · 64%" State="Uploading" HorizontalAlignment="Stretch"><c:Attachment.Media><c:Spinner Width="16" Height="16" /></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Cancel upload"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment>
    <c:Attachment Title="market-research.pdf" Description="Processing document" State="Processing" HorizontalAlignment="Stretch"><c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4 M10 9H8 M16 13H8 M16 17H8" /></Viewbox></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove market-research.pdf"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment>
    <c:Attachment Title="financial-model.xlsx" Description="Upload failed. Try again." State="Error" HorizontalAlignment="Stretch"><c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M12 9v4 M12 17h.01" /></Viewbox></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Retry upload"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16 M8 16H3v5" /></Viewbox></Button><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove financial-model.xlsx"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment>
    <c:Attachment Title="uploaded-report.pdf" Description="Uploaded · 1.8 MB" State="Done" HorizontalAlignment="Stretch"><c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M20 6 9 17l-5-5" /></Viewbox></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove uploaded-report.pdf"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment>
          </StackPanel>
  </Border>
</UserControl>
