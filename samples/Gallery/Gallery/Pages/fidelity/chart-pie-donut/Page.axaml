<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" xmlns:p="https://aioros.dev/pictor" x:DataType="m:ChartSamples" a:Page.Title="Fidelity: chart-pie-donut">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <Border x:DataType="m:ChartSamples">
      <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Visitors" Label="Visitors" /></c:ChartConfig></Border.Resources>
      <c:Card>
        <c:CardHeader Title="Pie Chart - Donut" Description="January - June 2024" />
        <c:CardContent>
          <p:PieChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Browsers}" Width="250" Height="250" HorizontalAlignment="Center">
            <p:Tooltip Cursor="False"><p:Tooltip.ContentTemplate><c:ChartTooltipContent HideLabel="True" /></p:Tooltip.ContentTemplate></p:Tooltip>
            <p:Pie Data="{Binding Browsers}" DataKey="Visitors" NameKey="Label" InnerRadius="60" IsAnimationActive="False"><p:Cell Fill="{DynamicResource PictorPalette1}" /><p:Cell Fill="{DynamicResource PictorPalette2}" /><p:Cell Fill="{DynamicResource PictorPalette3}" /><p:Cell Fill="{DynamicResource PictorPalette4}" /><p:Cell Fill="{DynamicResource PictorPalette5}" /></p:Pie>
          </p:PieChart>
        </c:CardContent>
        <c:CardFooter>
          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <TextBlock Text="Trending up by 5.2% this month" FontSize="14" LineHeight="14" FontWeight="Medium" VerticalAlignment="Center" />
              <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M22,7 L13.5,15.5 L8.5,10.5 L2,17 M16,7 L22,7 L22,13" /></Viewbox>
            </StackPanel>
            <TextBlock Text="Showing total visitors for the last 6 months" FontSize="14" LineHeight="14" Foreground="{DynamicResource CosmoMutedForegroundBrush}" HorizontalAlignment="Center" />
          </StackPanel>
        </c:CardFooter>
      </c:Card>
    </Border>
  </Border>
</UserControl>
