<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" xmlns:p="https://aioros.dev/pictor" x:DataType="m:ChartSamples" a:Page.Title="Fidelity: chart-plain-legend">
  <Border a:Web.Id="fixture" Width="640" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource CosmoBackgroundBrush}">
    <StackPanel Spacing="12">
      <p:PieChart Data="{Binding Browsers}" Width="300" Height="300">
        <p:Pie Data="{Binding Browsers}" DataKey="Visitors" NameKey="Label" IsAnimationActive="False" />
        <p:Legend />
      </p:PieChart>
      <p:PieChart Data="{Binding Browsers}" Width="300" Height="300">
        <p:Pie Data="{Binding Browsers}" DataKey="Visitors" NameKey="Label" IsAnimationActive="False" />
        <p:Legend Template="{x:Null}" ContentTemplate="{x:Null}" />
      </p:PieChart>
    </StackPanel>
  </Border>
</UserControl>
