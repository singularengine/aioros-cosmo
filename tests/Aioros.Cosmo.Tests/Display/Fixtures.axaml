            <c:CardContent Padding="16,0">
              <StackPanel Spacing="10">
                <c:SidebarInput PlaceholderText="Email" a:Web.InputType="email" AutomationProperties.Name="Email" />
                <Button Classes="sm sidebar-primary" Content="Subscribe" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              </StackPanel>
            </c:CardContent>
          </c:Card>
        </c:SidebarFooter>
        <c:SidebarRail />
      </c:Sidebar>
      <c:SidebarInset>
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="64" Padding="16,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CosmoBorderBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <c:SidebarTrigger Margin="-4,0,0,0" VerticalAlignment="Center" />
              <Separator Classes="vertical" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
              <c:Breadcrumb VerticalAlignment="Center">
                <HyperlinkButton Content="Build Your Application" NavigateUri="#" />
                <c:BreadcrumbPage Text="Data Fetching" />
              </c:Breadcrumb>
            </StackPanel>
          </Border>
          <DockPanel Margin="16">
            <UniformGrid DockPanel.Dock="Top" Columns="3" ColumnSpacing="16" Margin="0,0,0,16">
              <c:AspectRatio Ratio="1.7778"><Border CornerRadius="{DynamicResource CosmoRadiusXl}" Background="{DynamicResource CosmoMutedHalfBrush}" /></c:AspectRatio>
              <c:AspectRatio Ratio="1.7778"><Border CornerRadius="{DynamicResource CosmoRadiusXl}" Background="{DynamicResource CosmoMutedHalfBrush}" /></c:AspectRatio>
              <c:AspectRatio Ratio="1.7778"><Border CornerRadius="{DynamicResource CosmoRadiusXl}" Background="{DynamicResource CosmoMutedHalfBrush}" /></c:AspectRatio>
            </UniformGrid>
            <Border CornerRadius="{DynamicResource CosmoRadiusXl}" Background="{DynamicResource CosmoMutedHalfBrush}" />
          </DockPanel>
        </DockPanel>
      </c:SidebarInset>
    </c:SidebarProvider>
  </DataTemplate>
  <DataTemplate x:Key="sidebar-07">
    <c:SidebarProvider Width="1280" Height="800" MobileBreakpoint="0" x:DataType="m:ShellExample">
      <c:SidebarProvider.DataContext><m:ShellExample /></c:SidebarProvider.DataContext>
      <c:Sidebar Collapsible="Icon">
        <c:SidebarHeader>
          <c:SidebarMenu>
            <c:SidebarMenuItem>
              <c:SidebarMenuButton Classes="lg">
                <DockPanel>
                  <Viewbox Width="16" Height="16" DockPanel.Dock="Right" Margin="8,0,0,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M7 15 l5 5 5-5 M7 9 l5-5 5 5" /></Viewbox>
                  <Border Width="32" Height="32" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoSidebarPrimaryBrush}"><Panel><Viewbox Width="16" Height="16" IsVisible="{Binding ShowsGallery}"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarPrimaryForegroundBrush}" Data="M7 2h10 M5 6h14 M5,10 L19,10 A2,2 0 0 1 21,12 L21,20 A2,2 0 0 1 19,22 L5,22 A2,2 0 0 1 3,20 L3,12 A2,2 0 0 1 5,10 Z" /></Viewbox><Viewbox Width="16" Height="16" IsVisible="{Binding ShowsWaveform}"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarPrimaryForegroundBrush}" Data="M2 13a2 2 0 0 0 2-2V7a2 2 0 0 1 4 0v13a2 2 0 0 0 4 0V4a2 2 0 0 1 4 0v13a2 2 0 0 0 4 0v-4a2 2 0 0 1 2-2" /></Viewbox><Viewbox Width="16" Height="16" IsVisible="{Binding ShowsCommand}"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarPrimaryForegroundBrush}" Data="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3" /></Viewbox></Panel></Border>
                  <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActiveTeam.Name}" FontWeight="Medium" LineHeight="17.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ActiveTeam.Plan}" FontSize="12" LineHeight="15" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DockPanel>
                <c:SidebarMenuButton.Flyout>
                  <MenuFlyout Placement="RightEdgeAlignedTop">
                    <MenuItem Classes="label" Header="Teams" />
                    <MenuItem Header="Acme Inc" InputGesture="Ctrl+D1" Command="{Binding SelectTeam}" CommandParameter="Acme Inc" />
                    <MenuItem Header="Acme Corp." InputGesture="Ctrl+D2" Command="{Binding SelectTeam}" CommandParameter="Acme Corp." />
                    <MenuItem Header="Evil Corp." InputGesture="Ctrl+D3" Command="{Binding SelectTeam}" CommandParameter="Evil Corp." />
                    <Separator />
                    <MenuItem Header="Add team"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M5 12h14 M12 5v14" /></Viewbox></MenuItem.Icon></MenuItem>
                  </MenuFlyout>
                </c:SidebarMenuButton.Flyout>
              </c:SidebarMenuButton>
            </c:SidebarMenuItem>
          </c:SidebarMenu>
        </c:SidebarHeader>
        <c:SidebarContent>
          <c:SidebarGroup>
            <c:SidebarGroupLabel Content="Platform" />
            <c:SidebarMenu>
              <c:SidebarMenuItem IsCollapsible="True" IsExpanded="True">
                <c:SidebarMenuButton Tooltip="Playground"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M7 11 l2-2-2-2 M11 13h4 M5,3 L19,3 A2,2 0 0 1 21,5 L21,19 A2,2 0 0 1 19,21 L5,21 A2,2 0 0 1 3,19 L3,5 A2,2 0 0 1 5,3 Z" /></Viewbox><TextBlock Text="Playground" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                <c:SidebarMenuSub>
                  <c:SidebarMenuSubButton Content="History" />
                  <c:SidebarMenuSubButton Content="Starred" />
                  <c:SidebarMenuSubButton Content="Settings" />
                </c:SidebarMenuSub>
              </c:SidebarMenuItem>
              <c:SidebarMenuItem IsCollapsible="True">
                <c:SidebarMenuButton Tooltip="Models"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M12 8V4H8 M6,8 L18,8 A2,2 0 0 1 20,10 L20,18 A2,2 0 0 1 18,20 L6,20 A2,2 0 0 1 4,18 L4,10 A2,2 0 0 1 6,8 Z M2 14h2 M20 14h2 M15 13v2 M9 13v2" /></Viewbox><TextBlock Text="Models" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
