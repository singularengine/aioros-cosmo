  <DataTemplate x:Key="calendar-single">
    <Border HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" CornerRadius="{DynamicResource CosmoRadiusLg}" BoxShadow="{DynamicResource CosmoShadowSm}" Background="{DynamicResource CosmoBackgroundBrush}">
      <Calendar DisplayDate="2025-06-12" SelectionMode="SingleDate" SelectedDate="2025-06-12" />
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="calendar-range">
    <Border HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" CornerRadius="{DynamicResource CosmoRadiusLg}" BoxShadow="{DynamicResource CosmoShadowSm}" Background="{DynamicResource CosmoBackgroundBrush}">
      <Calendar DisplayDate="2025-06-12" SelectionMode="SingleRange" c:CalendarSelection.RangeStart="2025-06-09" c:CalendarSelection.RangeEnd="2025-06-26" />
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="calendar-multiple">
    <Border HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" CornerRadius="{DynamicResource CosmoRadiusLg}" BoxShadow="{DynamicResource CosmoShadowSm}" Background="{DynamicResource CosmoBackgroundBrush}">
      <Calendar DisplayDate="2025-06-12" SelectionMode="MultipleRange">
        <c:CalendarSelection.Dates><c:CalendarDates><sys:DateTime>2025-06-03</sys:DateTime><sys:DateTime>2025-06-12</sys:DateTime><sys:DateTime>2025-06-13</sys:DateTime><sys:DateTime>2025-06-24</sys:DateTime></c:CalendarDates></c:CalendarSelection.Dates>
      </Calendar>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="calendar-disabled">
    <Border HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" CornerRadius="{DynamicResource CosmoRadiusLg}" BoxShadow="{DynamicResource CosmoShadowSm}" Background="{DynamicResource CosmoBackgroundBrush}">
      <Calendar DisplayDate="2025-06-12" SelectionMode="SingleDate" SelectedDate="2025-06-12">
        <Calendar.BlackoutDates><CalendarDateRange><x:Arguments><sys:DateTime>2025-05-01</sys:DateTime><sys:DateTime>2025-06-11</sys:DateTime></x:Arguments></CalendarDateRange></Calendar.BlackoutDates>
      </Calendar>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="calendar-outside-hidden">
    <Border HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" CornerRadius="{DynamicResource CosmoRadiusLg}" BoxShadow="{DynamicResource CosmoShadowSm}" Background="{DynamicResource CosmoBackgroundBrush}">
      <Calendar DisplayDate="2025-06-12" SelectionMode="SingleDate" SelectedDate="2025-06-12" Classes="outside-hidden" />
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="calendar-dropdown">
    <Border HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" CornerRadius="{DynamicResource CosmoRadiusLg}" BoxShadow="{DynamicResource CosmoShadowSm}" Background="{DynamicResource CosmoBackgroundBrush}">
      <Calendar DisplayDate="2025-06-12" SelectionMode="SingleDate" SelectedDate="2025-06-12" Classes="dropdown" />
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="calendar-week-numbers">
    <Border HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" CornerRadius="{DynamicResource CosmoRadiusLg}" BoxShadow="{DynamicResource CosmoShadowSm}" Background="{DynamicResource CosmoBackgroundBrush}">
      <Calendar DisplayDate="2025-06-12" SelectionMode="SingleDate" SelectedDate="2025-06-12" Classes="week-numbers" />
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="date-picker-demo">
    <CalendarDatePicker Width="240" DisplayDate="2025-06-12" />
  </DataTemplate>
  <DataTemplate x:Key="date-picker-open">
    <Panel Height="372" VerticalAlignment="Top">
      <CalendarDatePicker Width="240" DisplayDate="2025-06-12" SelectedDate="2025-06-12" />
    </Panel>
  </DataTemplate>
  <DataTemplate x:Key="date-picker-input">
    <StackPanel Spacing="12">
      <Label Content="Subscription Date" Padding="4,0" Target="Picker" />
      <CalendarDatePicker Name="Picker" Classes="input" HorizontalAlignment="Stretch" DisplayDate="2025-06-01" SelectedDate="2025-06-01" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="date-picker-range-open">
    <Panel Height="372" VerticalAlignment="Top">
      <c:DateRangePicker Width="300" RangeStart="2022-01-20" RangeEnd="2022-02-09" />
    </Panel>
  </DataTemplate>
  <DataTemplate x:Key="date-picker-presets-open">
    <Panel Height="420" VerticalAlignment="Top">
      <CalendarDatePicker Width="240" DisplayDate="2025-06-12" SelectedDate="2025-06-12">
        <c:DatePresets.Items>
          <c:DatePresetList>
            <c:DatePreset Days="0">Today</c:DatePreset>
            <c:DatePreset Days="1">Tomorrow</c:DatePreset>
            <c:DatePreset Days="3">In 3 days</c:DatePreset>
            <c:DatePreset Days="7">In a week</c:DatePreset>
          </c:DatePresetList>
        </c:DatePresets.Items>
      </CalendarDatePicker>
    </Panel>
  </DataTemplate>
  <DataTemplate x:Key="button-extra-sizes">
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <Button Classes="xs" Content="Extra small" />
      <Button Classes="xs has-icon"><StackPanel><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPrimaryForegroundBrush}" Data="M9,18 L15,12 L9,6" /></Viewbox><TextBlock Text="Next" /></StackPanel></Button>
      <Button Classes="icon-xs" AutomationProperties.Name="Next"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPrimaryForegroundBrush}" Data="M9,18 L15,12 L9,6" /></Viewbox></Button>
      <Button Classes="icon-sm" AutomationProperties.Name="Next"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPrimaryForegroundBrush}" Data="M9,18 L15,12 L9,6" /></Viewbox></Button>
      <Button Classes="icon-lg" AutomationProperties.Name="Next"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPrimaryForegroundBrush}" Data="M9,18 L15,12 L9,6" /></Viewbox></Button>
      <Button Classes="outline xs" Content="Extra small" />
      <Button Classes="outline icon-xs" AutomationProperties.Name="Next"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M9,18 L15,12 L9,6" /></Viewbox></Button>
      <Button Classes="outline icon-sm" AutomationProperties.Name="Next"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M9,18 L15,12 L9,6" /></Viewbox></Button>
      <Button Classes="outline icon-lg" AutomationProperties.Name="Next"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M9,18 L15,12 L9,6" /></Viewbox></Button>
    </WrapPanel>
  </DataTemplate>
  <DataTemplate x:Key="field-content">
    <c:FieldGroup Width="448" HorizontalAlignment="Left">
      <c:Field Orientation="Horizontal">
        <c:FieldContent>
          <c:FieldLabel Content="Multi-factor authentication" Target="{Binding #mfa}" />
          <c:FieldDescription Text="Enable multi-factor authentication. If you do not have a two-factor device, you can use a one-time code sent to your email." />
        </c:FieldContent>
        <ToggleSwitch Name="mfa" a:Web.Id="mfa" />
      </c:Field>
      <c:Field Orientation="Horizontal">
        <c:FieldContent>
          <c:FieldTitle Text="Kubernetes" />
          <c:FieldDescription Text="Run GPU workloads on a K8s configured cluster." />
        </c:FieldContent>
        <CheckBox Name="k8s" a:Web.Id="k8s" />
      </c:Field>
    </c:FieldGroup>
  </DataTemplate>
  <DataTemplate x:Key="field-responsive">
    <StackPanel Spacing="24">
      <c:FieldGroup Width="560" HorizontalAlignment="Left">
        <c:Field Classes="responsive">
          <c:FieldContent>
            <c:FieldLabel Content="Name" Target="{Binding #wide}" />
            <c:FieldDescription Text="Provide your full name for identification." />
          </c:FieldContent>
          <TextBox Name="wide" a:Web.Id="wide" MinWidth="200" PlaceholderText="Evil Rabbit" />
        </c:Field>
      </c:FieldGroup>
      <c:FieldGroup Width="400" HorizontalAlignment="Left">
        <c:Field Classes="responsive">
          <c:FieldContent>
            <c:FieldLabel Content="Name" Target="{Binding #narrow}" />
            <c:FieldDescription Text="Provide your full name for identification." />
          </c:FieldContent>
          <TextBox Name="narrow" a:Web.Id="narrow" MinWidth="200" PlaceholderText="Evil Rabbit" />
        </c:Field>
      </c:FieldGroup>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="button-invalid">
    <StackPanel Spacing="16" HorizontalAlignment="Left">
      <Button Classes="outline" Content="Pick a date" HorizontalAlignment="Left">
        <DataValidationErrors.Error>
          <sys:Exception>
            <x:Arguments>
              <x:String>Pick a date.</x:String>
            </x:Arguments>
          </sys:Exception>
        </DataValidationErrors.Error>
      </Button>
      <c:Field Classes="invalid" HorizontalAlignment="Left">
        <Button Classes="outline" Content="Choose a plan" />
      </c:Field>
      <Button Content="Submit" HorizontalAlignment="Left">
        <DataValidationErrors.Error>
          <sys:Exception>
            <x:Arguments>
              <x:String>Fix the errors above.</x:String>
            </x:Arguments>
          </sys:Exception>
        </DataValidationErrors.Error>
      </Button>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="badge-links">
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <HyperlinkButton Theme="{DynamicResource CosmoBadgeLink}" NavigateUri="#" Content="Badge" />
      <HyperlinkButton Theme="{DynamicResource CosmoBadgeLink}" Classes="secondary" NavigateUri="#" Content="Badge" />
      <HyperlinkButton Theme="{DynamicResource CosmoBadgeLink}" Classes="destructive" NavigateUri="#" Content="Badge" />
      <HyperlinkButton Theme="{DynamicResource CosmoBadgeLink}" Classes="outline" NavigateUri="#" Content="Badge" />
      <HyperlinkButton Theme="{DynamicResource CosmoBadgeLink}" Classes="ghost" NavigateUri="#" Content="Badge" />
      <HyperlinkButton Theme="{DynamicResource CosmoBadgeLink}" Classes="link" NavigateUri="#" Content="Badge" />
    </WrapPanel>
  </DataTemplate>
  <DataTemplate x:Key="card-separated">
    <c:Card Width="384" HorizontalAlignment="Left">
      <c:CardHeader Classes="border" Title="Team members" Description="Invite your team to collaborate." />
      <c:CardContent>
        <TextBlock Text="Members can edit every project." FontSize="14" LineHeight="20" TextWrapping="Wrap" />
      </c:CardContent>
      <c:CardFooter Classes="border">
        <Button Content="Invite" HorizontalAlignment="Left" />
      </c:CardFooter>
    </c:Card>
  </DataTemplate>
  <DataTemplate x:Key="select-scrollable">
