  <DataTemplate x:Key="chart-tooltip-default">
    <Border x:DataType="m:ChartSamples">
      <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Running" Label="Running" Color="PictorPalette1" /><c:ChartConfigItem Key="Swimming" Label="Swimming" Color="PictorPalette2" /></c:ChartConfig></Border.Resources>
      <Border.DataContext><m:ChartSamples /></Border.DataContext>
      <c:Card>
        <c:CardHeader Title="Tooltip - Default" Description="Default tooltip with ChartTooltipContent." />
        <c:CardContent>
          <p:BarChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Activities}" Aspect="1.7777777777777777" ResponsiveWidths="542">
            <p:XAxis DataKey="Date" TickLine="False" TickMargin="10" AxisLine="False" TickFormat="{}{0:ddd}" />
            <p:Bar DataKey="Running" StackId="a" Radius="0, 0, 4, 4" IsAnimationActive="False" />
            <p:Bar DataKey="Swimming" StackId="a" Radius="4, 4, 0, 0" IsAnimationActive="False" />
            <p:Tooltip Cursor="False" DefaultIndex="1" LabelFormat="{}{0:yyyy-MM-dd}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent /></p:Tooltip.ContentTemplate></p:Tooltip>
          </p:BarChart>
        </c:CardContent>

      </c:Card>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="chart-tooltip-indicator-line">
    <Border x:DataType="m:ChartSamples">
      <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Running" Label="Running" Color="PictorPalette1" /><c:ChartConfigItem Key="Swimming" Label="Swimming" Color="PictorPalette2" /></c:ChartConfig></Border.Resources>
      <Border.DataContext><m:ChartSamples /></Border.DataContext>
      <c:Card>
        <c:CardHeader Title="Tooltip - Line Indicator" Description="Tooltip with line indicator." />
        <c:CardContent>
          <p:BarChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Activities}" Aspect="1.7777777777777777" ResponsiveWidths="542">
            <p:XAxis DataKey="Date" TickLine="False" TickMargin="10" AxisLine="False" TickFormat="{}{0:ddd}" />
            <p:Bar DataKey="Running" StackId="a" Radius="0, 0, 4, 4" IsAnimationActive="False" />
            <p:Bar DataKey="Swimming" StackId="a" Radius="4, 4, 0, 0" IsAnimationActive="False" />
            <p:Tooltip Cursor="False" DefaultIndex="1" LabelFormat="{}{0:yyyy-MM-dd}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent Indicator="Line" /></p:Tooltip.ContentTemplate></p:Tooltip>
          </p:BarChart>
        </c:CardContent>

      </c:Card>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="chart-tooltip-indicator-none">
    <Border x:DataType="m:ChartSamples">
      <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Running" Label="Running" Color="PictorPalette1" /><c:ChartConfigItem Key="Swimming" Label="Swimming" Color="PictorPalette2" /></c:ChartConfig></Border.Resources>
      <Border.DataContext><m:ChartSamples /></Border.DataContext>
      <c:Card>
        <c:CardHeader Title="Tooltip - No Indicator" Description="Tooltip with no indicator." />
        <c:CardContent>
          <p:BarChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Activities}" Aspect="1.7777777777777777" ResponsiveWidths="542">
            <p:XAxis DataKey="Date" TickLine="False" TickMargin="10" AxisLine="False" TickFormat="{}{0:ddd}" />
            <p:Bar DataKey="Running" StackId="a" Radius="0, 0, 4, 4" IsAnimationActive="False" />
            <p:Bar DataKey="Swimming" StackId="a" Radius="4, 4, 0, 0" IsAnimationActive="False" />
            <p:Tooltip Cursor="False" DefaultIndex="1" LabelFormat="{}{0:yyyy-MM-dd}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent HideIndicator="True" /></p:Tooltip.ContentTemplate></p:Tooltip>
          </p:BarChart>
        </c:CardContent>

      </c:Card>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="chart-area-interactive">
    <Border x:DataType="m:ChartInteractive">
      <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Visitors" Label="Visitors" /><c:ChartConfigItem Key="Desktop" Label="Desktop" Color="PictorPalette1" /><c:ChartConfigItem Key="Mobile" Label="Mobile" Color="PictorPalette2" /></c:ChartConfig></Border.Resources>
      <Border.DataContext><m:ChartInteractive /></Border.DataContext>
      <c:Card Padding="0,0,0,24">
        <Border BorderBrush="{DynamicResource CosmoBorderBrush}" BorderThickness="0,0,0,1">
          <c:CardHeader Padding="24,20" Title="Area Chart - Interactive" Description="Showing total visitors for the last 3 months">
            <c:CardHeader.Action>
              <ComboBox Width="160" SelectedIndex="{Binding TimeRange}"><ComboBoxItem Content="Last 3 months" /><ComboBoxItem Content="Last 30 days" /><ComboBoxItem Content="Last 7 days" /></ComboBox>
            </c:CardHeader.Action>
          </c:CardHeader>
        </Border>
        <c:CardContent Padding="24,24,24,0">
          <p:AreaChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Range}" Height="250" ResponsiveWidths="240 360 542 720">
            <p:CartesianGrid Vertical="False" />
            <p:XAxis DataKey="Date" TickLine="False" AxisLine="False" TickMargin="8" MinTickGap="32" TickFormat="{}{0:MMM d}" />
            <p:Tooltip Cursor="False" LabelFormat="{}{0:MMM d}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent Indicator="Dot" /></p:Tooltip.ContentTemplate></p:Tooltip>
            <p:Area DataKey="Mobile" Type="Natural" StackId="a" IsAnimationActive="False">
              <p:Area.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Offset="0.05" Color="{DynamicResource CosmoChart2TopColor}" />
                  <GradientStop Offset="0.95" Color="{DynamicResource CosmoChart2BottomColor}" />
                </LinearGradientBrush>
              </p:Area.Fill>
            </p:Area>
            <p:Area DataKey="Desktop" Type="Natural" StackId="a" IsAnimationActive="False">
              <p:Area.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Offset="0.05" Color="{DynamicResource CosmoChart1TopColor}" />
                  <GradientStop Offset="0.95" Color="{DynamicResource CosmoChart1BottomColor}" />
                </LinearGradientBrush>
              </p:Area.Fill>
            </p:Area>
            <p:Legend><p:Legend.Template><c:ChartLegendContent /></p:Legend.Template><p:Legend.ContentTemplate><c:ChartLegendItem /></p:Legend.ContentTemplate></p:Legend>
          </p:AreaChart>
        </c:CardContent>
      </c:Card>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="chart-bar-interactive">
    <Border x:DataType="m:ChartInteractive">
      <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Desktop" Label="Desktop" Color="PictorPalette2" /><c:ChartConfigItem Key="Mobile" Label="Mobile" Color="PictorPalette1" /></c:ChartConfig></Border.Resources>
      <Border.DataContext><m:ChartInteractive /></Border.DataContext>
      <c:Card Padding="0">
        <Border BorderBrush="{DynamicResource CosmoBorderBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <c:CardHeader Title="Bar Chart - Interactive" Description="Showing total visitors for the last 3 months" VerticalAlignment="Center" />
            <ListBox Grid.Column="1" Classes="chart-toggles" SelectedIndex="{Binding ActiveChart}">
              <ListBoxItem>
                <StackPanel Spacing="4">
                  <TextBlock Text="Desktop" FontSize="12" LineHeight="16" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                  <TextBlock Text="{Binding DesktopTotal}" FontSize="30" LineHeight="30" FontWeight="Bold" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem>
                <StackPanel Spacing="4">
                  <TextBlock Text="Mobile" FontSize="12" LineHeight="16" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                  <TextBlock Text="{Binding MobileTotal}" FontSize="30" LineHeight="30" FontWeight="Bold" />
                </StackPanel>
              </ListBoxItem>
            </ListBox>
          </Grid>
        </Border>
        <c:CardContent Padding="24">
          <Panel>
          <p:BarChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Daily}" Height="250" ResponsiveWidths="360 542 720" Padding="12,0,12,0" IsVisible="{Binding DesktopShown}">
            <p:CartesianGrid Vertical="False" />
            <p:XAxis DataKey="Date" TickLine="False" AxisLine="False" TickMargin="8" MinTickGap="32" TickFormat="{}{0:MMM d}" />
            <p:Tooltip Cursor="False" LabelFormat="{}{0:MMM d, yyyy}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent /></p:Tooltip.ContentTemplate></p:Tooltip>
            <p:Bar DataKey="Desktop" Name="Page Views" IsAnimationActive="False" />
          </p:BarChart>
          <p:BarChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Daily}" Height="250" ResponsiveWidths="360 542 720" Padding="12,0,12,0" IsVisible="{Binding MobileShown}">
            <p:CartesianGrid Vertical="False" />
            <p:XAxis DataKey="Date" TickLine="False" AxisLine="False" TickMargin="8" MinTickGap="32" TickFormat="{}{0:MMM d}" />
            <p:Tooltip Cursor="False" LabelFormat="{}{0:MMM d, yyyy}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent /></p:Tooltip.ContentTemplate></p:Tooltip>
            <p:Bar DataKey="Mobile" Name="Page Views" IsAnimationActive="False" />
          </p:BarChart>
          </Panel>
        </c:CardContent>
      </c:Card>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="chart-line-interactive">
    <Border x:DataType="m:ChartInteractive">
      <Border.Resources><c:ChartConfig x:Key="ChartConfig"><c:ChartConfigItem Key="Desktop" Label="Desktop" Color="PictorPalette1" /><c:ChartConfigItem Key="Mobile" Label="Mobile" Color="PictorPalette2" /></c:ChartConfig></Border.Resources>
      <Border.DataContext><m:ChartInteractive /></Border.DataContext>
      <c:Card Padding="0">
        <Border BorderBrush="{DynamicResource CosmoBorderBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <c:CardHeader Title="Line Chart - Interactive" Description="Showing total visitors for the last 3 months" VerticalAlignment="Center" />
            <ListBox Grid.Column="1" Classes="chart-toggles" SelectedIndex="{Binding ActiveChart}">
              <ListBoxItem>
                <StackPanel Spacing="4">
                  <TextBlock Text="Desktop" FontSize="12" LineHeight="16" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                  <TextBlock Text="{Binding DesktopTotal}" FontSize="30" LineHeight="30" FontWeight="Bold" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem>
                <StackPanel Spacing="4">
                  <TextBlock Text="Mobile" FontSize="12" LineHeight="16" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                  <TextBlock Text="{Binding MobileTotal}" FontSize="30" LineHeight="30" FontWeight="Bold" />
                </StackPanel>
              </ListBoxItem>
            </ListBox>
          </Grid>
        </Border>
        <c:CardContent Padding="24">
          <Panel>
          <p:LineChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Daily}" Height="250" ResponsiveWidths="360 542 720" Padding="12,0,12,0" IsVisible="{Binding DesktopShown}">
            <p:CartesianGrid Vertical="False" />
            <p:XAxis DataKey="Date" TickLine="False" AxisLine="False" TickMargin="8" MinTickGap="32" TickFormat="{}{0:MMM d}" />
            <p:Tooltip Cursor="False" LabelFormat="{}{0:MMM d, yyyy}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent /></p:Tooltip.ContentTemplate></p:Tooltip>
            <p:Line DataKey="Desktop" Name="Page Views" Type="Monotone" StrokeWidth="2" Dot="False" IsAnimationActive="False" />
          </p:LineChart>
          <p:LineChart c:ChartConfig.Config="{StaticResource ChartConfig}" Data="{Binding Daily}" Height="250" ResponsiveWidths="360 542 720" Padding="12,0,12,0" IsVisible="{Binding MobileShown}">
            <p:CartesianGrid Vertical="False" />
            <p:XAxis DataKey="Date" TickLine="False" AxisLine="False" TickMargin="8" MinTickGap="32" TickFormat="{}{0:MMM d}" />
            <p:Tooltip Cursor="False" LabelFormat="{}{0:MMM d, yyyy}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent /></p:Tooltip.ContentTemplate></p:Tooltip>
            <p:Line DataKey="Mobile" Name="Page Views" Type="Monotone" StrokeWidth="2" Dot="False" IsAnimationActive="False" />
          </p:LineChart>
          </Panel>
        </c:CardContent>
      </c:Card>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="login-01">
    <Border Classes="page" Padding="40">
      <StackPanel MaxWidth="384">
        <c:Card>
          <c:CardHeader Title="Login to your account" Description="Enter your email below to login to your account" />
          <c:CardContent>
            <c:FieldGroup>
              <c:Field>
                <c:FieldLabel Content="Email" Target="{Binding #email}" />
                <TextBox Name="email" a:Web.Id="email" a:Web.InputType="email" PlaceholderText="m@example.com" />
              </c:Field>
              <c:Field>
                <Grid ColumnDefinitions="Auto,*">
                  <c:FieldLabel Content="Password" Target="{Binding #password}" VerticalAlignment="Center" />
                  <HyperlinkButton Classes="link" NavigateUri="#" Padding="0" Height="NaN" MinHeight="0" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource CosmoForegroundBrush}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Forgot your password?" TextWrapping="Wrap" /></HyperlinkButton>
                </Grid>
                <TextBox Name="password" a:Web.Id="password" PasswordChar="•" />
              </c:Field>
              <c:Field>
                <Button Content="Login" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <Button Classes="outline" Content="Login with Google" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <c:FieldDescription TextAlignment="Center"><Run Text="Don't have an account? " /><Run Text="Sign up" a:Web.Href="#" TextDecorations="Underline" /></c:FieldDescription>
              </c:Field>
            </c:FieldGroup>
          </c:CardContent>
        </c:Card>
      </StackPanel>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="login-02">
    <Border Classes="page" Padding="40">
      <StackPanel Spacing="16">
        <Border a:Web.Href="#" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><Border Width="24" Height="24" CornerRadius="{DynamicResource CosmoRadiusMd}" Background="{DynamicResource CosmoPrimaryBrush}"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPrimaryForegroundBrush}" Data="M7 2h10 M5 6h14 M5,10 L19,10 A2,2 0 0 1 21,12 L21,20 A2,2 0 0 1 19,22 L5,22 A2,2 0 0 1 3,20 L3,12 A2,2 0 0 1 5,10 Z" /></Viewbox></Border><TextBlock Text="Acme Inc." FontSize="16" LineHeight="24" FontWeight="Medium" VerticalAlignment="Center" /></StackPanel></Border>
        <StackPanel MaxWidth="320">
          <c:FieldGroup>
            <StackPanel Spacing="4" HorizontalAlignment="Stretch">
              <TextBlock Text="Login to your account" FontSize="24" LineHeight="32" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Text="Enter your email below to login to your account" FontSize="14" LineHeight="20" Foreground="{DynamicResource CosmoMutedForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <c:Field>
              <c:FieldLabel Content="Email" Target="{Binding #email}" />
              <TextBox Name="email" a:Web.Id="email" a:Web.InputType="email" PlaceholderText="m@example.com" />
            </c:Field>
            <c:Field>
              <Grid ColumnDefinitions="Auto,*">
                <c:FieldLabel Content="Password" Target="{Binding #password}" VerticalAlignment="Center" />
                <HyperlinkButton Classes="link" NavigateUri="#" Padding="0" Height="NaN" MinHeight="0" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource CosmoForegroundBrush}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Forgot your password?" TextWrapping="Wrap" /></HyperlinkButton>
              </Grid>
              <TextBox Name="password" a:Web.Id="password" PasswordChar="•" />
            </c:Field>
            <c:Field>
              <Button Content="Login" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </c:Field>
            <c:FieldSeparator Content="Or continue with" />
            <c:Field>
              <Button Classes="outline has-icon" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"><StackPanel><Viewbox Width="16" Height="16"><Path Width="24" Height="24" Stretch="None" Fill="{DynamicResource CosmoForegroundBrush}" Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></Viewbox><TextBlock Text="Login with GitHub" /></StackPanel></Button>
              <c:FieldDescription TextAlignment="Center"><Run Text="Don't have an account? " /><Run Text="Sign up" a:Web.Href="#" TextDecorations="Underline" /></c:FieldDescription>
            </c:Field>
          </c:FieldGroup>
        </StackPanel>
      </StackPanel>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="login-03">
    <Border Classes="page" Padding="40" Background="{DynamicResource CosmoMutedBrush}">
      <StackPanel MaxWidth="384" Spacing="24">
        <Border a:Web.Href="#" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><Border Width="24" Height="24" CornerRadius="{DynamicResource CosmoRadiusMd}" Background="{DynamicResource CosmoPrimaryBrush}"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPrimaryForegroundBrush}" Data="M7 2h10 M5 6h14 M5,10 L19,10 A2,2 0 0 1 21,12 L21,20 A2,2 0 0 1 19,22 L5,22 A2,2 0 0 1 3,20 L3,12 A2,2 0 0 1 5,10 Z" /></Viewbox></Border><TextBlock Text="Acme Inc." FontSize="16" LineHeight="24" FontWeight="Medium" VerticalAlignment="Center" /></StackPanel></Border>
        <c:Card>
          <c:CardHeader><c:CardHeader.Title><TextBlock Text="Welcome back" FontSize="20" LineHeight="28" TextAlignment="Center" /></c:CardHeader.Title><c:CardHeader.Description><TextBlock Text="Login with your Apple or Google account" TextAlignment="Center" /></c:CardHeader.Description></c:CardHeader>
          <c:CardContent>
            <c:FieldGroup>
              <c:Field>
                <Button Classes="outline has-icon" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"><StackPanel><Viewbox Width="16" Height="16"><Path Width="24" Height="24" Stretch="None" Fill="{DynamicResource CosmoForegroundBrush}" Data="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" /></Viewbox><TextBlock Text="Login with Apple" /></StackPanel></Button>
                <Button Classes="outline has-icon" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"><StackPanel><Viewbox Width="16" Height="16"><Path Width="24" Height="24" Stretch="None" Fill="{DynamicResource CosmoForegroundBrush}" Data="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z" /></Viewbox><TextBlock Text="Login with Google" /></StackPanel></Button>
              </c:Field>
              <c:FieldSeparator Classes="card" Content="Or continue with" />
              <c:Field>
                <c:FieldLabel Content="Email" Target="{Binding #email}" />
                <TextBox Name="email" a:Web.Id="email" a:Web.InputType="email" PlaceholderText="m@example.com" />
              </c:Field>
              <c:Field>
                <Grid ColumnDefinitions="Auto,*">
                  <c:FieldLabel Content="Password" Target="{Binding #password}" VerticalAlignment="Center" />
                  <HyperlinkButton Classes="link" NavigateUri="#" Padding="0" Height="NaN" MinHeight="0" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource CosmoForegroundBrush}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Forgot your password?" TextWrapping="Wrap" /></HyperlinkButton>
                </Grid>
                <TextBox Name="password" a:Web.Id="password" PasswordChar="•" />
              </c:Field>
              <c:Field>
                <Button Content="Login" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <c:FieldDescription TextAlignment="Center"><Run Text="Don't have an account? " /><Run Text="Sign up" a:Web.Href="#" TextDecorations="Underline" /></c:FieldDescription>
              </c:Field>
            </c:FieldGroup>
          </c:CardContent>
        </c:Card>
        <c:FieldDescription TextAlignment="Center" Margin="24,0"><Run Text="By clicking continue, you agree to our " /><Run Text="Terms of Service" a:Web.Href="#" TextDecorations="Underline" /><Run Text=" and " /><Run Text="Privacy Policy" a:Web.Href="#" TextDecorations="Underline" /><Run Text="." /></c:FieldDescription>
      </StackPanel>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="login-04">
    <Border Classes="page" Padding="40" Background="{DynamicResource CosmoMutedBrush}">
      <StackPanel Classes="split" MaxWidth="896" Spacing="24">
        <c:Card Padding="0" ClipToBounds="True">
          <c:CardContent Padding="0">
            <Grid ColumnDefinitions="*,*">
              <c:FieldGroup Classes="split" Margin="32">
                <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                  <TextBlock Text="Welcome back" FontSize="24" LineHeight="32" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                  <TextBlock Text="Login to your Acme Inc account" FontSize="16" LineHeight="24" Foreground="{DynamicResource CosmoMutedForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <c:Field>
                  <c:FieldLabel Content="Email" Target="{Binding #email}" />
                  <TextBox Name="email" a:Web.Id="email" a:Web.InputType="email" PlaceholderText="m@example.com" />
                </c:Field>
                <c:Field>
                  <Grid ColumnDefinitions="Auto,*">
                    <c:FieldLabel Content="Password" Target="{Binding #password}" VerticalAlignment="Center" />
                    <HyperlinkButton Classes="link" NavigateUri="#" Padding="0" Height="NaN" MinHeight="0" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource CosmoForegroundBrush}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Forgot your password?" TextWrapping="Wrap" /></HyperlinkButton>
                  </Grid>
                  <TextBox Name="password" a:Web.Id="password" PasswordChar="•" />
                </c:Field>
                <c:Field>
                  <Button Content="Login" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </c:Field>
                <c:FieldSeparator Classes="card" Content="Or continue with" />
