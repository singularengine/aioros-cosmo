              <StackPanel Spacing="16" Margin="16,0,16,16">
            <c:AspectRatio Ratio="1.7778" MaxWidth="768" HorizontalAlignment="Left"><Border CornerRadius="{DynamicResource CosmoRadiusXl}" Background="{DynamicResource CosmoMutedHalfBrush}" /></c:AspectRatio>
            <c:AspectRatio Ratio="1.7778" MaxWidth="768" HorizontalAlignment="Left"><Border CornerRadius="{DynamicResource CosmoRadiusXl}" Background="{DynamicResource CosmoMutedHalfBrush}" /></c:AspectRatio>
