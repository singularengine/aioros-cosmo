<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo" xmlns:m="using:Gallery.Models" xmlns:sys="using:System" xmlns:p="https://aioros.dev/pictor">
  <DataTemplate x:Key="separator-demo">
    <StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Text="Radix Primitives" FontSize="14" LineHeight="14" FontWeight="Medium" />
        <TextBlock Text="An open-source UI component library." FontSize="14" LineHeight="20" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
      </StackPanel>
      <Separator Margin="0,16" />
      <StackPanel Orientation="Horizontal" Height="20" Spacing="16">
        <TextBlock Text="Blog" FontSize="14" LineHeight="20" VerticalAlignment="Center" />
        <Separator Classes="vertical" />
        <TextBlock Text="Docs" FontSize="14" LineHeight="20" VerticalAlignment="Center" />
        <Separator Classes="vertical" />
        <TextBlock Text="Source" FontSize="14" LineHeight="20" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="skeleton-demo">
    <StackPanel Spacing="32">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <c:Skeleton Width="48" Height="48" CornerRadius="9999" VerticalAlignment="Center" />
        <StackPanel Spacing="8" VerticalAlignment="Center">
          <c:Skeleton Width="250" Height="16" />
          <c:Skeleton Width="200" Height="16" />
        </StackPanel>
      </StackPanel>
      <StackPanel Spacing="12">
        <c:Skeleton Width="250" Height="125" CornerRadius="{DynamicResource CosmoRadiusXl}" />
        <StackPanel Spacing="8">
          <c:Skeleton Width="250" Height="16" />
          <c:Skeleton Width="200" Height="16" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="spinner-demo">
    <StackPanel Spacing="24">
      <StackPanel Orientation="Horizontal" Spacing="24">
        <c:Spinner Width="12" Height="12" VerticalAlignment="Center" />
        <c:Spinner VerticalAlignment="Center" />
        <c:Spinner Width="24" Height="24" VerticalAlignment="Center" />
        <c:Spinner Width="32" Height="32" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <Button Classes="sm has-icon" IsEnabled="False">
          <StackPanel><c:Spinner /><TextBlock Text="Loading..." /></StackPanel>
        </Button>
        <Button Classes="outline sm has-icon" IsEnabled="False">
          <StackPanel><c:Spinner /><TextBlock Text="Please wait" /></StackPanel>
        </Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <c:Badge><StackPanel><c:Spinner /><TextBlock Text="Syncing" /></StackPanel></c:Badge>
        <c:Badge Classes="secondary"><StackPanel><c:Spinner /><TextBlock Text="Updating" /></StackPanel></c:Badge>
        <c:Badge Classes="outline"><StackPanel><c:Spinner /><TextBlock Text="Processing" /></StackPanel></c:Badge>
      </StackPanel>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="kbd-demo">
    <StackPanel Spacing="16">
      <c:KbdGroup>
        <c:Kbd Content="⌘" />
        <c:Kbd Content="⇧" />
        <c:Kbd Content="⌥" />
        <c:Kbd Content="⌃" />
      </c:KbdGroup>
      <c:KbdGroup>
        <c:Kbd Content="Ctrl" />
        <TextBlock Text="+" FontSize="16" LineHeight="24" />
        <c:Kbd Content="B" />
      </c:KbdGroup>
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Text="Use" FontSize="14" LineHeight="20" VerticalAlignment="Center" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
        <c:KbdGroup>
          <c:Kbd Content="Ctrl + B" />
          <c:Kbd Content="Ctrl + K" />
        </c:KbdGroup>
        <TextBlock Text="to open the command palette" FontSize="14" LineHeight="20" VerticalAlignment="Center" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <Button Classes="outline sm" Padding="12,0,8,0">
          <StackPanel><TextBlock Text="Accept" /><c:Kbd Content="⏎" /></StackPanel>
        </Button>
        <Button Classes="outline sm" Padding="12,0,8,0">
          <StackPanel><TextBlock Text="Cancel" /><c:Kbd Content="Esc" /></StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="avatar-demo">
    <StackPanel Spacing="32">
      <StackPanel Orientation="Horizontal" Spacing="48">
        <c:Avatar Source="/Assets/avatar-shadcn.png" Content="CN" AutomationProperties.Name="@shadcn" />
        <c:Avatar Source="/Assets/avatar-evilrabbit.png" Content="ER" CornerRadius="{DynamicResource CosmoRadiusLg}" AutomationProperties.Name="@evilrabbit" />
        <c:AvatarGroup>
          <c:Avatar Source="/Assets/avatar-shadcn.png" Content="CN" AutomationProperties.Name="@shadcn" />
          <c:Avatar Source="/Assets/avatar-maxleiter.png" Content="LR" AutomationProperties.Name="@maxleiter" />
          <c:Avatar Source="/Assets/avatar-evilrabbit.png" Content="ER" AutomationProperties.Name="@evilrabbit" />
        </c:AvatarGroup>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="48">
        <c:Avatar Classes="sm" Content="CN" />
        <c:Avatar Content="CN" />
        <c:Avatar Classes="lg" Content="CN" />
      </StackPanel>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="avatar-badge">
    <StackPanel Orientation="Horizontal" Spacing="48">
      <c:Avatar Classes="sm" Source="/Assets/avatar-shadcn.png" Content="CN" AutomationProperties.Name="@shadcn">
        <c:Avatar.Badge><c:AvatarBadge /></c:Avatar.Badge>
      </c:Avatar>
      <c:Avatar Source="/Assets/avatar-shadcn.png" Content="CN" AutomationProperties.Name="@shadcn">
        <c:Avatar.Badge><c:AvatarBadge /></c:Avatar.Badge>
      </c:Avatar>
      <c:Avatar Classes="lg" Source="/Assets/avatar-shadcn.png" Content="CN" AutomationProperties.Name="@shadcn">
        <c:Avatar.Badge><c:AvatarBadge /></c:Avatar.Badge>
      </c:Avatar>
      <c:Avatar Content="ER">
        <c:Avatar.Badge><c:AvatarBadge><Viewbox Width="8" Height="8"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPrimaryForegroundBrush}" Data="M5,12 L19,12 M12,5 L12,19" /></Viewbox></c:AvatarBadge></c:Avatar.Badge>
      </c:Avatar>
      <c:Avatar Classes="lg" Content="ER">
        <c:Avatar.Badge><c:AvatarBadge><Viewbox Width="8" Height="8"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPrimaryForegroundBrush}" Data="M5,12 L19,12 M12,5 L12,19" /></Viewbox></c:AvatarBadge></c:Avatar.Badge>
      </c:Avatar>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="avatar-group-count">
    <StackPanel Spacing="32">
      <c:AvatarGroup>
        <c:Avatar Source="/Assets/avatar-shadcn.png" Content="CN" AutomationProperties.Name="@shadcn" />
        <c:Avatar Source="/Assets/avatar-maxleiter.png" Content="LR" AutomationProperties.Name="@maxleiter" />
        <c:Avatar Source="/Assets/avatar-evilrabbit.png" Content="ER" AutomationProperties.Name="@evilrabbit" />
        <c:AvatarGroupCount Content="+3" />
      </c:AvatarGroup>
      <c:AvatarGroup>
        <c:Avatar Classes="sm" Content="CN" />
        <c:Avatar Classes="sm" Content="LR" />
        <c:AvatarGroupCount Content="+2" />
      </c:AvatarGroup>
      <c:AvatarGroup>
        <c:Avatar Classes="lg" Content="CN" />
        <c:Avatar Classes="lg" Content="LR" />
        <c:AvatarGroupCount><Viewbox Width="20" Height="20"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M5,12 L19,12 M12,5 L12,19" /></Viewbox></c:AvatarGroupCount>
      </c:AvatarGroup>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="alert-demo">
    <StackPanel Spacing="16" Width="576" HorizontalAlignment="Left">
      <c:Alert Title="Success! Your changes have been saved" Content="This is an alert with icon, title and description.">
        <c:Alert.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M9,12 L11,14 L15,10" /></Viewbox></c:Alert.Icon>
      </c:Alert>
      <c:Alert Title="This Alert has a title and an icon. No description.">
        <c:Alert.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 8a2 2 0 0 0 0-4 2 2 0 0 0-4 0 2 2 0 0 0-4 0 2 2 0 0 0-4 0 2 2 0 0 0 0 4 M10,22 L9,8 M14,22 L15,8 M20 8c.5 0 .9.4.8 1l-2.6 12c-.1.5-.7 1-1.2 1H7c-.6 0-1.1-.4-1.2-1L3.2 9c-.1-.6.3-1 .8-1Z" /></Viewbox></c:Alert.Icon>
      </c:Alert>
      <c:Alert Classes="destructive" Title="Unable to process your payment.">
        <c:Alert.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoDestructiveBrush}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12,8 L12,12 M12,16 L12.01,16" /></Viewbox></c:Alert.Icon>
        <StackPanel Spacing="4">
          <TextBlock Text="Please verify your billing information and try again." LineHeight="22.75" TextWrapping="Wrap" />
          <c:List Classes="inside" TextBlock.LineHeight="20">
            <x:String>Check your card details</x:String>
            <x:String>Ensure sufficient funds</x:String>
            <x:String>Verify billing address</x:String>
          </c:List>
        </StackPanel>
      </c:Alert>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="aspect-ratio-demo">
    <c:AspectRatio Ratio="1.7777778" Width="450" HorizontalAlignment="Left">
      <Border CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedBrush}" ClipToBounds="True">
        <Image Source="/Assets/photo-landscape.png" Stretch="UniformToFill" AutomationProperties.Name="A landscape at dusk" />
      </Border>
    </c:AspectRatio>
  </DataTemplate>
  <DataTemplate x:Key="typography-headings">
    <StackPanel>
      <TextBlock Classes="typography h1" Text="Taxing Laughter: The Joke Tax Chronicles" />
      <Border Margin="0,40,0,0" Padding="0,0,0,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CosmoBorderBrush}">
        <TextBlock Classes="typography h2" Text="The People of the Kingdom" />
      </Border>
      <TextBlock Classes="typography h3" Margin="0,32,0,0" Text="The Joke Tax" />
      <TextBlock Classes="typography h4" Margin="0,24,0,0" Text="People stopped telling jokes" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="typography-text">
    <StackPanel>
      <TextBlock Classes="typography lead" Text="A modal dialog that interrupts the user with important content and expects a response." />
      <TextBlock Classes="typography p" Margin="0,24,0,0" Text="The king, seeing how much happier his subjects were, realized the error of his ways and repealed the joke tax." />
      <Border Classes="typography blockquote" Margin="0,24,0,0">
        <TextBlock Text="&quot;After all,&quot; he said, &quot;everyone enjoys a good joke, so it's only fair that they should pay for the privilege.&quot;" />
      </Border>
      <c:List Margin="0,16,0,24">
        <x:String>1st level of puns: 5 gold coins</x:String>
        <x:String>2nd level of jokes: 10 gold coins</x:String>
        <x:String>3rd level of one-liners : 20 gold coins</x:String>
      </c:List>
      <Border Classes="typography inline-code" Margin="0,-1.2">
        <TextBlock Text="@radix-ui/react-alert-dialog" />
      </Border>
      <TextBlock Classes="typography large" Margin="0,24,0,0" Text="Are you absolutely sure?" />
      <TextBlock Classes="typography small" Margin="0,16,0,0" Text="Email address" />
      <TextBlock Classes="typography muted" Margin="0,16,0,0" Text="Enter your email address." />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="empty-demo">
    <c:Empty Title="No Projects Yet" Description="You haven't created any projects yet. Get started by creating your first project.">
      <c:Empty.Media>
        <c:EmptyMedia Classes="icon"><Viewbox Width="24" Height="24"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M11 19h-6a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2h4l3 3h7a2 2 0 0 1 2 2v4 M20 21l2 -2l-2 -2 M17 17l-2 2l2 2" /></Viewbox></c:EmptyMedia>
      </c:Empty.Media>
      <StackPanel Spacing="24">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button Content="Create Project" />
          <Button Classes="outline" Content="Import Project" />
        </StackPanel>
        <HyperlinkButton Classes="link sm has-icon" HorizontalAlignment="Center" Foreground="{DynamicResource CosmoMutedForegroundBrush}">
          <StackPanel><TextBlock Text="Learn More" /><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M7,7 L17,7 L17,17 M7,17 L17,7" /></Viewbox></StackPanel>
        </HyperlinkButton>
      </StackPanel>
    </c:Empty>
  </DataTemplate>
  <DataTemplate x:Key="empty-outline">
    <c:Empty Classes="outline" Title="Cloud Storage Empty" Description="Upload files to your cloud storage to access them anywhere.">
      <c:Empty.Media>
        <c:EmptyMedia Classes="icon"><Viewbox Width="24" Height="24"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M6.657 18c-2.572 0 -4.657 -2.007 -4.657 -4.483c0 -2.475 2.085 -4.482 4.657 -4.482c.393 -1.762 1.794 -3.2 3.675 -3.773c1.88 -.572 3.956 -.193 5.444 1c1.488 1.19 2.162 3.007 1.77 4.769h.99c1.913 0 3.464 1.56 3.464 3.486c0 1.927 -1.551 3.487 -3.465 3.487h-11.878" /></Viewbox></c:EmptyMedia>
      </c:Empty.Media>
      <Button Classes="outline sm" Content="Upload Files" />
    </c:Empty>
  </DataTemplate>
  <DataTemplate x:Key="item-demo">
    <StackPanel Spacing="24" Width="448" HorizontalAlignment="Left">
      <c:Item Classes="outline" Title="Basic Item" Description="A simple item with title and description.">
        <c:Item.Actions>
          <Button Classes="outline sm" Content="Action" />
        </c:Item.Actions>
      </c:Item>
      <c:Item Classes="outline sm link" Title="Your profile has been verified.">
        <c:Item.Media>
          <c:ItemMedia><Viewbox Width="20" Height="20"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z M9,12 L11,14 L15,10" /></Viewbox></c:ItemMedia>
        </c:Item.Media>
        <c:Item.Actions>
          <Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M9,18 L15,12 L9,6" /></Viewbox>
        </c:Item.Actions>
      </c:Item>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="item-variant">
    <StackPanel Spacing="24">
      <c:Item Title="Default Variant" Description="Standard styling with subtle background and borders.">
        <c:Item.Actions>
          <Button Classes="outline sm" Content="Open" />
        </c:Item.Actions>
      </c:Item>
      <c:Item Classes="outline" Title="Outline Variant" Description="Outlined style with clear borders and transparent background.">
        <c:Item.Actions>
          <Button Classes="outline sm" Content="Open" />
        </c:Item.Actions>
      </c:Item>
      <c:Item Classes="muted" Title="Muted Variant" Description="Subdued appearance with muted colors for secondary content.">
        <c:Item.Actions>
          <Button Classes="outline sm" Content="Open" />
        </c:Item.Actions>
      </c:Item>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="tabs-demo">
    <StackPanel Width="384" HorizontalAlignment="Left">
      <TabControl SelectedIndex="0">
        <TabItem Header="Account">
          <c:Card>
            <c:CardHeader Title="Account" Description="Make changes to your account here. Click save when you're done." />
            <c:CardContent>
              <StackPanel Spacing="24">
                <StackPanel Spacing="12">
                  <Label Content="Name" />
                  <TextBox Text="Pedro Duarte" />
                </StackPanel>
                <StackPanel Spacing="12">
                  <Label Content="Username" />
                  <TextBox Text="@peduarte" />
                </StackPanel>
              </StackPanel>
            </c:CardContent>
            <c:CardFooter>
              <Button Content="Save changes" HorizontalAlignment="Left" />
            </c:CardFooter>
          </c:Card>
        </TabItem>
        <TabItem Header="Password">
          <c:Card>
            <c:CardHeader Title="Password" />
          </c:Card>
        </TabItem>
      </TabControl>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="tabs-list">
    <TabControl SelectedIndex="0">
      <TabItem Header="Overview" />
      <TabItem Header="Analytics" />
      <TabItem Header="Reports" />
      <TabItem Header="Notifications" IsEnabled="False" />
    </TabControl>
  </DataTemplate>
  <DataTemplate x:Key="tabs-line">
    <TabControl Classes="line" SelectedIndex="0">
      <TabItem Header="Overview" />
      <TabItem Header="Analytics" />
      <TabItem Header="Reports" />
    </TabControl>
  </DataTemplate>
  <DataTemplate x:Key="tabs-vertical">
    <TabControl TabStripPlacement="Left" SelectedIndex="0" Width="384" HorizontalAlignment="Left">
      <TabItem Header="Account">
        <TextBlock Text="Make changes to your account here." FontSize="14" LineHeight="20" Foreground="{DynamicResource CosmoMutedForegroundBrush}" TextWrapping="Wrap" />
      </TabItem>
      <TabItem Header="Password">
        <TextBlock Text="Change your password here." FontSize="14" LineHeight="20" Foreground="{DynamicResource CosmoMutedForegroundBrush}" TextWrapping="Wrap" />
      </TabItem>
      <TabItem Header="Notifications">
        <TextBlock Text="Choose what we email you about." FontSize="14" LineHeight="20" Foreground="{DynamicResource CosmoMutedForegroundBrush}" TextWrapping="Wrap" />
      </TabItem>
    </TabControl>
  </DataTemplate>
  <DataTemplate x:Key="tabs-vertical-line">
    <TabControl Classes="line" TabStripPlacement="Left" SelectedIndex="0">
      <TabItem Header="Account" />
      <TabItem Header="Password" />
      <TabItem Header="Notifications" />
    </TabControl>
  </DataTemplate>
  <DataTemplate x:Key="accordion-demo">
    <c:Accordion IsCollapsible="True">
      <Expander Header="Product Information" IsExpanded="True">
        <StackPanel Spacing="16">
          <TextBlock Text="Our flagship product combines cutting-edge technology with sleek design. Built with premium materials, it offers unparalleled performance and reliability." TextWrapping="Wrap" />
          <TextBlock Text="Key features include advanced processing capabilities, and an intuitive user interface designed for both beginners and experts." TextWrapping="Wrap" />
        </StackPanel>
      </Expander>
      <Expander Header="Shipping Details">
        <StackPanel Spacing="16">
          <TextBlock Text="We offer worldwide shipping through trusted courier partners. Standard delivery takes 3-5 business days, while express shipping ensures delivery within 1-2 business days." TextWrapping="Wrap" />
          <TextBlock Text="All orders are carefully packaged and fully insured. Track your shipment in real-time through our dedicated tracking portal." TextWrapping="Wrap" />
        </StackPanel>
      </Expander>
      <Expander Header="Return Policy">
        <StackPanel Spacing="16">
          <TextBlock Text="We stand behind our products with a comprehensive 30-day return policy. If you&apos;re not completely satisfied, simply return the item in its original condition." TextWrapping="Wrap" />
          <TextBlock Text="Our hassle-free return process includes free return shipping and full refunds processed within 48 hours of receiving the returned item." TextWrapping="Wrap" />
        </StackPanel>
      </Expander>
    </c:Accordion>
  </DataTemplate>
  <DataTemplate x:Key="collapsible-demo">
    <Expander Classes="collapsible" Width="350" Padding="0,0,16,0">
      <Expander.Header>
        <StackPanel Spacing="8">
          <Grid Height="32">
            <TextBlock Text="@peduarte starred 3 repositories" FontSize="14" LineHeight="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
          </Grid>
          <Border CornerRadius="{DynamicResource CosmoRadiusMd}" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" Padding="16,8"><TextBlock Text="@radix-ui/primitives" FontFamily="{DynamicResource CosmoFontMono}" FontSize="14" LineHeight="20" /></Border>
        </StackPanel>
      </Expander.Header>
      <StackPanel Spacing="8">
        <Border CornerRadius="{DynamicResource CosmoRadiusMd}" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" Padding="16,8"><TextBlock Text="@radix-ui/colors" FontFamily="{DynamicResource CosmoFontMono}" FontSize="14" LineHeight="20" /></Border>
        <Border CornerRadius="{DynamicResource CosmoRadiusMd}" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" Padding="16,8"><TextBlock Text="@stitches/react" FontFamily="{DynamicResource CosmoFontMono}" FontSize="14" LineHeight="20" /></Border>
      </StackPanel>
    </Expander>
  </DataTemplate>
  <DataTemplate x:Key="collapsible-open">
    <Expander Classes="collapsible" Width="350" Padding="0,0,16,0" IsExpanded="True">
      <Expander.Header>
        <StackPanel Spacing="8">
          <Grid Height="32">
            <TextBlock Text="@peduarte starred 3 repositories" FontSize="14" LineHeight="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
          </Grid>
          <Border CornerRadius="{DynamicResource CosmoRadiusMd}" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" Padding="16,8"><TextBlock Text="@radix-ui/primitives" FontFamily="{DynamicResource CosmoFontMono}" FontSize="14" LineHeight="20" /></Border>
        </StackPanel>
      </Expander.Header>
      <StackPanel Spacing="8">
        <Border CornerRadius="{DynamicResource CosmoRadiusMd}" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" Padding="16,8"><TextBlock Text="@radix-ui/colors" FontFamily="{DynamicResource CosmoFontMono}" FontSize="14" LineHeight="20" /></Border>
        <Border CornerRadius="{DynamicResource CosmoRadiusMd}" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" Padding="16,8"><TextBlock Text="@stitches/react" FontFamily="{DynamicResource CosmoFontMono}" FontSize="14" LineHeight="20" /></Border>
      </StackPanel>
    </Expander>
  </DataTemplate>
  <DataTemplate x:Key="breadcrumb-demo">
    <c:Breadcrumb>
      <HyperlinkButton Content="Home" NavigateUri="https://ui.shadcn.com/" />
      <Button AutomationProperties.Name="Toggle menu">
        <c:BreadcrumbEllipsis Width="16" Height="16" />
      </Button>
      <HyperlinkButton Content="Components" NavigateUri="https://ui.shadcn.com/docs/components" />
      <c:BreadcrumbPage Text="Breadcrumb" />
    </c:Breadcrumb>
  </DataTemplate>
  <DataTemplate x:Key="breadcrumb-separator">
    <c:Breadcrumb>
      <c:Breadcrumb.SeparatorTemplate>
        <DataTemplate><Viewbox Width="14" Height="14"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M22,2 L2,22" /></Viewbox></DataTemplate>
      </c:Breadcrumb.SeparatorTemplate>
      <HyperlinkButton Content="Home" NavigateUri="https://ui.shadcn.com/" />
      <HyperlinkButton Content="Components" NavigateUri="https://ui.shadcn.com/docs/components" />
      <c:BreadcrumbPage Text="Breadcrumb" />
    </c:Breadcrumb>
  </DataTemplate>
  <DataTemplate x:Key="pagination-demo">
    <c:Pagination>
      <c:PaginationPrevious />
      <Button Classes="ghost icon" Content="1" />
      <Button Classes="outline icon" Content="2" />
      <Button Classes="ghost icon" Content="3" />
      <c:PaginationEllipsis />
      <c:PaginationNext />
    </c:Pagination>
  </DataTemplate>
  <DataTemplate x:Key="button-group-demo">
    <c:ButtonGroup>
      <c:ButtonGroup>
      <Button Classes="outline icon" AutomationProperties.Name="Go Back"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M12,19 L5,12 L12,5 M19,12 L5,12" /></Viewbox></Button>
    </c:ButtonGroup>
      <c:ButtonGroup>
      <Button Classes="outline" Content="Archive" />
      <Button Classes="outline" Content="Report" />
    </c:ButtonGroup>
      <c:ButtonGroup>
      <Button Classes="outline" Content="Snooze" />
      <Button Classes="outline icon" AutomationProperties.Name="More Options"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M11,12 A1,1 0 1 1 13,12 A1,1 0 1 1 11,12 Z M18,12 A1,1 0 1 1 20,12 A1,1 0 1 1 18,12 Z M4,12 A1,1 0 1 1 6,12 A1,1 0 1 1 4,12 Z" /></Viewbox></Button>
    </c:ButtonGroup>
    </c:ButtonGroup>
  </DataTemplate>
  <DataTemplate x:Key="button-group-size">
    <StackPanel Spacing="32" HorizontalAlignment="Left">
    <c:ButtonGroup>
      <Button Classes="outline sm" Content="Small" />
      <Button Classes="outline sm" Content="Button" />
      <Button Classes="outline sm" Content="Group" />
      <Button Classes="outline icon-sm" AutomationProperties.Name="Add"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M5,12 L19,12 M12,5 L12,19" /></Viewbox></Button>
    </c:ButtonGroup>
    <c:ButtonGroup>
      <Button Classes="outline" Content="Default" />
      <Button Classes="outline" Content="Button" />
      <Button Classes="outline" Content="Group" />
      <Button Classes="outline icon" AutomationProperties.Name="Add"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M5,12 L19,12 M12,5 L12,19" /></Viewbox></Button>
    </c:ButtonGroup>
    <c:ButtonGroup>
      <Button Classes="outline lg" Content="Large" />
      <Button Classes="outline lg" Content="Button" />
      <Button Classes="outline lg" Content="Group" />
      <Button Classes="outline icon-lg" AutomationProperties.Name="Add"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M5,12 L19,12 M12,5 L12,19" /></Viewbox></Button>
    </c:ButtonGroup>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="button-group-orientation">
    <StackPanel Orientation="Horizontal" Spacing="32" VerticalAlignment="Top">
    <c:ButtonGroup Orientation="Vertical" VerticalAlignment="Top" AutomationProperties.Name="Media controls">
      <Button Classes="outline icon" AutomationProperties.Name="Add"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M5,12 L19,12 M12,5 L12,19" /></Viewbox></Button>
      <Button Classes="outline icon" AutomationProperties.Name="Remove"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M5,12 L19,12" /></Viewbox></Button>
    </c:ButtonGroup>
    <c:ButtonGroup VerticalAlignment="Top">
      <Button Classes="secondary sm" Content="Copy" />
      <Separator />
      <Button Classes="secondary sm" Content="Paste" />
    </c:ButtonGroup>
    <c:ButtonGroup VerticalAlignment="Top">
      <c:ButtonGroupText Content="https://" />
      <TextBox PlaceholderText="my-app" Width="160" />
      <Button Classes="outline" Content="Go" />
    </c:ButtonGroup>
    </StackPanel>
  </DataTemplate>
