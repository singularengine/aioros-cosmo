  <DataTemplate x:Key="sidebar-16">
    <c:SidebarProvider Width="1280" Height="800" MobileBreakpoint="0">
      <Border DockPanel.Dock="Top" Height="57" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CosmoBorderBrush}" Background="{DynamicResource CosmoBackgroundBrush}">
        <DockPanel Margin="16,0">
          <Panel DockPanel.Dock="Right" Width="192" VerticalAlignment="Center">
            <c:SidebarInput Height="32" Padding="28,4,12,4" PlaceholderText="Type to search..." AutomationProperties.Name="Search" />
            <Viewbox Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.5" IsHitTestVisible="False"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3,11 A8,8 0 1 1 19,11 A8,8 0 1 1 3,11 Z M21 21 l-4.3-4.3" /></Viewbox>
          </Panel>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <c:SidebarTrigger Width="32" Height="32" VerticalAlignment="Center" />
            <Separator Classes="vertical" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
            <c:Breadcrumb VerticalAlignment="Center">
              <HyperlinkButton Content="Build Your Application" NavigateUri="#" />
              <c:BreadcrumbPage Text="Data Fetching" />
            </c:Breadcrumb>
          </StackPanel>
        </DockPanel>
      </Border>
      <c:Sidebar>
        <c:SidebarHeader>
          <c:SidebarMenu>
            <c:SidebarMenuItem>
              <c:SidebarMenuButton Classes="lg" Tooltip="Acme Inc">
                <DockPanel>
                  <Border Width="32" Height="32" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoSidebarPrimaryBrush}"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarPrimaryForegroundBrush}" Data="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3" /></Viewbox></Border>
                  <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Acme Inc" FontWeight="Medium" LineHeight="17.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Enterprise" FontSize="12" LineHeight="15" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DockPanel>
              </c:SidebarMenuButton>
            </c:SidebarMenuItem>
          </c:SidebarMenu>
        </c:SidebarHeader>
        <c:SidebarContent>
          <c:SidebarContent.ItemsPanel><ItemsPanelTemplate><DockPanel LastChildFill="False" VerticalSpacing="8" /></ItemsPanelTemplate></c:SidebarContent.ItemsPanel>
          <c:SidebarGroup DockPanel.Dock="Top">
            <c:SidebarGroupLabel Content="Platform" />
            <c:SidebarMenu>
              <c:SidebarMenuItem IsCollapsible="True" IsExpanded="True">
                <c:SidebarMenuButton Tooltip="Playground"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M7 11 l2-2-2-2 M11 13h4 M5,3 L19,3 A2,2 0 0 1 21,5 L21,19 A2,2 0 0 1 19,21 L5,21 A2,2 0 0 1 3,19 L3,5 A2,2 0 0 1 5,3 Z" /></Viewbox><TextBlock Text="Playground" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                <c:SidebarMenuAction Toggles="True" AutomationProperties.Name="Toggle"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M9 18 l6-6-6-6" /></Viewbox></c:SidebarMenuAction>
                <c:SidebarMenuSub>
                  <c:SidebarMenuSubButton Content="History" />
                  <c:SidebarMenuSubButton Content="Starred" />
                  <c:SidebarMenuSubButton Content="Settings" />
                </c:SidebarMenuSub>
              </c:SidebarMenuItem>
              <c:SidebarMenuItem IsCollapsible="True">
                <c:SidebarMenuButton Tooltip="Models"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M12 8V4H8 M6,8 L18,8 A2,2 0 0 1 20,10 L20,18 A2,2 0 0 1 18,20 L6,20 A2,2 0 0 1 4,18 L4,10 A2,2 0 0 1 6,8 Z M2 14h2 M20 14h2 M15 13v2 M9 13v2" /></Viewbox><TextBlock Text="Models" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                <c:SidebarMenuAction Toggles="True" AutomationProperties.Name="Toggle"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M9 18 l6-6-6-6" /></Viewbox></c:SidebarMenuAction>
                <c:SidebarMenuSub>
                  <c:SidebarMenuSubButton Content="Genesis" />
                  <c:SidebarMenuSubButton Content="Explorer" />
                  <c:SidebarMenuSubButton Content="Quantum" />
                </c:SidebarMenuSub>
              </c:SidebarMenuItem>
              <c:SidebarMenuItem IsCollapsible="True">
                <c:SidebarMenuButton Tooltip="Documentation"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M12 7v14 M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z" /></Viewbox><TextBlock Text="Documentation" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                <c:SidebarMenuAction Toggles="True" AutomationProperties.Name="Toggle"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M9 18 l6-6-6-6" /></Viewbox></c:SidebarMenuAction>
                <c:SidebarMenuSub>
                  <c:SidebarMenuSubButton Content="Introduction" />
                  <c:SidebarMenuSubButton Content="Get Started" />
                  <c:SidebarMenuSubButton Content="Tutorials" />
                  <c:SidebarMenuSubButton Content="Changelog" />
                </c:SidebarMenuSub>
              </c:SidebarMenuItem>
              <c:SidebarMenuItem IsCollapsible="True">
                <c:SidebarMenuButton Tooltip="Settings"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M20 7h-9 M14 17H5 M14,17 A3,3 0 1 1 20,17 A3,3 0 1 1 14,17 Z M4,7 A3,3 0 1 1 10,7 A3,3 0 1 1 4,7 Z" /></Viewbox><TextBlock Text="Settings" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                <c:SidebarMenuAction Toggles="True" AutomationProperties.Name="Toggle"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M9 18 l6-6-6-6" /></Viewbox></c:SidebarMenuAction>
                <c:SidebarMenuSub>
                  <c:SidebarMenuSubButton Content="General" />
                  <c:SidebarMenuSubButton Content="Team" />
                  <c:SidebarMenuSubButton Content="Billing" />
                  <c:SidebarMenuSubButton Content="Limits" />
                </c:SidebarMenuSub>
              </c:SidebarMenuItem>
            </c:SidebarMenu>
          </c:SidebarGroup>
          <c:SidebarGroup DockPanel.Dock="Top" Classes="icon-hidden">
            <c:SidebarGroupLabel Content="Projects" />
            <c:SidebarMenu>
              <c:SidebarMenuItem>
                <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M22,6 L2,6 M22,18 L2,18 M6,2 L6,22 M18,2 L18,22" /></Viewbox><TextBlock Text="Design Engineering" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                <c:SidebarMenuAction Classes="show-on-hover" AutomationProperties.Name="More">
                  <Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M11,12 A1,1 0 1 1 13,12 A1,1 0 1 1 11,12 Z M18,12 A1,1 0 1 1 20,12 A1,1 0 1 1 18,12 Z M4,12 A1,1 0 1 1 6,12 A1,1 0 1 1 4,12 Z" /></Viewbox>
                  <c:SidebarMenuAction.Flyout>
                    <MenuFlyout Placement="RightEdgeAlignedTop">
                      <MenuItem Header="View Project"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" /></Viewbox></MenuItem.Icon></MenuItem>
                      <MenuItem Header="Share Project"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8 M16,6 L12,2 L8,6 M12,2 L12,15" /></Viewbox></MenuItem.Icon></MenuItem>
                      <Separator />
                      <MenuItem Header="Delete Project"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M3 6h18 M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6 M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2 M10,11 L10,17 M14,11 L14,17" /></Viewbox></MenuItem.Icon></MenuItem>
                    </MenuFlyout>
                  </c:SidebarMenuAction.Flyout>
                </c:SidebarMenuAction>
              </c:SidebarMenuItem>
              <c:SidebarMenuItem>
                <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M21 12c.552 0 1.005-.449.95-.998a10 10 0 0 0-8.953-8.951c-.55-.055-.998.398-.998.95v8a1 1 0 0 0 1 1z M21.21 15.89A10 10 0 1 1 8 2.83" /></Viewbox><TextBlock Text="Sales &amp; Marketing" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                <c:SidebarMenuAction Classes="show-on-hover" AutomationProperties.Name="More">
                  <Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M11,12 A1,1 0 1 1 13,12 A1,1 0 1 1 11,12 Z M18,12 A1,1 0 1 1 20,12 A1,1 0 1 1 18,12 Z M4,12 A1,1 0 1 1 6,12 A1,1 0 1 1 4,12 Z" /></Viewbox>
                  <c:SidebarMenuAction.Flyout>
                    <MenuFlyout Placement="RightEdgeAlignedTop">
                      <MenuItem Header="View Project"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" /></Viewbox></MenuItem.Icon></MenuItem>
                      <MenuItem Header="Share Project"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8 M16,6 L12,2 L8,6 M12,2 L12,15" /></Viewbox></MenuItem.Icon></MenuItem>
                      <Separator />
                      <MenuItem Header="Delete Project"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M3 6h18 M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6 M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2 M10,11 L10,17 M14,11 L14,17" /></Viewbox></MenuItem.Icon></MenuItem>
                    </MenuFlyout>
                  </c:SidebarMenuAction.Flyout>
                </c:SidebarMenuAction>
              </c:SidebarMenuItem>
              <c:SidebarMenuItem>
                <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z M15 5.764v15 M9 3.236v15" /></Viewbox><TextBlock Text="Travel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                <c:SidebarMenuAction Classes="show-on-hover" AutomationProperties.Name="More">
                  <Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M11,12 A1,1 0 1 1 13,12 A1,1 0 1 1 11,12 Z M18,12 A1,1 0 1 1 20,12 A1,1 0 1 1 18,12 Z M4,12 A1,1 0 1 1 6,12 A1,1 0 1 1 4,12 Z" /></Viewbox>
                  <c:SidebarMenuAction.Flyout>
                    <MenuFlyout Placement="RightEdgeAlignedTop">
                      <MenuItem Header="View Project"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" /></Viewbox></MenuItem.Icon></MenuItem>
                      <MenuItem Header="Share Project"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8 M16,6 L12,2 L8,6 M12,2 L12,15" /></Viewbox></MenuItem.Icon></MenuItem>
                      <Separator />
                      <MenuItem Header="Delete Project"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M3 6h18 M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6 M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2 M10,11 L10,17 M14,11 L14,17" /></Viewbox></MenuItem.Icon></MenuItem>
                    </MenuFlyout>
                  </c:SidebarMenuAction.Flyout>
                </c:SidebarMenuAction>
              </c:SidebarMenuItem>
              <c:SidebarMenuItem><c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M11,12 A1,1 0 1 1 13,12 A1,1 0 1 1 11,12 Z M18,12 A1,1 0 1 1 20,12 A1,1 0 1 1 18,12 Z M4,12 A1,1 0 1 1 6,12 A1,1 0 1 1 4,12 Z" /></Viewbox><TextBlock Text="More" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
            </c:SidebarMenu>
          </c:SidebarGroup>
          <c:SidebarGroup DockPanel.Dock="Bottom">
            <c:SidebarMenu>
              <c:SidebarMenuItem>
                <c:SidebarMenuButton Classes="sm"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M4.93 4.93 l4.24 4.24 M14.83 9.17 l4.24-4.24 M14.83 14.83 l4.24 4.24 M9.17 14.83 l-4.24 4.24 M8,12 A4,4 0 1 1 16,12 A4,4 0 1 1 8,12 Z" /></Viewbox><TextBlock Text="Support" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
              </c:SidebarMenuItem>
              <c:SidebarMenuItem>
                <c:SidebarMenuButton Classes="sm"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z M21.854 2.147 l-10.94 10.939" /></Viewbox><TextBlock Text="Feedback" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
              </c:SidebarMenuItem>
            </c:SidebarMenu>
          </c:SidebarGroup>
        </c:SidebarContent>
        <c:SidebarFooter>
          <c:SidebarMenu>
            <c:SidebarMenuItem>
              <c:SidebarMenuButton Classes="lg" Tooltip="shadcn">
                <DockPanel>
                  <Viewbox Width="16" Height="16" DockPanel.Dock="Right" Margin="8,0,0,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M7 15 l5 5 5-5 M7 9 l5-5 5 5" /></Viewbox>
                  <c:Avatar Width="32" Height="32" Content="CN" CornerRadius="{DynamicResource CosmoRadiusLg}" />
                  <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="shadcn" FontWeight="Medium" LineHeight="17.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="m@example.com" FontSize="12" LineHeight="15" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DockPanel>
                <c:SidebarMenuButton.Flyout>
                  <MenuFlyout Placement="RightEdgeAlignedBottom">
                    <MenuItem Classes="label">
                      <MenuItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <c:Avatar Width="32" Height="32" Content="CN" CornerRadius="{DynamicResource CosmoRadiusLg}" />
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="shadcn" FontWeight="Medium" FontSize="14" LineHeight="17.5" />
                            <TextBlock Text="m@example.com" FontWeight="Normal" FontSize="12" LineHeight="15" />
                          </StackPanel>
                        </StackPanel>
                      </MenuItem.Header>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Upgrade to Pro"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z M20 3v4 M22 5h-4 M4 17v2 M5 18H3" /></Viewbox></MenuItem.Icon></MenuItem>
                    <Separator />
                    <MenuItem Header="Account"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z M9 12 l2 2 4-4" /></Viewbox></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Billing"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M4,5 L20,5 A2,2 0 0 1 22,7 L22,17 A2,2 0 0 1 20,19 L4,19 A2,2 0 0 1 2,17 L2,7 A2,2 0 0 1 4,5 Z M2,10 L22,10" /></Viewbox></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Notifications"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M10.268 21a2 2 0 0 0 3.464 0 M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326" /></Viewbox></MenuItem.Icon></MenuItem>
                    <Separator />
                    <MenuItem Header="Log out"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16,17 L21,12 L16,7 M21,12 L9,12" /></Viewbox></MenuItem.Icon></MenuItem>
                  </MenuFlyout>
                </c:SidebarMenuButton.Flyout>
              </c:SidebarMenuButton>
            </c:SidebarMenuItem>
          </c:SidebarMenu>
        </c:SidebarFooter>
      </c:Sidebar>
      <c:SidebarInset>
        <DockPanel>
          <DockPanel Margin="16">
            <UniformGrid DockPanel.Dock="Top" Columns="3" ColumnSpacing="16" Margin="0,0,0,16">
              <c:AspectRatio Ratio="1.7778"><Border CornerRadius="{DynamicResource CosmoRadiusXl}" Background="{DynamicResource CosmoMutedHalfBrush}" /></c:AspectRatio>
              <c:AspectRatio Ratio="1.7778"><Border CornerRadius="{DynamicResource CosmoRadiusXl}" Background="{DynamicResource CosmoMutedHalfBrush}" /></c:AspectRatio>
              <c:AspectRatio Ratio="1.7778"><Border CornerRadius="{DynamicResource CosmoRadiusXl}" Background="{DynamicResource CosmoMutedHalfBrush}" /></c:AspectRatio>
            </UniformGrid>
            <Border CornerRadius="{DynamicResource CosmoRadiusXl}" Background="{DynamicResource CosmoMutedHalfBrush}" />
          </DockPanel>
        </DockPanel>
      </c:SidebarInset>
    </c:SidebarProvider>
  </DataTemplate>
  <DataTemplate x:Key="dashboard-01">
    <Panel Width="1280" Height="800" x:DataType="m:DashboardBlock" c:OverlayHost.IsHost="True">
      <Panel.DataContext><m:DashboardBlock /></Panel.DataContext>
      <Panel.Resources>
        <ResourceDictionary>
          <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="DashboardDoneBrush" Color="#00C950" /></ResourceDictionary>
            <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="DashboardDoneBrush" Color="#05DF72" /></ResourceDictionary>
          </ResourceDictionary.ThemeDictionaries>
          <c:ChartConfig x:Key="VisitorsConfig"><c:ChartConfigItem Key="Visitors" Label="Visitors" /><c:ChartConfigItem Key="Desktop" Label="Desktop" Color="PictorPrimary" /><c:ChartConfigItem Key="Mobile" Label="Mobile" Color="PictorPrimary" /></c:ChartConfig>
        </ResourceDictionary>
      </Panel.Resources>
      <Panel.Styles>
        <Style Selector="c|SidebarMenuButton.quick">
          <Setter Property="Background" Value="{DynamicResource CosmoPrimaryBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource CosmoPrimaryForegroundBrush}" />
          <Setter Property="MinWidth" Value="32" />
        </Style>
        <Style Selector="c|SidebarMenuButton.quick:pointerover, c|SidebarMenuButton.quick:pressed">
          <Setter Property="Background" Value="{DynamicResource CosmoButtonPrimaryHoverBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource CosmoPrimaryForegroundBrush}" />
        </Style>
        <Style Selector="c|Card.section">
          <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
              <GradientStop Offset="0" Color="{DynamicResource CosmoSectionCardBottomColor}" />
              <GradientStop Offset="1" Color="{DynamicResource CosmoSectionCardTopColor}" />
            </LinearGradientBrush>
          </Setter>
        </Style>
        <Style Selector="ListBox.toggle-group.range > ListBoxItem">
          <Setter Property="Padding" Value="16,0" />
        </Style>
        <Style Selector="TextBox.cell">
          <Setter Property="Height" Value="32" />
          <Setter Property="MinHeight" Value="32" />
          <Setter Property="Width" Value="64" />
          <Setter Property="HorizontalContentAlignment" Value="Right" />
          <Setter Property="TextAlignment" Value="Right" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.cell /template/ Border#PART_BorderElement">
          <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="TextBox.cell:pointerover /template/ Border#PART_BorderElement">
          <Setter Property="Background" Value="{DynamicResource CosmoInputHoverBackgroundBrush}" />
        </Style>
        <Style Selector="c|Badge.cell">
          <Setter Property="Padding" Value="6,2" />
          <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
        </Style>
        <Style Selector="c|Badge.count">
          <Setter Property="Width" Value="20" />
          <Setter Property="Height" Value="20" />
          <Setter Property="Padding" Value="4,0" />
          <Setter Property="CornerRadius" Value="9999" />
          <Setter Property="Background" Value="{DynamicResource CosmoMutedForegroundThirdBrush}" />
        </Style>
      </Panel.Styles>
      <c:SidebarProvider MobileBreakpoint="0">
        <c:Sidebar Variant="Inset" ExpandedWidth="288">
          <c:SidebarHeader>
            <c:SidebarMenu>
              <c:SidebarMenuItem>
                <c:SidebarMenuButton Padding="6"><DockPanel><Viewbox Width="20" Height="20" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M5.636 5.636a9 9 0 1 0 12.728 12.728a9 9 0 0 0 -12.728 -12.728 M16.243 7.757a6 6 0 0 0 -8.486 0" /></Viewbox><TextBlock Text="Acme Inc." FontSize="16" LineHeight="24" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel></c:SidebarMenuButton>
              </c:SidebarMenuItem>
            </c:SidebarMenu>
          </c:SidebarHeader>
          <c:SidebarContent>
            <c:SidebarContent.ItemsPanel><ItemsPanelTemplate><DockPanel LastChildFill="False" VerticalSpacing="8" /></ItemsPanelTemplate></c:SidebarContent.ItemsPanel>
            <c:SidebarGroup DockPanel.Dock="Top">
              <StackPanel Spacing="8">
                <c:SidebarMenu>
                  <c:SidebarMenuItem>
                    <DockPanel>
                      <Button Classes="outline icon" Width="32" Height="32" Margin="8,0,0,0" DockPanel.Dock="Right" AutomationProperties.Name="Inbox"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10 M3 7l9 6l9 -6" /></Viewbox></Button>
                      <c:SidebarMenuButton Classes="quick" Tooltip="Quick Create"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Fill="{DynamicResource CosmoPrimaryForegroundBrush}" StrokeThickness="0" Data="M4.929 4.929a10 10 0 1 1 14.141 14.141a10 10 0 0 1 -14.14 -14.14m8.071 4.071a1 1 0 1 0 -2 0v2h-2a1 1 0 1 0 0 2h2v2a1 1 0 1 0 2 0v-2h2a1 1 0 1 0 0 -2h-2v-2z" /></Viewbox><TextBlock Text="Quick Create" VerticalAlignment="Center" /></DockPanel></c:SidebarMenuButton>
                    </DockPanel>
                  </c:SidebarMenuItem>
                </c:SidebarMenu>
                <c:SidebarMenu>
                  <c:SidebarMenuItem><c:SidebarMenuButton Tooltip="Dashboard"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M10 13a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M13.45 11.55l2.05 -2.05 M6.4 20a9 9 0 1 1 11.2 0l-11.2 0" /></Viewbox><TextBlock Text="Dashboard" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
                  <c:SidebarMenuItem><c:SidebarMenuButton Tooltip="Lifecycle"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M13 5h8 M13 9h5 M13 15h8 M13 19h5 M3 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4 M3 15a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4" /></Viewbox><TextBlock Text="Lifecycle" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
                  <c:SidebarMenuItem><c:SidebarMenuButton Tooltip="Analytics"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M3 13a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v6a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -6 M15 9a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -10 M9 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -14 M4 20h14" /></Viewbox><TextBlock Text="Analytics" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
                  <c:SidebarMenuItem><c:SidebarMenuButton Tooltip="Projects"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2" /></Viewbox><TextBlock Text="Projects" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
                  <c:SidebarMenuItem><c:SidebarMenuButton Tooltip="Team"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M5 7a4 4 0 1 0 8 0a4 4 0 1 0 -8 0 M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2 M16 3.13a4 4 0 0 1 0 7.75 M21 21v-2a4 4 0 0 0 -3 -3.85" /></Viewbox><TextBlock Text="Team" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
                </c:SidebarMenu>
              </StackPanel>
            </c:SidebarGroup>
            <c:SidebarGroup DockPanel.Dock="Top" Classes="icon-hidden">
              <c:SidebarGroupLabel Content="Documents" />
              <c:SidebarMenu>
                <c:SidebarMenuItem>
                  <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M4 6a8 3 0 1 0 16 0a8 3 0 1 0 -16 0 M4 6v6a8 3 0 0 0 16 0v-6 M4 12v6a8 3 0 0 0 16 0v-6" /></Viewbox><TextBlock Text="Data Library" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                  <c:SidebarMenuAction Classes="show-on-hover" AutomationProperties.Name="More">
                    <Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M4 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M18 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /></Viewbox>
                    <c:SidebarMenuAction.Flyout>
                      <MenuFlyout Placement="RightEdgeAlignedTop">
                        <MenuItem Header="Open"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2" /></Viewbox></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Share"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M13 4v4c-6.575 1.028 -9.02 6.788 -10 12c-.037 .206 5.384 -5.962 10 -6v4l8 -7l-8 -7" /></Viewbox></MenuItem.Icon></MenuItem>
                        <Separator />
                        <MenuItem Header="Delete" Classes="destructive"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoDestructiveBrush}" Data="M4 7l16 0 M10 11l0 6 M14 11l0 6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" /></Viewbox></MenuItem.Icon></MenuItem>
                      </MenuFlyout>
                    </c:SidebarMenuAction.Flyout>
                  </c:SidebarMenuAction>
                </c:SidebarMenuItem>
                <c:SidebarMenuItem>
                  <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M8 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h5.697 M18 14v4h4 M18 11v-4a2 2 0 0 0 -2 -2h-2 M8 5a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2 M14 18a4 4 0 1 0 8 0a4 4 0 1 0 -8 0 M8 11h4 M8 15h3" /></Viewbox><TextBlock Text="Reports" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                  <c:SidebarMenuAction Classes="show-on-hover" AutomationProperties.Name="More">
                    <Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M4 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M18 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /></Viewbox>
                    <c:SidebarMenuAction.Flyout>
                      <MenuFlyout Placement="RightEdgeAlignedTop">
                        <MenuItem Header="Open"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2" /></Viewbox></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Share"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M13 4v4c-6.575 1.028 -9.02 6.788 -10 12c-.037 .206 5.384 -5.962 10 -6v4l8 -7l-8 -7" /></Viewbox></MenuItem.Icon></MenuItem>
                        <Separator />
                        <MenuItem Header="Delete" Classes="destructive"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoDestructiveBrush}" Data="M4 7l16 0 M10 11l0 6 M14 11l0 6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" /></Viewbox></MenuItem.Icon></MenuItem>
                      </MenuFlyout>
                    </c:SidebarMenuAction.Flyout>
                  </c:SidebarMenuAction>
                </c:SidebarMenuItem>
                <c:SidebarMenuItem>
                  <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M14 3v4a1 1 0 0 0 1 1h4 M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2 M9 12l1.333 5l1.667 -4l1.667 4l1.333 -5" /></Viewbox><TextBlock Text="Word Assistant" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                  <c:SidebarMenuAction Classes="show-on-hover" AutomationProperties.Name="More">
                    <Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M4 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M18 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /></Viewbox>
                    <c:SidebarMenuAction.Flyout>
                      <MenuFlyout Placement="RightEdgeAlignedTop">
                        <MenuItem Header="Open"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2" /></Viewbox></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Share"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M13 4v4c-6.575 1.028 -9.02 6.788 -10 12c-.037 .206 5.384 -5.962 10 -6v4l8 -7l-8 -7" /></Viewbox></MenuItem.Icon></MenuItem>
                        <Separator />
                        <MenuItem Header="Delete" Classes="destructive"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoDestructiveBrush}" Data="M4 7l16 0 M10 11l0 6 M14 11l0 6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" /></Viewbox></MenuItem.Icon></MenuItem>
                      </MenuFlyout>
                    </c:SidebarMenuAction.Flyout>
                  </c:SidebarMenuAction>
                </c:SidebarMenuItem>
                <c:SidebarMenuItem><c:SidebarMenuButton Opacity="0.7"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M4 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M18 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /></Viewbox><TextBlock Text="More" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
              </c:SidebarMenu>
            </c:SidebarGroup>
            <c:SidebarGroup DockPanel.Dock="Bottom">
              <c:SidebarMenu>
                <c:SidebarMenuItem>
                  <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065 M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" /></Viewbox><TextBlock Text="Settings" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                </c:SidebarMenuItem>
                <c:SidebarMenuItem>
                  <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M12 17l0 .01 M12 13.5a1.5 1.5 0 0 1 1 -1.5a2.6 2.6 0 1 0 -3 -4" /></Viewbox><TextBlock Text="Get Help" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                </c:SidebarMenuItem>
                <c:SidebarMenuItem>
                  <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0 M21 21l-6 -6" /></Viewbox><TextBlock Text="Search" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                </c:SidebarMenuItem>
              </c:SidebarMenu>
            </c:SidebarGroup>
          </c:SidebarContent>
          <c:SidebarFooter>
            <c:SidebarMenu>
              <c:SidebarMenuItem>
                <c:SidebarMenuButton Classes="lg" Tooltip="shadcn">
                  <DockPanel>
                    <Viewbox Width="16" Height="16" DockPanel.Dock="Right" Margin="8,0,0,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M11 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M11 5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /></Viewbox>
                    <c:Avatar Width="32" Height="32" Content="CN" CornerRadius="{DynamicResource CosmoRadiusLg}" />
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="shadcn" FontWeight="Medium" LineHeight="17.5" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="m@example.com" FontSize="12" LineHeight="15" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DockPanel>
                  <c:SidebarMenuButton.Flyout>
                    <MenuFlyout Placement="RightEdgeAlignedBottom">
                      <MenuItem Classes="label">
                        <MenuItem.Header>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:Avatar Width="32" Height="32" Content="CN" CornerRadius="{DynamicResource CosmoRadiusLg}" />
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="shadcn" FontWeight="Medium" FontSize="14" LineHeight="17.5" />
                              <TextBlock Text="m@example.com" FontWeight="Normal" FontSize="12" LineHeight="15" />
                            </StackPanel>
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      <Separator />
                      <MenuItem Header="Account"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M9 10a3 3 0 1 0 6 0a3 3 0 1 0 -6 0 M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855" /></Viewbox></MenuItem.Icon></MenuItem>
                      <MenuItem Header="Billing"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M3 8a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3l0 -8 M3 10l18 0 M7 15l.01 0 M11 15l2 0" /></Viewbox></MenuItem.Icon></MenuItem>
                      <MenuItem Header="Notifications"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M10 6h-3a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-3 M14 7a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" /></Viewbox></MenuItem.Icon></MenuItem>
                      <Separator />
                      <MenuItem Header="Log out"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M14 8v-2a2 2 0 0 0 -2 -2h-7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2 -2v-2 M9 12h12l-3 -3 M18 15l3 -3" /></Viewbox></MenuItem.Icon></MenuItem>
                    </MenuFlyout>
                  </c:SidebarMenuButton.Flyout>
                </c:SidebarMenuButton>
              </c:SidebarMenuItem>
            </c:SidebarMenu>
          </c:SidebarFooter>
        </c:Sidebar>
        <c:SidebarInset>
          <DockPanel>
            <Border DockPanel.Dock="Top" Height="48" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CosmoBorderBrush}">
              <DockPanel Margin="24,0">
                <HyperlinkButton DockPanel.Dock="Right" Classes="ghost sm" Content="GitHub" NavigateUri="https://github.com/shadcn-ui/ui/tree/main/apps/v4/app/(examples)/dashboard" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <c:SidebarTrigger Margin="-4,0,0,0" VerticalAlignment="Center" />
                  <Separator Classes="vertical" Height="16" Margin="8,0" VerticalAlignment="Center" />
                  <TextBlock Text="Documents" FontSize="16" LineHeight="24" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
              </DockPanel>
            </Border>
            <ScrollViewer Theme="{DynamicResource CosmoScrollArea}" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="24" Margin="0,24">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16" Margin="24,0">
                  <c:Card Classes="section" Grid.Row="0" Grid.Column="0">
                    <c:CardHeader>
                      <c:CardHeader.Title>
                        <StackPanel Spacing="8">
                          <TextBlock Text="Total Revenue" FontSize="14" LineHeight="20" FontWeight="Normal" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                          <TextBlock Text="$1,250.00" FontSize="30" LineHeight="36" FontWeight="SemiBold" FontFeatures="+tnum" />
                        </StackPanel>
                      </c:CardHeader.Title>
                      <c:CardHeader.Action><c:Badge Classes="outline"><StackPanel><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 17l6 -6l4 4l8 -8 M14 7l7 0l0 7" /></Viewbox><TextBlock Text="+12.5%" /></StackPanel></c:Badge></c:CardHeader.Action>
                    </c:CardHeader>
                    <c:CardFooter>
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Trending up this month" FontSize="14" LineHeight="20" FontWeight="Medium" /><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 17l6 -6l4 4l8 -8 M14 7l7 0l0 7" /></Viewbox></StackPanel>
                        <TextBlock Text="Visitors for the last 6 months" FontSize="14" LineHeight="20" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                      </StackPanel>
                    </c:CardFooter>
                  </c:Card>
                  <c:Card Classes="section" Grid.Row="0" Grid.Column="1">
                    <c:CardHeader>
                      <c:CardHeader.Title>
                        <StackPanel Spacing="8">
                          <TextBlock Text="New Customers" FontSize="14" LineHeight="20" FontWeight="Normal" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                          <TextBlock Text="1,234" FontSize="30" LineHeight="36" FontWeight="SemiBold" FontFeatures="+tnum" />
                        </StackPanel>
                      </c:CardHeader.Title>
                      <c:CardHeader.Action><c:Badge Classes="outline"><StackPanel><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 7l6 6l4 -4l8 8 M21 10l0 7l-7 0" /></Viewbox><TextBlock Text="-20%" /></StackPanel></c:Badge></c:CardHeader.Action>
                    </c:CardHeader>
                    <c:CardFooter>
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Down 20% this period" FontSize="14" LineHeight="20" FontWeight="Medium" /><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 7l6 6l4 -4l8 8 M21 10l0 7l-7 0" /></Viewbox></StackPanel>
                        <TextBlock Text="Acquisition needs attention" FontSize="14" LineHeight="20" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                      </StackPanel>
                    </c:CardFooter>
                  </c:Card>
                  <c:Card Classes="section" Grid.Row="1" Grid.Column="0">
                    <c:CardHeader>
                      <c:CardHeader.Title>
                        <StackPanel Spacing="8">
                          <TextBlock Text="Active Accounts" FontSize="14" LineHeight="20" FontWeight="Normal" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                          <TextBlock Text="45,678" FontSize="30" LineHeight="36" FontWeight="SemiBold" FontFeatures="+tnum" />
                        </StackPanel>
                      </c:CardHeader.Title>
                      <c:CardHeader.Action><c:Badge Classes="outline"><StackPanel><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 17l6 -6l4 4l8 -8 M14 7l7 0l0 7" /></Viewbox><TextBlock Text="+12.5%" /></StackPanel></c:Badge></c:CardHeader.Action>
                    </c:CardHeader>
                    <c:CardFooter>
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Strong user retention" FontSize="14" LineHeight="20" FontWeight="Medium" /><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 17l6 -6l4 4l8 -8 M14 7l7 0l0 7" /></Viewbox></StackPanel>
                        <TextBlock Text="Engagement exceed targets" FontSize="14" LineHeight="20" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                      </StackPanel>
                    </c:CardFooter>
                  </c:Card>
                  <c:Card Classes="section" Grid.Row="1" Grid.Column="1">
                    <c:CardHeader>
                      <c:CardHeader.Title>
                        <StackPanel Spacing="8">
                          <TextBlock Text="Growth Rate" FontSize="14" LineHeight="20" FontWeight="Normal" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                          <TextBlock Text="4.5%" FontSize="30" LineHeight="36" FontWeight="SemiBold" FontFeatures="+tnum" />
                        </StackPanel>
                      </c:CardHeader.Title>
                      <c:CardHeader.Action><c:Badge Classes="outline"><StackPanel><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 17l6 -6l4 4l8 -8 M14 7l7 0l0 7" /></Viewbox><TextBlock Text="+4.5%" /></StackPanel></c:Badge></c:CardHeader.Action>
                    </c:CardHeader>
                    <c:CardFooter>
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Steady performance increase" FontSize="14" LineHeight="20" FontWeight="Medium" /><Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 17l6 -6l4 4l8 -8 M14 7l7 0l0 7" /></Viewbox></StackPanel>
                        <TextBlock Text="Meets growth projections" FontSize="14" LineHeight="20" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
                      </StackPanel>
                    </c:CardFooter>
                  </c:Card>
                </Grid>
                <c:Card Margin="24,0">
                  <c:CardHeader Title="Total Visitors" Description="Total for the last 3 months">
                    <c:CardHeader.Action>
                      <ListBox Classes="toggle-group outline range" SelectionMode="Single,AlwaysSelected" SelectedIndex="{Binding Visitors.TimeRange}" AutomationProperties.Name="Time range">
                        <ListBoxItem Content="Last 3 months" />
                        <ListBoxItem Content="Last 30 days" />
                        <ListBoxItem Content="Last 7 days" />
                      </ListBox>
                    </c:CardHeader.Action>
                  </c:CardHeader>
                  <c:CardContent Padding="24,24,24,0">
                    <p:AreaChart c:ChartConfig.Config="{StaticResource VisitorsConfig}" Data="{Binding Visitors.Range}" Height="250" Margin="0,0,0,0">
                      <p:CartesianGrid Vertical="False" />
                      <p:XAxis DataKey="Date" TickLine="False" AxisLine="False" TickMargin="8" MinTickGap="32" TickFormat="{}{0:MMM d}" />
                      <p:Tooltip Cursor="False" LabelFormat="{}{0:MMM d}"><p:Tooltip.ContentTemplate><c:ChartTooltipContent Indicator="Dot" /></p:Tooltip.ContentTemplate></p:Tooltip>
                      <p:Area DataKey="Mobile" Type="Natural" StackId="a" IsAnimationActive="False">
                        <p:Area.Fill>
                          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0.05" Color="{DynamicResource CosmoPrimaryTopColor}" />
                            <GradientStop Offset="0.95" Color="{DynamicResource CosmoPrimaryBottomColor}" />
                          </LinearGradientBrush>
                        </p:Area.Fill>
                      </p:Area>
                      <p:Area DataKey="Desktop" Type="Natural" StackId="a" IsAnimationActive="False">
                        <p:Area.Fill>
                          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0.05" Color="{DynamicResource CosmoPrimaryColor}" />
                            <GradientStop Offset="0.95" Color="{DynamicResource CosmoPrimaryBottomColor}" />
                          </LinearGradientBrush>
                        </p:Area.Fill>
                      </p:Area>
                    </p:AreaChart>
                  </c:CardContent>
                </c:Card>
                <Panel Margin="24,0">
                  <TabControl SelectedIndex="{Binding Tab}">
                    <TabItem><TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Outline" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                      <StackPanel Spacing="16">
                        <Border BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}" CornerRadius="{DynamicResource CosmoRadiusLg}" ClipToBounds="True">
                          <TableView Classes="muted-header" ItemsSource="{Binding Sections.Rows}" c:DataTable.SelectsRows="True" c:DataTable.State="{Binding Sections.State}">
                            <TableView.Columns>
                              <TableViewColumn Width="44">
                                <TableViewColumn.Header></TableViewColumn.Header>
                                <TableViewColumn.CellTemplate>
                                  <DataTemplate x:DataType="m:DashboardSection"><Border Classes="grip" Width="28" Height="28" CornerRadius="{DynamicResource CosmoRadiusMd}" Background="Transparent" HorizontalAlignment="Left" AutomationProperties.Name="Drag to reorder"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M8 5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M8 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M8 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M14 5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M14 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M14 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /></Viewbox></Border></DataTemplate>
                                </TableViewColumn.CellTemplate>
                              </TableViewColumn>
                              <TableViewColumn Width="24">
                                <TableViewColumn.Header><CheckBox IsChecked="{Binding Sections.AllPageRowsSelected}" HorizontalAlignment="Center" AutomationProperties.Name="Select all" /></TableViewColumn.Header>
                                <TableViewColumn.CellTemplate>
                                  <DataTemplate x:DataType="m:DashboardSection"><CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" AutomationProperties.Name="Select row" /></DataTemplate>
                                </TableViewColumn.CellTemplate>
                              </TableViewColumn>
                              <TableViewColumn Width="306.27">
                                <TableViewColumn.Header>Header</TableViewColumn.Header>
                                <TableViewColumn.CellTemplate>
                                  <DataTemplate x:DataType="m:DashboardSection"><Button Classes="link" Padding="0" Content="{Binding Header}" Foreground="{DynamicResource CosmoForegroundBrush}" Command="{Binding View}" /></DataTemplate>
                                </TableViewColumn.CellTemplate>
                              </TableViewColumn>
                              <TableViewColumn Width="144" IsVisible="{Binding Sections.Columns[3].IsVisible}">
                                <TableViewColumn.Header>Section Type</TableViewColumn.Header>
                                <TableViewColumn.CellTemplate>
                                  <DataTemplate x:DataType="m:DashboardSection"><Border Width="128" HorizontalAlignment="Left"><c:Badge Classes="outline cell" Content="{Binding Type}" HorizontalAlignment="Left" /></Border></DataTemplate>
                                </TableViewColumn.CellTemplate>
                              </TableViewColumn>
                              <TableViewColumn Width="105.06" IsVisible="{Binding Sections.Columns[4].IsVisible}">
                                <TableViewColumn.Header>Status</TableViewColumn.Header>
                                <TableViewColumn.CellTemplate>
                                  <DataTemplate x:DataType="m:DashboardSection"><c:Badge Classes="outline cell"><StackPanel><Panel><Viewbox Width="16" Height="16" IsVisible="{Binding IsDone}"><Path Theme="{DynamicResource CosmoIcon}" Fill="{DynamicResource DashboardDoneBrush}" StrokeThickness="0" Data="M17 3.34a10 10 0 1 1 -14.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 14.995 -8.336zm-1.293 5.953a1 1 0 0 0 -1.32 -.083l-.094 .083l-3.293 3.292l-1.293 -1.292l-.094 -.083a1 1 0 0 0 -1.403 1.403l.083 .094l2 2l.094 .083a1 1 0 0 0 1.226 0l.094 -.083l4 -4l.083 -.094a1 1 0 0 0 -.083 -1.32z" /></Viewbox><Viewbox Width="16" Height="16" IsVisible="{Binding !IsDone}"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M12 6l0 -3 M16.25 7.75l2.15 -2.15 M18 12l3 0 M16.25 16.25l2.15 2.15 M12 18l0 3 M7.75 16.25l-2.15 2.15 M6 12l-3 0 M7.75 7.75l-2.15 -2.15" /></Viewbox></Panel><TextBlock Text="{Binding Status}" /></StackPanel></c:Badge></DataTemplate>
                                </TableViewColumn.CellTemplate>
                              </TableViewColumn>
                              <TableViewColumn Width="80" IsVisible="{Binding Sections.Columns[5].IsVisible}" HorizontalContentAlignment="Stretch">
                                <TableViewColumn.Header><TextBlock Text="Target" HorizontalAlignment="Right" /></TableViewColumn.Header>
                                <TableViewColumn.CellTemplate>
                                  <DataTemplate x:DataType="m:DashboardSection"><TextBox Classes="cell" Text="{Binding Target}" AutomationProperties.Name="Target" /></DataTemplate>
                                </TableViewColumn.CellTemplate>
                              </TableViewColumn>
                              <TableViewColumn Width="80" IsVisible="{Binding Sections.Columns[6].IsVisible}" HorizontalContentAlignment="Stretch">
                                <TableViewColumn.Header><TextBlock Text="Limit" HorizontalAlignment="Right" /></TableViewColumn.Header>
                                <TableViewColumn.CellTemplate>
                                  <DataTemplate x:DataType="m:DashboardSection"><TextBox Classes="cell" Text="{Binding Limit}" AutomationProperties.Name="Limit" /></DataTemplate>
                                </TableViewColumn.CellTemplate>
                              </TableViewColumn>
                              <TableViewColumn Width="168" IsVisible="{Binding Sections.Columns[7].IsVisible}">
                                <TableViewColumn.Header>Reviewer</TableViewColumn.Header>
                                <TableViewColumn.CellTemplate>
                                  <DataTemplate x:DataType="m:DashboardSection"><Panel>
                                <TextBlock Text="{Binding Reviewer}" IsVisible="{Binding IsAssigned}" VerticalAlignment="Center" />
                                <ComboBox Classes="sm" Width="152" PlaceholderText="Assign reviewer" SelectedItem="{Binding Assignee}" IsVisible="{Binding !IsAssigned}" AutomationProperties.Name="Reviewer">
                                  <x:String>Eddie Lake</x:String>
                                  <x:String>Jamik Tashpulatov</x:String>
                                </ComboBox>
                              </Panel></DataTemplate>
                                </TableViewColumn.CellTemplate>
                              </TableViewColumn>
                              <TableViewColumn Width="48">
                                <TableViewColumn.Header></TableViewColumn.Header>
                                <TableViewColumn.CellTemplate>
                                  <DataTemplate x:DataType="m:DashboardSection"><Button Classes="ghost icon" Width="32" Height="32" HorizontalAlignment="Left" AutomationProperties.Name="Open menu"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M11 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M11 5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /></Viewbox>
                              <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="w-32">
                                  <MenuItem Header="Edit" />
                                  <MenuItem Header="Make a copy" />
                                  <MenuItem Header="Favorite" />
                                  <Separator />
                                  <MenuItem Header="Delete" Classes="destructive" />
                                </MenuFlyout>
                              </Button.Flyout></Button></DataTemplate>
                                </TableViewColumn.CellTemplate>
                              </TableViewColumn>
                            </TableView.Columns>
                          </TableView>
                        </Border>
                        <DockPanel Margin="16,0">
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="32">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Label Content="Rows per page" Target="{Binding #rows}" VerticalAlignment="Center" />
                              <ComboBox Name="rows" Classes="sm" Width="80" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding Sections.PageSize}" />
                            </StackPanel>
                            <TextBlock FontSize="14" LineHeight="20" FontWeight="Medium" VerticalAlignment="Center">
                              <TextBlock.Text><MultiBinding StringFormat="Page {0} of {1}"><Binding Path="Sections.PageNumber" /><Binding Path="Sections.PageCount" /></MultiBinding></TextBlock.Text>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Classes="outline icon" Width="32" Height="32" Command="{Binding Sections.FirstPageCommand}" AutomationProperties.Name="Go to first page"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M11 7l-5 5l5 5 M17 7l-5 5l5 5" /></Viewbox></Button>
                              <Button Classes="outline icon" Width="32" Height="32" Command="{Binding Sections.PreviousPageCommand}" AutomationProperties.Name="Go to previous page"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M15 6l-6 6l6 6" /></Viewbox></Button>
                              <Button Classes="outline icon" Width="32" Height="32" Command="{Binding Sections.NextPageCommand}" AutomationProperties.Name="Go to next page"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M9 6l6 6l-6 6" /></Viewbox></Button>
                              <Button Classes="outline icon" Width="32" Height="32" Command="{Binding Sections.LastPageCommand}" AutomationProperties.Name="Go to last page"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M7 7l5 5l-5 5 M13 7l5 5l-5 5" /></Viewbox></Button>
                            </StackPanel>
                          </StackPanel>
                          <TextBlock FontSize="14" LineHeight="20" VerticalAlignment="Center" Foreground="{DynamicResource CosmoMutedForegroundBrush}">
                            <TextBlock.Text><MultiBinding StringFormat="{}{0} of {1} row(s) selected."><Binding Path="Sections.SelectedCount" /><Binding Path="Sections.FilteredCount" /></MultiBinding></TextBlock.Text>
                          </TextBlock>
                        </DockPanel>
                      </StackPanel>
                    </TabItem>
                    <TabItem><TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Past Performance" VerticalAlignment="Center" /><c:Badge Classes="secondary count" Content="3" /></StackPanel></TabItem.Header><c:AspectRatio Ratio="1.7778"><Rectangle Stroke="{DynamicResource CosmoBorderBrush}" StrokeThickness="1" StrokeDashArray="3,3" RadiusX="8" RadiusY="8" /></c:AspectRatio></TabItem>
                    <TabItem><TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Key Personnel" VerticalAlignment="Center" /><c:Badge Classes="secondary count" Content="2" /></StackPanel></TabItem.Header><c:AspectRatio Ratio="1.7778"><Rectangle Stroke="{DynamicResource CosmoBorderBrush}" StrokeThickness="1" StrokeDashArray="3,3" RadiusX="8" RadiusY="8" /></c:AspectRatio></TabItem>
                    <TabItem><TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Focus Documents" VerticalAlignment="Center" /></StackPanel></TabItem.Header><c:AspectRatio Ratio="1.7778"><Rectangle Stroke="{DynamicResource CosmoBorderBrush}" StrokeThickness="1" StrokeDashArray="3,3" RadiusX="8" RadiusY="8" /></c:AspectRatio></TabItem>
                  </TabControl>
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Classes="outline sm has-icon">
                      <StackPanel><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M4 6a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2l0 -12 M12 4l0 16" /></Viewbox><TextBlock Text="Customize Columns" /><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M6 9l6 6l6 -6" /></Viewbox></StackPanel>
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="w-56">
                    <MenuItem Header="Type" ToggleType="CheckBox" IsChecked="{Binding Sections.Columns[3].IsVisible, Mode=TwoWay}" />
                    <MenuItem Header="Status" ToggleType="CheckBox" IsChecked="{Binding Sections.Columns[4].IsVisible, Mode=TwoWay}" />
                    <MenuItem Header="Target" ToggleType="CheckBox" IsChecked="{Binding Sections.Columns[5].IsVisible, Mode=TwoWay}" />
                    <MenuItem Header="Limit" ToggleType="CheckBox" IsChecked="{Binding Sections.Columns[6].IsVisible, Mode=TwoWay}" />
                    <MenuItem Header="Reviewer" ToggleType="CheckBox" IsChecked="{Binding Sections.Columns[7].IsVisible, Mode=TwoWay}" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                    <Button Classes="outline sm has-icon"><StackPanel><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M12 5l0 14 M5 12l14 0" /></Viewbox><TextBlock Text="Add Section" /></StackPanel></Button>
                  </StackPanel>
                </Panel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </c:SidebarInset>
      </c:SidebarProvider>
      <c:Drawer Side="Right" IsOpen="{Binding ViewerOpen}">
        <DockPanel DataContext="{Binding Viewing}" x:DataType="m:DashboardSection">
          <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="16">
            <Button Content="Submit" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" c:Dialog.Closes="True" />
            <Button Classes="outline" Content="Done" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" c:Dialog.Closes="True" />
          </StackPanel>
          <c:DialogHeader DockPanel.Dock="Top" Padding="16" Title="{Binding Header}" Description="Showing total visitors for the last 6 months" />
          <ScrollViewer Theme="{DynamicResource CosmoScrollArea}" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="16,0">
              <p:AreaChart c:ChartConfig.Config="{StaticResource VisitorsConfig}" Data="{Binding Months}" Height="200" Padding="0,0,10,0">
                <p:CartesianGrid Vertical="False" />
                <p:XAxis DataKey="Month" Hide="True" />
                <p:Tooltip Cursor="False"><p:Tooltip.ContentTemplate><c:ChartTooltipContent Indicator="Dot" /></p:Tooltip.ContentTemplate></p:Tooltip>
                <p:Area DataKey="Mobile" Type="Natural" StackId="a" Fill="{DynamicResource PictorPrimary}" FillOpacity="0.6" Stroke="{DynamicResource PictorPrimary}" IsAnimationActive="False" />
                <p:Area DataKey="Desktop" Type="Natural" StackId="a" Fill="{DynamicResource PictorPrimary}" FillOpacity="0.4" Stroke="{DynamicResource PictorPrimary}" IsAnimationActive="False" />
              </p:AreaChart>
              <Separator />
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Trending up by 5.2% this month" FontWeight="Medium" LineHeight="14" /><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 17l6 -6l4 4l8 -8 M14 7l7 0l0 7" /></Viewbox></StackPanel>
                <TextBlock Text="Showing total visitors for the last 6 months. This is just some random text to test the layout. It spans multiple lines and should wrap around." TextWrapping="Wrap" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
              </StackPanel>
              <Separator />
              <StackPanel Spacing="16">
                <StackPanel Spacing="12">
                  <Label Content="Header" />
                  <TextBox Text="{Binding Header, Mode=OneWay}" AutomationProperties.Name="Header" />
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <StackPanel Spacing="12">
                    <Label Content="Type" />
                    <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Select a type" SelectedItem="{Binding Type, Mode=OneWay}" AutomationProperties.Name="Type"><x:String>Table of Contents</x:String><x:String>Executive Summary</x:String><x:String>Technical Approach</x:String><x:String>Design</x:String><x:String>Capabilities</x:String><x:String>Focus Documents</x:String><x:String>Narrative</x:String><x:String>Cover Page</x:String></ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="12">
                    <Label Content="Status" />
                    <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Select a status" SelectedItem="{Binding Status, Mode=OneWay}" AutomationProperties.Name="Status"><x:String>Done</x:String><x:String>In Progress</x:String><x:String>Not Started</x:String></ComboBox>
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <StackPanel Spacing="12">
                    <Label Content="Target" />
                    <TextBox Text="{Binding Target}" AutomationProperties.Name="Target" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="12">
                    <Label Content="Limit" />
                    <TextBox Text="{Binding Limit}" AutomationProperties.Name="Limit" />
                  </StackPanel>
                </Grid>
                <StackPanel Spacing="12">
                  <Label Content="Reviewer" />
                  <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Select a reviewer" SelectedItem="{Binding Reviewer, Mode=OneWay}" AutomationProperties.Name="Reviewer"><x:String>Eddie Lake</x:String><x:String>Jamik Tashpulatov</x:String><x:String>Emily Whalen</x:String></ComboBox>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </c:Drawer>
    </Panel>
  </DataTemplate>
  <DataTemplate x:Key="marker-demo">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="32">
    <c:Marker Content="Switched to a new branch"><c:Marker.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M6,3 L6,15 M15,6 A3,3 0 1 1 21,6 A3,3 0 1 1 15,6 Z M3,18 A3,3 0 1 1 9,18 A3,3 0 1 1 3,18 Z M18 9a9 9 0 0 1-9 9" /></Viewbox></c:Marker.Icon></c:Marker>
    <c:Marker Content="Thinking..."><c:Marker.Icon><c:Spinner Width="16" Height="16" /></c:Marker.Icon></c:Marker>
    <c:Marker Classes="separator" Content="Conversation compacted" />
    <c:Marker Content="Explored 4 files"><c:Marker.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M3,11 A8,8 0 1 1 19,11 A8,8 0 1 1 3,11 Z M21 21 l-4.3-4.3" /></Viewbox></c:Marker.Icon></c:Marker>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="marker-variants">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="32">
    <c:Marker Content="A default marker for inline notes." />
    <c:Marker Classes="separator" Content="A separator marker" />
    <c:Marker Classes="border" Content="A border marker for row boundaries." />
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="marker-icon">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="48">
    <c:Marker Content="Switched to a new branch"><c:Marker.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M6,3 L6,15 M15,6 A3,3 0 1 1 21,6 A3,3 0 1 1 15,6 Z M3,18 A3,3 0 1 1 9,18 A3,3 0 1 1 3,18 Z M18 9a9 9 0 0 1-9 9" /></Viewbox></c:Marker.Icon></c:Marker>
    <c:Marker Classes="separator" Content="Explored 4 files"><c:Marker.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M3,11 A8,8 0 1 1 19,11 A8,8 0 1 1 3,11 Z M21 21 l-4.3-4.3" /></Viewbox></c:Marker.Icon></c:Marker>
    <c:Marker Classes="vertical" Content="Syncing completed"><c:Marker.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M12 21V7 M16 12 l2 2 4-4 M22 6V4a1 1 0 0 0-1-1h-5a4 4 0 0 0-4 4 4 4 0 0 0-4-4H3a1 1 0 0 0-1 1v13a1 1 0 0 0 1 1h6a3 3 0 0 1 3 3 3 3 0 0 1 3-3h6a1 1 0 0 0 1-1v-1.3" /></Viewbox></c:Marker.Icon></c:Marker>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="marker-border">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="12">
    <c:Marker Classes="border" Content="Switched to release-candidate"><c:Marker.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M6,3 L6,15 M15,6 A3,3 0 1 1 21,6 A3,3 0 1 1 15,6 Z M3,18 A3,3 0 1 1 9,18 A3,3 0 1 1 3,18 Z M18 9a9 9 0 0 1-9 9" /></Viewbox></c:Marker.Icon></c:Marker>
    <c:Marker Classes="border" Content="Reviewed 8 related files"><c:Marker.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M3,11 A8,8 0 1 1 19,11 A8,8 0 1 1 3,11 Z M21 21 l-4.3-4.3" /></Viewbox></c:Marker.Icon></c:Marker>
    <c:Marker Classes="border" Content="Opened implementation notes"><c:Marker.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4 M10 9H8 M16 13H8 M16 17H8" /></Viewbox></c:Marker.Icon></c:Marker>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="marker-shimmer">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="32">
    <c:Marker Classes="shimmer" Content="Thinking..." />
    <c:Marker Classes="separator shimmer" Content="Reading 4 files" />
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="marker-status">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="32">
    <c:Marker Content="Compacting conversation"><c:Marker.Icon><c:Spinner Width="16" Height="16" /></c:Marker.Icon></c:Marker>
    <c:Marker Classes="separator" Content="Running tests"><c:Marker.Icon><c:Spinner Width="16" Height="16" /></c:Marker.Icon></c:Marker>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="marker-link-button">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="32">
    <c:MarkerLink NavigateUri="#links-and-buttons" Content="View the pull request"><c:MarkerLink.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[ContentPresenter].Foreground}" Data="M6,3 L6,15 M15,6 A3,3 0 1 1 21,6 A3,3 0 1 1 15,6 Z M3,18 A3,3 0 1 1 9,18 A3,3 0 1 1 3,18 Z M18 9a9 9 0 0 1-9 9" /></Viewbox></c:MarkerLink.Icon></c:MarkerLink>
    <c:MarkerButton Content="Revert this change"><c:MarkerButton.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[ContentPresenter].Foreground}" Data="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8 M3 3v5h5" /></Viewbox></c:MarkerButton.Icon></c:MarkerButton>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="bubble-demo">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="32">
    <c:Bubble Classes="end" Content="Hey there! what&apos;s up?" />
    <c:BubbleGroup><c:Bubble Classes="muted" Content="Hey! Want to see chat bubbles?" /><c:Bubble Classes="muted" Content="I can group messages, switch sides, and keep the whole thread easy to scan."><c:Bubble.Reactions><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="👍" /></StackPanel></c:Bubble.Reactions></c:Bubble></c:BubbleGroup>
    <c:Bubble Classes="end" Content="Sure. Hit me with your best demo." />
    <c:Bubble Classes="muted" Content="Yes. You are reading a demo that is demoing itself. Very meta. Very on-brand."><c:Bubble.Reactions><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="👍" /><TextBlock Text="🔥" /><TextBlock Text="👀" /><TextBlock Text="+2" /></StackPanel></c:Bubble.Reactions></c:Bubble>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="bubble-variants">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="48">
    <c:Bubble Content="This is the default primary bubble." />
    <c:Bubble Classes="secondary end" Content="This is the secondary variant." />
    <c:Bubble Classes="muted" Content="This one is muted. It uses a lower emphasis color for the chat bubble."><c:Bubble.Reactions><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="👍" /></StackPanel></c:Bubble.Reactions></c:Bubble>
    <c:Bubble Classes="tinted end" Content="This one is tinted. The tint is a softer color derived from the primary color." />
    <c:Bubble Classes="outline" Content="We can also use an outlined variant." />
    <c:Bubble Classes="destructive end" Content="Or a destructive variant with a reaction."><c:Bubble.Reactions><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="🔥" /></StackPanel></c:Bubble.Reactions></c:Bubble>
    <c:Bubble Classes="ghost" Content="Ghost bubbles work for assistant text and other content that should not be framed. They are full width and can take the full width of the container." />
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="bubble-alignment">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="32">
    <c:Bubble Classes="muted" Content="This bubble is aligned to the start. This is the default alignment." />
    <c:Bubble Classes="end" Content="This bubble is aligned to the end. Use this for user messages." />
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="bubble-group-demo">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="32">
    <c:Bubble Classes="muted" Content="Can you tell me what&apos;s the issue?" />
    <c:BubbleGroup><c:Bubble Classes="end" Content="You tell me!" /><c:Bubble Classes="end" Content="It worked yesterday. You broke it!" /><c:Bubble Classes="end reactions-start" Content="Find the bug and fix it."><c:Bubble.Reactions><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="👀" /></StackPanel></c:Bubble.Reactions></c:Bubble></c:BubbleGroup>
    <c:Bubble Classes="muted" Content="Want me to diff yesterday&apos;s you against today&apos;s you? It&apos;s a bit embarrassing." />
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="bubble-link-button">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="32">
    <c:Bubble Classes="muted" Content="How can I help you today?" />
    <c:BubbleGroup><c:Bubble Classes="tinted end"><Button Content="I forgot my password" /></c:Bubble><c:Bubble Classes="tinted end"><Button Content="I need help with my subscription" /></c:Bubble><c:Bubble Classes="tinted end"><Button Content="Something else. Talk to a human." /></c:Bubble></c:BubbleGroup>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="bubble-collapsible">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="32">
    <c:Bubble Classes="muted" Content="How can I help you today?" />
    <c:Bubble Classes="muted end">
            <c:Collapsible>
              <TextBlock c:Collapsible.Shows="Closed" TextWrapping="Wrap" LineHeight="22.75" Text="The accessibility review found two focus states that were visually too subtle in dark mode.&#10;&#10;I checked the dialog, menu, and drawer paths because each one renders focusable control..." />
              <TextBlock c:Collapsible.Shows="Open" TextWrapping="Wrap" LineHeight="22.75" Text="The accessibility review found two focus states that were visually too subtle in dark mode.&#10;&#10;I checked the dialog, menu, and drawer paths because each one renders focusable controls inside a layered surface.&#10;&#10;The dialog and drawer are fine. The menu needs the hover and focus tokens split so keyboard focus stays visible when the pointer is not involved.&#10;&#10;I also recommend keeping the change in the style file instead of the primitive so the other themes can choose their own focus treatment later." />
              <c:CollapsibleTrigger Classes="link" Padding="0" HorizontalAlignment="Left" Foreground="{DynamicResource CosmoMutedForegroundBrush}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock c:Collapsible.Shows="Closed" Text="Show more" />
                  <TextBlock c:Collapsible.Shows="Open" Text="Show less" />
                  <Viewbox Width="16" Height="16" Classes="chevron"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[Button].Foreground}" Data="M6 9 l6 6 6-6" /></Viewbox>
                </StackPanel>
              </c:CollapsibleTrigger>
            </c:Collapsible>
          </c:Bubble>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="bubble-markdown">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="32">
    <c:Bubble Classes="muted end"><c:Markdown Text="Hello! Are you actually **thinking**?" /></c:Bubble>
    <c:Bubble Classes="ghost"><c:Markdown Text="Ghost bubbles work for assistant text, **markdown**, and other content that should not be framed.&#10;&#10;This is perfect for assistant messages that should not have a frame and can take the full width of the container. You can also render `code` in it.&#10;&#10;Ghost bubbles are full width and can take the full width of the container.&#10;" /></c:Bubble>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="message-demo">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="24">
    <c:Message Classes="end"><c:Message.Avatar><c:Avatar Content="ME" /></c:Message.Avatar><c:MessageContent><c:Bubble Content="Deploying to prod real quick." /></c:MessageContent></c:Message>
    <c:Message><c:Message.Avatar><c:Avatar Content="R" /></c:Message.Avatar><c:MessageContent><c:Bubble Classes="muted" Content="It&apos;s 4:55 PM. On a Friday." /></c:MessageContent></c:Message>
    <c:Message Classes="end"><c:Message.Avatar><c:Avatar Content="ME" /></c:Message.Avatar><c:MessageContent><c:Bubble Content="It&apos;s a one-line change." /><c:MessageFooter Text="Delivered" /></c:MessageContent></c:Message>
    <c:Message><c:Message.Avatar><c:Avatar Content="R" /></c:Message.Avatar><c:MessageContent><c:BubbleGroup><c:Bubble Classes="muted" Content="It&apos;s always a one-line change 😭." /><c:Bubble Classes="muted" Content="Alright, let me take a look."><c:Bubble.Reactions><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="👍" /></StackPanel></c:Bubble.Reactions></c:Bubble></c:BubbleGroup></c:MessageContent></c:Message>
    <c:Marker><c:Marker.Content><TextBlock><Run Text="Oliver" FontWeight="Medium" /><Run Text=" is typing..." /></TextBlock></c:Marker.Content></c:Marker>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="message-group">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="24">
    <c:MessageGroup><c:Message><c:Message.Avatar><Border Width="32" /></c:Message.Avatar><c:MessageContent><c:Bubble Classes="muted" Content="I checked the registry addresses." /></c:MessageContent></c:Message><c:Message><c:Message.Avatar><c:Avatar Content="CN" /></c:Message.Avatar><c:MessageContent><c:Bubble Classes="muted" Content="The component and example JSON now live under the UI registry." /></c:MessageContent></c:Message></c:MessageGroup>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="message-header-footer">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="32">
    <c:Message><c:MessageContent><c:MessageHeader Text="Olivia" /><c:Bubble Classes="muted" Content="I already checked the logs." /></c:MessageContent></c:Message>
    <c:Message Classes="end"><c:MessageContent><c:Bubble Content="Send the report to the team. Ping @shadcn if you need help." /><c:MessageFooter><Run Text="Read " /><Run Text="Yesterday" FontWeight="Normal" /></c:MessageFooter></c:MessageContent></c:Message>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="message-avatar">
          <StackPanel Width="384" HorizontalAlignment="Left" Margin="0,48" Spacing="24">
    <c:Message><c:Message.Avatar><c:Avatar Content="R" /></c:Message.Avatar><c:MessageContent><c:Bubble Classes="muted" Content="The build failed during dependency installation." /></c:MessageContent></c:Message>
    <c:Message Classes="end"><c:Message.Avatar><c:Avatar Content="R" /></c:Message.Avatar><c:MessageContent><c:Bubble Content="Can you share the exact error?" /></c:MessageContent></c:Message>
    <c:Message><c:Message.Avatar><c:Avatar Content="R" /></c:Message.Avatar><c:MessageContent><c:BubbleGroup><c:Bubble Classes="muted" Content="Here&apos;s the error from the logs" /><c:Bubble Classes="muted" Content="Something went wrong with the build. The libraries are not installed correctly. Try running the build again." /></c:BubbleGroup></c:MessageContent></c:Message>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="attachment-demo">
          <StackPanel Width="384" HorizontalAlignment="Center" Margin="0,48" Spacing="12">
    <c:AttachmentGroup><c:Attachment Title="workspace.png" Description="PNG · 820 KB" Classes="vertical image"><c:Attachment.Media><Image Source="/Assets/art-binni.png" Stretch="UniformToFill" /></c:Attachment.Media></c:Attachment><c:Attachment Title="desk-reference.jpg" Description="JPG · 1.1 MB" Classes="vertical image"><c:Attachment.Media><Image Source="/Assets/art-byrom.png" Stretch="UniformToFill" /></c:Attachment.Media></c:Attachment><c:Attachment Title="office-reference.jpg" Description="JPG · 940 KB" Classes="vertical image"><c:Attachment.Media><Image Source="/Assets/art-malyavko.png" Stretch="UniformToFill" /></c:Attachment.Media></c:Attachment></c:AttachmentGroup>
    <c:Attachment Title="sales-dashboard.pdf" Description="Uploading · 64%" State="Uploading" HorizontalAlignment="Stretch"><c:Attachment.Media><c:Spinner Width="16" Height="16" /></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Cancel upload"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment>
    <c:Attachment Title="message-renderer.tsx" Description="TypeScript · 12 KB" HorizontalAlignment="Stretch"><c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M10 12.5 8 15l2 2.5 M14 12.5 l2 2.5-2 2.5 M14 2v4a2 2 0 0 0 2 2h4 M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z" /></Viewbox></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove message-renderer.tsx"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="attachment-states">
          <StackPanel Width="384" HorizontalAlignment="Center" Margin="0,48" Spacing="8">
    <c:Attachment Title="selected-file.pdf" Description="Ready to upload" State="Idle" HorizontalAlignment="Stretch"><c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12,6 L12,12 L16,14" /></Viewbox></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove selected-file.pdf"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment>
    <c:Attachment Title="design-system.zip" Description="Uploading · 64%" State="Uploading" HorizontalAlignment="Stretch"><c:Attachment.Media><c:Spinner Width="16" Height="16" /></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Cancel upload"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment>
    <c:Attachment Title="market-research.pdf" Description="Processing document" State="Processing" HorizontalAlignment="Stretch"><c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4 M10 9H8 M16 13H8 M16 17H8" /></Viewbox></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove market-research.pdf"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment>
    <c:Attachment Title="financial-model.xlsx" Description="Upload failed. Try again." State="Error" HorizontalAlignment="Stretch"><c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M12 9v4 M12 17h.01" /></Viewbox></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Retry upload"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16 M8 16H3v5" /></Viewbox></Button><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove financial-model.xlsx"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment>
    <c:Attachment Title="uploaded-report.pdf" Description="Uploaded · 1.8 MB" State="Done" HorizontalAlignment="Stretch"><c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M20 6 9 17l-5-5" /></Viewbox></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove uploaded-report.pdf"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="attachment-sizes">
          <StackPanel Width="384" HorizontalAlignment="Center" Margin="0,48" Spacing="12">
    <c:Attachment Title="Default attachment" Description="PDF · 2.4 MB" HorizontalAlignment="Stretch"><c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4 M10 9H8 M16 13H8 M16 17H8" /></Viewbox></c:Attachment.Media></c:Attachment>
    <c:Attachment Title="Small attachment" Description="PDF · 2.4 MB" Classes="sm" HorizontalAlignment="Stretch"><c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4 M10 9H8 M16 13H8 M16 17H8" /></Viewbox></c:Attachment.Media></c:Attachment>
    <c:Attachment Title="Extra small attachment" Classes="xs" HorizontalAlignment="Stretch"><c:Attachment.Media><Viewbox Width="14" Height="14"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4 M10 9H8 M16 13H8 M16 17H8" /></Viewbox></c:Attachment.Media></c:Attachment>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="attachment-group">
          <StackPanel Width="384" HorizontalAlignment="Center" Margin="0,48" Spacing="0">
    <c:AttachmentGroup><c:Attachment Title="briefing-notes.pdf" Description="PDF · 1.4 MB" Width="256"><c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4 M10 9H8 M16 13H8 M16 17H8" /></Viewbox></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove briefing-notes.pdf"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment><c:Attachment Title="workspace.png" Description="PNG · 820 KB" Classes="image" Width="256"><c:Attachment.Media><Image Source="/Assets/art-binni.png" Stretch="UniformToFill" /></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove workspace.png"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment><c:Attachment Title="customers.csv" Description="CSV · 18 KB" Width="256"><c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M12 3v18 M5,3 L19,3 A2,2 0 0 1 21,5 L21,19 A2,2 0 0 1 19,21 L5,21 A2,2 0 0 1 3,19 L3,5 A2,2 0 0 1 5,3 Z M3 9h18 M3 15h18" /></Viewbox></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove customers.csv"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment><c:Attachment Title="renderer.tsx" Description="TSX · 12 KB" Width="256"><c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M10 12.5 8 15l2 2.5 M14 12.5 l2 2.5-2 2.5 M14 2v4a2 2 0 0 0 2 2h4 M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z" /></Viewbox></c:Attachment.Media><c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove renderer.tsx"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions></c:Attachment></c:AttachmentGroup>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="attachment-trigger">
          <StackPanel Width="384" HorizontalAlignment="Center" Margin="0,48" Spacing="0">
    <StackPanel>
            <c:Attachment Title="research-summary.pdf" Description="Open preview dialog" HorizontalAlignment="Stretch">
              <c:Attachment.Media><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M14 2v4a2 2 0 0 0 2 2h4 M4.268 21a2 2 0 0 0 1.727 1H18a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v3 M9 18 l-1.5-1.5 M2,14 A3,3 0 1 1 8,14 A3,3 0 1 1 2,14 Z" /></Viewbox></c:Attachment.Media>
              <c:Attachment.Actions><StackPanel Orientation="Horizontal"><Button Classes="ghost icon-xs" AutomationProperties.Name="Copy link"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M10,8 L20,8 A2,2 0 0 1 22,10 L22,20 A2,2 0 0 1 20,22 L10,22 A2,2 0 0 1 8,20 L8,10 A2,2 0 0 1 10,8 Z M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></Viewbox></Button><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove research-summary.pdf"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></StackPanel></c:Attachment.Actions>
              <c:Attachment.Trigger><Button x:Name="previewTrigger" Theme="{DynamicResource CosmoAttachmentTrigger}" AutomationProperties.Name="Preview research-summary.pdf" /></c:Attachment.Trigger>
            </c:Attachment>
            <c:Dialog Trigger="{Binding #previewTrigger}" MaxWidth="448">
              <c:DialogHeader Title="research-summary.pdf" Description="The attachment trigger fills the card and opens the dialog, while the actions stay independently clickable above it." />
            </c:Dialog>
          </StackPanel>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="attachment-image">
          <StackPanel Width="384" HorizontalAlignment="Center" Margin="0,48" Spacing="0">
    <c:AttachmentGroup HorizontalAlignment="Center"><c:Attachment Title="workspace.png" Description="PNG · 820 KB" Classes="vertical image">
                <c:Attachment.Media><Image Source="/Assets/art-binni.png" Stretch="UniformToFill" /></c:Attachment.Media>
                <c:Attachment.Actions><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove workspace.png"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></c:Attachment.Actions>
                <c:Attachment.Trigger><HyperlinkButton Theme="{DynamicResource CosmoAttachmentTrigger}" NavigateUri="/Assets/art-binni.png" AutomationProperties.Name="Open workspace.png" /></c:Attachment.Trigger>
              </c:Attachment><c:Attachment Title="desk-reference.jpg" Description="JPG · 1.1 MB" Classes="vertical image">
                <c:Attachment.Media><Image Source="/Assets/art-byrom.png" Stretch="UniformToFill" /></c:Attachment.Media>
                <c:Attachment.Actions><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove desk-reference.jpg"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></c:Attachment.Actions>
                <c:Attachment.Trigger><HyperlinkButton Theme="{DynamicResource CosmoAttachmentTrigger}" NavigateUri="/Assets/art-byrom.png" AutomationProperties.Name="Open desk-reference.jpg" /></c:Attachment.Trigger>
              </c:Attachment><c:Attachment Title="office-reference.jpg" Description="JPG · 940 KB" Classes="vertical image">
                <c:Attachment.Media><Image Source="/Assets/art-malyavko.png" Stretch="UniformToFill" /></c:Attachment.Media>
                <c:Attachment.Actions><Button Classes="ghost icon-xs" AutomationProperties.Name="Remove office-reference.jpg"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M18 6 6 18 M6 6 l12 12" /></Viewbox></Button></c:Attachment.Actions>
                <c:Attachment.Trigger><HyperlinkButton Theme="{DynamicResource CosmoAttachmentTrigger}" NavigateUri="/Assets/art-malyavko.png" AutomationProperties.Name="Open office-reference.jpg" /></c:Attachment.Trigger>
              </c:Attachment></c:AttachmentGroup>
          </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="message-scroller-end">
    <c:Card Width="384" Height="400" Padding="0" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Top">
      <c:Card.ItemsPanel><ItemsPanelTemplate><Panel /></ItemsPanelTemplate></c:Card.ItemsPanel>
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="24,16,24,24" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CosmoBorderBrush}">
          <StackPanel Spacing="4">
            <TextBlock Text="Support" FontWeight="SemiBold" LineHeight="16" />
            <TextBlock Text="A conversation about a failed deploy." FontSize="14" LineHeight="20" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
          </StackPanel>
        </Border>
        <c:MessageScroller DefaultScrollPosition="End">
          <StackPanel Margin="24" Spacing="16">
            <c:Message Classes="end"><c:MessageContent><c:Bubble Classes="end" Content="Deploying to prod real quick." /></c:MessageContent></c:Message>
            <c:Message><c:MessageContent><c:Bubble Classes="muted" Content="It&apos;s 4:55 PM. On a Friday." /></c:MessageContent></c:Message>
            <c:Message Classes="end"><c:MessageContent><c:Bubble Classes="end" Content="It&apos;s a one-line change." /></c:MessageContent></c:Message>
            <c:Message><c:MessageContent><c:Bubble Classes="muted" Content="It&apos;s always a one-line change. Alright, let me take a look." /></c:MessageContent></c:Message>
            <c:Message Classes="end"><c:MessageContent><c:Bubble Classes="end" Content="The build failed during dependency installation." /></c:MessageContent></c:Message>
            <c:Message><c:MessageContent><c:Bubble Classes="muted" Content="Can you share the exact error?" /></c:MessageContent></c:Message>
            <c:Message Classes="end"><c:MessageContent><c:Bubble Classes="end" Content="Something went wrong with the build. The libraries are not installed correctly." /></c:MessageContent></c:Message>
            <c:Message><c:MessageContent><c:Bubble Classes="muted" Content="Try running the build again. I cleared the cache." /></c:MessageContent></c:Message>
            <c:Message Classes="end"><c:MessageContent><c:Bubble Classes="end" Content="It worked. Thanks!" /></c:MessageContent></c:Message>
          </StackPanel>
        </c:MessageScroller>
      </DockPanel>
    </c:Card>
  </DataTemplate>
  <DataTemplate x:Key="message-scroller-start">
    <c:Card Width="384" Height="400" Padding="0" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Top">
      <c:Card.ItemsPanel><ItemsPanelTemplate><Panel /></ItemsPanelTemplate></c:Card.ItemsPanel>
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="24,16,24,24" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CosmoBorderBrush}">
          <StackPanel Spacing="4">
            <TextBlock Text="Support" FontWeight="SemiBold" LineHeight="16" />
            <TextBlock Text="A conversation about a failed deploy." FontSize="14" LineHeight="20" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
          </StackPanel>
        </Border>
        <c:MessageScroller DefaultScrollPosition="Start">
          <StackPanel Margin="24" Spacing="16">
            <c:Message Classes="end"><c:MessageContent><c:Bubble Classes="end" Content="Deploying to prod real quick." /></c:MessageContent></c:Message>
            <c:Message><c:MessageContent><c:Bubble Classes="muted" Content="It&apos;s 4:55 PM. On a Friday." /></c:MessageContent></c:Message>
            <c:Message Classes="end"><c:MessageContent><c:Bubble Classes="end" Content="It&apos;s a one-line change." /></c:MessageContent></c:Message>
            <c:Message><c:MessageContent><c:Bubble Classes="muted" Content="It&apos;s always a one-line change. Alright, let me take a look." /></c:MessageContent></c:Message>
            <c:Message Classes="end"><c:MessageContent><c:Bubble Classes="end" Content="The build failed during dependency installation." /></c:MessageContent></c:Message>
            <c:Message><c:MessageContent><c:Bubble Classes="muted" Content="Can you share the exact error?" /></c:MessageContent></c:Message>
            <c:Message Classes="end"><c:MessageContent><c:Bubble Classes="end" Content="Something went wrong with the build. The libraries are not installed correctly." /></c:MessageContent></c:Message>
            <c:Message><c:MessageContent><c:Bubble Classes="muted" Content="Try running the build again. I cleared the cache." /></c:MessageContent></c:Message>
            <c:Message Classes="end"><c:MessageContent><c:Bubble Classes="end" Content="It worked. Thanks!" /></c:MessageContent></c:Message>
          </StackPanel>
        </c:MessageScroller>
      </DockPanel>
    </c:Card>
  </DataTemplate>
  <DataTemplate x:Key="code-block-demo">
    <c:CodeBlock Width="512" HorizontalAlignment="Left">
      <c:CodeBlock.Title><StackPanel Orientation="Horizontal" Spacing="6"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M10 12.5 8 15l2 2.5 M14 12.5 l2 2.5-2 2.5 M14 2v4a2 2 0 0 0 2 2h4 M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z" /></Viewbox><TextBlock Text="app/api/chat/route.ts" VerticalAlignment="Center" /></StackPanel></c:CodeBlock.Title><c:CodeBlock.Actions><StackPanel Orientation="Horizontal" Spacing="4"><Button Classes="code-block" AutomationProperties.Name="Wrap lines"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[Button].Foreground}" Data="M3,6 L21,6 M3 12h15a3 3 0 1 1 0 6h-4 M16,16 L14,18 L16,20 M3,18 L10,18" /></Viewbox></Button><Button Classes="code-block" AutomationProperties.Name="Download"><Viewbox Width="12" Height="12"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[Button].Foreground}" Data="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7,10 L12,15 L17,10 M12,15 L12,3" /></Viewbox></Button><c:CodeBlockCopyButton Value="import { streamText } from &quot;ai&quot;&#10;&#10;export async function POST(request: Request) {&#10;  const { messages } = await request.json()&#10;&#10;  const result = streamText({&#10;    model: &quot;anthropic/claude-sonnet-4.5&quot;,&#10;    system: &quot;You are a helpful assistant. Answer in one short paragraph.&quot;,&#10;    messages,&#10;  })&#10;&#10;  return result.toUIMessageStreamResponse()&#10;}" /></StackPanel></c:CodeBlock.Actions>
      <c:CodeBlockContent LineNumbers="True">
        <StackPanel>
          <c:CodeBlockLine><TextBlock><Run Text="import" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" { streamText } " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="from" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;ai&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="export" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="async" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="function" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="POST" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="(" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="request" Foreground="{DynamicResource CosmoCodeVariableBrush}" /><Run Text=":" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="Request" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text=") {" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="const" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" { " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="messages" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=" } " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="await" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" request." Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="json" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="()" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
          <c:CodeBlockLine Classes="highlighted"><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="const" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="result" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="streamText" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="({" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine Classes="highlighted"><TextBlock><Run Text="    model: " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;anthropic/claude-sonnet-4.5&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /><Run Text="," Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine Classes="highlighted"><TextBlock><Run Text="    system: " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;You are a helpful assistant. Answer in one short paragraph.&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /><Run Text="," Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
