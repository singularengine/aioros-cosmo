                  </MenuFlyout>
                </c:SidebarMenuButton.Flyout>
              </c:SidebarMenuButton>
            </c:SidebarMenuItem>
          </c:SidebarMenu>
        </c:SidebarFooter>
      </c:Sidebar>
      <c:SidebarInset>
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="64" Padding="16,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <c:SidebarTrigger Margin="-4,0,0,0" VerticalAlignment="Center" />
              <Separator Classes="vertical" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
              <c:Breadcrumb VerticalAlignment="Center">
                <HyperlinkButton Content="Build Your Application" NavigateUri="#" />
                <c:BreadcrumbPage Text="Data Fetching" />
              </c:Breadcrumb>
            </StackPanel>
          </Border>
          <DockPanel Margin="16,0,16,16">
            <UniformGrid DockPanel.Dock="Top" Columns="3" ColumnSpacing="16" Margin="0,0,0,16">
              <c:AspectRatio Ratio="1.7778"><Border CornerRadius="{DynamicResource CosmoRadiusXl}" Background="{DynamicResource CosmoMutedHalfBrush}" /></c:AspectRatio>
              <c:AspectRatio Ratio="1.7778"><Border CornerRadius="{DynamicResource CosmoRadiusXl}" Background="{DynamicResource CosmoMutedHalfBrush}" /></c:AspectRatio>
              <c:AspectRatio Ratio="1.7778"><Border CornerRadius="{DynamicResource CosmoRadiusXl}" Background="{DynamicResource CosmoMutedHalfBrush}" /></c:AspectRatio>
            </UniformGrid>
            <Border CornerRadius="{DynamicResource CosmoRadiusXl}" Background="{DynamicResource CosmoMutedHalfBrush}" />
          </DockPanel>
        </DockPanel>
      </c:SidebarInset>
    </c:SidebarProvider>
  </DataTemplate>
  <DataTemplate x:Key="sidebar-09">
    <c:SidebarProvider Width="1280" Height="800" MobileBreakpoint="0" IsOpen="{Binding SidebarOpen}" x:DataType="m:ShellExample">
      <c:SidebarProvider.DataContext><m:ShellExample /></c:SidebarProvider.DataContext>
      <c:SidebarProvider.Styles>
        <Style Selector="Button.mail">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{DynamicResource CosmoSidebarForegroundBrush}" />
          <Setter Property="CornerRadius" Value="0" />
          <Setter Property="BorderThickness" Value="0,0,0,1" />
          <Setter Property="BorderBrush" Value="{DynamicResource CosmoSidebarBorderBrush}" />
          <Setter Property="FontWeight" Value="Normal" />
          <Setter Property="Height" Value="NaN" />
        </Style>
        <Style Selector="Button.mail:pointerover">
          <Setter Property="Background" Value="{DynamicResource CosmoSidebarAccentBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource CosmoSidebarAccentForegroundBrush}" />
        </Style>
        <Style Selector="c|SidebarMenuButton.rail.lg">
          <Setter Property="Height" Value="32" />
          <Setter Property="Padding" Value="0" />
        </Style>
      </c:SidebarProvider.Styles>
      <c:Sidebar Collapsible="Icon" ExpandedWidth="350" ClipToBounds="True">
        <DockPanel Grid.RowSpan="3">
          <Border DockPanel.Dock="Left" Width="49" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource CosmoSidebarBorderBrush}">
            <DockPanel>
              <c:SidebarHeader DockPanel.Dock="Top" Margin="8">
                <c:SidebarMenu>
                  <c:SidebarMenuItem>
                    <c:SidebarMenuButton Classes="lg rail" Tooltip="Acme Inc">
                      <DockPanel>
                        <Border Width="32" Height="32" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoSidebarPrimaryBrush}"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarPrimaryForegroundBrush}" Data="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3" /></Viewbox></Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="Acme Inc" FontWeight="Medium" LineHeight="17.5" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="Enterprise" FontSize="12" LineHeight="15" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DockPanel>
                    </c:SidebarMenuButton>
                  </c:SidebarMenuItem>
                </c:SidebarMenu>
              </c:SidebarHeader>
              <c:SidebarFooter DockPanel.Dock="Bottom" Margin="8">
                <c:SidebarMenu>
                  <c:SidebarMenuItem>
                    <c:SidebarMenuButton Classes="lg rail" Tooltip="shadcn">
                      <DockPanel>
                        <Viewbox Width="16" Height="16" DockPanel.Dock="Right" Margin="8,0,0,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M7 15 l5 5 5-5 M7 9 l5-5 5 5" /></Viewbox>
                        <c:Avatar Width="32" Height="32" Content="CN" CornerRadius="{DynamicResource CosmoRadiusLg}" />
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="shadcn" FontWeight="Medium" LineHeight="17.5" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="m@example.com" FontSize="12" LineHeight="15" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DockPanel>
                      <c:SidebarMenuButton.Flyout>
                        <MenuFlyout Placement="RightEdgeAlignedBottom">
                          <MenuItem Classes="label">
                            <MenuItem.Header>
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Avatar Width="32" Height="32" Content="CN" CornerRadius="{DynamicResource CosmoRadiusLg}" />
                                <StackPanel VerticalAlignment="Center">
                                  <TextBlock Text="shadcn" FontWeight="Medium" FontSize="14" LineHeight="17.5" />
                                  <TextBlock Text="m@example.com" FontWeight="Normal" FontSize="12" LineHeight="15" />
                                </StackPanel>
                              </StackPanel>
                            </MenuItem.Header>
                          </MenuItem>
                          <Separator />
                          <MenuItem Header="Upgrade to Pro"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z M20 3v4 M22 5h-4 M4 17v2 M5 18H3" /></Viewbox></MenuItem.Icon></MenuItem>
                          <Separator />
                          <MenuItem Header="Account"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z M9 12 l2 2 4-4" /></Viewbox></MenuItem.Icon></MenuItem>
                          <MenuItem Header="Billing"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M4,5 L20,5 A2,2 0 0 1 22,7 L22,17 A2,2 0 0 1 20,19 L4,19 A2,2 0 0 1 2,17 L2,7 A2,2 0 0 1 4,5 Z M2,10 L22,10" /></Viewbox></MenuItem.Icon></MenuItem>
                          <MenuItem Header="Notifications"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M10.268 21a2 2 0 0 0 3.464 0 M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326" /></Viewbox></MenuItem.Icon></MenuItem>
                          <Separator />
                          <MenuItem Header="Log out"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16,17 L21,12 L16,7 M21,12 L9,12" /></Viewbox></MenuItem.Icon></MenuItem>
                        </MenuFlyout>
                      </c:SidebarMenuButton.Flyout>
                    </c:SidebarMenuButton>
                  </c:SidebarMenuItem>
                </c:SidebarMenu>
              </c:SidebarFooter>
              <c:SidebarContent>
                <c:SidebarGroup>
                  <c:SidebarMenu>
                    <c:SidebarMenuItem>
                      <c:SidebarMenuButton Classes="rail" Tooltip="Inbox" ToolTip.Tip="Inbox" ToolTip.Placement="Right" Command="{Binding SelectFolder}" CommandParameter="Inbox"
                                           IsActive="{Binding InInbox}"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M22,12 L16,12 L14,15 L10,15 L8,12 L2,12 M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" /></Viewbox><TextBlock Text="Inbox" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                    </c:SidebarMenuItem>
                    <c:SidebarMenuItem>
                      <c:SidebarMenuButton Classes="rail" Tooltip="Drafts" ToolTip.Tip="Drafts" ToolTip.Placement="Right" Command="{Binding SelectFolder}" CommandParameter="Drafts"
                                           IsActive="{Binding InDrafts}"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4" /></Viewbox><TextBlock Text="Drafts" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                    </c:SidebarMenuItem>
                    <c:SidebarMenuItem>
                      <c:SidebarMenuButton Classes="rail" Tooltip="Sent" ToolTip.Tip="Sent" ToolTip.Placement="Right" Command="{Binding SelectFolder}" CommandParameter="Sent"
                                           IsActive="{Binding InSent}"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z M21.854 2.147 l-10.94 10.939" /></Viewbox><TextBlock Text="Sent" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                    </c:SidebarMenuItem>
                    <c:SidebarMenuItem>
                      <c:SidebarMenuButton Classes="rail" Tooltip="Junk" ToolTip.Tip="Junk" ToolTip.Placement="Right" Command="{Binding SelectFolder}" CommandParameter="Junk"
                                           IsActive="{Binding InJunk}"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M3,3 L21,3 A1,1 0 0 1 22,4 L22,7 A1,1 0 0 1 21,8 L3,8 A1,1 0 0 1 2,7 L2,4 A1,1 0 0 1 3,3 Z M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8 M9.5 17 l5-5 M9.5 12 l5 5" /></Viewbox><TextBlock Text="Junk" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                    </c:SidebarMenuItem>
                    <c:SidebarMenuItem>
                      <c:SidebarMenuButton Classes="rail" Tooltip="Trash" ToolTip.Tip="Trash" ToolTip.Placement="Right" Command="{Binding SelectFolder}" CommandParameter="Trash"
                                           IsActive="{Binding InTrash}"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M3 6h18 M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6 M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2 M10,11 L10,17 M14,11 L14,17" /></Viewbox><TextBlock Text="Trash" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                    </c:SidebarMenuItem>
                  </c:SidebarMenu>
                </c:SidebarGroup>
              </c:SidebarContent>
            </DockPanel>
          </Border>
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="16">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                  <Label Content="Unreads" Target="{Binding #unreads}" VerticalAlignment="Center" FontWeight="Normal" />
                  <ToggleSwitch Name="unreads" IsChecked="{Binding Unreads}" />
                </StackPanel>
                <TextBlock Text="{Binding Folder}" FontSize="16" LineHeight="24" FontWeight="Medium" Foreground="{DynamicResource CosmoForegroundBrush}" VerticalAlignment="Center" />
              </DockPanel>
              <c:SidebarInput PlaceholderText="Type to search..." AutomationProperties.Name="Search" />
            </StackPanel>
            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource CosmoSidebarBorderBrush}" />
            <ScrollViewer Theme="{DynamicResource CosmoScrollArea}" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Mails}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="m:ShellMail">
                    <Button Classes="mail" Padding="16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Date}" FontSize="12" LineHeight="15" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Name}" LineHeight="17.5" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding Subject}" FontWeight="Medium" LineHeight="17.5" />
                        <TextBlock Grid.Row="2" Text="{Binding Teaser}" Width="260" HorizontalAlignment="Left" FontSize="12" LineHeight="15" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </DockPanel>
      </c:Sidebar>
      <c:SidebarInset>
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CosmoBorderBrush}" Background="{DynamicResource CosmoBackgroundBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:SidebarTrigger Margin="-4,0,0,0" VerticalAlignment="Center" />
              <Separator Classes="vertical" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
              <c:Breadcrumb VerticalAlignment="Center">
                <HyperlinkButton Content="All Inboxes" NavigateUri="#" />
                <c:BreadcrumbPage Text="Inbox" />
              </c:Breadcrumb>
            </StackPanel>
          </Border>
          <ScrollViewer Theme="{DynamicResource CosmoScrollArea}" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16" Spacing="16">
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
              <Border Height="48" CornerRadius="{DynamicResource CosmoRadiusLg}" Background="{DynamicResource CosmoMutedHalfBrush}" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </c:SidebarInset>
    </c:SidebarProvider>
  </DataTemplate>
  <DataTemplate x:Key="sidebar-10">
    <c:SidebarProvider Width="1280" Height="800" MobileBreakpoint="0" x:DataType="m:ShellExample">
      <c:SidebarProvider.DataContext><m:ShellExample /></c:SidebarProvider.DataContext>
      <c:SidebarProvider.Styles>
        <Style Selector="c|SidebarMenuAction.start">
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="Margin" Value="8,6,0,0" />
          <Setter Property="Background" Value="{DynamicResource CosmoSidebarAccentBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource CosmoSidebarAccentForegroundBrush}" />
        </Style>
        <Style Selector="FlyoutPresenter.actions">
          <Setter Property="Width" Value="224" />
          <Setter Property="Padding" Value="0" />
        </Style>
      </c:SidebarProvider.Styles>
      <c:Sidebar Classes="borderless">
        <c:SidebarHeader>
          <c:SidebarMenu>
            <c:SidebarMenuItem>
              <c:SidebarMenuButton Padding="6,6" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="20" Height="20" CornerRadius="{DynamicResource CosmoRadiusMd}" Background="{DynamicResource CosmoSidebarPrimaryBrush}"><Panel><Viewbox Width="12" Height="12" IsVisible="{Binding ShowsGallery}"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarPrimaryForegroundBrush}" Data="M7 2h10 M5 6h14 M5,10 L19,10 A2,2 0 0 1 21,12 L21,20 A2,2 0 0 1 19,22 L5,22 A2,2 0 0 1 3,20 L3,12 A2,2 0 0 1 5,10 Z" /></Viewbox><Viewbox Width="12" Height="12" IsVisible="{Binding ShowsWaveform}"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarPrimaryForegroundBrush}" Data="M2 13a2 2 0 0 0 2-2V7a2 2 0 0 1 4 0v13a2 2 0 0 0 4 0V4a2 2 0 0 1 4 0v13a2 2 0 0 0 4 0v-4a2 2 0 0 1 2-2" /></Viewbox><Viewbox Width="12" Height="12" IsVisible="{Binding ShowsCommand}"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarPrimaryForegroundBrush}" Data="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3" /></Viewbox></Panel></Border>
                  <TextBlock Text="{Binding ActiveTeam.Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Viewbox Width="16" Height="16" Opacity="0.5" VerticalAlignment="Center"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M6 9 l6 6 6-6" /></Viewbox>
                </StackPanel>
                <c:SidebarMenuButton.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <MenuItem Classes="label" Header="Teams" />
                    <MenuItem Header="Acme Inc" InputGesture="Ctrl+D1" Command="{Binding SelectTeam}" CommandParameter="Acme Inc" />
                    <MenuItem Header="Acme Corp." InputGesture="Ctrl+D2" Command="{Binding SelectTeam}" CommandParameter="Acme Corp." />
                    <MenuItem Header="Evil Corp." InputGesture="Ctrl+D3" Command="{Binding SelectTeam}" CommandParameter="Evil Corp." />
                    <Separator />
                    <MenuItem Header="Add team"><MenuItem.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoPopoverForegroundBrush}" Data="M5 12h14 M12 5v14" /></Viewbox></MenuItem.Icon></MenuItem>
                  </MenuFlyout>
                </c:SidebarMenuButton.Flyout>
              </c:SidebarMenuButton>
            </c:SidebarMenuItem>
          </c:SidebarMenu>
          <c:SidebarMenu>
            <c:SidebarMenuItem><c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M3,11 A8,8 0 1 1 19,11 A8,8 0 1 1 3,11 Z M21 21 l-4.3-4.3" /></Viewbox><TextBlock Text="Search" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
            <c:SidebarMenuItem><c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z M20 3v4 M22 5h-4 M4 17v2 M5 18H3" /></Viewbox><TextBlock Text="Ask AI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
            <c:SidebarMenuItem><c:SidebarMenuButton IsActive="True"><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8 M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /></Viewbox><TextBlock Text="Home" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
            <c:SidebarMenuItem><c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M22,12 L16,12 L14,15 L10,15 L8,12 L2,12 M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" /></Viewbox><TextBlock Text="Inbox" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
          </c:SidebarMenu>
        </c:SidebarHeader>
        <c:SidebarContent>
          <c:SidebarContent.ItemsPanel><ItemsPanelTemplate><DockPanel LastChildFill="False" VerticalSpacing="8" /></ItemsPanelTemplate></c:SidebarContent.ItemsPanel>
          <c:SidebarGroup DockPanel.Dock="Top" Classes="icon-hidden">
            <c:SidebarGroupLabel Content="Favorites" />
            <c:SidebarMenu>
              <c:SidebarMenuItem>
                <c:SidebarMenuButton ToolTip.Tip="Project Management &amp; Task Tracking"><DockPanel><TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" Text="📊" /><TextBlock Text="Project Management &amp; Task Tracking" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                <c:SidebarMenuAction Classes="show-on-hover" AutomationProperties.Name="More">
                  <Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M11,12 A1,1 0 1 1 13,12 A1,1 0 1 1 11,12 Z M18,12 A1,1 0 1 1 20,12 A1,1 0 1 1 18,12 Z M4,12 A1,1 0 1 1 6,12 A1,1 0 1 1 4,12 Z" /></Viewbox>
                  <c:SidebarMenuAction.Flyout>
                    <MenuFlyout Placement="RightEdgeAlignedTop">
