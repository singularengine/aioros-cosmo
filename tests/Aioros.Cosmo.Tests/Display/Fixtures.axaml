  <DataTemplate x:Key="menubar-demo">
    <Panel Height="300" VerticalAlignment="Top">
      <Menu VerticalAlignment="Top">
        <MenuItem Header="File">
          <MenuItem Header="New Tab" InputGesture="Ctrl+T" />
          <MenuItem Header="New Window" InputGesture="Ctrl+N" />
          <MenuItem Header="New Incognito Window" IsEnabled="False" />
          <MenuItem Header="-" />
          <MenuItem Header="Share">
            <MenuItem Header="Email link" />
            <MenuItem Header="Messages" />
            <MenuItem Header="Notes" />
          </MenuItem>
          <MenuItem Header="-" />
          <MenuItem Header="Print..." InputGesture="Ctrl+P" />
        </MenuItem>
        <MenuItem Header="Edit">
          <MenuItem Header="Undo" InputGesture="Ctrl+Z" />
          <MenuItem Header="Redo" InputGesture="Ctrl+Shift+Z" />
          <MenuItem Header="-" />
          <MenuItem Header="Cut" />
          <MenuItem Header="Copy" />
          <MenuItem Header="Paste" />
        </MenuItem>
        <MenuItem Header="View">
          <MenuItem Header="Always Show Bookmarks Bar" ToggleType="CheckBox" />
          <MenuItem Header="Always Show Full URLs" ToggleType="CheckBox" IsChecked="True" />
          <MenuItem Header="-" />
          <MenuItem Header="Reload" InputGesture="Ctrl+R" Classes="inset" />
          <MenuItem Header="Toggle Fullscreen" Classes="inset" />
        </MenuItem>
        <MenuItem Header="Profiles">
          <MenuItem Header="Andy" ToggleType="Radio" GroupName="profiles" />
          <MenuItem Header="Benoit" ToggleType="Radio" GroupName="profiles" IsChecked="True" />
          <MenuItem Header="Luis" ToggleType="Radio" GroupName="profiles" />
          <MenuItem Header="-" />
          <MenuItem Header="Add Profile..." Classes="inset" />
        </MenuItem>
      </Menu>
    </Panel>
  </DataTemplate>
  <DataTemplate x:Key="menubar-open">
    <Panel Height="300" VerticalAlignment="Top">
      <Menu VerticalAlignment="Top">
        <MenuItem Header="File">
          <MenuItem Header="New Tab" InputGesture="Ctrl+T" />
          <MenuItem Header="New Window" InputGesture="Ctrl+N" />
          <MenuItem Header="New Incognito Window" IsEnabled="False" />
          <MenuItem Header="-" />
          <MenuItem Header="Share">
            <MenuItem Header="Email link" />
            <MenuItem Header="Messages" />
            <MenuItem Header="Notes" />
          </MenuItem>
          <MenuItem Header="-" />
          <MenuItem Header="Print..." InputGesture="Ctrl+P" />
        </MenuItem>
        <MenuItem Header="Edit">
          <MenuItem Header="Undo" InputGesture="Ctrl+Z" />
          <MenuItem Header="Redo" InputGesture="Ctrl+Shift+Z" />
          <MenuItem Header="-" />
          <MenuItem Header="Cut" />
          <MenuItem Header="Copy" />
          <MenuItem Header="Paste" />
        </MenuItem>
        <MenuItem Header="View">
          <MenuItem Header="Always Show Bookmarks Bar" ToggleType="CheckBox" />
          <MenuItem Header="Always Show Full URLs" ToggleType="CheckBox" IsChecked="True" />
          <MenuItem Header="-" />
          <MenuItem Header="Reload" InputGesture="Ctrl+R" Classes="inset" />
          <MenuItem Header="Toggle Fullscreen" Classes="inset" />
        </MenuItem>
        <MenuItem Header="Profiles">
          <MenuItem Header="Andy" ToggleType="Radio" GroupName="profiles" />
          <MenuItem Header="Benoit" ToggleType="Radio" GroupName="profiles" IsChecked="True" />
          <MenuItem Header="Luis" ToggleType="Radio" GroupName="profiles" />
          <MenuItem Header="-" />
          <MenuItem Header="Add Profile..." Classes="inset" />
        </MenuItem>
      </Menu>
    </Panel>
  </DataTemplate>
  <DataTemplate x:Key="resizable-demo">
    <Border Width="450" Height="202" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}"
            CornerRadius="{DynamicResource CosmoRadiusLg}" ClipToBounds="True">
      <c:ResizablePanelGroup>
        <c:ResizablePanel DefaultSize="50"><Panel Height="200"><TextBlock Text="One" FontSize="16" LineHeight="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Panel></c:ResizablePanel>
        <c:ResizableHandle />
        <c:ResizablePanel DefaultSize="50">
          <c:ResizablePanelGroup Orientation="Vertical">
            <c:ResizablePanel DefaultSize="25"><TextBlock Text="Two" FontSize="16" LineHeight="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:ResizablePanel>
            <c:ResizableHandle />
            <c:ResizablePanel DefaultSize="75"><TextBlock Text="Three" FontSize="16" LineHeight="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:ResizablePanel>
          </c:ResizablePanelGroup>
        </c:ResizablePanel>
      </c:ResizablePanelGroup>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="resizable-handle">
    <Border Width="450" Height="200" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}"
            CornerRadius="{DynamicResource CosmoRadiusLg}" ClipToBounds="True">
      <c:ResizablePanelGroup>
        <c:ResizablePanel DefaultSize="25"><TextBlock Text="Sidebar" FontSize="16" LineHeight="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:ResizablePanel>
        <c:ResizableHandle WithHandle="True" />
        <c:ResizablePanel DefaultSize="75"><TextBlock Text="Content" FontSize="16" LineHeight="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:ResizablePanel>
      </c:ResizablePanelGroup>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="resizable-vertical">
    <Border Width="450" Height="200" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource CosmoBorderBrush}"
            CornerRadius="{DynamicResource CosmoRadiusLg}" ClipToBounds="True">
      <c:ResizablePanelGroup Orientation="Vertical">
        <c:ResizablePanel DefaultSize="25"><TextBlock Text="Header" FontSize="16" LineHeight="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:ResizablePanel>
        <c:ResizableHandle />
        <c:ResizablePanel DefaultSize="75"><TextBlock Text="Content" FontSize="16" LineHeight="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:ResizablePanel>
      </c:ResizablePanelGroup>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="carousel-demo">
    <Carousel Width="320" HorizontalAlignment="Center">
      <Border Padding="4"><c:Card><c:AspectRatio Ratio="1"><c:CardContent Padding="24"><TextBlock Text="1" FontSize="36" LineHeight="40" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:AspectRatio></c:Card></Border>
      <Border Padding="4"><c:Card><c:AspectRatio Ratio="1"><c:CardContent Padding="24"><TextBlock Text="2" FontSize="36" LineHeight="40" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:AspectRatio></c:Card></Border>
      <Border Padding="4"><c:Card><c:AspectRatio Ratio="1"><c:CardContent Padding="24"><TextBlock Text="3" FontSize="36" LineHeight="40" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:AspectRatio></c:Card></Border>
      <Border Padding="4"><c:Card><c:AspectRatio Ratio="1"><c:CardContent Padding="24"><TextBlock Text="4" FontSize="36" LineHeight="40" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:AspectRatio></c:Card></Border>
      <Border Padding="4"><c:Card><c:AspectRatio Ratio="1"><c:CardContent Padding="24"><TextBlock Text="5" FontSize="36" LineHeight="40" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:AspectRatio></c:Card></Border>
    </Carousel>
  </DataTemplate>
  <DataTemplate x:Key="carousel-api">
    <StackPanel Width="320" HorizontalAlignment="Center">
      <Carousel Name="Slides">
        <c:Card><c:AspectRatio Ratio="1"><c:CardContent Padding="24"><TextBlock Text="1" FontSize="36" LineHeight="40" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:AspectRatio></c:Card>
        <c:Card><c:AspectRatio Ratio="1"><c:CardContent Padding="24"><TextBlock Text="2" FontSize="36" LineHeight="40" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:AspectRatio></c:Card>
        <c:Card><c:AspectRatio Ratio="1"><c:CardContent Padding="24"><TextBlock Text="3" FontSize="36" LineHeight="40" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:AspectRatio></c:Card>
        <c:Card><c:AspectRatio Ratio="1"><c:CardContent Padding="24"><TextBlock Text="4" FontSize="36" LineHeight="40" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:AspectRatio></c:Card>
        <c:Card><c:AspectRatio Ratio="1"><c:CardContent Padding="24"><TextBlock Text="5" FontSize="36" LineHeight="40" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:AspectRatio></c:Card>
      </Carousel>
      <TextBlock Text="Slide 1 of 5" FontSize="14" LineHeight="20" Margin="0,8" HorizontalAlignment="Center" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="carousel-orientation">
    <Carousel Classes="vertical align-start" Width="320" Height="196" Margin="0,48" HorizontalAlignment="Center" ViewportFraction="0.7449">
      <Border Padding="4,4,4,8"><c:Card VerticalAlignment="Top"><c:CardContent Padding="24"><TextBlock Text="1" FontSize="30" LineHeight="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:Card></Border>
      <Border Padding="4,4,4,8"><c:Card VerticalAlignment="Top"><c:CardContent Padding="24"><TextBlock Text="2" FontSize="30" LineHeight="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:Card></Border>
      <Border Padding="4,4,4,8"><c:Card VerticalAlignment="Top"><c:CardContent Padding="24"><TextBlock Text="3" FontSize="30" LineHeight="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:Card></Border>
      <Border Padding="4,4,4,8"><c:Card VerticalAlignment="Top"><c:CardContent Padding="24"><TextBlock Text="4" FontSize="30" LineHeight="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:Card></Border>
      <Border Padding="4,4,4,8"><c:Card VerticalAlignment="Top"><c:CardContent Padding="24"><TextBlock Text="5" FontSize="30" LineHeight="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></c:CardContent></c:Card></Border>
    </Carousel>
  </DataTemplate>
  <DataTemplate x:Key="command-demo">
    <c:Command Classes="outline">
      <c:CommandGroup Header="Suggestions">
        <c:CommandItem><StackPanel><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M8 2v4 M16 2v4 M5,4 L19,4 A2,2 0 0 1 21,6 L21,20 A2,2 0 0 1 19,22 L5,22 A2,2 0 0 1 3,20 L3,6 A2,2 0 0 1 5,4 Z M3 10h18" /></Viewbox><TextBlock Text="Calendar" /></StackPanel></c:CommandItem>
        <c:CommandItem><StackPanel><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M8 14s1.5 2 4 2 4-2 4-2 M9,9 L9.01,9 M15,9 L15.01,9" /></Viewbox><TextBlock Text="Search Emoji" /></StackPanel></c:CommandItem>
        <c:CommandItem IsEnabled="False"><StackPanel><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M6,2 L18,2 A2,2 0 0 1 20,4 L20,20 A2,2 0 0 1 18,22 L6,22 A2,2 0 0 1 4,20 L4,4 A2,2 0 0 1 6,2 Z M8,6 L16,6 M16,14 L16,18 M16 10h.01 M12 10h.01 M8 10h.01 M12 14h.01 M8 14h.01 M12 18h.01 M8 18h.01" /></Viewbox><TextBlock Text="Calculator" /></StackPanel></c:CommandItem>
      </c:CommandGroup>
      <c:CommandSeparator />
      <c:CommandGroup Header="Settings">
        <c:CommandItem Shortcut="⌘P"><StackPanel><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2 M8,7 A4,4 0 1 1 16,7 A4,4 0 1 1 8,7 Z" /></Viewbox><TextBlock Text="Profile" /></StackPanel></c:CommandItem>
        <c:CommandItem Shortcut="⌘B"><StackPanel><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M4,5 L20,5 A2,2 0 0 1 22,7 L22,17 A2,2 0 0 1 20,19 L4,19 A2,2 0 0 1 2,17 L2,7 A2,2 0 0 1 4,5 Z M2,10 L22,10" /></Viewbox><TextBlock Text="Billing" /></StackPanel></c:CommandItem>
        <c:CommandItem Shortcut="⌘S"><StackPanel><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" Data="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M9,12 A3,3 0 1 1 15,12 A3,3 0 1 1 9,12 Z" /></Viewbox><TextBlock Text="Settings" /></StackPanel></c:CommandItem>
