                          <c:SidebarMenuItem><c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M10,8 L20,8 A2,2 0 0 1 22,10 L22,20 A2,2 0 0 1 20,22 L10,22 A2,2 0 0 1 8,20 L8,10 A2,2 0 0 1 10,8 Z M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></Viewbox><TextBlock Text="Duplicate" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
                          <c:SidebarMenuItem><c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M15,14 L20,9 L15,4 M4 20v-7a4 4 0 0 1 4-4h12" /></Viewbox><TextBlock Text="Move to" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton></c:SidebarMenuItem>
