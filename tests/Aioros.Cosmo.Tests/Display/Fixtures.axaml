              <Border Classes="cover" Grid.Column="1"><Border Background="#EAEAEA" CornerRadius="0,13,13,0" ClipToBounds="True"><Border.Resources>
          <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
              <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="PlaceholderShade" Color="Transparent" /></ResourceDictionary>
              <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="PlaceholderShade" Color="#CC000000" /></ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
          </ResourceDictionary>
        </Border.Resources><Panel><Image Source="/Assets/placeholder.png" Stretch="UniformToFill" AutomationProperties.Name="Image" /><Border Background="{DynamicResource PlaceholderShade}" /></Panel></Border></Border>
