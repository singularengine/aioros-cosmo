    </c:CodeBlock>
    </Expander>
      <c:TraceLine IsVisible="{Binding Chat.ToolsRunning[1]}" Content="Running npm --version" Status="Running"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox></c:TraceLine.Icon></c:TraceLine>
    <Expander IsVisible="{Binding Chat.ToolsShown[1]}" Classes="trace">
      <Expander.Header><c:TraceLine Content="Ran npm --version"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox></c:TraceLine.Icon></c:TraceLine></Expander.Header>
      <c:CodeBlock Classes="sm">

      <c:CodeBlockContent Wrap="True">
        <StackPanel>
          <c:CodeBlockLine><TextBlock Text="11.6.2" /></c:CodeBlockLine>
        </StackPanel>
      </c:CodeBlockContent>
    </c:CodeBlock>
    </Expander>
      <c:TraceLine IsVisible="{Binding Chat.ToolsRunning[2]}" Content="Running pnpm --version" Status="Running"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox></c:TraceLine.Icon></c:TraceLine>
    <Expander IsVisible="{Binding Chat.ToolsShown[2]}" Classes="trace">
      <Expander.Header><c:TraceLine Content="Failed to run pnpm --version" Status="Error"><c:TraceLine.Icon><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{Binding $parent[c:TraceLine].Foreground}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox></c:TraceLine.Icon></c:TraceLine></Expander.Header>
      <c:CodeBlock Classes="sm">

      <c:CodeBlockContent Wrap="True">
        <StackPanel>
          <c:CodeBlockLine><TextBlock Text="command not found: pnpm" /></c:CodeBlockLine>
        </StackPanel>
      </c:CodeBlockContent>
    </c:CodeBlock>
    </Expander>
    </c:Trace><TextBlock IsVisible="{Binding Chat.HasAnswer}" Text="{Binding Chat.Answer}" TextWrapping="Wrap" Foreground="{DynamicResource CosmoForegroundBrush}" /></c:MessageContent></c:Message></StackPanel>
    </DockPanel>
  </DataTemplate>
  <DataTemplate x:Key="questionnaire-demo">
    <c:Questionnaire Width="448" HorizontalAlignment="Center" Shortcuts="Letters" ShowProgress="True" SubmitContent="Save plan">
      <c:QuestionnaireItem Name="direction" Title="What should the agent build next?" Description="Choose a direction or describe another task." IsRequired="True">
        <c:QuestionnaireChoice Value="tool-calls" Description="Show what the agent ran and what came back."><c:QuestionnaireChoice.Content><TextBlock Text="Tool call timeline" FontWeight="Medium" /></c:QuestionnaireChoice.Content></c:QuestionnaireChoice>
        <c:QuestionnaireChoice Value="approvals" Description="Ask before sensitive or destructive actions."><c:QuestionnaireChoice.Content><TextBlock Text="Approval checkpoints" FontWeight="Medium" /></c:QuestionnaireChoice.Content></c:QuestionnaireChoice>
        <c:QuestionnaireChoice Value="handoffs" Description="Make delegated work and results easier to follow."><c:QuestionnaireChoice.Content><TextBlock Text="Sub-agent handoffs" FontWeight="Medium" /></c:QuestionnaireChoice.Content></c:QuestionnaireChoice>
        <c:QuestionnaireInput PlaceholderText="Describe another feature…" AutomationProperties.Name="Another agent feature" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="signals" Title="What should every progress update include?" Description="Select all that apply, or skip this question.">
        <c:QuestionnaireCheck Value="progress" Content="Progress" />
        <c:QuestionnaireCheck Value="decisions" Content="Decisions" />
        <c:QuestionnaireCheck Value="risks" Content="Risks" />
        <c:QuestionnaireCheck Value="next-step" Content="Next step" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="timing" Title="When should work begin?" Description="Choose when the agent should begin the work." IsRequired="True">
        <c:QuestionnaireChoice Value="now" Content="Start now" />
        <c:QuestionnaireChoice Value="next-cycle" Content="Next development cycle" />
        <c:QuestionnaireChoice Value="backlog" Content="Add it to the backlog" />
      </c:QuestionnaireItem>
    </c:Questionnaire>
  </DataTemplate>
  <DataTemplate x:Key="questionnaire-multiple">
    <c:Questionnaire Width="448" HorizontalAlignment="Center" Shortcuts="Letters" SubmitContent="Share context">
      <c:QuestionnaireItem Name="context" Title="What context should the agent inspect?" Description="Select every source that may affect the implementation." IsRequired="True">
        <c:QuestionnaireCheck Value="source" Content="Relevant source files" />
        <c:QuestionnaireCheck Value="tests" Content="Existing tests" />
        <c:QuestionnaireCheck Value="docs" Content="Architecture documentation" />
        <c:QuestionnaireCheck Value="history" Content="Recent commit history" />
      </c:QuestionnaireItem>
    </c:Questionnaire>
  </DataTemplate>
  <DataTemplate x:Key="questionnaire-freeform">
    <c:Questionnaire Width="448" HorizontalAlignment="Center" Shortcuts="Letters" SubmitContent="Use this approach">
      <c:QuestionnaireItem Name="approach" Title="How should the agent approach this refactor?" Description="Choose a strategy or write a more specific instruction." IsRequired="True">
        <c:QuestionnaireChoice Value="incremental" Content="Make the smallest safe change" />
        <c:QuestionnaireChoice Value="module" Content="Refactor one module at a time" />
        <c:QuestionnaireChoice Value="rewrite" Content="Replace the implementation completely" />
        <c:QuestionnaireInput PlaceholderText="Describe another approach…" AutomationProperties.Name="Another refactoring approach" />
      </c:QuestionnaireItem>
    </c:Questionnaire>
  </DataTemplate>
  <DataTemplate x:Key="questionnaire-animated">
    <c:Questionnaire Width="448" HorizontalAlignment="Center" ShowProgress="True" SubmitContent="Save workflow" Classes="animated">
      <c:QuestionnaireItem Name="task" Title="What should the agent do?" Description="Choose the task for this run." IsRequired="True">
        <c:QuestionnaireChoice Value="implement" Content="Implement the requested change" />
        <c:QuestionnaireChoice Value="debug" Content="Debug the current behavior" />
        <c:QuestionnaireChoice Value="review" Content="Review the implementation" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="review" Title="How should the work be reviewed?" Description="Select the verification depth." IsRequired="True">
        <c:QuestionnaireChoice Value="targeted" Content="Targeted checks" />
        <c:QuestionnaireChoice Value="complete" Content="Complete test suite" />
        <c:QuestionnaireChoice Value="manual" Content="Tests and manual QA" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="delivery" Title="How should the result be delivered?" Description="Choose the final handoff format." IsRequired="True">
        <c:QuestionnaireChoice Value="summary" Content="Concise summary" />
        <c:QuestionnaireChoice Value="diff" Content="Summary and changed files" />
        <c:QuestionnaireChoice Value="handoff" Content="Detailed review handoff" />
      </c:QuestionnaireItem>
    </c:Questionnaire>
  </DataTemplate>
  <DataTemplate x:Key="questionnaire-card">
    <c:Questionnaire Width="448" HorizontalAlignment="Center" Shortcuts="Numbers" ShowProgress="True" SubmitContent="Create task" Classes="card card-title">
      <c:QuestionnaireItem Name="task" Title="What should the agent work on?" Description="Choose the task that should be handled next." IsRequired="True">
        <c:QuestionnaireChoice Value="fix" Content="Fix the failing tests" />
        <c:QuestionnaireChoice Value="refactor" Content="Refactor the data layer" />
        <c:QuestionnaireChoice Value="docs" Content="Update the integration guide" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="output" Title="What should the final handoff include?" Description="Pick the level of detail needed for review." IsRequired="True">
        <c:QuestionnaireChoice Value="summary" Content="Summary only" />
        <c:QuestionnaireChoice Value="files" Content="Summary and changed files" />
        <c:QuestionnaireChoice Value="review" Content="Full review handoff" />
      </c:QuestionnaireItem>
    </c:Questionnaire>
  </DataTemplate>
  <DataTemplate x:Key="questionnaire-conditional">
    <Border x:DataType="m:QuestionnaireExamples" Width="448" HorizontalAlignment="Center">
      <Border.DataContext><m:QuestionnaireExamples /></Border.DataContext>
      <c:Questionnaire ShowProgress="True" SubmitContent="Save execution plan">
      <c:QuestionnaireItem Name="runtime" Title="Where should the agent run?" Description="Cloud runs add an environment question to this flow." IsRequired="True">
        <c:QuestionnaireChoice Value="local" Content="Local workspace" IsChecked="{Binding Local}" />
        <c:QuestionnaireChoice Value="cloud" Content="Cloud workspace" IsChecked="{Binding Cloud}" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="environment" Title="Which cloud environment should it use?" IsRequired="True" IsEnabled="{Binding Cloud}">
        <c:QuestionnaireChoice Value="preview" Content="Preview" />
        <c:QuestionnaireChoice Value="staging" Content="Staging" />
        <c:QuestionnaireChoice Value="isolated" Content="Isolated sandbox" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="approval" Title="When should the agent request approval?" IsRequired="True">
        <c:QuestionnaireChoice Value="writes" Content="Before writing files" />
        <c:QuestionnaireChoice Value="commands" Content="Before running commands" />
        <c:QuestionnaireChoice Value="sensitive" Content="Only for sensitive actions" />
      </c:QuestionnaireItem>
    </c:Questionnaire>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="questionnaire-controlled">
    <Border x:DataType="m:QuestionnaireExamples" Width="448" HorizontalAlignment="Center">
      <Border.DataContext><m:QuestionnaireExamples /></Border.DataContext>
      <Grid>
        <c:Questionnaire ShowProgress="True" SubmitContent="Save workflow" CurrentIndex="{Binding Checkpoint}">
      <c:QuestionnaireItem Name="scope" Title="What may the agent change?" Description="The host stores the active checkpoint while Questionnaire navigates." IsRequired="True">
        <c:QuestionnaireChoice Value="component" Content="Only the target component" />
        <c:QuestionnaireChoice Value="tests" Content="Component and related tests" />
        <c:QuestionnaireChoice Value="feature" Content="The complete feature area" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="checks" Title="Which verification level should it use?" IsRequired="True">
        <c:QuestionnaireChoice Value="targeted" Content="Targeted tests" />
        <c:QuestionnaireChoice Value="package" Content="Package tests and typecheck" />
        <c:QuestionnaireChoice Value="full" Content="Full workspace verification" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="output" Title="What should the agent return when finished?" IsRequired="True">
        <c:QuestionnaireChoice Value="summary" Content="Concise summary" />
        <c:QuestionnaireChoice Value="diff" Content="Summary with changed files" />
        <c:QuestionnaireChoice Value="handoff" Content="Detailed implementation handoff" />
      </c:QuestionnaireItem>
    </c:Questionnaire>
        <TextBlock Text="{Binding CheckpointText}" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="14" LineHeight="20" Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
      </Grid>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="questionnaire-dialog">
    <StackPanel Width="448" HorizontalAlignment="Left">
      <Button x:Name="clarification" Classes="outline" Height="32" Padding="12,0" CornerRadius="16" HorizontalAlignment="Left" Content="Open clarification" />
      <c:Dialog Trigger="{Binding #clarification}" MaxWidth="448">
        <c:Questionnaire ShowProgress="True" SubmitContent="Send answer">
      <c:QuestionnaireItem Name="scope" Title="Which files are in scope?" Description="Choose how broadly the agent can update the workspace." IsRequired="True">
        <c:QuestionnaireChoice Value="component" Content="Component only" />
        <c:QuestionnaireChoice Value="feature" Content="Complete feature directory" />
        <c:QuestionnaireChoice Value="workspace" Content="Any related workspace file" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="tests" Title="How much verification is needed?" Description="Choose the checks the agent should run before handoff." IsRequired="True">
        <c:QuestionnaireChoice Value="targeted" Content="Targeted tests" />
        <c:QuestionnaireChoice Value="package" Content="Package tests" />
        <c:QuestionnaireChoice Value="full" Content="Full workspace verification" />
      </c:QuestionnaireItem>
    </c:Questionnaire>
      </c:Dialog>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="questionnaire-navigation-state">
    <c:Questionnaire Width="448" HorizontalAlignment="Center" ShowProgress="True" SubmitContent="Save permissions" RequiresAnswer="True" Classes="secondary-next">
      <c:QuestionnaireItem Name="permission" Title="What may the agent modify?" Description="Next is intentionally disabled until an answer is selected." IsRequired="True">
        <c:QuestionnaireChoice Value="files" Content="Project files" />
        <c:QuestionnaireChoice Value="tests" Content="Project files and tests" />
        <c:QuestionnaireChoice Value="config" Content="Files, tests, and configuration" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="verification" Title="What must pass before completion?" IsRequired="True">
        <c:QuestionnaireChoice Value="tests" Content="Tests" />
        <c:QuestionnaireChoice Value="types" Content="Tests and types" />
        <c:QuestionnaireChoice Value="all" Content="Tests, types, and visual QA" />
      </c:QuestionnaireItem>
    </c:Questionnaire>
  </DataTemplate>
  <DataTemplate x:Key="questionnaire-progress">
    <c:Questionnaire Width="448" HorizontalAlignment="Center" ShowProgress="True" SubmitContent="Finish plan" Classes="segmented" ProgressFormat="Checkpoint {0} of {1}">
      <c:QuestionnaireItem Name="scope" Title="How large is the change?" IsRequired="True">
        <c:QuestionnaireChoice Value="small" Content="Small patch" />
        <c:QuestionnaireChoice Value="medium" Content="Feature-sized change" />
        <c:QuestionnaireChoice Value="large" Content="Cross-package change" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="strategy" Title="How should commits be organized?" IsRequired="True">
        <c:QuestionnaireChoice Value="single" Content="Single commit" />
        <c:QuestionnaireChoice Value="logical" Content="Logical commits" />
        <c:QuestionnaireChoice Value="squash" Content="Squash before review" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="tests" Title="Which tests should run?" IsRequired="True">
        <c:QuestionnaireChoice Value="targeted" Content="Targeted tests" />
        <c:QuestionnaireChoice Value="package" Content="Package suite" />
        <c:QuestionnaireChoice Value="workspace" Content="Full workspace" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="delivery" Title="How should the work be delivered?" IsRequired="True">
        <c:QuestionnaireChoice Value="patch" Content="Patch only" />
        <c:QuestionnaireChoice Value="commit" Content="Committed locally" />
        <c:QuestionnaireChoice Value="branch" Content="Push a review branch" />
      </c:QuestionnaireItem>
    </c:Questionnaire>
  </DataTemplate>
  <DataTemplate x:Key="questionnaire-resume">
    <c:Questionnaire Width="448" HorizontalAlignment="Center" ShowProgress="True" SubmitContent="Update draft" CurrentIndex="1" ResetContent="Reset changes">
      <c:QuestionnaireItem Name="change" Title="What kind of migration is this?" Description="This answer was saved during the previous session." IsRequired="True">
        <c:QuestionnaireChoice Value="incremental" Content="Incremental migration" IsChecked="True" />
        <c:QuestionnaireChoice Value="cutover" Content="Single cutover" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="verification" Title="How should the migration be verified?" Description="These checks were selected during the previous session." IsRequired="True">
        <c:QuestionnaireCheck Value="tests" Content="Run migration tests" IsChecked="True" />
        <c:QuestionnaireCheck Value="typecheck" Content="Run the typecheck" IsChecked="True" />
        <c:QuestionnaireCheck Value="manual" Content="Perform a manual smoke test" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="notes" Title="Anything else the agent should remember?" Description="This note was saved with the draft.">
        <c:QuestionnaireInput Text="Keep the existing public API stable." AutomationProperties.Name="Saved migration note" />
      </c:QuestionnaireItem>
    </c:Questionnaire>
  </DataTemplate>
  <DataTemplate x:Key="questionnaire-shortcuts">
    <Border x:DataType="m:QuestionnaireExamples" Width="448" HorizontalAlignment="Center">
      <Border.DataContext><m:QuestionnaireExamples /></Border.DataContext>
      <Grid>
        <c:Questionnaire SubmitContent="Confirm action" Shortcuts="{Binding Shortcuts}">
      <c:QuestionnaireItem Name="action" Title="What should the agent do next?" Description="Use the displayed shortcut or navigate with the keyboard." IsRequired="True">
        <c:QuestionnaireChoice Value="inspect" Content="Inspect the implementation" />
        <c:QuestionnaireChoice Value="tests" Content="Run the relevant tests" />
        <c:QuestionnaireChoice Value="patch" Content="Prepare the patch" />
      </c:QuestionnaireItem>
    </c:Questionnaire>
        <ComboBox Classes="native sm" Width="128" HorizontalAlignment="Right" VerticalAlignment="Top" SelectedIndex="{Binding ShortcutStyle}" AutomationProperties.Name="Shortcut style">
          <ComboBoxItem Content="No shortcuts" /><ComboBoxItem Content="Letters" /><ComboBoxItem Content="Numbers" />
        </ComboBox>
      </Grid>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="questionnaire-skip">
    <c:Questionnaire Width="448" HorizontalAlignment="Center" ShowProgress="True" SubmitContent="Submit brief">
      <c:QuestionnaireItem Name="task" Title="What kind of change is this?" Description="Choose the category that best describes the work." IsRequired="True">
        <c:QuestionnaireChoice Value="feature" Content="New feature" />
        <c:QuestionnaireChoice Value="fix" Content="Bug fix" />
        <c:QuestionnaireChoice Value="refactor" Content="Refactor" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="constraints" Title="Are there any implementation constraints?" Description="Answer if needed, or intentionally skip this question.">
        <c:QuestionnaireChoice Value="no-dependencies" Content="Do not add dependencies" />
        <c:QuestionnaireChoice Value="no-migrations" Content="Do not change the database" />
        <c:QuestionnaireChoice Value="preserve-api" Content="Preserve the public API" />
        <c:QuestionnaireInput PlaceholderText="Describe another constraint…" AutomationProperties.Name="Another implementation constraint" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="review" Title="How should the work be reviewed?" Description="Choose the checks the agent should complete before handoff." IsRequired="True">
        <c:QuestionnaireChoice Value="tests" Content="Run the test suite" />
        <c:QuestionnaireChoice Value="diff" Content="Review the final diff" />
        <c:QuestionnaireChoice Value="both" Content="Tests and diff review" />
      </c:QuestionnaireItem>
    </c:Questionnaire>
  </DataTemplate>
  <DataTemplate x:Key="questionnaire-validation">
    <Border x:DataType="m:QuestionnaireExamples" Width="448" HorizontalAlignment="Center">
      <Border.DataContext><m:QuestionnaireExamples /></Border.DataContext>
      <c:Questionnaire Width="448" HorizontalAlignment="Center" ShowProgress="True" SubmitContent="Validate answers" Classes="card fit-progress" ProgressFormat="{}{0} / {1}" CurrentIndex="{Binding ValidationIndex}" SubmitCommand="{Binding ValidateCommand}">
      <c:QuestionnaireItem Name="detail" Title="How much detail should the answer include?" Description="Choose the response depth." IsRequired="True" Message="{Binding DetailError, Mode=TwoWay}">
        <c:QuestionnaireChoice Value="summary" Content="Concise summary" />
        <c:QuestionnaireChoice Value="complete" Content="Complete answer" />
      </c:QuestionnaireItem>
      <c:QuestionnaireItem Name="audience" Title="Who will read the answer?" Description="Public answers require complete context." IsRequired="True">
        <c:QuestionnaireChoice Value="team" Content="My team" />
        <c:QuestionnaireChoice Value="public" Content="Public audience" />
      </c:QuestionnaireItem>
    </c:Questionnaire>
    </Border>
  </DataTemplate>
</ResourceDictionary>
