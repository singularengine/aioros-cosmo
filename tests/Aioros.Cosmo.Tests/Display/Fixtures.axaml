      <c:CodeBlock.Actions><StackPanel Orientation="Horizontal" Spacing="4"><c:CodeBlockCopyButton Value="export function useDebounce&lt;T&gt;(value: T, delay = 300) {&#10;  const [debounced, setDebounced] = React.useState(value)&#10;&#10;  React.useEffect(() =&gt; {&#10;    const timeout = setTimeout(() =&gt; setDebounced(value), delay)&#10;    return () =&gt; clearTimeout(timeout)&#10;  }, [value, delay])&#10;&#10;  return debounced&#10;}" IsEnabled="{Binding Copies[0]}" /></StackPanel></c:CodeBlock.Actions>
