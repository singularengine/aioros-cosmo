  <DataTemplate x:Key="sidebar-11">
    <c:SidebarProvider Width="1280" Height="800" MobileBreakpoint="0">
      <c:SidebarProvider.Styles>
        <Style Selector="c|SidebarMenuItem.tree > c|SidebarMenuButton /template/ Viewbox#PART_Chevron">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="c|SidebarMenuItem.tree > c|SidebarMenuButton Viewbox.chevron">
          <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="c|SidebarMenuItem.tree:expanded > c|SidebarMenuButton Viewbox.chevron">
          <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="c|SidebarMenuButton.file:active">
          <Setter Property="Background" Value="Transparent" />
        </Style>
      </c:SidebarProvider.Styles>
      <c:Sidebar>
        <c:SidebarContent>
          <c:SidebarGroup>
            <c:SidebarGroupLabel Content="Changes" />
            <c:SidebarMenu>
              <c:SidebarMenuItem>
                <c:SidebarMenuButton><DockPanel><Viewbox Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoSidebarForegroundBrush}" Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4" /></Viewbox><TextBlock Text="README.md" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></c:SidebarMenuButton>
                <c:SidebarMenuBadge Content="M" />
