  <DataTemplate x:Key="code-block-rtl">
    <StackPanel Width="448" HorizontalAlignment="Left" Spacing="12" FlowDirection="RightToLeft" TextElement.FontFamily="avares://Aioros.Cosmo/Assets/Fonts#Geist, avares://Aioros.Cosmo/Assets/Fonts#Cosmo Symbols, avares://Aioros.Cosmo/Assets/Fonts#Cosmo Emoji, avares://Aioros.Cosmo.Tests/Assets/Fonts#Noto Naskh Arabic">
      <TextBlock Text="ثبّت الحزم، ثم شغّل خادم التطوير." LineHeight="20" />
      <c:CodeBlock>
      <c:CodeBlock.Title><StackPanel Orientation="Horizontal" Spacing="6"><Viewbox Width="16" Height="16"><Path Theme="{DynamicResource CosmoIcon}" Stroke="{DynamicResource CosmoForegroundBrush}" Data="M4,17 L10,11 L4,5 M12,19 L20,19" /></Viewbox><TextBlock Text="الطرفية" VerticalAlignment="Center" /></StackPanel></c:CodeBlock.Title><c:CodeBlock.Actions><StackPanel Orientation="Horizontal" Spacing="4"><c:CodeBlockCopyButton Value="pnpm add ai @ai-sdk/react zod&#10;pnpm dev" /></StackPanel></c:CodeBlock.Actions>
      <c:CodeBlockContent LineNumbers="True">
        <StackPanel>
          <c:CodeBlockLine><TextBlock><Run Text="pnpm" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="add" Foreground="{DynamicResource CosmoCodeStringBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="ai" Foreground="{DynamicResource CosmoCodeStringBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="@ai-sdk/react" Foreground="{DynamicResource CosmoCodeStringBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="zod" Foreground="{DynamicResource CosmoCodeStringBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="pnpm" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="dev" Foreground="{DynamicResource CosmoCodeStringBrush}" /></TextBlock></c:CodeBlockLine>
        </StackPanel>
      </c:CodeBlockContent>
    </c:CodeBlock>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="code-block-chat">
    <StackPanel Width="448" HorizontalAlignment="Left" Spacing="16">
      <c:Message Classes="end"><c:MessageContent><c:Bubble Classes="muted" Content="How do I stream a response?" /></c:MessageContent></c:Message>
      <c:Message><c:MessageContent Spacing="12"><TextBlock Text="Create a route handler that returns the stream:" TextWrapping="Wrap" /><c:CodeBlock Title="app/api/chat/route.ts">
      <c:CodeBlock.Actions><StackPanel Orientation="Horizontal" Spacing="4"><c:CodeBlockCopyButton Value="import { streamText } from &quot;ai&quot;&#10;&#10;export async function POST(request: Request) {&#10;  const { messages } = await request.json()&#10;&#10;  const result = streamText({&#10;    model: &quot;anthropic/claude-sonnet-4.5&quot;,&#10;    messages,&#10;  })&#10;&#10;  return result.toUIMessageStreamResponse()&#10;}" /></StackPanel></c:CodeBlock.Actions>
      <c:CodeBlockContent>
        <StackPanel>
          <c:CodeBlockLine><TextBlock><Run Text="import" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" { streamText } " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="from" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;ai&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="export" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="async" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="function" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="POST" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="(" Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="request" Foreground="{DynamicResource CosmoCodeVariableBrush}" /><Run Text=":" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="Request" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text=") {" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="const" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" { " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="messages" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=" } " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="await" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" request." Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="json" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="()" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="const" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="result" Foreground="{DynamicResource CosmoCodeConstantBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="=" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="streamText" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="({" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="    model: " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="&quot;anthropic/claude-sonnet-4.5&quot;" Foreground="{DynamicResource CosmoCodeStringBrush}" /><Run Text="," Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="    messages," Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="  })" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock Text=" " /></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="  " Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="return" Foreground="{DynamicResource CosmoCodeKeywordBrush}" /><Run Text=" result." Foreground="{DynamicResource CosmoCodeTextBrush}" /><Run Text="toUIMessageStreamResponse" Foreground="{DynamicResource CosmoCodeFunctionBrush}" /><Run Text="()" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
          <c:CodeBlockLine><TextBlock><Run Text="}" Foreground="{DynamicResource CosmoCodeTextBrush}" /></TextBlock></c:CodeBlockLine>
        </StackPanel>
      </c:CodeBlockContent>
    </c:CodeBlock><TextBlock Text="The client reads it with useChat." TextWrapping="Wrap" /></c:MessageContent></c:Message>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="code-block-markdown">
    <StackPanel x:DataType="m:CodeBlockMarkdownExample" Width="448" HorizontalAlignment="Left" Spacing="16" Margin="0,24">
      <StackPanel.DataContext><m:CodeBlockMarkdownExample /></StackPanel.DataContext>
      <c:Message IsVisible="{Binding Chat.Asked}" Classes="end"><c:MessageContent><c:Bubble Classes="muted" Content="How do I debounce a search input in React?" /></c:MessageContent></c:Message>
      <c:Message IsVisible="{Binding Chat.Answering}"><c:MessageContent><c:Markdown Text="{Binding Chat.Answer}" LineNumbers="False" /></c:MessageContent></c:Message>
      <Button Classes="outline sm" Height="28" Padding="12,0" CornerRadius="16" HorizontalAlignment="Left" Content="Replay" IsVisible="{Binding Chat.Idle}" Command="{Binding ReplayCommand}" />
    </StackPanel>
  </DataTemplate>
