    </Expander>
      <c:TraceLine IsVisible="{Binding Chat.ToolsRunning[2]}" Content="Running pnpm install --frozen-lockfile" Status="Running"><c:TraceLine.Icon><c:Spinner Width="16" Height="16" /></c:TraceLine.Icon></c:TraceLine>
