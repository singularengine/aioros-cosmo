<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AiorosVersion>0.1.0-preview.1</AiorosVersion>
    <PictorVersion>0.1.0-preview.1</PictorVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Aioros" Version="$(AiorosVersion)" />
    <PackageVersion Include="Aioros.Markup" Version="$(AiorosVersion)" />
    <PackageVersion Include="Aioros.Testing" Version="$(AiorosVersion)" />
    <PackageVersion Include="Aioros.Pictor.Avalonia" Version="$(PictorVersion)" />
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>
