<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="https://aioros.dev/cosmo">
  <StackPanel Spacing="16" Margin="24" MaxWidth="560" HorizontalAlignment="Left">
    <c:Empty Title="Page not found" Description="The page you are looking for does not exist." />
    <HyperlinkButton Classes="outline" NavigateUri="/" Content="Go to the dashboard" />
  </StackPanel>
</UserControl>
