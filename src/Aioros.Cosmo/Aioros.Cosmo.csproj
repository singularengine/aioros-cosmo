<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <RootNamespace>Aioros.Cosmo</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>shadcn/ui's components, variants and design tokens as pure Avalonia XAML: control themes and resource dictionaries that Aioros writes as HTML on the web and Avalonia draws natively on the desktop. An independent port, not affiliated with or endorsed by shadcn.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/singularengine/aioros-cosmo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/singularengine/aioros-cosmo.git</RepositoryUrl>
    <PackageTags>avalonia;xaml;aioros;shadcn;ui;components;design-tokens</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Aioros.Markup" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Aioros.Cosmo.Tests" />
  </ItemGroup>
</Project>
