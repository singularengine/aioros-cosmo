<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="https://aioros.dev/cosmo">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Aioros.Cosmo/Display/Icons.axaml" />
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme x:Key="{x:Type Calendar}" TargetType="Calendar">
    <Setter Property="Background" Value="{DynamicResource CosmoBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="c:CalendarDays.Follows" Value="True" />
    <Setter Property="AllowTapRangeSelection" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <StackPanel Name="PART_Root" HorizontalAlignment="Left">
            <CalendarItem Name="PART_CalendarItem" Foreground="{TemplateBinding Foreground}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[SelectionMode=MultipleRange]">
      <Setter Property="AllowTapRangeSelection" Value="False" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type CalendarItem}" TargetType="CalendarItem">
    <Setter Property="DayTitleTemplate">
      <Template x:DataType="x:String">
        <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.8" LineHeight="19.2"
                   Foreground="{DynamicResource CosmoMutedForegroundBrush}" />
      </Template>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="Auto,Auto">
          <Grid ColumnDefinitions="32,*,32" Height="32" Margin="0,0,0,16">
            <Button Name="PART_PreviousButton" Classes="ghost icon-sm" Padding="0" AutomationProperties.Name="Go to the Previous Month">
              <Viewbox Width="16" Height="16">
                <Path Theme="{StaticResource CosmoIcon}" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource CosmoChevronLeftGeometry}" />
              </Viewbox>
            </Button>
            <Button Name="PART_HeaderButton" Grid.Column="1" Classes="calendar-caption" HorizontalAlignment="Center" />
            <StackPanel Name="PART_Dropdowns" Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False">
              <ComboBox Classes="calendar-dropdown" AutomationProperties.Name="Choose the Month"
                        ItemsSource="{Binding $parent[Calendar].(c:CalendarCaption.Months)}"
                        SelectedIndex="{Binding $parent[Calendar].(c:CalendarCaption.Month), Mode=TwoWay}" />
              <ComboBox Classes="calendar-dropdown" AutomationProperties.Name="Choose the Year"
                        ItemsSource="{Binding $parent[Calendar].(c:CalendarCaption.Years)}"
                        SelectedIndex="{Binding $parent[Calendar].(c:CalendarCaption.Year), Mode=TwoWay}" />
            </StackPanel>
            <Button Name="PART_NextButton" Grid.Column="2" Classes="ghost icon-sm" Padding="0" AutomationProperties.Name="Go to the Next Month">
              <Viewbox Width="16" Height="16">
                <Path Theme="{StaticResource CosmoIcon}" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource CosmoChevronRightGeometry}" />
              </Viewbox>
            </Button>
          </Grid>
          <Grid Name="PART_MonthView" Grid.Row="1" IsVisible="False" HorizontalAlignment="Left"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" />
          <Grid Name="PART_YearView" Grid.Row="1" IsVisible="False" HorizontalAlignment="Left"
                RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="56,56,56,56" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Button.calendar-caption">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="^ /template/ Button.calendar-caption:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type CalendarDayButton}" TargetType="CalendarDayButton">
    <Setter Property="ClickMode" Value="Release" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="0,8,0,0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CosmoRadiusMd}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Band" Background="Transparent">
          <Border Name="PART_Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="1" BorderBrush="Transparent" BackgroundSizing="OuterBorderEdge">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" TextBlock.LineHeight="14"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource CosmoAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CosmoAccentForegroundBrush}" />
    </Style>
    <Style Selector="^:dayfocused /template/ Border#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource CosmoRingBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CosmoFocusRingShadow}" />
    </Style>
    <Style Selector="^:today">
      <Setter Property="Background" Value="{DynamicResource CosmoAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CosmoAccentForegroundBrush}" />
    </Style>
    <Style Selector="^:inactive">
      <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
    </Style>
    <Style Selector="^:blackout">
      <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource CosmoPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CosmoPrimaryForegroundBrush}" />
    </Style>
    <Style Selector="^.range-middle">
      <Setter Property="Background" Value="{DynamicResource CosmoAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CosmoAccentForegroundBrush}" />
    </Style>
    <Style Selector="^.outside-hidden:inactive">
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="^.outside-hidden:inactive /template/ Border#PART_Band">
      <Setter Property="Opacity" Value="0" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type CalendarButton}" TargetType="CalendarButton">
    <Setter Property="ClickMode" Value="Release" />
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="2,4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CosmoRadiusMd}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="1" BorderBrush="Transparent">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource CosmoAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CosmoAccentForegroundBrush}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource CosmoPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CosmoPrimaryForegroundBrush}" />
    </Style>
    <Style Selector="^:inactive">
      <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
    </Style>
    <Style Selector="^:btnfocused /template/ Border#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource CosmoRingBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CosmoFocusRingShadow}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
