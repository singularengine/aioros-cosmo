<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="https://aioros.dev/cosmo">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Aioros.Cosmo/Display/Icons.axaml" />
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme x:Key="{x:Type c:DateRangePicker}" TargetType="c:DateRangePicker">
    <Setter Property="Height" Value="36" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Template">
      <ControlTemplate>
        <Button Name="PART_Button" Classes="outline" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="12,0"
                HorizontalContentAlignment="Left" FontWeight="Normal" AutomationProperties.Name="{TemplateBinding Text}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
              <Path Theme="{StaticResource CosmoIcon}" Stroke="{Binding $parent[Button].Foreground}" Data="{DynamicResource CosmoLucideCalendarGeometry}" />
            </Viewbox>
            <TextBlock Name="PART_Text" Text="{TemplateBinding Text}" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="w-auto p-0">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Calendar Name="PART_First" Classes="range-first" Background="Transparent" Padding="12,12,0,12" IsTodayHighlighted="False" />
                <Calendar Name="PART_Second" Classes="range-last" Background="Transparent" Padding="0,12,12,12" IsTodayHighlighted="False" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[IsEmpty=True] /template/ TextBlock#PART_Text">
      <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
