<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="https://aioros.dev/cosmo">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Aioros.Cosmo/Display/Icons.axaml" />
  </ResourceDictionary.MergedDictionaries>
  <StreamGeometry x:Key="CosmoLucideGripVerticalGeometry">M8,12 A1,1 0 1 1 10,12 A1,1 0 1 1 8,12 Z M8,5 A1,1 0 1 1 10,5 A1,1 0 1 1 8,5 Z M8,19 A1,1 0 1 1 10,19 A1,1 0 1 1 8,19 Z M14,12 A1,1 0 1 1 16,12 A1,1 0 1 1 14,12 Z M14,5 A1,1 0 1 1 16,5 A1,1 0 1 1 14,5 Z M14,19 A1,1 0 1 1 16,19 A1,1 0 1 1 14,19 Z</StreamGeometry>

  <ControlTheme x:Key="{x:Type c:ResizableHandle}" TargetType="c:ResizableHandle">
    <Setter Property="Background" Value="{DynamicResource CosmoBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
    <Setter Property="Width" Value="1" />
    <Setter Property="MinWidth" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Hit" Background="Transparent" Margin="-2,0" />
          <Border Name="PART_Line" Background="{TemplateBinding Background}" />
          <Border Name="PART_Ring" Margin="-2" BorderThickness="1" BorderBrush="{DynamicResource CosmoRingBrush}" IsVisible="False" />
          <Border Name="PART_Grip" Width="12" Height="16" CornerRadius="2" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                  BorderBrush="{DynamicResource CosmoBorderBrush}" Background="{DynamicResource CosmoBorderBrush}" IsVisible="{TemplateBinding WithHandle}">
            <Viewbox Width="10" Height="10">
              <Path Theme="{StaticResource CosmoIcon}" Stroke="{TemplateBinding Foreground}" Data="{StaticResource CosmoLucideGripVerticalGeometry}" />
            </Viewbox>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus-visible /template/ Border#PART_Ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:vertical">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="1" />
      <Setter Property="MinHeight" Value="1" />
      <Setter Property="Cursor" Value="SizeNorthSouth" />
    </Style>
    <Style Selector="^:vertical /template/ Border#PART_Hit">
      <Setter Property="Margin" Value="0,-2" />
    </Style>
    <Style Selector="^:vertical /template/ Border#PART_Grip">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
