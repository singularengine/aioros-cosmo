  <StreamGeometry x:Key="CosmoLoaderGeometry">M21,12 A9,9 0 1 1 14.781,3.44</StreamGeometry>
  <StreamGeometry x:Key="CosmoChevronRightGeometry">M9,18 L15,12 L9,6</StreamGeometry>
  <StreamGeometry x:Key="CosmoChevronLeftGeometry">M15,18 L9,12 L15,6</StreamGeometry>
