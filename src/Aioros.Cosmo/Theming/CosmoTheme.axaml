<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="https://aioros.dev/cosmo" xmlns:a="https://aioros.dev"
        x:Class="Aioros.Cosmo.Theming.CosmoTheme">
  <Styles.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="CosmoFontSans">avares://Aioros.Cosmo/Assets/Fonts#Geist, avares://Aioros.Cosmo/Assets/Fonts#Cosmo Symbols, avares://Aioros.Cosmo/Assets/Fonts#Cosmo Emoji</FontFamily>
      <FontFamily x:Key="CosmoFontMono">avares://Aioros.Cosmo/Assets/Fonts#Geist Mono</FontFamily>
      <FontFamily x:Key="CosmoFontCode">avares://Aioros.Cosmo/Assets/Fonts#Geist Mono, avares://Aioros.Cosmo/Assets/Fonts#Cosmo Mono Symbols, avares://Aioros.Cosmo/Assets/Fonts#Cosmo Emoji</FontFamily>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Aioros.Cosmo/Buttons/Button.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Display/Badge.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Display/Card.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Display/Display.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Navigation/Navigation.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Navigation/Menus.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Display/ScrollArea.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Display/Table.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Forms/Label.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Forms/TextBox.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Navigation/SidebarInput.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Forms/Field.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Forms/ComboBox.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Forms/CheckBox.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Forms/RadioButton.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Forms/ToggleSwitch.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Forms/ToggleButton.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Forms/Slider.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Forms/RangeSlider.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Forms/ProgressBar.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Forms/InputGroup.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Forms/InputOtp.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Forms/FileInput.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Forms/DataValidationErrors.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Overlays/Overlays.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Overlays/Flyout.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Overlays/ToolTip.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Overlays/Menu.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Overlays/Dialog.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Overlays/Toast.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Layout/Resizable.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Display/Carousel.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Search/Command.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Navigation/Sidebar.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Dates/Calendar.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Dates/DatePicker.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Dates/DateRangePicker.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Chat/Chat.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Chat/CodeBlock.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Chat/Trace.axaml" />
        <ResourceInclude Source="avares://Aioros.Cosmo/Chat/Questionnaire.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Calendar TextBlock.week-number">
    <Setter Property="Width" Value="32" />
    <Setter Property="FontSize" Value="12.8" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
  </Style>
  <Style Selector="Calendar TextBlock.week-number.week">
    <Setter Property="LineHeight" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="c|Field.invalid > Button">
    <Setter Property="BorderBrush" Value="{DynamicResource CosmoDestructiveBrush}" />
  </Style>
  <Style Selector="c|Field.invalid > Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource CosmoDestructiveBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource CosmoDestructiveFocusRingShadow}" />
  </Style>
  <Style Selector="ToolTip c|Kbd">
    <Setter Property="Background" Value="{DynamicResource CosmoKbdTooltipBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoBackgroundBrush}" />
  </Style>
  <Style Selector="c|ItemHeader > :is(Control), c|ItemFooter > :is(Control)">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="c|ItemHeader > :is(Control):nth-last-child(1), c|ItemFooter > :is(Control):nth-last-child(1)">
    <Setter Property="DockPanel.Dock" Value="Right" />
  </Style>
  <Style Selector="c|Pagination Button.outline">
    <Setter Property="a:Web.Current" Value="page" />
  </Style>
  <Style Selector="c|Field.invalid > Button.outline">
    <Setter Property="BorderBrush" Value="{DynamicResource CosmoButtonOutlineInvalidBorderBrush}" />
  </Style>
  <Style Selector="c|Field.invalid > Button.outline:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource CosmoButtonOutlineInvalidBorderBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource CosmoOutlineDestructiveFocusShadow}" />
  </Style>
  <Style Selector="c|FieldContent > c|FieldLabel">
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <ContainerQuery Name="field-group" Query="min-width:448">
    <Style Selector="c|Field.responsive">
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>
  </ContainerQuery>
  <Style Selector="Calendar.sidebar CalendarDayButton">
    <Setter Property="Width" Value="33" />
    <Setter Property="Height" Value="33" />
  </Style>
  <Style Selector="Calendar.sidebar CalendarDayButton:today, Calendar.sidebar CalendarDayButton:selected">
    <Setter Property="Background" Value="{DynamicResource CosmoSidebarPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoSidebarPrimaryForegroundBrush}" />
  </Style>
  <Style Selector="c|Collapsible">
    <Setter Property="a:Web.Flag" Value="IsOpen" />
  </Style>
  <Style Selector="c|CollapsibleTrigger">
    <Setter Property="a:Web.Flips" Value="IsOpen" />
  </Style>
  <Style Selector="c|Collapsible :is(Control).chevron">
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
  </Style>
  <Style Selector="c|Collapsible:open :is(Control).chevron">
    <Setter Property="RenderTransform" Value="rotate(180deg)" />
  </Style>
  <Style Selector="c|Bubble > :is(Button)">
    <Setter Property="Theme" Value="{StaticResource CosmoBubbleAction}" />
  </Style>
  <Style Selector="c|Bubble > :is(Button):pointerover /template/ Border#PART_Box">
    <Setter Property="Background" Value="{DynamicResource CosmoBubbleHoverBrush}" />
  </Style>
  <Style Selector="c|Bubble.secondary > :is(Button):pointerover /template/ Border#PART_Box">
    <Setter Property="Background" Value="{DynamicResource CosmoBubbleSecondaryHoverBrush}" />
  </Style>
  <Style Selector="c|Bubble.muted > :is(Button):pointerover /template/ Border#PART_Box">
    <Setter Property="Background" Value="{DynamicResource CosmoBubbleMutedHoverBrush}" />
  </Style>
  <Style Selector="c|Bubble.tinted > :is(Button):pointerover /template/ Border#PART_Box">
    <Setter Property="Background" Value="{DynamicResource CosmoBubbleTintedHoverBrush}" />
  </Style>
  <Style Selector="c|Bubble.outline > :is(Button):pointerover /template/ Border#PART_Box">
    <Setter Property="Background" Value="{DynamicResource CosmoBubbleOutlineHoverBrush}" />
  </Style>
  <Style Selector="c|Bubble.outline > :is(Button):pointerover">
    <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
  </Style>
  <Style Selector="c|Bubble.ghost > :is(Button):pointerover /template/ Border#PART_Box">
    <Setter Property="Background" Value="{DynamicResource CosmoBubbleGhostHoverBrush}" />
  </Style>
  <Style Selector="c|Bubble.ghost > :is(Button):pointerover">
    <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
  </Style>
  <Style Selector="c|Bubble.destructive > :is(Button):pointerover /template/ Border#PART_Box">
    <Setter Property="Background" Value="{DynamicResource CosmoBubbleDestructiveHoverBrush}" />
  </Style>
  <Style Selector="c|Sidebar > c|SidebarHeader">
    <Setter Property="Grid.Row" Value="0" />
    <Setter Property="Margin" Value="8" />
  </Style>
  <Style Selector="c|Sidebar > c|SidebarContent">
    <Setter Property="Grid.Row" Value="1" />
  </Style>
  <Style Selector="c|Sidebar > c|SidebarFooter">
    <Setter Property="Grid.Row" Value="2" />
    <Setter Property="Margin" Value="8" />
  </Style>
  <Style Selector="c|Sidebar > c|SidebarRail">
    <Setter Property="Grid.RowSpan" Value="3" />
  </Style>
  <Style Selector="c|Sidebar:floating > c|SidebarRail">
    <Setter Property="Margin" Value="0,-9,-16,-9" />
  </Style>
  <Style Selector="c|Sidebar:inset > c|SidebarRail">
    <Setter Property="Margin" Value="0,-8,-15,-8" />
  </Style>
  <Style Selector="c|SidebarGroup">
    <Setter Property="Margin" Value="8" />
  </Style>
  <Style Selector="c|Sidebar:icon c|SidebarGroupLabel">
    <Setter Property="Margin" Value="0,-32,0,0" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="c|Sidebar:icon :is(Control).icon-hidden">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="c|Sidebar:icon c|SidebarMenuSub">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="c|Sidebar:icon c|SidebarMenuAction">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="c|Sidebar:icon c|SidebarMenuBadge">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="c|SidebarMenuItem:action > c|SidebarMenuButton">
    <Setter Property="Padding" Value="8,6,32,6" />
  </Style>
  <Style Selector="c|Sidebar:icon c|SidebarMenuButton">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="c|Sidebar:icon c|SidebarMenuButton.lg">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="c|SidebarMenuItem:collapsible:not(:expanded) > c|SidebarMenuSub">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="c|SidebarMenuItem:collapsible > c|SidebarMenuButton /template/ Viewbox#PART_Chevron">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="c|SidebarMenuItem:action-toggles > c|SidebarMenuButton /template/ Viewbox#PART_Chevron">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="c|Sidebar:icon c|SidebarMenuButton /template/ Viewbox#PART_Chevron">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="c|SidebarMenuItem:expanded > c|SidebarMenuButton /template/ Viewbox#PART_Chevron">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>
  <Style Selector="c|SidebarMenuItem > c|SidebarMenuAction[Toggles=True]">
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="c|SidebarMenuItem:expanded > c|SidebarMenuAction[Toggles=True]">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>
  <Style Selector="c|SidebarMenuItem.plus > c|SidebarMenuButton /template/ Viewbox#PART_Chevron > Path">
    <Setter Property="Data" Value="{StaticResource CosmoLucidePlusGeometry}" />
  </Style>
  <Style Selector="c|SidebarMenuItem.plus > c|SidebarMenuButton /template/ Viewbox#PART_Chevron">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="c|SidebarMenuItem.plus:expanded > c|SidebarMenuButton /template/ Viewbox#PART_Chevron">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="c|SidebarMenuItem.plus:expanded > c|SidebarMenuButton /template/ Viewbox#PART_Minus">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="c|SidebarMenuSub.flat">
    <Setter Property="Margin" Value="1,0,13,0" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="c|SidebarMenuItem > c|SidebarMenuAction.show-on-hover">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="c|SidebarMenuItem:pointerover > c|SidebarMenuAction.show-on-hover">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="c|SidebarMenuButton > StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="8" />
  </Style>
  <Style Selector="c|SidebarMenuButton > StackPanel > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="c|DialogSurface.command c|Command /template/ Border#PART_InputWrapper">
    <Setter Property="Height" Value="48" />
  </Style>
  <Style Selector="c|DialogSurface.command c|Command /template/ TextBox#PART_Input">
    <Setter Property="Height" Value="48" />
  </Style>
  <Style Selector="c|DialogSurface.command c|CommandGroup">
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="c|DialogSurface.command c|CommandGroup:following">
    <Setter Property="Padding" Value="8,0,8,4" />
  </Style>
  <Style Selector="c|DialogSurface.command c|CommandItem">
    <Setter Property="Padding" Value="8,12" />
  </Style>
  <Style Selector="c|DialogSurface.command c|CommandItem Viewbox">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="c|CommandItem > StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="8" />
  </Style>
  <Style Selector="c|CommandItem > StackPanel > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="FlyoutPresenter.combobox">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Width" Value="NaN" />
  </Style>
  <Style Selector="Button.carousel-indicator">
    <Setter Property="Theme" Value="{DynamicResource CosmoCarouselIndicator}" />
  </Style>
  <Style Selector="Button > StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="8" />
  </Style>
  <Style Selector="Button.sm > StackPanel">
    <Setter Property="Spacing" Value="6" />
  </Style>
  <Style Selector="Button.xs > StackPanel">
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="Button.navigation-menu-link > StackPanel">
    <Setter Property="Orientation" Value="Vertical" />
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="HyperlinkButton.navigation-menu-link > StackPanel">
    <Setter Property="Orientation" Value="Vertical" />
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="Button > StackPanel > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="c|Badge > StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="c|Badge > StackPanel > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="c|Field[Orientation=Horizontal] > :is(Control)">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="c|Field[Orientation=Horizontal]:content > :is(Control)">
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="c|Field[Orientation=Horizontal]:content > CheckBox, c|Field[Orientation=Horizontal]:content > RadioButton">
    <Setter Property="Margin" Value="0,1,0,0" />
  </Style>
  <Style Selector="c|Field[Orientation=Vertical] > ComboBox">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="c|Message.end c|MessageContent > :is(Control):not(c|Bubble)">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="c|Message.end c|Bubble /template/ Panel#PART_Area">
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="c|Message.end c|Bubble:wraps /template/ Panel#PART_Area">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.code-block">
    <Setter Property="Theme" Value="{StaticResource CosmoCodeBlockButton}" />
  </Style>
  <Style Selector="c|CodeBlock:header c|CodeBlockContent">
    <Setter Property="Padding" Value="16,8,16,16" />
  </Style>
  <Style Selector="c|CodeBlock:footer c|CodeBlockContent">
    <Setter Property="Padding" Value="16,16,16,8" />
  </Style>
  <Style Selector="c|CodeBlock:header:footer c|CodeBlockContent">
    <Setter Property="Padding" Value="16,8" />
  </Style>
  <Style Selector="c|CodeBlock.sm c|CodeBlockContent">
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="c|CodeBlock.sm:header c|CodeBlockContent">
    <Setter Property="Padding" Value="12,6,12,12" />
  </Style>
  <Style Selector="c|CodeBlock.sm c|CodeBlockContent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="TextBlock.LineHeight" Value="19.5" />
  </Style>
  <Style Selector="c|CodeBlock.sm c|CodeBlockLine">
    <Setter Property="Margin" Value="-12,0" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector="c|CodeBlockContent :is(Layoutable)">
    <Setter Property="UseLayoutRounding" Value="False" />
  </Style>
  <Style Selector="c|Questionnaire.animated c|QuestionnaireItem">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="0.25,0.1,0.25,1" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="0.25,0.1,0.25,1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="c|Questionnaire.card c|QuestionnaireItem /template/ StackPanel#PART_Body">
    <Setter Property="Margin" Value="24,0" />
  </Style>
  <Style Selector="c|Questionnaire.card c|QuestionnaireItem /template/ ContentPresenter#PART_Title">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="c|Questionnaire.card c|QuestionnaireItem /template/ ContentPresenter#PART_Description">
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="c|Questionnaire.card-title c|QuestionnaireItem /template/ ContentPresenter#PART_Title">
    <Setter Property="TextBlock.LineHeight" Value="16" />
  </Style>
  <Style Selector="c|Questionnaire.card c|QuestionnaireItem /template/ TextBlock#PART_Progress">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="MinWidth" Value="114" />
  </Style>
  <Style Selector="c|Questionnaire.card.fit-progress c|QuestionnaireItem /template/ TextBlock#PART_Progress">
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="Border.questionnaire-segment">
    <Setter Property="Background" Value="{DynamicResource CosmoMutedBrush}" />
  </Style>
  <Style Selector="Border.questionnaire-segment.done">
    <Setter Property="Background" Value="{DynamicResource CosmoPrimaryBrush}" />
  </Style>
  <Style Selector=":is(Button).trace">
    <Setter Property="Theme" Value="{StaticResource CosmoTraceAction}" />
  </Style>
  <Style Selector=":is(Button).trace:pointerover c|TraceLine:not(:error)">
    <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
  </Style>
  <Style Selector="c|CodeBlockLine.hunk">
    <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
  </Style>
  <Style Selector="c|DialogHeader.mono /template/ ContentPresenter#PART_Title">
    <Setter Property="FontFamily" Value="{DynamicResource CosmoFontMono}" />
  </Style>
  <Style Selector="StackPanel.markdown-body, StackPanel.markdown-body :is(Layoutable)">
    <Setter Property="UseLayoutRounding" Value="False" />
  </Style>
  <Style Selector="Border.markdown-code">
    <Setter Property="a:Web.Tag" Value="code" />
    <Setter Property="Background" Value="{DynamicResource CosmoMutedBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Margin" Value="0,0,0,-5.09" />
  </Style>
  <Style Selector="Border.markdown-code > TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource CosmoFontCode}" />
    <Setter Property="FontSize" Value="12.6" />
    <Setter Property="LineHeight" Value="15.12" />
  </Style>
  <Style Selector="Border.markdown-quote">
    <Setter Property="BorderBrush" Value="{DynamicResource CosmoMarkdownQuoteBrush}" />
    <Setter Property="BorderThickness" Value="4,0,0,0" />
    <Setter Property="Padding" Value="16,0,0,0" />
  </Style>
  <Style Selector="Border.markdown-quote TextBlock">
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
  </Style>
  <Style Selector="c|CodeBlock:floating c|CodeBlockCopyButton /template/ Border#PART_Box">
    <Setter Property="BoxShadow" Value="{DynamicResource CosmoCodeBlockFloatingShadow}" />
  </Style>
  <Style Selector="c|CodeBlockContent.show-more /template/ ScrollViewer#PART_Viewport">
    <Setter Property="a:Web.ScrollFade" Value="y" />
  </Style>
  <Style Selector="c|Collapsible:not(:open) c|CodeBlockContent.show-more">
    <Setter Property="MaxHeight" Value="256" />
  </Style>
  <Style Selector="c|Collapsible:not(:open) c|CodeBlockContent.show-more /template/ ScrollViewer#PART_Viewport">
    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="c|Collapsible:open c|CodeBlockContent.show-more.scroll">
    <Setter Property="MaxHeight" Value="384" />
  </Style>
  <Style Selector="c|CodeBlock c|CollapsibleTrigger.ghost.xs">
    <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
  </Style>
  <Style Selector="c|CollapsibleTrigger.code-block">
    <Setter Property="Theme" Value="{StaticResource CosmoCodeBlockButton}" />
  </Style>
  <Style Selector="c|Collapsible:open c|CollapsibleTrigger.code-block">
    <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
  </Style>
  <Style Selector="c|Collapsible:open c|CodeBlockContent.wrap-toggle">
    <Setter Property="Wrap" Value="True" />
  </Style>
  <Style Selector="c|CodeBlockContent:wrap TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="c|FieldGroup > c|FieldGroup">
    <Setter Property="Spacing" Value="16" />
  </Style>
  <Style Selector="c|Field[Orientation=Horizontal] c|FieldDescription">
    <Setter Property="a:Web.TextWrap" Value="balance" />
  </Style>
  <Style Selector="c|Field > c|FieldDescription:nth-last-child(2)">
