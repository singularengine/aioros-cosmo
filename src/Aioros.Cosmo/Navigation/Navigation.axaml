<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:a="https://aioros.dev" xmlns:c="https://aioros.dev/cosmo">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Aioros.Cosmo/Display/Icons.axaml" />
  </ResourceDictionary.MergedDictionaries>

  <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
    <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Name="PART_Root" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
          <Border Name="PART_TabsList" Grid.ColumnSpan="2" Background="{DynamicResource CosmoMutedBrush}" CornerRadius="{DynamicResource CosmoRadiusLg}" Padding="3" Height="36"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Border>
          <ContentPresenter Name="PART_SelectedContentHost" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                            IsVisible="{TemplateBinding SelectedContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[TabStripPlacement=Left] /template/ Border#PART_TabsList">
      <Setter Property="Grid.ColumnSpan" Value="1" />
      <Setter Property="Grid.RowSpan" Value="2" />
      <Setter Property="Height" Value="NaN" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ ContentPresenter#PART_SelectedContentHost">
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Grid.RowSpan" Value="2" />
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Grid.ColumnSpan" Value="1" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left]">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="^.line /template/ Border#PART_TabsList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="^.line">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="4" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="^.line[TabStripPlacement=Left]">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Spacing="4" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CosmoRadiusMd}" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoTabsTriggerBrush}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Height" Value="29" />
    <Setter Property="MinHeight" Value="29" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_LayoutRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                              Foreground="{TemplateBinding Foreground}" TextBlock.LineHeight="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Border Name="PART_SelectedPipe" Background="{DynamicResource CosmoForegroundBrush}" Height="2" Margin="0,0,0,-5" VerticalAlignment="Bottom" Opacity="0">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="0.4,0,0.2,1" />
              </Transitions>
            </Border.Transitions>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource CosmoTabsActiveBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CosmoTabsActiveBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="BoxShadow" Value="{DynamicResource CosmoShadowSm}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_LayoutRoot">
      <Setter Property="BorderBrush" Value="{DynamicResource CosmoRingBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CosmoTabsFocusShadow}" />
    </Style>
    <Style Selector="^:selected:focus-visible /template/ Border#PART_LayoutRoot">
      <Setter Property="BorderBrush" Value="{DynamicResource CosmoTabsActiveFocusBorderBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CosmoTabsActiveFocusShadow}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CosmoAccordionTrigger" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0,16" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CosmoRadiusMd}" Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              TextBlock.LineHeight="20" VerticalAlignment="Top" />
            <Viewbox Name="PART_Chevron" Grid.Column="1" Width="16" Height="16" Margin="0,2,0,0" VerticalAlignment="Top" RenderTransformOrigin="50%,50%">
              <Viewbox.Transitions>
                <Transitions>
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                </Transitions>
              </Viewbox.Transitions>
              <Path Theme="{StaticResource CosmoIcon}" Data="{StaticResource CosmoChevronDownGeometry}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" />
            </Viewbox>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Viewbox#PART_Chevron">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource CosmoFocusRingShadow}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>

  <c:HeightTransition x:Key="CosmoAccordionTransition" />

  <ControlTheme x:Key="{x:Type Expander}" TargetType="Expander">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource CosmoBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="ContentTransition" Value="{StaticResource CosmoAccordionTransition}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <StackPanel>
            <ToggleButton Name="ExpanderHeader" Theme="{StaticResource CosmoAccordionTrigger}" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" IsEnabled="{TemplateBinding IsEnabled}" />
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              IsVisible="{TemplateBinding IsExpanded}" Padding="0,0,0,16" ClipToBounds="True" TextBlock.LineHeight="20" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:Accordion}" TargetType="c:Accordion">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="CosmoCollapsibleTrigger" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          <Border Name="PART_Toggle" Width="32" Height="32" CornerRadius="{DynamicResource CosmoRadiusMd}" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
            <Viewbox Width="16" Height="16">
              <Path Theme="{StaticResource CosmoIcon}" Data="{StaticResource CosmoChevronsUpDownGeometry}" Stroke="{DynamicResource CosmoForegroundBrush}" />
            </Viewbox>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Toggle">
      <Setter Property="Background" Value="{DynamicResource CosmoButtonGhostHoverBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Toggle">
      <Setter Property="BorderBrush" Value="{DynamicResource CosmoRingBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CosmoFocusRingShadow}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CosmoCollapsible" TargetType="Expander">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="8" Background="{TemplateBinding Background}">
          <ToggleButton Name="ExpanderHeader" Theme="{StaticResource CosmoCollapsibleTrigger}" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                        Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" IsEnabled="{TemplateBinding IsEnabled}"
                        Padding="{TemplateBinding Padding}" AutomationProperties.Name="Toggle" />
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            IsVisible="{TemplateBinding IsExpanded}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:Breadcrumb}" TargetType="c:Breadcrumb">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
    <Setter Property="AutomationProperties.Name" Value="breadcrumb" />
    <Setter Property="AutomationProperties.LandmarkType" Value="Navigation" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="10" a:Web.Tag="ol" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="SeparatorTemplate">
      <DataTemplate>
        <Viewbox Width="14" Height="14">
          <Path Theme="{StaticResource CosmoIcon}" Data="{StaticResource CosmoChevronRightGeometry}" Stroke="{DynamicResource CosmoMutedForegroundBrush}" />
        </Viewbox>
      </DataTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:BreadcrumbItem}" TargetType="c:BreadcrumbItem">
    <Setter Property="a:Web.Tag" Value="li" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ContentPresenter Name="PART_Separator" Content=" " ContentTemplate="{TemplateBinding SeparatorTemplate}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"
                            IsVisible="{TemplateBinding IsFirst, Converter={x:Static BoolConverters.Not}}" />
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            TextBlock.LineHeight="20" VerticalAlignment="Center" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:BreadcrumbPage}" TargetType="c:BreadcrumbPage">
    <Setter Property="a:Web.Current" Value="page" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:BreadcrumbEllipsis}" TargetType="c:BreadcrumbEllipsis">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="AutomationProperties.Name" Value="More" />
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Path Theme="{StaticResource CosmoIcon}" Data="{StaticResource CosmoEllipsisGeometry}" Stroke="{TemplateBinding Foreground}" />
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="CosmoBreadcrumbLink" TargetType="HyperlinkButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                          CornerRadius="{DynamicResource CosmoRadiusSm}" TextBlock.LineHeight="20" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="0.4,0,0.2,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource CosmoFocusRingShadow}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CosmoBreadcrumbTrigger" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoMutedForegroundBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                          CornerRadius="{DynamicResource CosmoRadiusSm}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource CosmoFocusRingShadow}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:Pagination}" TargetType="c:Pagination">
    <Setter Property="AutomationProperties.Name" Value="pagination" />
    <Setter Property="AutomationProperties.LandmarkType" Value="Navigation" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" a:Web.Tag="ul" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:PaginationItem}" TargetType="c:PaginationItem">
    <Setter Property="a:Web.Tag" Value="li" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:PaginationPrevious}" TargetType="c:PaginationPrevious" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Content" Value="Previous" />
    <Setter Property="AutomationProperties.Name" Value="Go to previous page" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
              <Path Theme="{StaticResource CosmoIcon}" Data="{StaticResource CosmoChevronLeftGeometry}" Stroke="{TemplateBinding Foreground}" />
            </Viewbox>
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" a:Web.HideBelow="639"
                              Foreground="{TemplateBinding Foreground}" TextBlock.LineHeight="20" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource CosmoButtonGhostHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CosmoAccentForegroundBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource CosmoRingBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CosmoFocusRingShadow}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:PaginationNext}" TargetType="c:PaginationNext" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Content" Value="Next" />
    <Setter Property="AutomationProperties.Name" Value="Go to next page" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" a:Web.HideBelow="639"
                              Foreground="{TemplateBinding Foreground}" TextBlock.LineHeight="20" VerticalAlignment="Center" />
            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
              <Path Theme="{StaticResource CosmoIcon}" Data="{StaticResource CosmoChevronRightGeometry}" Stroke="{TemplateBinding Foreground}" />
            </Viewbox>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource CosmoButtonGhostHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CosmoAccentForegroundBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource CosmoRingBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CosmoFocusRingShadow}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:PaginationEllipsis}" TargetType="c:PaginationEllipsis">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Foreground" Value="{DynamicResource CosmoForegroundBrush}" />
    <Setter Property="AutomationProperties.Name" Value="More pages" />
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Path Theme="{StaticResource CosmoIcon}" Data="{StaticResource CosmoEllipsisGeometry}" Stroke="{TemplateBinding Foreground}" />
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:ButtonGroupText}" TargetType="c:ButtonGroupText">
    <Setter Property="Background" Value="{DynamicResource CosmoMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CosmoBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CosmoRadiusMd}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" BoxShadow="{DynamicResource CosmoShadowXs}">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" TextBlock.LineHeight="20"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
